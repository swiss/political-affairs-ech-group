resource="http://data.europa.eu/eli/reg/2020/2011/oj"/>	</rdf:Description>	<!-- publication of a corrigendum, impacting the modifier and in turn impacting the basic act -->	<!--the impact analysis description for the corrigendum http://data.europa.eu/eli/reg/2020/2011/corrigendum/2022-02-10/oj, will list two impacts, the first one is the direct one from the corrigendum to the modifier, the second one (second level one) from the modifier to the basic act -->	<!--second level impact, with one passive location : first part, from corrigendum to modifier-->	<rdf:Description rdf:about="http://data.europa.eu/eli/impact/C442AFF21183314D85D1E0D55A9DA7094884A4BD_3">		<rdf:type rdf:resource="http://data.europa.eu/eli-i/ontology#Correction"/>		<!--Depending if a consolidation of the modifier took place or not, this property impactProduction might be available or not: -->		<eli-extension:impactProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0000010</eli-extension:impactProduction>		<eli-i:impact_from rdf:resource="http://data.europa.eu/eli/reg/2020/2011/corrigendum/2022-02-10/oj"/>		<eli-i:impact_to rdf:resource="http://data.europa.eu/eli/reg/2020/2011/anx_III/oj/slv"/>		<eli-i:triggers_modification_of_type rdf:resource="http://publications.europa.eu/resource/authority/modification-type/REPLACEMENT"/>		<eli-i:impact_has_date_applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-01</eli-i:impact_has_date_applicability>		<eli-i:impact_is_explicit rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</eli-i:impact_is_explicit>		<eli-i:impact_to rdf:resource="http://data.europa.eu/eli/reg/2020/2011/anx_III/oj"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/reg/2020/2011/anx_III/2022-01-01"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/reg/2020/2011/anx_III/2022-01-01/sl"/>	</rdf:Description>	<!--second level impact, with one passive location : corrigendum to basic act, via the modifier-->	<rdf:Description rdf:about="http://data.europa.eu/eli/impact/C442AFF21183314D85D1E0D55A9DA7094884A4BD_3zzz">		<rdf:type rdf:resource="http://data.europa.eu/eli-i/ontology#Correction"/>		<eli-extension:impactProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0010020</eli-extension:impactProduction>		<eli-i:impact_from rdf:resource="http://data.europa.eu/eli/reg/2020/2011/corrigendum/2022-02-10/oj"/>		<eli-i:indirect_impact_from rdf:resource="http://data.europa.eu/eli/impact/C442AFF21183314D85D1E0D55A9DA7094884A4BD_3"/>		<eli-i:impact_to rdf:resource="http://data.europa.eu.eli/reg/2013/1409/anx_III/oj/slv"/>		<eli-i:triggers_modification_of_type rdf:resource="http://publications.europa.eu/resource/authority/modification-type/REPLACEMENT"/>		<eli-i:impact_has_date_applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-12-01</eli-i:impact_has_date_applicability>		<eli-i:impact_is_explicit rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</eli-i:impact_is_explicit>		<eli-i:impact_to rdf:resource="http://data.europa.eu/eli/reg/2013/1409/anx_III/oj"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/reg/2013/1409/anx_III/2022-01-01"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/reg/2013/1409/anx_III/2022-01-01/sl"/>	</rdf:Description>	<!--* eli:is_part_of relations * -->	<rdf:Description rdf:about="http://data.europa.eu/eli/reg/2013/1409/anx_III/2022-01-01">		<eli:is_part_of rdf:resource="http://data.europa.eu/eli/reg/2013/1409/2022-01-01"/>	</rdf:Description>	<rdf:Description rdf:about="http://data.europa.eu/eli/reg/2020/2011/anx_III/oj">		<eli:is_part_of rdf:resource="http://data.europa.eu/eli/reg/2020/2011/oj"/>	</rdf:Description>	<rdf:Description rdf:about="http://data.europa.eu/eli/reg/2013/1409/anx_III/oj">		<eli:is_part_of rdf:resource="http://data.europa.eu/eli/reg/2013/1409/oj"/>	</rdf:Description>						***********