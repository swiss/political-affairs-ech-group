asic act -->	<!--description of the first part, corrigendum to corrected act (the modifier): -->	<rdf:Description rdf:about="http://data.europa.eu/eli/impact/A035E20E77E1A2750BCDC5BCCEFC56FF56E2443F">		<rdf:type rdf:resource="http://data.europa.eu/eli-i/ontology#Correction"/>		<!--depending wether or not a consolidation is done here between the corrigendum and the modifier, we may keep this reference production or remove it !! -->		<eli-extension:impactProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0000010</eli-extension:impactProduction>		<eli-i:impact_from rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/corrigendum/2022-02-03/oj"/>		<eli-i:impact_to rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/art_1/oj/fin"/>		<eli-i:triggers_modification_of_type rdf:resource="http://publications.europa.eu/resource/authority/modification-type/REPLACEMENT"/>		<eli-i:impact_has_date_applicability rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-01-21</eli-i:impact_has_date_applicability>		<eli-i:impact_is_explicit rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</eli-i:impact_is_explicit>		<eli-i:impact_to rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/art_1/oj"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/art_1/2022-01-21"/>		<eli-i:impact_is_consolidated_by rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/art_1/2022-01-21/fin"/>	</rdf:Description>	<!--description of the second part, corrigendum to basic act: -->	<rdf:Description rdf:about="http://data.europa.eu/eli/impact/A035E20E77E1A2750BCDC5BCCEFC56FF56E2443F_zzz">		<rdf:type rdf:resource="http://data.europa.eu/eli-i/ontology#Correction"/>		<eli-extension:impactProduction rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0030020</eli-extension:impactProduction>		<eli-i:impact_from rdf:resource="http://data.europa.eu/eli/dec_impl/2022/88/corrigendum/2022-02-03/oj"/>		<eli-i:indir