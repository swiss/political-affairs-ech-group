<http://data.europa.eu/eli/shapes> a owl:Ontology, adms:Asset;
  rdfs:label "ELI range validation shapes"@en;
  dct:title "ELI range validation shapes"@en;
  dct:description "This specification adds additionnal constraints on top of the \"core\" ELI validation constraint to check for the proper range of some of the ELI properties. Those constraints cannot be enforced when publishing ELI metadata in a single webpage, but can be enforced when applying the rules on a complete graph. This file is not autonomous and must be used in complement to the \"core\" ELI validation rules."@en;
  owl:versionInfo "45717";
  dct:conformsTo <https://www.w3.org/TR/shacl>;
  dct:created "2025-09-26"^^xsd:date;
  dct:modified "2025-09-26T00:00:00.000Z"^^xsd:dateTime;
  dct:creator "ELI Taskforce"@en .

