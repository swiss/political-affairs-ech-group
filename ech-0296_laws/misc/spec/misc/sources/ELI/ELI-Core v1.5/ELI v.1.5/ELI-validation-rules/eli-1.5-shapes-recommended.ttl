elishrec:Component_belongsToEli a sh:ConstraintComponent;
  sh:parameter _:eb559f955f9d4974b990ebae92fed3761462;
  sh:labelTemplate "Found in ELI ontology";
  sh:nodeValidator elishrec:Component_belongsToEli-nodeValidator .

_:eb559f955f9d4974b990ebae92fed3761462 sh:path elishrec:belongsToEli;
  sh:name "déclaré dans ELI"@fr, "declared in ELI"@en .

elishrec:Component_belongsToEli-nodeValidator a sh:SPARQLSelectValidator;
  sh:message "Cannot be found in the ELI ontology";
  sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this
WHERE {
 # To work this requires the ELI OWL file
 FILTER NOT EXISTS {
 $this a ?predicateType . VALUES ?predicateType { owl:ObjectProperty owl:DatatypeProperty owl:AnnotationProperty }
 }
 FILTER ($belongsToEli) .
}""" .

<http://data.europa.eu/eli/shapes-recommended> a owl:Ontology, adms:Asset;
  rdfs:label "ELI recommended shapes"@en;
  dct:title "ELI recommended shapes"@en;
  dct:description "This specification encodes the non-mandatory, \"recommended\" rules for ELI metadata encoding. It is a complement to the core validation rules for ELI metadata."@en;
  owl:versionInfo "45778";
  dct:conformsTo <https://www.w3.org/TR/shacl>;
  dct:created "2025-09-26"^^xsd:date;
  dct:modified "2025-12-12T00:00:00.000Z"^^xsd:dateTime;
  dct:creator "ELI Taskforce"@en .

eli:LegalResource a rdfs:Class, sh:NodeShape;
  sh:property elishrec:LegalResourceLegalExpression_relevant_for, elishrec:LegalResourceLegalExpression_jurisdiction,
    elishrec:LegalResource_date_document_or_date_publication_or_version_date .

eli:LegalExpression a rdfs:Class, sh:NodeShape;
  sh:property elishrec:LegalResourceLegalExpression_relevant_for, elishrec:LegalResourceLegalExpression_jurisdiction .

eli:Format a rdfs:Class, sh:NodeShape;
  sh:property elishrec:Format_media_type .

eli:LegalResourceSubdivision a rdfs:Class, sh:NodeShape .

eli:Work a rdfs:Class, sh:NodeShape;
  sh:property elishrec:Work_is_about .

eli:Expression a rdfs:Class, sh:NodeShape;
  sh:property elishrec:Expression_language .

eli:Manifestation a rdfs:Class, sh:NodeShape;
  sh:property elishrec:Manifestation_format .

eli:Person a rdfs:Class, sh:NodeShape .

eli:Organization a rdfs:Class, sh:NodeShape .

eli:ComplexWork a rdfs:Class, sh:NodeShape .

eli:WorkSubdivision a rdfs:Class, sh:NodeShape .

elishrec:AnyEliNamespaceProperty a sh:NodeShape;
  sh:severity sh:Warning;
  sh:target elishrec:AnyEliNamespaceProperty-target;
  elishrec:belongsToEli "true" .

elishrec:AnyEliNamespaceProperty-target sh:select """PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT DISTINCT $this
WHERE {
 ?x $this ?o .
 FILTER (STRSTARTS(STR($this), \"http://data.europa.eu/eli/ontology#\")) .
}""" .

elishrec:Work_is_about sh:path eli:is_about;
  sh:severity sh:Info;
  sh:description "eli:is_about CAN have an IRI value like \"^http://eurovoc.europa.eu(.*)\", but it is OK to use your own";
  sh:pattern "^http://eurovoc.europa.eu(.*)" .

elishrec:Expression_language sh:path eli:language;
  sh:severity sh:Warning;
  sh:description "eli:language SHOULD have an IRI value starting with \"^http://publications.europa.eu/resource/authority/language/(.*)\"";
  sh:nodeKind sh:IRI;
  sh:pattern "^http://publications.europa.eu/resource/authority/language/(.*)" .

elishrec:LegalResourceLegalExpression_relevant_for sh:path eli:relevant_for;
  sh:severity sh:Info;
  sh:description "eli:relevant_for CAN have an IRI value like \"^http://publications.europa.eu/resource/authority/atu/(.*)\", but it is OK to use a local identifier";
  sh:pattern "^http://publications.europa.eu/resource/authority/atu/(.*)" .

elishrec:LegalResourceLegalExpression_jurisdiction sh:path eli:jurisdiction;
  sh:severity sh:Info;
  sh:description "eli:jurisdiction CAN have an IRI value like \"^http://publications.europa.eu/resource/authority/atu/(.*)\", but it is OK to use a local identifier";
  sh:pattern "^http://publications.europa.eu/resource/authority/atu/(.*)" .

elishrec:LegalResource_date_document_or_date_publication_or_version_date sh:path _:eb559f955f9d4974b990ebae92fed3761445;
  sh:severity sh:Warning;
  sh:description "Either eli:date_document or eli:date_publication or eli:version_date SHOULD be present on a LegalResource";
  sh:minCount "1"^^xsd:integer .

_:eb559f955f9d4974b990ebae92fed3761445 sh:alternativePath _:eb559f955f9d4974b990ebae92fed3761446 .

_:eb559f955f9d4974b990ebae92fed3761446 rdf:first eli:date_document;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761447 .

_:eb559f955f9d4974b990ebae92fed3761447 rdf:first eli:date_publication;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761448 .

_:eb559f955f9d4974b990ebae92fed3761448 rdf:first eli:version_date;
  rdf:rest rdf:nil .

elishrec:Format_media_type sh:path eli:media_type;
  sh:severity sh:Info;
  sh:description "A Format CAN indicate a value for the property \"media_type\", with a IANA media-type, for content negotiation (if you use a IANA media-type, value will be the same for eli:format and eli:media_type).";
  sh:minCount "1"^^xsd:integer .

elishrec:Manifestation_format sh:path eli:format;
  sh:severity sh:Warning;
  sh:description "eli:format SHOULD have a value in application:xml, application:akn+xml, application:xhtml+xml, application:pdf, application:pdf;type=archival, application:pdf;type=generated, application:pdf;type=scanned, application:pdf;type=signed, text:html, text:plain, eli:print_format";
  sh:in _:eb559f955f9d4974b990ebae92fed3761449 .

_:eb559f955f9d4974b990ebae92fed3761449 rdf:first <http://www.iana.org/assignments/media-types/application/xml>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761450 .

_:eb559f955f9d4974b990ebae92fed3761450 rdf:first <http://www.iana.org/assignments/media-types/application/akn+xml>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761451 .

_:eb559f955f9d4974b990ebae92fed3761451 rdf:first <http://www.iana.org/assignments/media-types/application/xhtml+xml>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761452 .

_:eb559f955f9d4974b990ebae92fed3761452 rdf:first <http://www.iana.org/assignments/media-types/application/pdf>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761453 .

_:eb559f955f9d4974b990ebae92fed3761453 rdf:first <http://www.iana.org/assignments/media-types/application/pdf;type=archival>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761454 .

_:eb559f955f9d4974b990ebae92fed3761454 rdf:first <http://www.iana.org/assignments/media-types/application/pdf;type=generated>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761455 .

_:eb559f955f9d4974b990ebae92fed3761455 rdf:first <http://www.iana.org/assignments/media-types/application/pdf;type=scanned>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761456 .

_:eb559f955f9d4974b990ebae92fed3761456 rdf:first <http://www.iana.org/assignments/media-types/application/pdf;type=signed>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761457 .

_:eb559f955f9d4974b990ebae92fed3761457 rdf:first <http://www.iana.org/assignments/media-types/text/html>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761458 .

_:eb559f955f9d4974b990ebae92fed3761458 rdf:first <http://www.iana.org/assignments/media-types/text/plain>;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761459 .

_:eb559f955f9d4974b990ebae92fed3761459 rdf:first eli:print_format;
  rdf:rest rdf:nil .

