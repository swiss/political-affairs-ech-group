elish:AbstractLegalResource a sh:NodeShape;
  rdfs:label "Abstract Legal resource"@en;
  rdfs:comment """Legal resources that have at least one other legal resource as member.
Note : for performance reasons, the rdfs:subClassOf criteria is implemented with a \"?\" rather than a \"*\"."""@en;
  sh:target elish:AbstractLegalResource-target;
  sh:property elish:AbstractLegalResource_has_member_or_is_member_of .

elish:AbstractLegalResource-target sh:select """PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this rdf:type/rdfs:subClassOf? eli:LegalResource .
 FILTER NOT EXISTS { $this eli:is_realized_by|^eli:realizes ?something . }
}""" .

elish:IndividualLegalResource a sh:NodeShape;
  rdfs:label "Individual Legal resource"@en;
  rdfs:comment """Legal resources that do not have other legal resources as members (and that MUST but realized by at least one Expression).
Note : for performance reasons, the rdfs:subClassOf criteria is implemented with a \"?\" rather than a \"*\""""@en;
  sh:target elish:IndividualLegalResource-target;
  sh:property elish:IndividualLegalResource_is_realized_by_or_inverse_realizes, elish:IndividualLegalResource_zeroorone_is_member_of_or_has_member_then_type_document;
  sh:sparql elish:BusinessRule_1 .

elish:IndividualLegalResource-target sh:select """PREFIX eli: <http://data.europa.eu/eli/ontology#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this rdf:type/rdfs:subClassOf? eli:LegalResource .
 FILTER NOT EXISTS { $this eli:has_member|^eli:is_member_of ?something . }
}""" .

