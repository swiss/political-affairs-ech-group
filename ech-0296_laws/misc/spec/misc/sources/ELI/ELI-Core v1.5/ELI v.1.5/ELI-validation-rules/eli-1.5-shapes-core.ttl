  sh:name "first date of entry into force"@en;
  sh:description """A LegalResource or LegalExpression MUST not have more than one first_date_entry_into_force.
eli:first_date_entry_in_force MUST have a literal value with datatype xsd:date""";
  sh:nodeKind sh:Literal;
  sh:maxCount "1"^^xsd:integer;
  sh:datatype xsd:date .

