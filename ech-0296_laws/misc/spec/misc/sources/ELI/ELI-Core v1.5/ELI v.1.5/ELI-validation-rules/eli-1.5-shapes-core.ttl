elish:BusinessRule_1 a sh:SPARQLConstraint;
  dct:description "For a given individual LegalResource, we MUST find at least one Format that qualifies for the Pillar 4 full-text retrieval algorithm"@fr;
  sh:message "No suitable eli:Format has been found on an individual legal resource to retrieve the full-text of the legislation";
  sh:select """PREFIX eli: <http://data.europa.eu/eli/ontology#>
SELECT $this
WHERE {
 FILTER NOT EXISTS {
 $this (eli:is_realized_by|^eli:realizes) ?expression .
 ?expression eli:is_embodied_by|^eli:embodies ?format .
 ?format eli:media_type|eli:format ?mediaTypeOrFormat .
 FILTER(?mediaTypeOrFormat IN (
 <http://www.iana.org/assignments/media-types/text/html>,
 <http://www.iana.org/assignments/media-types/application/xhtml+xml>,
 <http://www.iana.org/assignments/media-types/application/xml>,
 <http://www.iana.org/assignments/media-types/application/pdf>
 ))
 }
}""" .
