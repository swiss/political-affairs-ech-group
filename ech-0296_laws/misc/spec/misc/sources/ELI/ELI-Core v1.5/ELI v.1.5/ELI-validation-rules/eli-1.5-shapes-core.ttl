  sh:property elish:LegalResourceLegalExpressionFormat_uri_schema, elish:LegalResourceLegalExpressionFormat_id_local,
    elish:LegalResourceLegalExpression_relevant_for, elish:LegalResourceLegalExpression_jurisdiction,
    elish:LegalResourceLegalExpression_description, elish:LegalResourceLegalExpression_version,
    elish:LegalResourceLegalExpression_version_date, elish:LegalResourceLegalExpression_date_publication,
