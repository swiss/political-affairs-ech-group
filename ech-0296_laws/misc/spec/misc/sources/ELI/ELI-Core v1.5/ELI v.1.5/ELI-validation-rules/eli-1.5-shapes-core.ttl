elish:LegalResourceLegalExpression_date_publication sh:path eli:date_publication;
  sh:severity sh:Violation;
  sh:name "date of publication"@en;
  sh:description """A LegalResource or LegalExpression MUST not have more than one date_publication.
eli:date_publication MUST have a literal value with datatype xsd:date""";
  sh:nodeKind sh:Literal;
  sh:maxCount "1"^^xsd:integer;
  sh:datatype xsd:date .

elish:LegalResourceLegalExpression_in_force sh:path eli:in_force;
  sh:severity sh:Violation;
  sh:name "in force"@en;
  sh:description """A LegalResource or LegalExpression MUST not have more than one in_force.
eli:in_force MUST have an IRI value in ( eli:InForce-inForce eli:InForce-partiallyInForce eli:InForce-notInForce )""";
  sh:nodeKind sh:IRI;
  sh:maxCount "1"^^xsd:integer;
  sh:in _:eb559f955f9d4974b990ebae92fed3761194 .

_:eb559f955f9d4974b990ebae92fed3761194 rdf:first eli:InForce-inForce;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761195 .

_:eb559f955f9d4974b990ebae92fed3761195 rdf:first eli:InForce-partiallyInForce;
  rdf:rest _:eb559f955f9d4974b990ebae92fed3761196 .

_:eb559f955f9d4974b990ebae92fed3761196 rdf:first eli:InForce-notInForce;
  rdf:rest rdf:nil .

