<http://data.europa.eu/eli/shapes> a owl:Ontology, adms:Asset;
  rdfs:label "ELI validation shapes"@en;
  dct:title "ELI validation shapes"@en;
  dct:description "This specification encodes the \"core\" rules that must be followed when publishing ELI metadata inside webpages. As such it does not declare range constraints for properties that link to entities that are not described inside a single webpage. This specification is complemented by a set of \"recommended\" rules, and the additionnal range constraints that are kept in a separate file."@en;
  owl:versionInfo "45778";
  dct:conformsTo <https://www.w3.org/TR/shacl>;
  dct:created "2025-09-26"^^xsd:date;
  dct:modified "2025-12-12T00:00:00.000Z"^^xsd:dateTime;
  dct:creator "ELI Taskforce"@en .

eli:LegalResource a rdfs:Class, sh:NodeShape;
  rdfs:label "Legal resource"@en;
  sh:nodeKind sh:IRI;
  sh:pattern "^http[s]?://(.*)/eli/(.*)";
  sh:severity sh:Violation;
  sh:property elish:LegalResourceLegalExpressionFormat_uri_schema, elish:LegalResourceLegalExpressionFormat_id_local,
    elish:LegalResourceLegalExpression_relevant_for, elish:LegalResourceLegalExpression_jurisdiction,
    elish:LegalResourceLegalExpression_description, elish:LegalResourceLegalExpression_version,
    elish:LegalResourceLegalExpression_version_date, elish:LegalResourceLegalExpression_date_publication,
    elish:LegalResourceLegalExpression_in_force, elish:LegalResourceLegalExpression_first_date_entry_in_force,
    elish:LegalResourceLegalExpression_date_no_longer_in_force, elish:LegalResourceLegalExpression_date_applicability,
    elish:LegalResourceLegalExpression_related_to, elish:LegalResourceLegalExpression_cites,
    elish:LegalResourceLegalExpression_inverse_cited_by, elish:LegalResourceLegalExpression_consolidates,
    elish:LegalResourceLegalExpression_consolidated_by, elish:LegalResourceLegalExpression_transposes,
    elish:LegalResourceLegalExpression_ensures_implementation_of, elish:LegalResourceLegalExpression_applies,
    elish:LegalResourceLegalExpression_commences, elish:LegalResourceLegalExpression_commenced_by,
    elish:LegalResourceLegalExpression_repeals, elish:LegalResourceLegalExpression_repealed_by,
    elish:LegalResourceLegalExpression_cited_by_case_law, elish:LegalResourceLegalExpression_cited_by_case_law_reference,
    elish:LegalResource_is_part_of, elish:LegalResource_has_part, elish:LegalResource_is_member_of,
    elish:LegalResource_has_member, elish:LegalResource_is_realized_by, elish:LegalResource_type_document,
    elish:LegalResource_passed_by, elish:LegalResource_countersigned_by, elish:LegalResource_responsibility_of,
    elish:LegalResource_responsibility_of_agent, elish:LegalResource_transposed_by, elish:LegalResource_implementation_ensured_by,
    elish:LegalResource_applied_by, elish:LegalResource_is_another_publication_of, elish:LegalResource_has_another_publication .

eli:LegalExpression a rdfs:Class, sh:NodeShape;
  rdfs:label "Legal expression"@en;
  sh:nodeKind sh:IRI;
  sh:pattern "^http[s]?://(.*)/eli/(.*)";
