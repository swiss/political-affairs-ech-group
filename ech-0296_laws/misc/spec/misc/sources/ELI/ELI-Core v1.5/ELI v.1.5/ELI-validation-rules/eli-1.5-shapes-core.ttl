    elish:LegalResourceLegalExpression_consolidated_by, elish:LegalResourceLegalExpression_transposes,
    elish:LegalResourceLegalExpression_ensures_implementation_of, elish:LegalResourceLegalExpression_applies,
    elish:LegalResourceLegalExpression_commences, elish:LegalResourceLegalExpression_commenced_by,
    elish:LegalResourceLegalExpression_repeals, elish:LegalResourceLegalExpression_repealed_by,
    elish:LegalResourceLegalExpression_cited_by_case_law, elish:LegalResourceLegalExpression_cited_by_case_law_reference,
    elish:LegalExpression_realizes, elish:LegalExpression_is_embodied_by, elish:LegalExpression_title,
    elish:LegalExpression_language, elish:LegalExpression_has_translation, elish:LegalExpression_is_translation_of,
    elish:LegalExpression_realizes_or_inverse_is_realized_by, elish:LegalExpression_is_embodied_by_or_inverse_embodies,
    elish:LegalExpressionFormat_publisher, elish:LegalExpressionFormat_publisher_agent .

eli:Format a rdfs:Class, sh:NodeShape;
