				<block xml:id="d1e76" name="num">ANNEX III</block>
				<block xml:id="d1e79" name="heading">MANAGEMENT AREAS FOR SANDEEL IN ICES DIVISIONS 2a, 3a AND ICES
					SUBAREA 4</block>
			</container>
		</preface>
		<mainBody xml:id="d1e84">
			<paragraph xml:id="d1e86">
				<content xml:id="d1e88">
					<p xml:id="d1e90">For the purposes of the management of the fishing opportunities of sandeel in
						ICES divisions 2a, 3a and ICES subarea 4 fixed in Annex IA, the management
						areas within which specific catch limits apply are defined as shown below
						and in the Appendix to this Annex:</p>
				</content>
			</paragraph>
