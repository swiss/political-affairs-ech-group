        <mainBody xml:id="d1e84">
            <paragraph xml:id="d1e86">
                <content xml:id="d1e88">
                    <p xml:id="d1e90">Exploratory fishing for toothfish in the CCAMLR Convention Area in 2019/2020
                        shall be limited to the following:</p>
                </content>
            </paragraph>
            <paragraph xml:id="d1e94">
                <hcontainer xml:id="d1e96" name="BLOCK_TAB">
                    <num xml:id="d1e98">Table A</num>
