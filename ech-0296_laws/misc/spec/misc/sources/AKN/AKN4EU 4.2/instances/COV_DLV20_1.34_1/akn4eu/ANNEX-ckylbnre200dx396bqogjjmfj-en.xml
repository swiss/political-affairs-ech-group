                        <content xml:id="d1e104">
                            <table xml:id="d1e106">
                                <tr xml:id="d1e108">
                                    <th xml:id="d1e110">
                                        <p xml:id="d1e112">Member State</p>
                                    </th>
                                    <th xml:id="d1e115">
                                        <p xml:id="d1e117">Area</p>
                                    </th>
                                    <th xml:id="d1e120">
                                        <p xml:id="d1e122">Maximum number of vessels</p>
                                    </th>
                                </tr>
                                <tr xml:id="d1e126">
                                    <td xml:id="d1e128">
                                        <p xml:id="d1e130">Spain</p>
                                    </td>
                                    <td xml:id="d1e133">
                                        <p xml:id="d1e135">48.6</p>
                                    </td>
                                    <td xml:id="d1e138">
                                        <p xml:id="d1e140">1</p>
                                    </td>
                                </tr>
                                <tr xml:id="d1e144">
                                    <td xml:id="d1e146">
