    {
      "_section": "=== 7. AKN4CH VOCABULARY DECLARATION (namespace definition) ===",

      "@id":   "https://fedlex.admin.ch/vocabulary/akn4ch",
      "@type": ["owl:Ontology", "skos:ConceptScheme"],
      "rdfs:label":   { "@value": "AKN4CH — Akoma Ntoso for Switzerland Extension Vocabulary", "@language": "en" },
      "dcterms:title": { "@value": "AKN4CH Ontologie — Schweizerische Erweiterung zu JOLux/ELI", "@language": "de" },
      "dcterms:description": { "@value": "Extends JOLux and ELI with article-level RDF nodes, Botschaft linkage, Curia Vista integration, and public affairs metadata for Swiss federal legislation.", "@language": "en" },
      "owl:versionInfo": "0.1-draft",
      "dcterms:created": { "@value": "2026-06-01", "@type": "xsd:date" },

      "_comment_properties": "Custom properties defined by AKN4CH",
      "akn4ch:defines": [
        { "@id": "akn4ch:ArticleNode",          "rdfs:comment": "Subclass of jolux:LegalResourceSubdivision for article-level RDF nodes bridged from Akoma Ntoso XML" },
        { "@id": "akn4ch:aknEId",               "rdfs:comment": "The eId attribute value from the Akoma Ntoso XML, e.g. art_1 or art_1/para_1" },
        { "@id": "akn4ch:articleNumber",         "rdfs:comment": "The display article number as string, e.g. '35'" },
        { "@id": "akn4ch:articleHeading",        "rdfs:comment": "rdf:langString — article title per official language" },
        { "@id": "akn4ch:articleText",           "rdfs:comment": "rdf:langString — full article text per language including all paragraphs" },
        { "@id": "akn4ch:paragraphs",            "rdfs:comment": "Ordered list of paragraph nodes within an article" },
        { "@id": "akn4ch:paragraphNumber",       "rdfs:comment": "Paragraph number as display string, e.g. '1', '2', '3'" },
        { "@id": "akn4ch:paragraphText",         "rdfs:comment": "rdf:langString — text of a single paragraph per language" },
        { "@id": "akn4ch:motivatedBy",           "rdfs:comment": "Links an article to its Botschaft explanation — both the main BBl document and the article-specific section in Part 2" },
        { "@id": "akn4ch:botschaftDocument",     "rdfs:comment": "URI of the BBl jolux:Act containing the Botschaft" },
        { "@id": "akn4ch:botschaftSection",      "rdfs:comment": "URI fragment of the specific section in the Botschaft explaining this article or range" },
        { "@id": "akn4ch:sectionLabel",          "rdfs:comment": "rdf:langString — human-readable label of the Botschaft section" },
        { "@id": "akn4ch:sectionReference",      "rdfs:comment": "Bibliographic reference string, e.g. BBl 1997 I 1, S. 131" },
        { "@id": "akn4ch:articleRangeStart",     "rdfs:comment": "First article number covered by this Botschaft section" },
        { "@id": "akn4ch:articleRangeEnd",       "rdfs:comment": "Last article number covered by this Botschaft section" },
        { "@id": "akn4ch:botschaftSections",     "rdfs:comment": "Array of section objects on a BBl Act indexing article-specific explanations" },
        { "@id": "akn4ch:implementedBy",         "rdfs:comment": "Links a federal article to its cantonal implementing law (article or law level)" },
        { "@id": "akn4ch:aknStandard",           "rdfs:comment": "States the AKN version used in the XML manifestation, e.g. Akoma Ntoso 1.0" },
        { "@id": "akn4ch:curiaVistaAffairId",    "rdfs:comment": "Affair ID in Curia Vista parliamentary database, e.g. 19960091" },
        { "@id": "akn4ch:curiaVistaUrl",         "rdfs:comment": "Direct URL to the affair in parlament.ch Curia Vista" },
        { "@id": "akn4ch:voteResult",            "rdfs:comment": "Result of a popular vote: approved | rejected" },
        { "@id": "akn4ch:voteYesPercent",        "rdfs:comment": "Percentage of yes votes in a popular referendum" },
        { "@id": "akn4ch:voteCantonsMajority",   "rdfs:comment": "Boolean — whether the cantons majority was reached" },
        { "@id": "akn4ch:citedBy",               "rdfs:comment": "Inverse of jolux:Citation — laws citing this article" }
      ]
    }

  ]
}
