        {
          "_comment": "Article 1 — Schweizerische Eidgenossenschaft",
          "@id":   "https://fedlex.data.admin.ch/eli/cc/1999/404/art_1",
          "@type": ["jolux:LegalResourceSubdivision", "akn4ch:ArticleNode"],
          "jolux:legalResourceSubdivisionIsPartOf": {
            "@id": "https://fedlex.data.admin.ch/eli/cc/1999/404"
          },
          "jolux:legalResourceSubdivisionType": {
            "@id": "https://fedlex.data.admin.ch/vocabulary/subdivision-type/art"
          },
          "akn4ch:aknEId":        "art_1",
          "akn4ch:articleNumber": "1",
          "akn4ch:articleHeading": [
            { "@value": "Schweizerische Eidgenossenschaft", "@language": "de" },
            { "@value": "Confédération suisse",            "@language": "fr" },
            { "@value": "Confederazione Svizzera",         "@language": "it" },
            { "@value": "Confederaziun svizra",            "@language": "rm" }
          ],
          "akn4ch:articleText": [
            { "@value": "Das Schweizer Volk und die Kantone Zürich, Bern, Luzern, Uri, Schwyz, Obwalden und Nidwalden, Glarus, Zug, Freiburg, Solothurn, Basel-Stadt und Basel-Landschaft, Schaffhausen, Appenzell Ausserrhoden und Appenzell Innerrhoden, St. Gallen, Graubünden, Aargau, Thurgau, Tessin, Waadt, Wallis, Neuenburg, Genf und Jura bilden die Schweizerische Eidgenossenschaft.", "@language": "de" },
            { "@value": "Le peuple suisse et les cantons de Zurich, Berne, Lucerne, Uri, Schwyz, Obwald et Nidwald, Glaris, Zoug, Fribourg, Soleure, Bâle-Ville et Bâle-Campagne, Schaffhouse, Appenzell Rhodes-Extérieures et Appenzell Rhodes-Intérieures, Saint-Gall, Grisons, Argovie, Thurgovie, Tessin, Vaud, Valais, Neuchâtel, Genève et Jura forment la Confédération suisse.", "@language": "fr" },
            { "@value": "Il popolo svizzero e i Cantoni di Zurigo, Berna, Lucerna, Uri, Svitto, Obvaldo e Nidvaldo, Glarona, Zugo, Friburgo, Soletta, Basilea Città e Basilea Campagna, Sciaffusa, Appenzello Esterno e Appenzello Interno, San Gallo, Grigioni, Argovia, Turgovia, Ticino, Vaud, Vallese, Neuchâtel, Ginevra e Giura formano la Confederazione Svizzera.", "@language": "it" }
          ],
          "akn4ch:paragraphs": [
            {
              "akn4ch:aknEId": "art_1/para_1",
              "akn4ch:paragraphNumber": "1",
              "akn4ch:paragraphText": [
                { "@value": "Das Schweizer Volk und die Kantone ... bilden die Schweizerische Eidgenossenschaft.", "@language": "de" }
              ]
            }
          ],
          "akn4ch:motivatedBy": {
            "_comment": "Link to Botschaft BBl 1997 I 1 — main dispatch document",
            "akn4ch:botschaftDocument": {
              "@id": "https://fedlex.data.admin.ch/eli/fga/1997/1_1_1",
              "rdfs:label": { "@value": "Botschaft zur neuen Bundesverfassung vom 20. November 1996", "@language": "de" },
              "jolux:dateDocument": { "@value": "1996-11-20", "@type": "xsd:date" }
            },
            "_comment_specific": "Article-specific explanation in Part 2 of the Botschaft",
            "akn4ch:botschaftSection": {
              "@id": "https://fedlex.data.admin.ch/eli/fga/1997/1_1_1#section-2-1-1",
              "akn4ch:sectionLabel": { "@value": "Art. 1 — Erläuterungen", "@language": "de" },
              "akn4ch:sectionReference": "BBl 1997 I 1, S. 131"
            }
          },
          "akn4ch:implementedBy": [],
          "eli:amended_by": []
        },
        {
          "_comment": "Article 35 — Verwirklichung der Grundrechte",
          "@id":   "https://fedlex.data.admin.ch/eli/cc/1999/404/art_35",
          "@type": ["jolux:LegalResourceSubdivision", "akn4ch:ArticleNode"],
          "jolux:legalResourceSubdivisionIsPartOf": {
            "@id": "https://fedlex.data.admin.ch/eli/cc/1999/404"
          },
          "jolux:legalResourceSubdivisionType": {
            "@id": "https://fedlex.data.admin.ch/vocabulary/subdivision-type/art"
          },
          "akn4ch:aknEId":        "art_35",
          "akn4ch:articleNumber": "35",
          "akn4ch:articleHeading": [
            { "@value": "Verwirklichung der Grundrechte", "@language": "de" },
            { "@value": "Réalisation des droits fondamentaux", "@language": "fr" },
            { "@value": "Attuazione dei diritti fondamentali", "@language": "it" }
          ],
          "akn4ch:articleText": [
            { "@value": "1 Die Grundrechte müssen in der ganzen Rechtsordnung zur Geltung kommen.\n2 Wer staatliche Aufgaben wahrnimmt, ist an die Grundrechte gebunden und verpflichtet, zu ihrer Verwirklichung beizutragen.\n3 Die Behörden sorgen dafür, dass die Grundrechte, soweit sie sich dazu eignen, auch unter Privaten wirksam werden.", "@language": "de" },
            { "@value": "1 Les droits fondamentaux doivent être réalisés dans l'ensemble de l'ordre juridique.\n2 Quiconque assume une tâche de l'État est tenu de respecter les droits fondamentaux et de contribuer à leur réalisation.\n3 Les autorités veillent à ce que les droits fondamentaux, dans la mesure où ils s'y prêtent, soient aussi réalisés dans les relations qui lient les particuliers entre eux.", "@language": "fr" },
            { "@value": "1 I diritti fondamentali devono essere attuati in tutto l'ordinamento giuridico.\n2 Chi svolge compiti statali è tenuto a rispettare i diritti fondamentali e a contribuire alla loro attuazione.\n3 Le autorità provvedono affinché i diritti fondamentali, per quanto vi si prestino, siano realizzati anche nelle relazioni tra privati.", "@language": "it" }
          ],
          "akn4ch:paragraphs": [
            {
              "akn4ch:aknEId": "art_35/para_1",
              "akn4ch:paragraphNumber": "1",
              "akn4ch:paragraphText": [
                { "@value": "Die Grundrechte müssen in der ganzen Rechtsordnung zur Geltung kommen.", "@language": "de" }
              ]
            },
            {
              "akn4ch:aknEId": "art_35/para_2",
              "akn4ch:paragraphNumber": "2",
              "akn4ch:paragraphText": [
                { "@value": "Wer staatliche Aufgaben wahrnimmt, ist an die Grundrechte gebunden und verpflichtet, zu ihrer Verwirklichung beizutragen.", "@language": "de" }
              ]
            },
            {
              "akn4ch:aknEId": "art_35/para_3",
              "akn4ch:paragraphNumber": "3",
              "akn4ch:paragraphText": [
                { "@value": "Die Behörden sorgen dafür, dass die Grundrechte, soweit sie sich dazu eignen, auch unter Privaten wirksam werden.", "@language": "de" }
              ]
            }
          ],
          "akn4ch:motivatedBy": {
            "akn4ch:botschaftDocument": {
              "@id": "https://fedlex.data.admin.ch/eli/fga/1997/1_1_1",
              "rdfs:label": { "@value": "Botschaft zur neuen Bundesverfassung", "@language": "de" }
            },
            "akn4ch:botschaftSection": {
              "@id": "https://fedlex.data.admin.ch/eli/fga/1997/1_1_1#section-2-3-3",
              "akn4ch:sectionLabel": { "@value": "Art. 35 — Erläuterungen", "@language": "de" },
              "akn4ch:sectionReference": "BBl 1997 I 1, S. 147",
              "akn4ch:articleRangeStart": "35",
              "akn4ch:articleRangeEnd": "36"
            }
          },
          "jolux:Citation": [
            {
              "@id": "https://fedlex.data.admin.ch/eli/cc/2005/370#art_35_citation_1",
              "@type": "jolux:Citation",
              "jolux:citationFromLegalResource": {
                "@id": "https://fedlex.data.admin.ch/eli/cc/2005/370/text",
                "rdfs:label": { "@value": "BGG — Bundesgesetz über das Bundesgericht", "@language": "de" }
              },
              "jolux:citationToLegalResource": {
                "@id": "https://fedlex.data.admin.ch/eli/cc/1999/404/art_35"
              }
            }
          ],
          "eli:amended_by": [],
