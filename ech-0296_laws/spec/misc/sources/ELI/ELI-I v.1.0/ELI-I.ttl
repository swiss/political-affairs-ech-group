@prefix schema: <http://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skosthes: <http://purl.org/iso25964/skos-thes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xls2rdf: <https://xls2rdf.sparna.fr/vocabulary#> .
@prefix eli-dl: <http://data.europa.eu/eli/eli-draft-legislation-ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix eli-i: <http://data.europa.eu/eli/eli-impact-ontology#> .
@prefix frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .

<http://data.europa.eu/eli/eli-impact-ontology#> a owl:Ontology;
  rdfs:label "ELI-I Metadata Ontology"@en;
  rdfs:comment "ELI-I ontology is a add-on to ELI ontology with the aims to describe legal impacts of a legislation to an other legislation and the changes in the new consolidated version of the impacted legislations."@en;
  owl:versionInfo "V1.0";
  owl:imports <http://www.w3.org/2004/02/skos/core>, <http://data.europa.eu/eli/ontology#>,
    <http://data.europa.eu/eli/eli-draft-legislation-ontology#> .

eli-i:ImpactAnalysis a owl:Class;
  dc:identifier "ImpactAnalysis";
  rdfs:subClassOf eli-dl:Activity, _:eb6cc77188eb4cb7b2905dee9570aa94983;
  rdfs:comment "Instances of this class describe an activity of analysing one given legal resource to identifies the impacts it has on other legal resoures."@en .

eli-i:Impact a owl:Class;
  dc:identifier "Impact";
  rdfs:subClassOf owl:Thing, _:eb6cc77188eb4cb7b2905dee9570aa94984, _:eb6cc77188eb4cb7b2905dee9570aa94985,
    _:eb6cc77188eb4cb7b2905dee9570aa94986, _:eb6cc77188eb4cb7b2905dee9570aa94990, _:eb6cc77188eb4cb7b2905dee9570aa94994,
    _:eb6cc77188eb4cb7b2905dee9570aa94995, _:eb6cc77188eb4cb7b2905dee9570aa94999;
  rdfs:comment "Instances of this class describe impact from a Work, part of Work, or Expression to another Work, part of Work or Expression. The sub-classes should be used instead of this class to specify the type of impact."@en .

eli-i:Change a owl:Class;
  dc:identifier "Change";
  rdfs:subClassOf eli-i:Impact;
  rdfs:comment "This class is a reification of the property eli:changes. See definition in eli ontology."@en .

eli-i:Repeal a owl:Class;
  dc:identifier "Repeal";
  rdfs:subClassOf eli-i:Change;
  rdfs:comment "This class is a reification of the property eli:repeals. See definition in eli ontology."@en .

eli-i:Amendment a owl:Class;
  dc:identifier "Amendment";
  rdfs:subClassOf eli-i:Change;
  rdfs:comment "This class is a reification of the property eli:amends. See definition in eli ontology."@en .

eli-i:Commencement a owl:Class;
  dc:identifier "Commencement";
  rdfs:subClassOf eli-i:Change;
  rdfs:comment "This class is a reification of the property eli:commences. See definition in eli ontology."@en .

eli-i:Correction a owl:Class;
  dc:identifier "Correction";
  rdfs:subClassOf eli-i:Impact;
  rdfs:comment "This class is a reification of the property eli:corrects. See definition in eli ontology."@en .

eli-i:ModificationPosition a owl:Class;
  dc:identifier "ModificationPosition";
  rdfs:subClassOf skos:Concept;
  rdfs:comment "Instances of this class describe precise locations for applying a modification to a legal resource, part of legal resource or expression. Uses the EU controlled vocabulary subdivision-position. http://publications.europa.eu/resource/authority/subdivision-position (AFTER, BEFORE, BEGIN, END)"@en .

eli-i:ModificationType a owl:Class;
  dc:identifier "ModificationType";
  rdfs:subClassOf skos:Concept;
  rdfs:comment "Instances of this class describe modification type for applying the change. Uses EU controlled vocabulary modification-type http://publications.europa.eu/resource/authority/modification-type/ (DELETION, INSERTION, RENUMBERING, REPEAL, REPLACEMENT)"@en .

eli-i:has_impact a owl:ObjectProperty;
  dc:identifier "has_impact";
  rdfs:domain _:eb6cc77188eb4cb7b2905dee9570aa94974;
  rdfs:range eli-i:Impact;
  rdfs:label "has impact"@en;
  owl:inverseOf eli-i:impact_from;
  rdfs:comment "Reference to an impact generated by this legal resource, expression, or part of legal resource. This is the inverse of eli-i:impact_from"@en .

_:eb6cc77188eb4cb7b2905dee9570aa94974 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94975 .

_:eb6cc77188eb4cb7b2905dee9570aa94975 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94976 .

_:eb6cc77188eb4cb7b2905dee9570aa94976 rdf:first eli:Expression;
  rdf:rest rdf:nil .

eli-i:is_impacted_by a owl:ObjectProperty;
  dc:identifier "is_impacted_by";
  rdfs:domain _:eb6cc77188eb4cb7b2905dee9570aa94977;
  rdfs:range eli-i:Impact;
  rdfs:label "is impacted by"@en;
  owl:inverseOf eli-i:impact_to;
  rdfs:comment "Reference to an impact that impacts this legal resource or legal expression, or a part of it."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94977 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94978 .

_:eb6cc77188eb4cb7b2905dee9570aa94978 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94979 .

_:eb6cc77188eb4cb7b2905dee9570aa94979 rdf:first eli:Expression;
  rdf:rest rdf:nil .

eli-i:consolidates_impact a owl:ObjectProperty;
  dc:identifier "consolidates_impact";
  rdfs:domain _:eb6cc77188eb4cb7b2905dee9570aa94980;
  rdfs:range eli-i:Impact;
  rdfs:label "consolidates impact"@en;
  owl:inverseOf eli-i:impact_is_consolidated_by;
  rdfs:comment "Reference to an impact that is taken into account by this consolidated text. This is expressed on consolidations."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94980 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94981 .

_:eb6cc77188eb4cb7b2905dee9570aa94981 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94982 .

_:eb6cc77188eb4cb7b2905dee9570aa94982 rdf:first eli:Expression;
  rdf:rest rdf:nil .

eli-i:impact_analysis_based_on_a_realization_of a owl:ObjectProperty, owl:FunctionalProperty;
  dc:identifier "impact_analysis_based_on_a_realization_of";
  rdfs:domain eli-i:ImpactAnalysis;
  rdfs:range eli:Work;
  rdfs:label "impact analysis based on a realization of"@en;
  rdfs:comment "Reference to the legal resource on which the impact analysis was conducted"@en .

_:eb6cc77188eb4cb7b2905dee9570aa94983 a owl:Restriction;
  owl:onProperty eli-i:impact_analysis_based_on_a_realization_of;
  owl:minCardinality "1"^^xsd:integer;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:identifies_an_impact a owl:ObjectProperty;
  dc:identifier "identifies_an_impact";
  rdfs:domain eli-i:ImpactAnalysis;
  rdfs:range eli-i:Impact;
  rdfs:label "identifies an impact"@en;
  rdfs:comment "Reference to an impact that was found during the impact analysis. This is repeated for every impact found during the analysis."@en .

eli-i:impact_id a owl:DatatypeProperty;
  dc:identifier "impact_id";
  rdfs:domain eli-i:Impact;
  rdfs:range xsd:string;
  rdfs:label "impact id"@en;
  rdfs:comment "Identifier of the impact"@en .

eli-i:impact_has_date_applicability a owl:DatatypeProperty, owl:FunctionalProperty;
  dc:identifier "impact_has_date_applicability";
  rdfs:domain eli-i:Impact;
  rdfs:range xsd:date;
  rdfs:label "impact has date applicability"@en;
  rdfs:comment "The date at which the impact becomes applicable"@en .

_:eb6cc77188eb4cb7b2905dee9570aa94984 a owl:Restriction;
  owl:onProperty eli-i:impact_has_date_applicability;
  owl:minCardinality "1"^^xsd:integer;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:impact_has_date_obsolescence a owl:DatatypeProperty, owl:FunctionalProperty;
  dc:identifier "impact_has_date_obsolescence";
  rdfs:domain eli-i:Impact;
  rdfs:range xsd:date;
  rdfs:label "impact has date obsolescence"@en;
  rdfs:comment "Impact obsolescence date (its effect was cancelled by another impact). To be used when a modification is entirely overwritten by another, and the former one was not published in any consolidated text."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94985 a owl:Restriction;
  owl:onProperty eli-i:impact_has_date_obsolescence;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:impact_is_explicit a owl:DatatypeProperty, owl:FunctionalProperty;
  dc:identifier "impact_is_explicit";
  rdfs:domain eli-i:Impact;
  rdfs:range xsd:boolean;
  rdfs:label "impact is explicit"@en;
  rdfs:comment "Boolean that specifies whether the impact to the legal resource is explicit (value \"true\") or implicit (value \"false\"). By default impacts are considered explicit."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94986 a owl:Restriction;
  owl:onProperty eli-i:impact_is_explicit;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:impact_from a owl:ObjectProperty, owl:FunctionalProperty;
  dc:identifier "impact_from";
  rdfs:domain eli-i:Impact;
  rdfs:range _:eb6cc77188eb4cb7b2905dee9570aa94987;
  rdfs:label "impact from"@en;
  owl:inverseOf eli-i:has_impact;
  rdfs:comment "Reference of the legal resource or legal expression, or part of it, that generates the impact."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94987 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94988 .

_:eb6cc77188eb4cb7b2905dee9570aa94988 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94989 .

_:eb6cc77188eb4cb7b2905dee9570aa94989 rdf:first eli:Expression;
  rdf:rest rdf:nil .

_:eb6cc77188eb4cb7b2905dee9570aa94990 a owl:Restriction;
  owl:onProperty eli-i:impact_from;
  owl:minCardinality "1"^^xsd:integer;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:impact_from_has_comment a owl:DatatypeProperty;
  dc:identifier "impact_from_has_comment";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact from comment"@en;
  rdfs:comment "Comment about the source of the impact"@en .

eli-i:impact_from_text a owl:DatatypeProperty;
  dc:identifier "impact_from_text";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact from text"@en;
  rdfs:comment "Text describing the impact"@en .

eli-i:impact_to a owl:ObjectProperty;
  dc:identifier "impact_to";
  rdfs:domain eli-i:Impact;
  rdfs:range _:eb6cc77188eb4cb7b2905dee9570aa94991;
  rdfs:label "impact to"@en;
  owl:inverseOf eli-i:is_impacted_by;
  rdfs:comment "Reference to the work, expression, or subdivision being impacted by this impact. Depending on the use-case, the impacted resource can be the basic act (OP use case), an actual and/or future version of a consolidated text (Malta use case ?) or the complex work of the consolidation (Switzerland use case)"@en .

_:eb6cc77188eb4cb7b2905dee9570aa94991 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94992 .

_:eb6cc77188eb4cb7b2905dee9570aa94992 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94993 .

_:eb6cc77188eb4cb7b2905dee9570aa94993 rdf:first eli:Expression;
  rdf:rest rdf:nil .

_:eb6cc77188eb4cb7b2905dee9570aa94994 a owl:Restriction;
  owl:onProperty eli-i:impact_to;
  owl:minCardinality "1"^^xsd:integer .

eli-i:impact_to_has_comment a owl:DatatypeProperty;
  dc:identifier "impact_to_has_comment";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact to comment"@en;
  rdfs:comment "Comment about the target of the impact"@en .

eli-i:impact_to_text a owl:DatatypeProperty;
  dc:identifier "impact_to_text";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact to text"@en;
  rdfs:comment "Literal text impacted"@en .

eli-i:triggers_modification_of_type a owl:ObjectProperty;
  dc:identifier "triggers_modification_of_type";
  rdfs:domain eli-i:Impact;
  rdfs:range eli-i:ModificationType;
  rdfs:label "triggers modification of type"@en;
  rdfs:comment "Indicates the type of modification on the legal resource, or part of the legal resource which is impacted"@en .

eli-i:modication_has_position a owl:ObjectProperty, owl:FunctionalProperty;
  dc:identifier "modiication_has_position";
  rdfs:domain eli-i:Impact;
  rdfs:range eli-i:ModificationPosition;
  rdfs:label "modiication has position"@en;
  rdfs:comment "Precise location (in relation to a subdivision) for applying the modification. A controlled vocabulary of the OP can be used for a restricted list of values : http://publications.europa.eu/resource/authority/subdivision-position (AFTER, BEFORE, BEGIN, END)"@en .

_:eb6cc77188eb4cb7b2905dee9570aa94995 a owl:Restriction;
  owl:onProperty eli-i:modication_has_position;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:impact_is_consolidated_by a owl:ObjectProperty;
  dc:identifier "impact_is_consolidated_by";
  rdfs:domain eli-i:Impact;
  rdfs:range _:eb6cc77188eb4cb7b2905dee9570aa94996;
  rdfs:label "impact is consolidated by"@en;
  owl:inverseOf eli-i:consolidates_impact;
  rdfs:comment "Reference to the consolidated works incorporating the impact. It can be repeated if future versions of the consolidation are published, in that case an impact can be consolidated by more than one consolidation."@en .

_:eb6cc77188eb4cb7b2905dee9570aa94996 a owl:Class;
  owl:unionOf _:eb6cc77188eb4cb7b2905dee9570aa94997 .

_:eb6cc77188eb4cb7b2905dee9570aa94997 rdf:first eli:Work;
  rdf:rest _:eb6cc77188eb4cb7b2905dee9570aa94998 .

_:eb6cc77188eb4cb7b2905dee9570aa94998 rdf:first eli:Expression;
  rdf:rest rdf:nil .

eli-i:impact_is_consolidated_by_text a owl:DatatypeProperty;
  dc:identifier "impact_is_consolidated_by_text";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact is consolidated by text"@en;
  rdfs:comment "The extract of the text of the consolidated version in which this impact was consolidated."@en .

eli-i:impact_is_consolidated_by_has_comment a owl:DatatypeProperty;
  dc:identifier "impact_is_consolidated_by_has_comment";
  rdfs:domain eli-i:Impact;
  rdfs:range rdfs:Literal;
  rdfs:label "impact is consolidated by comment"@en;
  rdfs:comment "Comment about the consolidation of the impact"@en .

eli-i:indirect_impact_from a owl:ObjectProperty, owl:FunctionalProperty;
  dc:identifier "indirect_impact_from";
  rdfs:domain eli-i:Impact;
  rdfs:range eli-i:Impact;
  rdfs:label "indirect impact from"@en;
  owl:inverseOf eli-i:has_indirect_impact;
  rdfs:comment """Reference to an indirect impact. 'Indirect' means that the impact does not point to the target mentioned by the modifier but at another which is indirectly modified.
Ex: Modifier 'A' modifies another modifier 'B' that modifies 'C', then we may have an indirect impact from 'A' to 'C',"""@en .

_:eb6cc77188eb4cb7b2905dee9570aa94999 a owl:Restriction;
  owl:onProperty eli-i:indirect_impact_from;
  owl:maxCardinality "1"^^xsd:integer .

eli-i:has_indirect_impact a owl:ObjectProperty;
  dc:identifier "has_indirect_impact";
  rdfs:domain eli-i:Impact;
  rdfs:range eli-i:Impact;
  rdfs:label "has indirect impact"@en;
  owl:inverseOf eli-i:indirect_impact_from;
  rdfs:comment "Reference to an impact induced indirectly by this impact."@en .
