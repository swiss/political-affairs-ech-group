    laws:xml_attribute "true" ;
    laws:xml_name "xml:lang" .

xsd:anyURI a rdfs:Datatype .

laws:BlockList a owl:Class ;
    rdfs:label "BlockList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockListItem ;
            owl:onProperty laws:items ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:items ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:list_introduction ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:list_introduction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:list_introduction ] ;
    skos:definition """A block list of enumerated or lettered items (akn:blockList), optionally introduced by an akn:listIntroduction element.
""" ;
    skos:exactMatch akn:blockList ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Auflistung von nummerierten oder buchstabierten Punkten (akn:blockList), optional eingeleitet durch ein akn:listIntroduction-Element.
""" ;
    laws:xml_element "akn:blockList" .

laws:Book a owl:Class ;
    rdfs:label "Book" ;
