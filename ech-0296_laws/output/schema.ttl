	skos:definition "The short title of the act." ;
	skos:exactMatch akn:shortTitle ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Der Kurztitel des Erlasses." ;
	laws:xml_element "akn:shortTitle" .
