laws:FedlexDocument a owl:Class ;
	rdfs:label "FedlexDocument" ;
	rdfs:subClassOf _:c14n544 , _:c14n851 , _:c14n93 ;
	skos:definition "Root element of a Fedlex AkomaNtoso document (akn:akomaNtoso). Must contain exactly one akn:act element and no other children (FLX-RT-001). Carries the AkomaNtoso namespace declaration and the Fedlex extension namespace.\n" ;
	skos:exactMatch akn:akomaNtoso ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Wurzelelement eines Fedlex AkomaNtoso-Dokuments (akn:akomaNtoso). Muss genau ein akn:act-Element enthalten, keine weiteren Kinder (FLX-RT-001). Trägt die AkomaNtoso-Namespace-Deklaration und den Fedlex-Erweiterungs-Namespace.\n" ;
	laws:schematron_rule "FLX-RT-001: The document root should only contain an act" ;
	laws:xml_element "akn:akomaNtoso" ;
	laws:xml_namespace "http://docs.oasis-open.org/legaldocml/ns/akn/3.0" ;
	laws:xml_namespace_fedlex "http://fedlex.admin.ch/" .
laws:FedlexRoleEnum\#heading a owl:Class ;
	rdfs:label "heading" ;
	rdfs:subClassOf laws:FedlexRoleEnum ;
	skos:definition "Marks a paragraph as a heading; found on akn:p in the preamble of the Federal Constitution. Outside the reach of FLX-XF-003, which governs akn:level and akn:subheading.\n" ;
	laws:description_de "Kennzeichnet einen Absatz als Überschrift; kommt an akn:p in der Präambel der Bundesverfassung vor. Ausserhalb der Reichweite von FLX-XF-003, die akn:level und akn:subheading regelt.\n" .
laws:FedlexRoleEnum\#marginal a owl:Class ;
	rdfs:label "marginal" ;
	rdfs:subClassOf laws:FedlexRoleEnum ;
	skos:definition "Marks a level as a marginal note. Only allowed on akn:level (FLX-XF-004)." ;
	laws:description_de "Kennzeichnet ein level als Randnote. Nur bei akn:level erlaubt (FLX-XF-004)." .
laws:FedlexRoleEnum\#reference a owl:Class ;
	rdfs:label "reference" ;
	rdfs:subClassOf laws:FedlexRoleEnum ;
	skos:definition "Marks a subheading as a reference heading. Only allowed on akn:subheading (FLX-XF-005)." ;
	laws:description_de "Kennzeichnet eine Unterüberschrift als Referenzüberschrift. Nur bei akn:subheading erlaubt (FLX-XF-005).\n" .
laws:FedlexRoleEnum a owl:Class ;
	rdfs:label "FedlexRoleEnum" ;
	owl:unionOf _:c14n840 ;
	skos:definition "Allowed values for the fedlex:role extension attribute (FLX-XF-003). 'marginal' is only permitted on akn:level elements (FLX-XF-004). 'reference' is only permitted on akn:subheading elements (FLX-XF-005).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Erlaubte Werte für das Fedlex-Erweiterungsattribut fedlex:role (FLX-XF-003). 'marginal' nur bei akn:level-Elementen (FLX-XF-004). 'reference' nur bei akn:subheading-Elementen (FLX-XF-005).\n" ;
	linkml:permissible_values laws:FedlexRoleEnum\#heading , laws:FedlexRoleEnum\#marginal , laws:FedlexRoleEnum\#reference .
laws:ForceMod a owl:Class ;
	rdfs:label "ForceMod" ;
	rdfs:subClassOf laws:Modification , _:c14n1045 , _:c14n12 , _:c14n301 , _:c14n361 , _:c14n366 , _:c14n392 , _:c14n58 , _:c14n787 , _:c14n8 , _:c14n841 , _:c14n885 , _:c14n968 , _:c14n973 ;
	skos:definition "A modification of legal force: an act, or a part of it, enters into force, ceases, is postponed, prorogued, re-enacted or declared unconstitutional.\n" ;
	skos:exactMatch akn:forceMod ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eine Änderung der Rechtskraft: ein Erlass oder ein Teil davon tritt in Kraft, ausser Kraft, wird aufgeschoben, verlängert, neu erlassen oder für verfassungswidrig erklärt.\n" ;
	laws:xml_element "akn:forceMod" .
