	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Zweck des Behälters (akn:container/@name)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "name" .
laws:containers a owl:ObjectProperty ;
	rdfs:label "containers" ;
	rdfs:range laws:Container ;
	skos:definition "Containers of the preface (akn:container)." ;
	skos:exactMatch akn:container ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Behälter des Vorspanns (akn:container)." ;
	laws:xml_element "akn:container" .
laws:content_blocks a owl:ObjectProperty ;
	rdfs:label "content_blocks" ;
	rdfs:range laws:BlockElement ;
	skos:definition "Block-level content in reading order: paragraphs, lists and tables as they follow one another in the document.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Blockinhalt in Lesereihenfolge: Absätze, Aufzählungen und Tabellen, wie sie im Dokument aufeinanderfolgen.\n" .
laws:content_ref a owl:ObjectProperty ;
	rdfs:label "content_ref" ;
	rdfs:range laws:Content ;
	skos:definition "Content element within a paragraph (akn:content)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Inhaltselement innerhalb eines Absatzes (akn:content)." ;
	laws:xml_element "akn:content" .
laws:date_attr a owl:DatatypeProperty ;
	rdfs:label "date_attr" ;
	skos:definition "The date this element marks up, in ISO 8601 (@date)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Das Datum, das dieses Element auszeichnet, nach ISO 8601 (@date)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "date" .
laws:date_value a owl:DatatypeProperty ;
	rdfs:label "date_value" ;
	rdfs:range xsd:date ;
	skos:definition "An ISO 8601 date value (akn:FRBRdate/@date)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein ISO-8601-Datumswert (akn:FRBRdate/@date)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "date" .
laws:doc_name a owl:ObjectProperty ;
	rdfs:label "doc_name" ;
	rdfs:range laws:DocNameEnum ;
