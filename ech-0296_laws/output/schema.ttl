	laws:description_de "Kursiv-Inline-Markup (akn:i)." ;
	laws:xml_element "akn:i" .
laws:Identification a owl:Class ;
	rdfs:label "Identification" ;
	rdfs:subClassOf _:c14n1009 , _:c14n1031 , _:c14n115 , _:c14n304 , _:c14n443 , _:c14n451 , _:c14n635 , _:c14n778 , _:c14n786 , _:c14n849 , _:c14n872 , _:c14n923 ;
	skos:definition "FRBR identification block (akn:identification) grouping Work, Expression, and Manifestation descriptions. The @source attribute references the responsible organization as an intra-document anchor (e.g. '#ch.bk').\n" ;
	skos:exactMatch akn:identification ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Identifikationsblock (akn:identification) mit Work-, Expression- und Manifestations-Beschreibungen. Das @source-Attribut referenziert die verantwortliche Organisation als Dokument-internen Anker (z.B. '#ch.bk').\n" ;
	laws:xml_element "akn:identification" .
laws:Inline a owl:Class ;
