	skos:definition "A holder carrying a single @value attribute typed as an ELI URI (AKN valueType). Reused for FRBRthis and FRBRuri.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Halter mit einem @value-Attribut vom Typ ELI-URI (AKN valueType). Wiederverwendet für FRBRthis und FRBRuri.\n" .
laws:ValueType a owl:Class ;
