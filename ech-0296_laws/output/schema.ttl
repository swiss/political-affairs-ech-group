laws:fedlex_role a owl:ObjectProperty ;
    rdfs:label "fedlex_role" ;
    rdfs:range laws:FedlexRoleEnum ;
    skos:definition """Fedlex extension attribute fedlex:role. FLX-XF-003 permits 'marginal' (only on akn:level, FLX-XF-004) and 'reference' (only on akn:subheading, FLX-XF-005); the published Federal Constitution additionally carries 'heading' on a preamble paragraph.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:role. FLX-XF-003 lässt 'marginal' (nur an akn:level, FLX-XF-004) und 'reference' (nur an akn:subheading, FLX-XF-005) zu; die publizierte Bundesverfassung führt zusätzlich 'heading' an einem Präambel-Absatz.
""" ;
    laws:schematron_rules "FLX-XF-003, FLX-XF-004, FLX-XF-005" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:role" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:frbr_this a owl:ObjectProperty ;
    rdfs:label "frbr_this" ;
