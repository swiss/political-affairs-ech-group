""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Kurzform-Abkürzung des Gesetzesnamens (@shortForm), z.B. 'BV' (Deutsch), 'Cst.' (Französisch).
""" ;
