laws:transitionals a owl:ObjectProperty ;
    rdfs:label "transitionals" ;
    rdfs:range laws:Transitional ;
    skos:definition "Transitional provision elements (akn:transitional)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
