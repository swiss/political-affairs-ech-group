            owl:onProperty laws:fedlex_role ] ;
    skos:definition """A preface paragraph (akn:p). Fedlex requires akn:docNumber and akn:docTitle somewhere in the preface (FLX-PF-001/002); cantonal collections additionally mark up the systematic number, the short title, the abbreviation and the date.
""" ;
    skos:exactMatch akn:p ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Vorspann-Absatz (akn:p). Fedlex verlangt akn:docNumber und akn:docTitle irgendwo im Vorspann (FLX-PF-001/002); kantonale Sammlungen zeichnen zusätzlich Ordnungsnummer, Kurztitel, Abkürzung und Datum aus.
""" ;
    laws:xml_element "akn:p" ;
    laws:xsd_mixed "true" .

laws:Proviso a owl:Class ;
