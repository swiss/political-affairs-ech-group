laws:Abbr a owl:Class ;
    rdfs:label "Abbr" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:title_attr ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:title_attr ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:title_attr ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "The abbreviation of the act." ;
    skos:exactMatch akn:abbr ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Abkürzung des Erlasses." ;
    laws:xml_element "akn:abbr" .

laws:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActBody ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:attachments_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:conclusions_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:attachments_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:components_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Conclusions ;
            owl:onProperty laws:conclusions_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Preamble ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Preface ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( laws:ActTypeEnum xsd:string ) ] ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Components ;
            owl:onProperty laws:components_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActMeta ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:conclusions_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:components_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Attachments ;
            owl:onProperty laws:attachments_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:meta ] ;
    skos:definition """The legislative act element (akn:act). Main content container of an AkomaNtoso document. The @name attribute specifies the type of act (e.g. 'publicLaw').
""" ;
    skos:exactMatch akn:act ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Das Erlasselement (akn:act). Hauptinhaltselement eines AkomaNtoso-Dokuments. Das @name-Attribut gibt den Erlasstyp an (z.B. 'publicLaw').
""" ;
    laws:xml_element "akn:act" .

laws:ActMeta a owl:Class ;
    rdfs:label "ActMeta" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Identification ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:TemporalData ;
            owl:onProperty laws:temporal_data_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:analysis_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:analysis_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Notes ;
            owl:onProperty laws:notes_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:references_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:notes_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:References ;
            owl:onProperty laws:references_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:notes_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Analysis ;
            owl:onProperty laws:analysis_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:temporal_data_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:temporal_data_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:references_ref ] ;
    skos:definition """Metadata section of the act (akn:meta). Contains FRBR identification (Work, Expression, Manifestation levels) and named reference definitions.
""" ;
    skos:exactMatch akn:meta ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Metadaten-Abschnitt des Erlasses (akn:meta). Enthält die FRBR-Identifikation (Work-, Expression-, Manifestations-Ebene) sowie benannte Referenz-Definitionen.
""" ;
    laws:xml_element "akn:meta" .

laws:AuthorialNote a owl:Class ;
    rdfs:label "AuthorialNote" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
