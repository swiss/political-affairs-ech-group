    skos:definition """The preamble of the act (akn:preamble), containing introductory prose paragraphs preceding the operative body.
""" ;
    skos:exactMatch akn:preamble ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Die Präambel des Erlasses (akn:preamble) mit einleitenden Fliesstext-Absätzen vor dem Hauptteil.
""" ;
    laws:xml_element "akn:preamble" .

laws:PrefaceP a owl:Class ;
    rdfs:label "PrefaceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
