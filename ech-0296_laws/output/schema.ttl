laws:FrbrDateNameEnum a owl:Class ;
	rdfs:label "FrbrDateNameEnum" ;
	owl:unionOf _:c14n14 ;
	skos:definition "Date types Fedlex uses in akn:FRBRdate/@name, taken from the JoLux vocabulary. Cantonal publishers use their own designations; the slot therefore also admits a free string.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Datumsarten, die Fedlex in akn:FRBRdate/@name verwendet, aus dem JoLux-Vokabular. Kantonale Publikationsstellen führen eigene Bezeichnungen, weshalb der Slot auch eine freie Zeichenkette zulässt.\n" ;
	linkml:permissible_values jolux:dateApplicability , jolux:dateDocument , jolux:dateEntryInForce .
laws:I a owl:Class ;
	rdfs:label "I" ;
	rdfs:subClassOf laws:InlineElement , _:c14n445 , _:c14n831 ;
