	skos:exactMatch akn:subchapter ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Unterkapitel-Ebene (akn:subchapter). Erlaubte Kinder: section, subsection, level, sowie direkt article (FLX-HR-001-sh). Benötigt eindeutiges @eId (FLX-HR-002-sh).\n" ;
	laws:schematron_rules "FLX-HR-001-sh, FLX-HR-002-sh" ;
