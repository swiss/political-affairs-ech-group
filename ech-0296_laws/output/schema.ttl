	laws:description_de "Unterabschnitt-Ebene (akn:subsection). Erlaubte Kinder: level, sowie direkt article (FLX-HR-001-ss). Benötigt eindeutiges @eId (FLX-HR-002-ss).\n" ;
	laws:schematron_rules "FLX-HR-001-ss, FLX-HR-002-ss" ;
	laws:xml_element "akn:subsection" ;
	laws:xsd_content_model "choice" .
