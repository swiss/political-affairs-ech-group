    laws:description_de """Einfacher Halter mit einem einzelnen @value-Attribut (AKN valueType). Wiederverwendet für FRBRcountry, FRBRnumber, FRBRauthoritative usw.
""" .

laws:content_ref a owl:ObjectProperty ;
    rdfs:label "content_ref" ;
    rdfs:range laws:Content ;
