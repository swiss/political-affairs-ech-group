    skos:definition """A placeholder for stripped content (akn:placeholder), carrying the fedlex:message extension attribute (e.g. 'E40S10-TAB').
""" ;
    skos:exactMatch akn:placeholder ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Platzhalter für entfernten Inhalt (akn:placeholder) mit dem Erweiterungsattribut fedlex:message (z.B. 'E40S10-TAB').
""" ;
    laws:xml_element "akn:placeholder" .

laws:Preface a owl:Class ;
    rdfs:label "Preface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preface_paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Container ;
            owl:onProperty laws:containers ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:PrefaceP ;
            owl:onProperty laws:preface_paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:containers ] ;
    skos:definition """The preface of the act (akn:preface), containing the document number and title. Fedlex Schematron requires both akn:docNumber (FLX-PF-001) and akn:docTitle (FLX-PF-002) to be present inside a akn:p element.
""" ;
    skos:exactMatch akn:preface ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Vorspann des Erlasses (akn:preface) mit Dokumentnummer und -titel. Fedlex Schematron verlangt akn:docNumber (FLX-PF-001) und akn:docTitle (FLX-PF-002) innerhalb eines akn:p-Elements.
""" ;
    laws:schematron_rules "FLX-PF-001: Missing docNumber; FLX-PF-002: Missing docTitle" ;
    laws:xml_element "akn:preface" .

laws:Ref a owl:Class ;
    rdfs:label "Ref" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition """An inline reference (akn:ref). Carries @href, and for internal SR cross-references the Fedlex extension attributes fedlex:rs and fedlex:rs-uri.
""" ;
    skos:exactMatch akn:ref ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Inline-Referenz (akn:ref). Trägt @href, und bei internen SR-Querverweisen die Fedlex-Erweiterungsattribute fedlex:rs und fedlex:rs-uri.
""" ;
    laws:xml_element "akn:ref" .

laws:Role a owl:Class ;
    rdfs:label "Role" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:refers_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:refers_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:refers_to ],
        laws:InlineElement ;
    skos:definition "A role a person holds, pointing at its declaration." ;
    skos:exactMatch akn:role ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Eine Rolle, die eine Person innehat, mit Verweis auf ihre Deklaration." ;
    laws:xml_element "akn:role" .

laws:ShortTitle a owl:Class ;
    rdfs:label "ShortTitle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:title_attr ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:title_attr ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:title_attr ],
        laws:InlineElement ;
    skos:definition "The short title of the act." ;
    skos:exactMatch akn:shortTitle ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Der Kurztitel des Erlasses." ;
    laws:xml_element "akn:shortTitle" .

laws:Signature a owl:Class ;
    rdfs:label "Signature" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        laws:InlineElement ;
    skos:definition "A signature line." ;
    skos:exactMatch akn:signature ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Eine Unterschriftszeile." ;
    laws:xml_element "akn:signature" .

laws:Span a owl:Class ;
    rdfs:label "Span" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Generic inline span (akn:span)." ;
    skos:exactMatch akn:span ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Generischer Inline-Bereich (akn:span)." ;
    laws:xml_element "akn:span" .

laws:Sup a owl:Class ;
    rdfs:label "Sup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Superscript inline markup (akn:sup)." ;
    skos:exactMatch akn:sup ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Hochgestelltes Inline-Markup (akn:sup)." ;
    laws:xml_element "akn:sup" .

laws:TableCell a owl:Class ;
    rdfs:label "TableCell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockElement ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:colspan ],
        laws:Cell ;
    skos:definition """A cell in a table row (akn:td). Contains block content: prose paragraphs (akn:p) and block lists (akn:blockList).
""" ;
    skos:exactMatch akn:td ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Zelle in einer Tabellenzeile (akn:td). Enthält Block-Inhalt: Fliesstext-Absätze (akn:p) und Auflistungen (akn:blockList).
""" ;
    laws:xml_element "akn:td" ;
    laws:xsd_content_model "choice" .

laws:TableHeaderCell a owl:Class ;
    rdfs:label "TableHeaderCell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockElement ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:colspan ],
        laws:Cell ;
    skos:definition "A header cell of a table row (akn:th)." ;
    skos:exactMatch akn:th ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Eine Kopfzelle einer Tabellenzeile (akn:th)." ;
    laws:xml_element "akn:th" .

laws:TextRun a owl:Class ;
    rdfs:label "TextRun" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:text ],
        laws:InlineElement ;
    skos:definition """A plain run of character data within mixed content. Emitted as the text node of a mixed complexType, not as an element.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein einfacher Textabschnitt in gemischtem Inhalt. Wird als Textknoten eines mixed-complexType ausgegeben, nicht als Element.
""" .

laws:TextualMod a owl:Class ;
    rdfs:label "TextualMod" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:ModDestination ;
            owl:onProperty laws:mod_destinations ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ModNew ;
            owl:onProperty laws:mod_new ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( laws:ModTypeEnum xsd:string ) ] ;
            owl:onProperty laws:mod_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ModOld ;
            owl:onProperty laws:mod_old ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ModSource ;
            owl:onProperty laws:mod_sources ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:mod_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:mod_old ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:mod_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:mod_destinations ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:mod_new ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:mod_type ],
        laws:Modification ;
    skos:definition """A textual modification: the wording of another act is inserted, substituted, repealed, renumbered, split or joined.
""" ;
    skos:exactMatch akn:textualMod ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Textänderung: der Wortlaut eines anderen Erlasses wird eingefügt, ersetzt, aufgehoben, neu nummeriert, geteilt oder zusammengeführt.
""" ;
    laws:xml_element "akn:textualMod" .

laws:act_name a owl:DatatypeProperty ;
    rdfs:label "act_name" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( laws:ActTypeEnum xsd:string ) ] ;
    skos:definition """Type of the act (akn:act/@name). The permissible values of ActTypeEnum are those Fedlex uses; cantonal collections name their own types, which is why a free string remains admissible.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Typ des Erlasses (akn:act/@name). Die zulässigen Werte von ActTypeEnum sind die von Fedlex verwendeten; kantonale Sammlungen benennen eigene Typen, weshalb eine freie Zeichenkette zulässig bleibt.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:active_modifications a owl:ObjectProperty ;
    rdfs:label "active_modifications" ;
    rdfs:range laws:ActiveModifications ;
    skos:definition "The modifications this act makes to others (akn:activeModifications)." ;
    skos:exactMatch akn:activeModifications ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Änderungen, die dieser Erlass an anderen vornimmt (akn:activeModifications)." ;
    laws:xml_element "akn:activeModifications" .

laws:analysis_ref a owl:ObjectProperty ;
    rdfs:label "analysis_ref" ;
    rdfs:range laws:Analysis ;
    skos:definition "The analysis block of the metadata (akn:analysis)." ;
    skos:exactMatch akn:analysis ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Der Analyseblock der Metadaten (akn:analysis)." ;
    laws:xml_element "akn:analysis" .

laws:as_attr a owl:DatatypeProperty ;
    rdfs:label "as_attr" ;
    skos:definition "Role in which the person acts (@as)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Rolle, in der die Person handelt (@as)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "as" .

laws:as_role a owl:DatatypeProperty ;
    rdfs:label "as_role" ;
    rdfs:range xsd:string ;
    skos:definition """Role the author plays (akn:FRBRauthor/@as), as an anchor reference, e.g. '#publisher', '#rightsHolder'.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Rolle des Autors (akn:FRBRauthor/@as), als Anker-Referenz, z.B. '#publisher', '#rightsHolder'.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "as" .

laws:attachments_ref a owl:ObjectProperty ;
    rdfs:label "attachments_ref" ;
    rdfs:range laws:Attachments ;
    skos:definition "The documents attached to the act (akn:attachments)." ;
    skos:exactMatch akn:attachments ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die dem Erlass beigefügten Dokumente (akn:attachments)." ;
    laws:xml_element "akn:attachments" .

laws:block_name a owl:ObjectProperty ;
    rdfs:label "block_name" ;
    rdfs:range laws:BlockNameEnum ;
    skos:definition "Purpose of the block (akn:block/@name)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zweck des Blocks (akn:block/@name)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:body a owl:ObjectProperty ;
    rdfs:label "body" ;
    rdfs:range laws:ActBody ;
    skos:definition "Main body of the act (akn:body)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Hauptteil des Erlasses (akn:body)." .

laws:border a owl:DatatypeProperty ;
    rdfs:label "border" ;
    rdfs:range xsd:string ;
    skos:definition "The @border attribute on akn:table (HTML-style presentation)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Das @border-Attribut auf akn:table (HTML-artige Darstellung)." ;
    laws:xml_attribute "true" .

laws:components_ref a owl:ObjectProperty ;
    rdfs:label "components_ref" ;
    rdfs:range laws:Components ;
    skos:definition "The documents embedded in this act (akn:components)." ;
    skos:exactMatch akn:components ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die diesem Erlass beiliegenden Dokumente (akn:components)." ;
    laws:xml_element "akn:components" .

laws:conclusions_ref a owl:ObjectProperty ;
    rdfs:label "conclusions_ref" ;
    rdfs:range laws:Conclusions ;
    skos:definition "The concluding formula of the act (akn:conclusions)." ;
    skos:exactMatch akn:conclusions ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Schlussformel des Erlasses (akn:conclusions)." ;
    laws:xml_element "akn:conclusions" .

laws:container_name a owl:ObjectProperty ;
    rdfs:label "container_name" ;
    rdfs:range laws:ContainerNameEnum ;
    skos:definition "Purpose of the container (akn:container/@name)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zweck des Behälters (akn:container/@name)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:date_value a owl:DatatypeProperty ;
    rdfs:label "date_value" ;
    rdfs:range xsd:date ;
    skos:definition "An ISO 8601 date value (akn:FRBRdate/@date)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein ISO-8601-Datumswert (akn:FRBRdate/@date)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "date" .

laws:doc_name a owl:ObjectProperty ;
    rdfs:label "doc_name" ;
    rdfs:range laws:DocNameEnum ;
    skos:definition "Kind of the embedded document (akn:doc/@name)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Art des beiliegenden Dokuments (akn:doc/@name)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:doc_ref a owl:ObjectProperty ;
    rdfs:label "doc_ref" ;
    rdfs:range laws:Doc ;
    skos:definition "The embedded document itself (akn:doc)." ;
    skos:exactMatch akn:doc ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Das beiliegende Dokument selbst (akn:doc)." ;
    laws:xml_element "akn:doc" .

laws:end_ref a owl:DatatypeProperty ;
    rdfs:label "end_ref" ;
    skos:definition "Anchor of the date on which the interval ends (@end); empty while open." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Anker des Datums, an dem das Intervall endet (@end); leer, solange es offen ist." ;
    laws:xml_attribute "true" ;
    laws:xml_name "end" .

laws:fedlex_generator a owl:DatatypeProperty ;
    rdfs:label "fedlex_generator" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:generator on akn:FRBRformat[@value='xml']. Identifies the tool that generated the XML file. Only allowed on FRBRformat (FLX-XF-002).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:generator bei akn:FRBRformat[@value='xml']. Identifiziert das Werkzeug, das die XML-Datei erzeugt hat. Nur bei FRBRformat erlaubt (FLX-XF-002).
""" ;
    laws:schematron_rule "FLX-XF-002: generator only allowed on FRBRformat[@value='xml']" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:generator" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_message a owl:DatatypeProperty ;
    rdfs:label "fedlex_message" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:message on akn:placeholder, marking stripped content (e.g. 'E40S10-TAB').
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:message auf akn:placeholder, das entfernten Inhalt kennzeichnet (z.B. 'E40S10-TAB').
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:message" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_rs a owl:DatatypeProperty ;
    rdfs:label "fedlex_rs" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:rs on akn:ref: the SR number of the referenced law (e.g. '641.20').
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:rs auf akn:ref: die SR-Nummer des referenzierten Erlasses (z.B. '641.20').
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:rs" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_rs_uri a owl:DatatypeProperty ;
    rdfs:label "fedlex_rs_uri" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Fedlex extension attribute fedlex:rs-uri on akn:ref: the ELI URI of the referenced law's systematic-collection entry.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:rs-uri auf akn:ref: die ELI-URI des SR-Eintrags des referenzierten Erlasses.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:rs-uri" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:frbr_country a owl:ObjectProperty ;
    rdfs:label "frbr_country" ;
    rdfs:range laws:ValueType ;
    skos:closeMatch eli:jurisdiction ;
    skos:definition "Country code for this legislative text (akn:FRBRcountry/@value), e.g. 'CH'." ;
    skos:exactMatch akn:FRBRcountry ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ländercode für diesen Erlass (akn:FRBRcountry/@value), z.B. 'CH'." ;
    laws:xml_element "akn:FRBRcountry" .

laws:frbr_date_name a owl:DatatypeProperty ;
    rdfs:label "frbr_date_name" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( laws:FrbrDateNameEnum xsd:string ) ] ;
    skos:definition """Type of this date (akn:FRBRdate/@name). Fedlex uses the JoLux vocabulary; the permissible values of FrbrDateNameEnum carry the corresponding ELI property. Cantonal publishers use their own designations, which is why a free string remains admissible.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Art dieses Datums (akn:FRBRdate/@name). Fedlex verwendet das JoLux-Vokabular; die zulässigen Werte von FrbrDateNameEnum tragen die entsprechende ELI-Eigenschaft. Kantonale Publikationsstellen führen eigene Bezeichnungen, weshalb eine freie Zeichenkette zulässig bleibt.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:frbr_expression a owl:ObjectProperty ;
    rdfs:label "frbr_expression" ;
    rdfs:range eli:LegalExpression ;
    skos:definition "FRBR Expression level description (akn:FRBRExpression)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Expression-Ebenen-Beschreibung (akn:FRBRExpression)." .

laws:frbr_manifestation a owl:ObjectProperty ;
    rdfs:label "frbr_manifestation" ;
    rdfs:range eli:Format ;
    skos:definition "FRBR Manifestation level description (akn:FRBRManifestation)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Manifestations-Ebenen-Beschreibung (akn:FRBRManifestation)." .

laws:frbr_subtype a owl:ObjectProperty ;
    rdfs:label "frbr_subtype" ;
    rdfs:range laws:ValueType ;
    skos:definition "Subtype of the work (akn:FRBRsubtype), e.g. 'Gesetz'. Used by cantonal collections." ;
    skos:exactMatch akn:FRBRsubtype ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Untertyp des Werks (akn:FRBRsubtype), z.B. „Gesetz“. Von kantonalen Sammlungen verwendet." ;
    laws:xml_element "akn:FRBRsubtype" .

laws:frbr_work a owl:ObjectProperty ;
    rdfs:label "frbr_work" ;
    rdfs:range eli:LegalResource ;
    skos:definition "FRBR Work level description (akn:FRBRWork)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Work-Ebenen-Beschreibung (akn:FRBRWork)." .

laws:identification_ref a owl:ObjectProperty ;
    rdfs:label "identification_ref" ;
    rdfs:range laws:Identification ;
    skos:definition "FRBR identification block (akn:identification)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Identifikationsblock (akn:identification)." ;
    laws:xml_element "akn:identification" .

laws:language_value a owl:ObjectProperty ;
    rdfs:label "language_value" ;
    rdfs:range laws:DocumentLanguageEnum ;
    skos:definition "The @language attribute of akn:FRBRlanguage, e.g. 'de'." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Das @language-Attribut von akn:FRBRlanguage, z.B. 'de'." ;
    laws:xml_attribute "true" ;
    laws:xml_name "language" .

laws:list_introduction a owl:ObjectProperty ;
    rdfs:label "list_introduction" ;
    rdfs:range laws:MixedText ;
    skos:definition "Optional introduction text before a block list (akn:listIntroduction)." ;
    skos:exactMatch akn:listIntroduction ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Optionaler Einleitungstext vor einer Auflistung (akn:listIntroduction)." ;
    laws:xml_element "akn:listIntroduction" .

laws:main_body a owl:ObjectProperty ;
    rdfs:label "main_body" ;
    rdfs:range laws:MainBody ;
    skos:definition "Body of the embedded document (akn:mainBody)." ;
    skos:exactMatch akn:mainBody ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Hauptteil des beiliegenden Dokuments (akn:mainBody)." ;
    laws:xml_element "akn:mainBody" .

laws:name_attr2 a owl:DatatypeProperty ;
    rdfs:label "name_attr2" ;
    skos:definition "Purpose of the formula (@name)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zweck der Formel (@name)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:notes_ref a owl:ObjectProperty ;
    rdfs:label "notes_ref" ;
    rdfs:range laws:Notes ;
    skos:definition "The notes block of the metadata (akn:notes)." ;
    skos:exactMatch akn:notes ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Der Anmerkungsblock der Metadaten (akn:notes)." ;
    laws:xml_element "akn:notes" .

laws:original_ref a owl:ObjectProperty ;
    rdfs:label "original_ref" ;
    rdfs:range laws:OriginalRef ;
    skos:definition "Reference to the original version (akn:original)." ;
    skos:exactMatch akn:original ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Verweis auf die ursprüngliche Fassung (akn:original)." ;
    laws:xml_element "akn:original" .

laws:passive_modifications a owl:ObjectProperty ;
    rdfs:label "passive_modifications" ;
    rdfs:range laws:PassiveModifications ;
    skos:definition "The modifications other acts make to this one (akn:passiveModifications)." ;
    skos:exactMatch akn:passiveModifications ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Änderungen, die andere Erlasse an diesem vornehmen (akn:passiveModifications)." ;
    laws:xml_element "akn:passiveModifications" .

laws:preamble_ref a owl:ObjectProperty ;
    rdfs:label "preamble_ref" ;
    rdfs:range laws:Preamble ;
    skos:definition "Preamble of the act (akn:preamble)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Präambel des Erlasses (akn:preamble)." ;
    laws:xml_element "akn:preamble" .

laws:references_ref a owl:ObjectProperty ;
    rdfs:label "references_ref" ;
    rdfs:range laws:References ;
    skos:definition "References section of the meta (akn:references)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Referenzen-Abschnitt der Metadaten (akn:references)." ;
    laws:xml_element "akn:references" .

laws:short_form a owl:DatatypeProperty ;
    rdfs:label "short_form" ;
    rdfs:range xsd:string ;
    skos:definition """Short form abbreviation of the legislative name (@shortForm), e.g. 'BV' (German), 'Cst.' (French).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Kurzform-Abkürzung des Gesetzesnamens (@shortForm), z.B. 'BV' (Deutsch), 'Cst.' (Französisch).
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "shortForm" .

laws:src a owl:DatatypeProperty ;
    rdfs:label "src" ;
    skos:definition "Location of the referenced component (@src)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ort des verwiesenen Bestandteils (@src)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "src" .

laws:start_ref a owl:DatatypeProperty ;
    rdfs:label "start_ref" ;
    skos:definition "Anchor of the date on which the interval begins (@start)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Anker des Datums, an dem das Intervall beginnt (@start)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "start" .

laws:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    skos:definition "Editorial state of the element (@status), e.g. 'edited'." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Bearbeitungsstand des Elements (@status), z.B. „edited“." ;
    laws:xml_attribute "true" ;
    laws:xml_name "status" .

laws:style a owl:DatatypeProperty ;
    rdfs:label "style" ;
    skos:definition "Presentation hint of the element (@style)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Darstellungsangabe des Elements (@style)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "style" .

laws:temporal_data_ref a owl:ObjectProperty ;
    rdfs:label "temporal_data_ref" ;
    rdfs:range laws:TemporalData ;
    skos:definition "The temporal data of the metadata (akn:temporalData)." ;
    skos:exactMatch akn:temporalData ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Zeitangaben der Metadaten (akn:temporalData)." ;
    laws:xml_element "akn:temporalData" .

laws:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:definition "The character data of a TextRun; emitted as a text node in mixed content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Zeichendaten eines TextRun; wird als Textknoten in gemischtem Inhalt ausgegeben." ;
    laws:xsd_text "true" .

laws:value_uri a owl:DatatypeProperty ;
    rdfs:label "value_uri" ;
    rdfs:range xsd:anyURI ;
    skos:definition "A @value attribute typed as an ELI URI (akn:FRBRthis/@value, akn:FRBRuri/@value)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein @value-Attribut vom Typ ELI-URI (akn:FRBRthis/@value, akn:FRBRuri/@value)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "value" .

laws:xml_lang a owl:DatatypeProperty ;
    rdfs:label "xml_lang" ;
    rdfs:range xsd:string ;
    skos:definition "XML language code attribute (xml:lang), e.g. 'de', 'fr', 'it', 'rm', 'en'." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "XML-Sprachattribut (xml:lang), z.B. 'de', 'fr', 'it', 'rm', 'en'." ;
    laws:xml_attribute "true" ;
    laws:xml_name "xml:lang" .

xsd:anyURI a rdfs:Datatype .

laws:BlockList a owl:Class ;
    rdfs:label "BlockList" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:items ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:style ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:style ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:style ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:list_introduction ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:list_introduction ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockListItem ;
            owl:onProperty laws:items ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:list_introduction ],
        laws:BlockElement ;
    skos:definition """A block list of enumerated or lettered items (akn:blockList), optionally introduced by an akn:listIntroduction element.
""" ;
    skos:exactMatch akn:blockList ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Auflistung von nummerierten oder buchstabierten Punkten (akn:blockList), optional eingeleitet durch ein akn:listIntroduction-Element.
""" ;
    laws:xml_element "akn:blockList" .

laws:BlockNameEnum a owl:Class ;
    rdfs:label "BlockNameEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0296/laws/BlockNameEnum#heading> <https://ld.ech.ch/schema/0296/laws/BlockNameEnum#num> ) ;
    skos:definition "Block purposes Fedlex uses in akn:block/@name." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zwecke, die Fedlex in akn:block/@name verwendet." ;
    linkml:permissible_values <https://ld.ech.ch/schema/0296/laws/BlockNameEnum#heading>,
        <https://ld.ech.ch/schema/0296/laws/BlockNameEnum#num> .

laws:BlockParagraph a owl:Class ;
    rdfs:label "BlockParagraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:FedlexRoleEnum ;
            owl:onProperty laws:fedlex_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_role ],
        laws:BlockElement ;
    skos:definition """A prose paragraph within content (akn:p). May contain mixed content with inline markup (XmlContent type). Note: akn:br is not allowed here, only in heading elements (FLX-TXT-001).
""" ;
    skos:exactMatch akn:p ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Fliesstext-Absatz in Content (akn:p). Kann gemischten Inhalt mit Inline-Markup enthalten (XmlContent-Typ). Hinweis: akn:br ist hier nicht erlaubt, nur in Überschriften (FLX-TXT-001).
""" ;
    laws:schematron_note "FLX-TXT-001: br not allowed in p — only in heading/subheading/docTitle" ;
    laws:xml_element "akn:p" .

laws:Book a owl:Class ;
    rdfs:label "Book" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Section ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subsection ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Chapter ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Part ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subchapter ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Title ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ] ;
    skos:definition """Book-level division of an act (akn:book). Allowed children: title, part, chapter, subchapter, section, subsection, level (FLX-HR-001-bk). Requires unique @eId (FLX-HR-002-bk).
""" ;
    skos:exactMatch akn:book ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Buch-Ebene eines Erlasses (akn:book). Erlaubte Kinder: title, part, chapter, subchapter, section, subsection, level (FLX-HR-001-bk). Benötigt eindeutiges @eId (FLX-HR-002-bk).
""" ;
    laws:schematron_rules "FLX-HR-001-bk, FLX-HR-002-bk" ;
    laws:xml_element "akn:book" ;
    laws:xsd_content_model "choice" .

laws:Content a owl:Class ;
    rdfs:label "Content" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockElement ;
            owl:onProperty laws:content_blocks ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ] ;
    skos:definition """The content of a paragraph (akn:content). Contains block-level elements: akn:p (prose), akn:blockList (numbered/lettered lists), akn:table. When used inside a akn:level, must contain an akn:mod element (FLX-HR-003).
""" ;
    skos:exactMatch akn:content ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Inhalt eines Absatzes (akn:content). Enthält Block-Elemente: akn:p (Fliesstext), akn:blockList (Aufzählungen), akn:table. Wenn in einem akn:level, muss ein akn:mod-Element enthalten sein (FLX-HR-003).
""" ;
    laws:schematron_note "FLX-HR-003: content in level only allowed for modifications (must contain akn:mod)" ;
    laws:xml_element "akn:content" ;
    laws:xsd_content_model "choice" .

laws:FRBRAuthor a owl:Class ;
    rdfs:label "FRBRAuthor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:as_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:as_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:as_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ] ;
    skos:definition """An author or rights-holder entry for an FRBR entity (akn:FRBRauthor). @href references the organization; @as references the role (both as intra-document anchors).
""" ;
    skos:exactMatch akn:FRBRauthor ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Autoren- oder Rechteinhaber-Eintrag einer FRBR-Entität (akn:FRBRauthor). @href referenziert die Organisation; @as referenziert die Rolle (beide als Dokument-interne Anker).
""" ;
    laws:xml_element "akn:FRBRauthor" .

laws:FRBRDate a owl:Class ;
    rdfs:label "FRBRDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:date_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:date_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_date_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( laws:FrbrDateNameEnum xsd:string ) ] ;
            owl:onProperty laws:frbr_date_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty laws:date_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_date_name ] ;
    skos:definition """A date entry for an FRBR entity (akn:FRBRdate). The @name attribute uses Fedlex/JoLux vocabulary: jolux:dateEntryInForce, jolux:dateDocument, jolux:dateApplicability.
""" ;
    skos:exactMatch akn:FRBRdate ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Datumseintrag einer FRBR-Entität (akn:FRBRdate). Das @name-Attribut verwendet Fedlex/JoLux-Vokabular: jolux:dateEntryInForce, jolux:dateDocument, jolux:dateApplicability.
""" ;
    laws:xml_element "akn:FRBRdate" .

laws:Table a owl:Class ;
    rdfs:label "Table" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:TableRow ;
            owl:onProperty laws:table_rows ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:border ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:border ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:table_rows ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:border ],
        laws:BlockElement ;
    skos:definition """A table element within content (akn:table). Contains rows (akn:tr) with cells (akn:td). Corresponds to the HTML table model.
""" ;
    skos:exactMatch akn:table ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Tabellen-Element innerhalb von Content (akn:table). Enthält Zeilen (akn:tr) mit Zellen (akn:td). Entspricht dem HTML-Tabellenmodell.
""" ;
    laws:xml_element "akn:table" .

laws:Title a owl:Class ;
    rdfs:label "Title" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Subchapter ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Section ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Part ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:subheading ],
