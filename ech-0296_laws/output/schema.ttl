laws:ActiveRef a owl:Class ;
    rdfs:label "ActiveRef" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
