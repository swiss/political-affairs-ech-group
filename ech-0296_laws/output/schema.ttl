	rdfs:subClassOf _:c14n1040 , _:c14n617 , _:c14n81 , _:c14n827 , _:c14n84 , _:c14n944 ;
	skos:definition "A date entry for an FRBR entity (akn:FRBRdate). The @name attribute uses Fedlex/JoLux vocabulary: jolux:dateEntryInForce, jolux:dateDocument, jolux:dateApplicability.\n" ;
	skos:exactMatch akn:FRBRdate ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
