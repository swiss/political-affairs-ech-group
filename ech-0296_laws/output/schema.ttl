    rdfs:subClassOf laws:Ref ;
    owl:onProperty laws:element_type ;
    owl:someValuesFrom laws:Ref .

[] a owl:Restriction ;
    rdfs:subClassOf laws:BlockElement ;
    owl:onProperty laws:element_type ;
    owl:someValuesFrom laws:BlockElement .

