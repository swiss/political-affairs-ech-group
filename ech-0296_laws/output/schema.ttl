laws:Level a owl:Class ;
	rdfs:label "Level" ;
	rdfs:subClassOf _:c14n1011 , _:c14n102 , _:c14n1020 , _:c14n1044 , _:c14n108 , _:c14n164 , _:c14n187 , _:c14n211 , _:c14n233 , _:c14n234 , _:c14n241 , _:c14n26 , _:c14n28 , _:c14n325 , _:c14n364 , _:c14n407 , _:c14n479 , _:c14n492 , _:c14n578 , _:c14n627 , _:c14n634 , _:c14n646 , _:c14n654 , _:c14n657 , _:c14n681 , _:c14n694 , _:c14n7 , _:c14n705 , _:c14n76 , _:c14n764 , _:c14n785 , _:c14n793 , _:c14n96 , _:c14n964 ;
	skos:definition "Transparent structural division (akn:level). A level is 'transparent': its allowed children are the same as those of its nearest non-level ancestor (FLX-HR-001-lv). A level containing akn:content is only permitted when the content includes a modification element (akn:mod) — used for amending acts (FLX-HR-003). The fedlex:role='marginal' attribute marks it as a marginal note (FLX-XF-004). Requires unique @eId (FLX-HR-002-lv, FLX-HR-004).\n" ;
	skos:exactMatch akn:level ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Transparente Strukturebene (akn:level). Ein level ist 'transparent': erlaubte Kinder entsprechen denen des nächsten nicht-level-Vorfahren (FLX-HR-001-lv). Ein level mit akn:content ist nur erlaubt, wenn der Inhalt ein Änderungselement (akn:mod) enthält (FLX-HR-003). fedlex:role='marginal' kennzeichnet es als Randnote (FLX-XF-004). Benötigt eindeutiges @eId (FLX-HR-002-lv, FLX-HR-004).\n" ;
	laws:schematron_rules "FLX-HR-001-lv, FLX-HR-002-lv, FLX-HR-003, FLX-HR-004, FLX-XF-004" ;
	laws:transparency_note "[en] 'level' is transparent: XPath context for child validation uses the nearest non-level ancestor. This cannot be expressed in XSD; enforced by Schematron FLX-HR-001-lv. [de] 'level' ist transparent: der XPath-Kontext für die Kindvalidierung nutzt den nächsten nicht-level-Vorfahren. Nicht in XSD ausdrückbar; durch Schematron FLX-HR-001-lv erzwungen.\n" ;
	laws:xml_element "akn:level" ;
	laws:xsd_content_model "choice" .
laws:MainBody a owl:Class ;
	rdfs:label "MainBody" ;
	rdfs:subClassOf _:c14n1004 , _:c14n285 , _:c14n303 , _:c14n371 , _:c14n716 , _:c14n843 , _:c14n995 ;
	skos:definition "Body of an embedded document (akn:mainBody). Unlike the act body it holds paragraphs and levels directly, without the legislative hierarchy.\n" ;
	skos:exactMatch akn:mainBody ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Hauptteil eines beiliegenden Dokuments (akn:mainBody). Anders als der Erlasskörper nimmt er Absätze und Ebenen unmittelbar auf, ohne die Gesetzeshierarchie.\n" ;
	laws:xml_element "akn:mainBody" .
