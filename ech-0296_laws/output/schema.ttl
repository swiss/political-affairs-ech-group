laws:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Paragraph ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subdivision ;
            owl:onProperty laws:subdivisions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subdivisions ] ;
    skos:definition """An article, the primary legislative unit (akn:article). Constraints (FLX-ART-*): - akn:num is mandatory (FLX-ART-001) - only heading elements (num, heading, subheading) plus akn:paragraph and akn:subdivision are allowed as children (FLX-ART-002) - requires unique @eId (FLX-ART-003)
""" ;
    skos:exactMatch akn:article ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Artikel, die primäre legislative Einheit (akn:article). Constraints (FLX-ART-*): - akn:num ist obligatorisch (FLX-ART-001) - nur Überschriften-Elemente (num, heading, subheading) sowie akn:paragraph und akn:subdivision sind als Kinder erlaubt (FLX-ART-002) - benötigt eindeutiges @eId (FLX-ART-003)
""" ;
    laws:schematron_rules """FLX-ART-001: num mandatory; FLX-ART-002: content restricted to heading+paragraph+subdivision; FLX-ART-003: eId required
""" ;
    laws:xml_element "akn:article" ;
    laws:xsd_content_model "choice" .

laws:DocumentLanguageEnum a owl:Class ;
    rdfs:label "DocumentLanguageEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#de> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#fr> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#it> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#rm> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#en> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#ger> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#fre> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#ita> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#roh> <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#eng> ) ;
    skos:definition "Language codes used for Swiss federal documents." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Sprachcodes für schweizerische Bundesdokumente." ;
    linkml:permissible_values <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#de>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#en>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#eng>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#fr>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#fre>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#ger>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#it>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#ita>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#rm>,
        <https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#roh> .

laws:Level a owl:Class ;
    rdfs:label "Level" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Content ;
            owl:onProperty laws:content_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subsection ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Section ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Chapter ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Book ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FedlexRoleEnum ;
            owl:onProperty laws:fedlex_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Part ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subchapter ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:content_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Title ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:content_ref ] ;
    skos:definition """Transparent structural division (akn:level). A level is 'transparent': its allowed children are the same as those of its nearest non-level ancestor (FLX-HR-001-lv). A level containing akn:content is only permitted when the content includes a modification element (akn:mod) — used for amending acts (FLX-HR-003). The fedlex:role='marginal' attribute marks it as a marginal note (FLX-XF-004). Requires unique @eId (FLX-HR-002-lv, FLX-HR-004).
""" ;
    skos:exactMatch akn:level ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Transparente Strukturebene (akn:level). Ein level ist 'transparent': erlaubte Kinder entsprechen denen des nächsten nicht-level-Vorfahren (FLX-HR-001-lv). Ein level mit akn:content ist nur erlaubt, wenn der Inhalt ein Änderungselement (akn:mod) enthält (FLX-HR-003). fedlex:role='marginal' kennzeichnet es als Randnote (FLX-XF-004). Benötigt eindeutiges @eId (FLX-HR-002-lv, FLX-HR-004).
""" ;
    laws:schematron_rules "FLX-HR-001-lv, FLX-HR-002-lv, FLX-HR-003, FLX-HR-004, FLX-XF-004" ;
    laws:transparency_note """[en] 'level' is transparent: XPath context for child validation uses the nearest non-level ancestor. This cannot be expressed in XSD; enforced by Schematron FLX-HR-001-lv. [de] 'level' ist transparent: der XPath-Kontext für die Kindvalidierung nutzt den nächsten nicht-level-Vorfahren. Nicht in XSD ausdrückbar; durch Schematron FLX-HR-001-lv erzwungen.
""" ;
    laws:xml_element "akn:level" ;
    laws:xsd_content_model "choice" .

