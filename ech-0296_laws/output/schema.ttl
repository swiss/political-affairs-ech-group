	rdfs:label "transitionals" ;
	rdfs:range laws:Transitional ;
	skos:definition "Transitional provision elements (akn:transitional)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Übergangsbestimmungs-Elemente (akn:transitional)." .
laws:up_to a owl:DatatypeProperty ;
	rdfs:label "up_to" ;
	skos:definition "End of a range of destinations (@upTo)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ende eines Zielbereichs (@upTo)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "upTo" .
laws:value a owl:DatatypeProperty ;
	rdfs:label "value" ;
	rdfs:range xsd:string ;
	skos:definition "Generic value attribute (@value) used across multiple AkomaNtoso elements." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Generisches Wert-Attribut (@value), in mehreren AkomaNtoso-Elementen verwendet." ;
	laws:xml_attribute "true" .
laws:value_uri a owl:DatatypeProperty ;
	rdfs:label "value_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A @value attribute typed as an ELI URI (akn:FRBRthis/@value, akn:FRBRuri/@value)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein @value-Attribut vom Typ ELI-URI (akn:FRBRthis/@value, akn:FRBRuri/@value)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "value" .
laws:xml_lang a owl:DatatypeProperty ;
	rdfs:label "xml_lang" ;
	rdfs:range xsd:string ;
	skos:definition "XML language code attribute (xml:lang), e.g. 'de', 'fr', 'it', 'rm', 'en'." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "XML-Sprachattribut (xml:lang), z.B. 'de', 'fr', 'it', 'rm', 'en'." ;
	laws:xml_attribute "true" ;
	laws:xml_name "xml:lang" .
