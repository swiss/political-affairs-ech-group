	rdfs:subClassOf _:c14n23 , _:c14n352 , _:c14n570 , _:c14n712 , _:c14n715 , _:c14n720 , _:c14n814 , _:c14n82 , _:c14n869 ;
	skos:definition "A holder for akn:FRBRformat: a @value (typically 'xml') plus the optional fedlex:generator extension attribute (FLX-XF-002).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Halter für akn:FRBRformat: ein @value (typischerweise 'xml') plus das optionale Erweiterungsattribut fedlex:generator (FLX-XF-002).\n" .
