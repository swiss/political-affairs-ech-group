laws:BlockParagraph a owl:Class ;
    rdfs:label "BlockParagraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ] ;
    skos:definition """A prose paragraph within content (akn:p). May contain mixed content with inline markup (XmlContent type). Note: akn:br is not allowed here, only in heading elements (FLX-TXT-001).
""" ;
    skos:exactMatch akn:p ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Fliesstext-Absatz in Content (akn:p). Kann gemischten Inhalt mit Inline-Markup enthalten (XmlContent-Typ). Hinweis: akn:br ist hier nicht erlaubt, nur in Überschriften (FLX-TXT-001).
""" ;
    laws:schematron_note "FLX-TXT-001: br not allowed in p — only in heading/subheading/docTitle" ;
    laws:xml_element "akn:p" .

