    skos:definition "Section-level child elements (akn:section)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Abschnitt-Kindelemente (akn:section)." .

laws:refers_to a owl:DatatypeProperty ;
    rdfs:label "refers_to" ;
    skos:definition "Anchor naming what this element refers to (@refersTo)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Anker, der nennt, worauf sich das Element bezieht (@refersTo)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "refersTo" .

laws:ModTypeEnum a owl:Class ;
    rdfs:label "ModTypeEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#repeal> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#substitution> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#insertion> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#replacement> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#renumbering> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#split> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#join> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#entryIntoForce> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#endOfEnactment> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#postponementOfEntryIntoForce> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#prorogationOfForce> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#reEnactment> <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#unconstitutionality> ) ;
    skos:definition """Kinds of modification defined by Akoma Ntoso: the textual ones from the TextualMods list, those of legal force from ForceMods.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Änderungsarten, die Akoma Ntoso definiert: die textlichen aus der Liste TextualMods, die der Rechtskraft aus ForceMods.
""" ;
    linkml:permissible_values <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#endOfEnactment>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#entryIntoForce>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#insertion>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#join>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#postponementOfEntryIntoForce>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#prorogationOfForce>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#reEnactment>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#renumbering>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#repeal>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#replacement>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#split>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#substitution>,
        <https://ld.ech.ch/schema/0296/laws/ModTypeEnum#unconstitutionality> .

laws:subsections a owl:ObjectProperty ;
    rdfs:label "subsections" ;
    rdfs:range laws:Subsection ;
    skos:definition "Subsection-level child elements (akn:subsection)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Unterabschnitt-Kindelemente (akn:subsection)." .

laws:title_attr a owl:DatatypeProperty ;
    rdfs:label "title_attr" ;
    skos:definition "Human-readable label of the marked-up passage (@title)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Menschenlesbare Bezeichnung der ausgezeichneten Stelle (@title)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "title" .

laws:BlockElement a owl:Class ;
    rdfs:label "BlockElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:element_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:element_type ],
        [ owl:unionOf ( laws:BlockList laws:BlockParagraph laws:Citations laws:Formula laws:Table ) ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:element_type ] ;
    skos:definition """Abstract base for a block-level element: the paragraphs, lists and tables of the content, and the formula and citations of the preamble.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Abstrakte Basis für ein Element auf Blockebene: die Absätze, Aufzählungen und Tabellen des Inhalts sowie Formel und Erwägungen des Vorspruchs.
""" .

laws:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "Anchor reference to the responsible organization (@source), e.g. '#ch.bk'." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Anker-Referenz auf die verantwortliche Organisation (@source), z.B. '#ch.bk'." ;
    laws:xml_attribute "true" .

laws:articles a owl:ObjectProperty ;
    rdfs:label "articles" ;
    rdfs:range laws:Article ;
    skos:definition "Article child elements (akn:article)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Artikel-Kindelemente (akn:article)." .

laws:content_blocks a owl:ObjectProperty ;
    rdfs:label "content_blocks" ;
    rdfs:range laws:BlockElement ;
    skos:definition """Block-level content in reading order: paragraphs, lists and tables as they follow one another in the document.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Blockinhalt in Lesereihenfolge: Absätze, Aufzählungen und Tabellen, wie sie im Dokument aufeinanderfolgen.
""" .

laws:levels a owl:ObjectProperty ;
    rdfs:label "levels" ;
    rdfs:range laws:Level ;
    skos:definition "Transparent level child elements (akn:level)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Transparente Level-Kindelemente (akn:level)." .

laws:subheading a owl:ObjectProperty ;
    rdfs:label "subheading" ;
    rdfs:range laws:MixedText ;
    skos:definition """Subheading element for a hierarchical structure (akn:subheading). The fedlex:role='reference' attribute marks it as a reference heading (FLX-XF-005). Max one subheading per element (FLX-HD-006).
""" ;
    skos:exactMatch akn:subheading ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Unterüberschrift für ein Strukturelement (akn:subheading). fedlex:role='reference' kennzeichnet es als Referenzüberschrift (FLX-XF-005). Maximal eine subheading pro Element (FLX-HD-006).
""" ;
    laws:schematron_rules """FLX-HD-006: max one subheading; FLX-XF-005: fedlex:role='reference' only allowed on subheading
""" ;
    laws:xml_element "akn:subheading" .

laws:show_as a owl:DatatypeProperty ;
    rdfs:label "show_as" ;
    rdfs:range xsd:string ;
    skos:definition "Human-readable display label for a TLC reference (@showAs)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Lesbare Anzeigebezeichnung einer TLC-Referenz (@showAs)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "showAs" .

laws:href a owl:DatatypeProperty ;
    rdfs:label "href" ;
    rdfs:range xsd:string ;
    skos:definition "URI reference (@href), used for links to organizations, roles, or external URIs." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "URI-Referenz (@href), für Links zu Organisationen, Rollen oder externen URIs." ;
    laws:xml_attribute "true" .

laws:heading a owl:ObjectProperty ;
    rdfs:label "heading" ;
    rdfs:range laws:MixedText ;
    skos:definition """Heading element for a hierarchical structure (akn:heading). May contain inline markup including akn:br (FLX-TXT-001: br permitted in heading context). Must precede subheading (FLX-HD-004, FLX-HD-005).
""" ;
    skos:exactMatch akn:heading ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Überschrift für ein Strukturelement (akn:heading). Kann Inline-Markup einschliesslich akn:br enthalten (FLX-TXT-001: br in Überschriften erlaubt). Muss vor subheading stehen (FLX-HD-004, FLX-HD-005).
""" ;
    laws:schematron_rules """FLX-HD-004: max one heading; FLX-HD-005: heading before subheading; FLX-TXT-001: br permitted here
""" ;
    laws:xml_element "akn:heading" .

laws:num a owl:ObjectProperty ;
    rdfs:label "num" ;
    rdfs:range laws:MixedText ;
    skos:definition """Number element for a hierarchical structure or article (akn:num). In articles, num is mandatory (FLX-ART-001). The num element must precede heading and subheading (FLX-HD-001, FLX-HD-002, FLX-HD-003).
""" ;
    skos:exactMatch akn:num ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Nummerierungselement für ein Strukturelement oder einen Artikel (akn:num). Bei Artikeln obligatorisch (FLX-ART-001). num muss vor heading und subheading stehen (FLX-HD-001, FLX-HD-002, FLX-HD-003).
""" ;
    laws:schematron_rules "FLX-HD-001: max one num; FLX-HD-002: num before heading; FLX-HD-003: num before subheading" ;
    laws:xml_element "akn:num" .

laws:MixedText a owl:Class ;
    rdfs:label "MixedText" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ] ;
    skos:definition """Reusable mixed-content holder: an ordered run of text and inline markup. Used as the range for num, heading, subheading, listIntroduction, docTitle, so the wrapping element name comes from the referring slot's xml_element.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Wiederverwendbarer Halter für gemischten Inhalt: eine geordnete Folge aus Text und Inline-Markup. Range für num, heading, subheading, listIntroduction, docTitle; der umschliessende Elementname kommt vom referenzierenden Slot.
""" .

laws:inline_content a owl:ObjectProperty ;
    rdfs:label "inline_content" ;
    rdfs:range laws:InlineElement ;
    skos:definition """Ordered mixed content: a sequence of text runs and inline-markup elements (InlineElement subclasses). Document order is preserved by list order. Allowed inline elements: akn:ref, akn:b, akn:i, akn:sup, akn:span, akn:authorialNote, akn:inline, akn:placeholder, akn:br.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Geordneter gemischter Inhalt: eine Folge aus Textabschnitten und Inline-Markup-Elementen (InlineElement-Subklassen). Die Dokumentreihenfolge wird durch die Listenreihenfolge bewahrt.
""" ;
    laws:xsd_mixed "true" .

laws:InlineElement a owl:Class ;
    rdfs:label "InlineElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:element_type ],
        [ owl:unionOf ( laws:Abbr laws:ActiveRef laws:AuthorialNote laws:B laws:Br laws:DateInline laws:Def laws:DocDate laws:DocNumber laws:DocTitle laws:DocketNumber laws:Eol laws:I laws:Inline laws:NoteRef laws:Person laws:Placeholder laws:Ref laws:Role laws:ShortTitle laws:Signature laws:Span laws:Sup laws:TextRun ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:element_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:element_type ] ;
    skos:definition "Abstract base for a modeled inline-markup element inside mixed content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Abstrakte Basis für ein modelliertes Inline-Markup-Element in gemischtem Inhalt." .

laws:element_type a owl:DatatypeProperty ;
    rdfs:label "element_type" ;
    rdfs:range xsd:string ;
    skos:definition """Type designator discriminating the concrete subclass of an abstract base: InlineElement (TextRun, Ref, B, I, Sup, Span, Br, Inline, Placeholder, AuthorialNote) or BlockElement (BlockParagraph, BlockList, Table).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Typ-Diskriminator für die konkrete Unterklasse einer abstrakten Basis: InlineElement oder BlockElement.
""" .

laws:eId a owl:DatatypeProperty ;
    rdfs:label "eId" ;
    rdfs:range xsd:string ;
    skos:definition """Unique element identifier within the document (@eId). Required by Fedlex Schematron on all hierarchical structure elements, articles, subdivisions, and paragraphs. Follows the AKN eId naming convention (hierarchical path notation), e.g. 'ti_1', 'ch_1', 'art_1', 'art_1-para_1'.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eindeutiger Element-Identifier im Dokument (@eId). Vom Fedlex Schematron gefordert bei allen Hierarchieelementen, Artikeln, Unterabschnitten und Absätzen. Folgt der AKN-eId-Namenskonvention (hierarchische Pfadnotation), z.B. 'ti_1', 'ch_1', 'art_1', 'art_1-para_1'.
""" ;
    laws:xml_attribute "true" .

xsd:string a rdfs:Datatype .

