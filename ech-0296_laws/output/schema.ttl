laws:Doc a owl:Class ;
    rdfs:label "Doc" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:doc_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActMeta ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MainBody ;
            owl:onProperty laws:main_body ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Preface ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:main_body ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:doc_name ],
        [ a owl:Restriction ;
