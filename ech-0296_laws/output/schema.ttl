            owl:minCardinality 0 ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ] ;
    skos:definition """Book-level division of an act (akn:book). Allowed children: title, part, chapter, subchapter, section, subsection, level (FLX-HR-001-bk). Requires unique @eId (FLX-HR-002-bk).
""" ;
    skos:exactMatch akn:book ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Buch-Ebene eines Erlasses (akn:book). Erlaubte Kinder: title, part, chapter, subchapter, section, subsection, level (FLX-HR-001-bk). Benötigt eindeutiges @eId (FLX-HR-002-bk).
""" ;
    laws:schematron_rules "FLX-HR-001-bk, FLX-HR-002-bk" ;
    laws:xml_element "akn:book" ;
    laws:xsd_content_model "choice" .

laws:FRBRAuthor a owl:Class ;
    rdfs:label "FRBRAuthor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:as_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:as_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:as_role ] ;
    skos:definition """An author or rights-holder entry for an FRBR entity (akn:FRBRauthor). @href references the organization; @as references the role (both as intra-document anchors).
""" ;
    skos:exactMatch akn:FRBRauthor ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Autoren- oder Rechteinhaber-Eintrag einer FRBR-Entität (akn:FRBRauthor). @href referenziert die Organisation; @as referenziert die Rolle (beide als Dokument-interne Anker).
""" ;
    laws:xml_element "akn:FRBRauthor" .

laws:FRBRDate a owl:Class ;
    rdfs:label "FRBRDate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:date_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:frbr_date_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_date_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:date_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_date_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty laws:date_value ] ;
    skos:definition """A date entry for an FRBR entity (akn:FRBRdate). The @name attribute uses Fedlex/JoLux vocabulary: jolux:dateEntryInForce, jolux:dateDocument, jolux:dateApplicability.
""" ;
    skos:exactMatch akn:FRBRdate ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Datumseintrag einer FRBR-Entität (akn:FRBRdate). Das @name-Attribut verwendet Fedlex/JoLux-Vokabular: jolux:dateEntryInForce, jolux:dateDocument, jolux:dateApplicability.
""" ;
    laws:xml_element "akn:FRBRdate" .

laws:FedlexRoleEnum a owl:Class ;
    rdfs:label "FedlexRoleEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#marginal> <https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#reference> ) ;
    skos:definition """Allowed values for the fedlex:role extension attribute (FLX-XF-003). 'marginal' is only permitted on akn:level elements (FLX-XF-004). 'reference' is only permitted on akn:subheading elements (FLX-XF-005).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Erlaubte Werte für das Fedlex-Erweiterungsattribut fedlex:role (FLX-XF-003). 'marginal' nur bei akn:level-Elementen (FLX-XF-004). 'reference' nur bei akn:subheading-Elementen (FLX-XF-005).
""" ;
    linkml:permissible_values <https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#marginal>,
        <https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#reference> .

