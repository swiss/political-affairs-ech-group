laws:ActTypeEnum a owl:Class ;
    rdfs:label "ActTypeEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0296/laws/ActTypeEnum#publicLaw> <https://ld.ech.ch/schema/0296/laws/ActTypeEnum#privateAct> <https://ld.ech.ch/schema/0296/laws/ActTypeEnum#amendment> <https://ld.ech.ch/schema/0296/laws/ActTypeEnum#constitution> ) ;
    skos:definition "Type of legislative act expressed in the akn:act/@name attribute." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Art des Erlasses, ausgedrückt im @name-Attribut von akn:act." ;
    linkml:permissible_values <https://ld.ech.ch/schema/0296/laws/ActTypeEnum#amendment>,
