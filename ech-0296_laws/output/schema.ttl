laws:Preface a owl:Class ;
	rdfs:label "Preface" ;
	rdfs:subClassOf _:c14n247 , _:c14n636 , _:c14n697 , _:c14n755 ;
	skos:definition "The preface of the act (akn:preface), containing the document number and title. Fedlex Schematron requires both akn:docNumber (FLX-PF-001) and akn:docTitle (FLX-PF-002) to be present inside a akn:p element.\n" ;
	skos:exactMatch akn:preface ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Der Vorspann des Erlasses (akn:preface) mit Dokumentnummer und -titel. Fedlex Schematron verlangt akn:docNumber (FLX-PF-001) und akn:docTitle (FLX-PF-002) innerhalb eines akn:p-Elements.\n" ;
	laws:schematron_rules "FLX-PF-001: Missing docNumber; FLX-PF-002: Missing docTitle" ;
	laws:xml_element "akn:preface" .
laws:PrefaceP a owl:Class ;
	rdfs:label "PrefaceP" ;
	rdfs:subClassOf _:c14n224 , _:c14n532 , _:c14n624 , _:c14n719 , _:c14n866 ;
	skos:definition "A preface paragraph (akn:p). Fedlex requires akn:docNumber and akn:docTitle somewhere in the preface (FLX-PF-001/002); cantonal collections additionally mark up the systematic number, the short title, the abbreviation and the date.\n" ;
	skos:exactMatch akn:p ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein Vorspann-Absatz (akn:p). Fedlex verlangt akn:docNumber und akn:docTitle irgendwo im Vorspann (FLX-PF-001/002); kantonale Sammlungen zeichnen zusätzlich Ordnungsnummer, Kurztitel, Abkürzung und Datum aus.\n" ;
	laws:xml_element "akn:p" ;
	laws:xsd_mixed "true" .
laws:Proviso a owl:Class ;
	rdfs:label "Proviso" ;
	rdfs:subClassOf _:c14n1002 , _:c14n208 , _:c14n292 , _:c14n35 , _:c14n355 , _:c14n442 , _:c14n449 , _:c14n504 , _:c14n548 , _:c14n555 , _:c14n581 , _:c14n684 , _:c14n780 , _:c14n871 , _:c14n927 ;
	skos:definition "A proviso in the body of an act (akn:proviso). Permitted as a top-level body element (FLX-BD-001). Typically appears after the main articles.\n" ;
	skos:exactMatch akn:proviso ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein Vorbehalt im Hauptteil eines Erlasses (akn:proviso). Als Hauptteil-Element auf oberster Ebene erlaubt (FLX-BD-001). Erscheint typischerweise nach den Hauptartikeln.\n" ;
	laws:xml_element "akn:proviso" ;
	laws:xsd_content_model "choice" .
laws:Ref a owl:Class ;
	rdfs:label "Ref" ;
	rdfs:subClassOf laws:InlineElement , _:c14n10 , _:c14n1028 , _:c14n254 , _:c14n293 , _:c14n316 , _:c14n330 , _:c14n655 , _:c14n699 , _:c14n701 , _:c14n863 , _:c14n893 , _:c14n895 , _:c14n984 , _:c14n990 ;
	skos:definition "An inline reference (akn:ref). Carries @href, and for internal SR cross-references the Fedlex extension attributes fedlex:rs and fedlex:rs-uri.\n" ;
	skos:exactMatch akn:ref ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eine Inline-Referenz (akn:ref). Trägt @href, und bei internen SR-Querverweisen die Fedlex-Erweiterungsattribute fedlex:rs und fedlex:rs-uri.\n" ;
	laws:xml_element "akn:ref" .
laws:References a owl:Class ;
	rdfs:label "References" ;
	rdfs:subClassOf _:c14n1016 , _:c14n168 , _:c14n201 , _:c14n319 , _:c14n338 , _:c14n349 , _:c14n36 , _:c14n396 , _:c14n626 , _:c14n727 , _:c14n845 , _:c14n877 , _:c14n908 , _:c14n91 , _:c14n912 , _:c14n939 ;
	skos:definition "Named reference definitions used across the document (akn:references). Defines organizations, roles, and other entities that are referenced by anchor (@href='#eId') elsewhere in the document.\n" ;
	skos:exactMatch akn:references ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Benannte Referenz-Definitionen für das gesamte Dokument (akn:references). Definiert Organisationen, Rollen und andere Entitäten, die über Anker (@href='#eId') referenziert werden.\n" ;
	laws:xml_element "akn:references" .
laws:Role a owl:Class ;
