	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Geordneter gemischter Inhalt: eine Folge aus Textabschnitten und Inline-Markup-Elementen (InlineElement-Subklassen). Die Dokumentreihenfolge wird durch die Listenreihenfolge bewahrt.\n" ;
	laws:xsd_mixed "true" .
