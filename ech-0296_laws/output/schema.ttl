            owl:onProperty laws:table_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:table_cells ] ;
    skos:definition "A row in an AkomaNtoso table (akn:tr)." ;
    skos:exactMatch akn:tr ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Eine Zeile in einer AkomaNtoso-Tabelle (akn:tr)." ;
    laws:xml_element "akn:tr" .

laws:TemporalData a owl:Class ;
    rdfs:label "TemporalData" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:TemporalGroup ;
            owl:onProperty laws:temporal_groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:temporal_groups ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:source ] ;
    skos:definition """The temporal groups a modification refers to. Each group holds the interval during which it applies.
""" ;
    skos:exactMatch akn:temporalData ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Die Zeitgruppen, auf die sich eine Änderung bezieht. Jede Gruppe hält das Intervall, in dem sie gilt.
""" ;
    laws:xml_element "akn:temporalData" .

laws:TemporalGroup a owl:Class ;
    rdfs:label "TemporalGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:time_intervals ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:TimeInterval ;
            owl:onProperty laws:time_intervals ] ;
    skos:definition "A named period, referred to by a modification through @period." ;
    skos:exactMatch akn:temporalGroup ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein benannter Zeitraum, auf den sich eine Änderung über @period bezieht." ;
    laws:xml_element "akn:temporalGroup" .

laws:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:start_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:end_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:end_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:start_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:refers_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:refers_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:refers_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:end_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:start_ref ] ;
    skos:definition """An interval between two dates. Start and end name date elements in the document by anchor rather than carrying the date themselves; an empty end means the interval is still open.
""" ;
    skos:exactMatch akn:timeInterval ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Intervall zwischen zwei Daten. Anfang und Ende benennen Datumselemente im Dokument über einen Anker, statt das Datum selbst zu tragen; ein leeres Ende heisst, dass das Intervall offen ist.
""" ;
    laws:xml_element "akn:timeInterval" .

laws:Transitional a owl:Class ;
    rdfs:label "Transitional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Paragraph ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ] ;
    skos:definition """A transitional provision in the body of an act (akn:transitional). Permitted as a top-level body element (FLX-BD-001). Structure follows article conventions.
""" ;
    skos:exactMatch akn:transitional ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Übergangsbestimmung im Hauptteil eines Erlasses (akn:transitional). Als Hauptteil-Element auf oberster Ebene erlaubt (FLX-BD-001). Struktur wie Artikel.
""" ;
    laws:xml_element "akn:transitional" ;
    laws:xsd_content_model "choice" .

