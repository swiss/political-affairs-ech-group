	rdfs:subClassOf laws:Modification , _:c14n1017 , _:c14n1037 , _:c14n123 , _:c14n127 , _:c14n159 , _:c14n197 , _:c14n273 , _:c14n3 , _:c14n422 , _:c14n586 , _:c14n725 , _:c14n729 , _:c14n784 , _:c14n797 , _:c14n810 , _:c14n942 , _:c14n954 ;
