""" ;
    skos:exactMatch akn:title ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Titel-Ebene eines Erlasses (akn:title). Erlaubte Kinder: book, part, chapter, subchapter, section, subsection, level (FLX-HR-001-ti). Benötigt eindeutiges @eId (FLX-HR-002-ti).
""" ;
    laws:schematron_rules "FLX-HR-001-ti, FLX-HR-002-ti" ;
    laws:xml_element "akn:title" ;
    laws:xsd_content_model "choice" .

laws:Paragraph a owl:Class ;
    rdfs:label "Paragraph" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:content_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:content_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Content ;
            owl:onProperty laws:content_ref ] ;
    skos:definition """A paragraph within an article or subdivision (akn:paragraph). Constraints (FLX-PR-*): - only heading elements and akn:content are allowed as children (FLX-PR-001) - only permitted as a direct child of akn:article or akn:subdivision (FLX-PR-002) - requires unique @eId (FLX-PR-003)
""" ;
    skos:exactMatch akn:paragraph ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Absatz innerhalb eines Artikels oder Unterabschnitts (akn:paragraph). Constraints (FLX-PR-*): - nur Überschriften-Elemente und akn:content als Kinder erlaubt (FLX-PR-001) - nur als direktes Kind von akn:article oder akn:subdivision erlaubt (FLX-PR-002) - benötigt eindeutiges @eId (FLX-PR-003)
""" ;
    laws:schematron_rules """FLX-PR-001: content restricted; FLX-PR-002: only in article/subdivision; FLX-PR-003: eId required
""" ;
    laws:xml_element "akn:paragraph" .

