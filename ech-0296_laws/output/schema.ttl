@prefix akn: <http://docs.oasis-open.org/legaldocml/ns/akn/3.0/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix jolux: <http://data.legilux.public.lu/resource/ontology/jolux#> .
@prefix laws: <https://ld.ech.ch/schema/0296/laws/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ld.ech.ch/schema/0296/laws.owl.ttl> a owl:Ontology ;
    rdfs:label "ech-0296-laws-schema" ;
    dcterms:license "CC-BY" ;
    dcterms:title "eCH-0296 Erlasse und Gesetzestexte" ;
    skos:definition """LinkML schema for the Fedlex-specific subset of AkomaNtoso 3.0 covering Swiss federal law texts (eCH-0296). Models the full document structure (act, FRBR metadata, preface, body, legislative hierarchy, article content) and encodes all Fedlex Schematron constraints (AKN-fedlex-1.sch) as annotations. Intended for documentation generation and as the basis for a Fedlex-conformant XSD.
""" ;
    laws:description_de """LinkML-Schema für das Fedlex-spezifische Subset von AkomaNtoso 3.0 für schweizerische Bundeserlasse (eCH-0296). Modelliert die vollständige Dokumentenstruktur (act, FRBR-Metadaten, Vorspann, Hauptteil, Gesetzeshierarchie, Artikelinhalt) und kodiert alle Fedlex-Schematron-Constraints (AKN-fedlex-1.sch) als Annotierungen.
""" .

laws:FedlexDocument a owl:Class ;
    rdfs:label "FedlexDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Act ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:act_ref ] ;
    skos:definition """Root element of a Fedlex AkomaNtoso document (akn:akomaNtoso). Must contain exactly one akn:act element and no other children (FLX-RT-001). Carries the AkomaNtoso namespace declaration and the Fedlex extension namespace.
""" ;
    skos:exactMatch akn:akomaNtoso ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Wurzelelement eines Fedlex AkomaNtoso-Dokuments (akn:akomaNtoso). Muss genau ein akn:act-Element enthalten, keine weiteren Kinder (FLX-RT-001). Trägt die AkomaNtoso-Namespace-Deklaration und den Fedlex-Erweiterungs-Namespace.
""" ;
    laws:schematron_rule "FLX-RT-001: The document root should only contain an act" ;
    laws:xml_element "akn:akomaNtoso" ;
    laws:xml_namespace "http://docs.oasis-open.org/legaldocml/ns/akn/3.0" ;
    laws:xml_namespace_fedlex "http://fedlex.admin.ch/" .

laws:block_lists a owl:ObjectProperty ;
    rdfs:label "block_lists" ;
    rdfs:range laws:BlockList ;
    skos:definition "Block list elements (akn:blockList) within content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Auflistungs-Elemente (akn:blockList) innerhalb von Content." .

laws:block_paragraphs a owl:ObjectProperty ;
    rdfs:label "block_paragraphs" ;
    rdfs:range laws:BlockParagraph ;
    skos:definition "Block paragraph elements (akn:p) within content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Block-Absatz-Elemente (akn:p) innerhalb von Content." .

laws:tables a owl:ObjectProperty ;
    rdfs:label "tables" ;
    rdfs:range laws:Table ;
    skos:definition "Table elements (akn:table) within content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Tabellen-Elemente (akn:table) innerhalb von Content." .

<https://ld.ech.ch/schema/0296/laws/ContainerNameEnum#headerOfAnnex> a owl:Class ;
    rdfs:label "headerOfAnnex" ;
    rdfs:subClassOf laws:ContainerNameEnum ;
    skos:definition "Heading area of an annex." ;
    laws:description_de "Kopfbereich eines Anhangs." .

<https://ld.ech.ch/schema/0296/laws/DocNameEnum#annex> a owl:Class ;
    rdfs:label "annex" ;
    rdfs:subClassOf laws:DocNameEnum ;
    skos:definition "An annex to the act." ;
    laws:description_de "Ein Anhang zum Erlass." .

eli:Format a owl:Class ;
    rdfs:label "FRBRManifestation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty eli:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FormatType ;
            owl:onProperty eli:format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eli:format ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ] ;
    skos:definition """FRBR Manifestation level (akn:FRBRManifestation): a specific file format of the expression. For Fedlex XML files the format value is 'xml'. The optional fedlex:generator attribute is only permitted here (FLX-XF-002).
""" ;
    skos:exactMatch akn:FRBRManifestation,
        laws:FRBRManifestation ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Manifestations-Ebene (akn:FRBRManifestation): ein spezifisches Dateiformat der Expression. Für Fedlex XML-Dateien ist der Formatwert 'xml'. Das optionale Attribut fedlex:generator ist nur hier erlaubt (FLX-XF-002).
""" ;
    laws:schematron_note "FLX-XF-002: fedlex:generator only allowed on FRBRformat[@value='xml']" ;
    laws:xml_element "akn:FRBRManifestation" .

eli:LegalExpression a owl:Class ;
    rdfs:label "FRBRExpression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eli:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:LanguageType ;
            owl:onProperty eli:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty eli:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ] ;
    skos:definition """FRBR Expression level (akn:FRBRExpression): a specific language version of the legislative text. Identified by an ELI URI that includes the language code.
""" ;
    skos:exactMatch akn:FRBRExpression,
        laws:FRBRExpression ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Expression-Ebene (akn:FRBRExpression): eine sprachspezifische Version des Erlasses. Identifiziert durch einen ELI-URI mit Sprachcode.
""" ;
    laws:xml_element "akn:FRBRExpression" .

eli:LegalResource a owl:Class ;
    rdfs:label "FRBRWork" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRName ;
            owl:onProperty laws:frbr_names ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_names ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty eli:number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_subtype ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty eli:number ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty eli:number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_subtype ] ;
    skos:definition """FRBR Work level (akn:FRBRWork): the abstract legislative text independent of language or version. Contains ELI URIs, Fedlex/JoLux dates, authors, country code (CH), SR number, and multilingual names with short forms.
""" ;
    skos:exactMatch akn:FRBRWork,
        laws:FRBRWork ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Work-Ebene (akn:FRBRWork): der abstrakte Erlass unabhängig von Sprache und Version. Enthält ELI-URIs, Fedlex/JoLux-Daten, Autoren, Ländercode (CH), SR-Nummer und mehrsprachige Namen mit Kurzformen.
""" ;
    laws:xml_element "akn:FRBRWork" .

jolux:dateApplicability a owl:Class ;
    rdfs:label "jolux:dateApplicability" ;
    rdfs:subClassOf laws:FrbrDateNameEnum ;
    skos:definition """Date up to which the consolidated version reflects the law -- the 'Stand am' of the Fedlex delivery.
""" ;
    skos:exactMatch eli:date_applicability ;
    laws:description_de """Datum, auf das die konsolidierte Fassung nachgeführt ist — der „Stand am“ der Fedlex-Auslieferung.
""" .

jolux:dateDocument a owl:Class ;
    rdfs:label "jolux:dateDocument" ;
    rdfs:subClassOf laws:FrbrDateNameEnum ;
    skos:definition "Date of adoption or signature of the act." ;
    skos:exactMatch eli:date_document ;
    laws:description_de "Datum der Verabschiedung oder Unterzeichnung des Erlasses." .

jolux:dateEntryInForce a owl:Class ;
    rdfs:label "jolux:dateEntryInForce" ;
    rdfs:subClassOf laws:FrbrDateNameEnum ;
    skos:definition "Date on which the act, or its first part, came into force." ;
    skos:exactMatch eli:first_date_entry_in_force ;
    laws:description_de "Datum, an dem der Erlass oder sein erster Teil in Kraft trat." .

laws:ActBody a owl:Class ;
    rdfs:label "ActBody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Section ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Transitional ;
            owl:onProperty laws:transitionals ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Proviso ;
            owl:onProperty laws:provisos ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:component_refs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:status ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ComponentRef ;
            owl:onProperty laws:component_refs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Title ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subsection ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:provisos ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:period ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subchapter ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:transitionals ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Chapter ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Part ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Book ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:status ] ;
    skos:definition """The main body of the act (akn:body), containing the legislative hierarchy. Allowed direct children are restricted to: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. No other elements are permitted (FLX-BD-001).
""" ;
    skos:exactMatch akn:body ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Hauptteil des Erlasses (akn:body) mit der Gesetzeshierarchie. Erlaubte direkte Kinder: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. Keine anderen Elemente erlaubt (FLX-BD-001).
""" ;
    laws:schematron_rule "FLX-BD-001: Illegal element in body — only the listed hierarchy elements are permitted" ;
    laws:xml_element "akn:body" ;
    laws:xsd_content_model "choice" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#amendment> a owl:Class ;
    rdfs:label "amendment" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "An amending act" ;
    laws:description_de "Eine Änderung" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#constitution> a owl:Class ;
    rdfs:label "constitution" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A constitutional act" ;
    laws:description_de "Eine Verfassung" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#privateAct> a owl:Class ;
    rdfs:label "privateAct" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A private law act" ;
    laws:description_de "Ein Erlass des Privatrechts" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#publicLaw> a owl:Class ;
    rdfs:label "publicLaw" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A public law act" ;
    laws:description_de "Ein Erlass des öffentlichen Rechts" .

laws:ActiveModifications a owl:Class ;
    rdfs:label "ActiveModifications" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:modifications ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Modification ;
            owl:onProperty laws:modifications ] ;
    skos:definition "The modifications this act makes to others." ;
    skos:exactMatch akn:activeModifications ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die Änderungen, die dieser Erlass an anderen vornimmt." ;
    laws:xml_element "akn:activeModifications" .

laws:Analysis a owl:Class ;
    rdfs:label "Analysis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:ActiveModifications ;
            owl:onProperty laws:active_modifications ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:passive_modifications ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:PassiveModifications ;
            owl:onProperty laws:passive_modifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:active_modifications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:passive_modifications ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:active_modifications ] ;
    skos:definition """The analysis block: which modifications this act makes and receives. Fedlex does not use it; cantonal collections record their amendments here.
""" ;
    skos:exactMatch akn:analysis ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Analyseblock: welche Änderungen dieser Erlass vornimmt und erfährt. Fedlex verwendet ihn nicht; kantonale Sammlungen halten hier ihre Änderungen fest.
""" ;
    laws:xml_element "akn:analysis" .

laws:Attachment a owl:Class ;
    rdfs:label "Attachment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Act ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:act_ref ] ;
    skos:definition "A single attached document." ;
    skos:exactMatch akn:attachment ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein einzelnes beigefügtes Dokument." ;
    laws:xml_element "akn:attachment" .

laws:Attachments a owl:Class ;
    rdfs:label "Attachments" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Attachment ;
            owl:onProperty laws:attachment_list ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:attachment_list ] ;
    skos:definition "Documents attached to the act." ;
    skos:exactMatch akn:attachments ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Dem Erlass beigefügte Dokumente." ;
    laws:xml_element "akn:attachments" .

laws:Block a owl:Class ;
    rdfs:label "Block" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockNameEnum ;
            owl:onProperty laws:block_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:block_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ] ;
    skos:definition "A generic block (akn:block) whose @name states its purpose; carries mixed content." ;
    skos:exactMatch akn:block ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein generischer Block (akn:block), dessen @name den Zweck nennt; trägt gemischten Inhalt." ;
    laws:xml_element "akn:block" .

laws:BlockListItem a owl:Class ;
    rdfs:label "BlockListItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
