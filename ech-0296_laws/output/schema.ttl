laws:FRBRName a owl:Class ;
    rdfs:label "FRBRName" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:xml_lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:short_form ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:value ],
