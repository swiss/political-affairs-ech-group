<https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#heading> a owl:Class ;
    rdfs:label "heading" ;
    rdfs:subClassOf laws:FedlexRoleEnum ;
    skos:definition """Marks a paragraph as a heading; found on akn:p in the preamble of the Federal Constitution. Outside the reach of FLX-XF-003, which governs akn:level and akn:subheading.
""" ;
    laws:description_de """Kennzeichnet einen Absatz als Überschrift; kommt an akn:p in der Präambel der Bundesverfassung vor. Ausserhalb der Reichweite von FLX-XF-003, die akn:level und akn:subheading regelt.
""" .

<https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#marginal> a owl:Class ;
    rdfs:label "marginal" ;
    rdfs:subClassOf laws:FedlexRoleEnum ;
    skos:definition "Marks a level as a marginal note. Only allowed on akn:level (FLX-XF-004)." ;
    laws:description_de "Kennzeichnet ein level als Randnote. Nur bei akn:level erlaubt (FLX-XF-004)." .

<https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#reference> a owl:Class ;
    rdfs:label "reference" ;
    rdfs:subClassOf laws:FedlexRoleEnum ;
    skos:definition "Marks a subheading as a reference heading. Only allowed on akn:subheading (FLX-XF-005)." ;
    laws:description_de """Kennzeichnet eine Unterüberschrift als Referenzüberschrift. Nur bei akn:subheading erlaubt (FLX-XF-005).
""" .

laws:FormatType a owl:Class ;
