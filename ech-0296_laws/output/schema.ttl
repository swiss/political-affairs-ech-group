@prefix akn: <http://docs.oasis-open.org/legaldocml/ns/akn/3.0/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix laws: <https://ld.ech.ch/schema/0296/laws/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ld.ech.ch/schema/0296/laws.owl.ttl> a owl:Ontology ;
    rdfs:label "ech-0296-laws-schema" ;
    dcterms:license "CC-BY" ;
    dcterms:title "eCH-0296 Erlasse und Gesetzestexte" ;
    skos:definition """LinkML schema for the Fedlex-specific subset of AkomaNtoso 3.0 covering Swiss federal law texts (eCH-0296). Models the full document structure (act, FRBR metadata, preface, body, legislative hierarchy, article content) and encodes all Fedlex Schematron constraints (AKN-fedlex-1.sch) as annotations. Intended for documentation generation and as the basis for a Fedlex-conformant XSD.
""" ;
    laws:description_de """LinkML-Schema für das Fedlex-spezifische Subset von AkomaNtoso 3.0 für schweizerische Bundeserlasse (eCH-0296). Modelliert die vollständige Dokumentenstruktur (act, FRBR-Metadaten, Vorspann, Hauptteil, Gesetzeshierarchie, Artikelinhalt) und kodiert alle Fedlex-Schematron-Constraints (AKN-fedlex-1.sch) als Annotierungen.
""" .

laws:FedlexDocument a owl:Class ;
    rdfs:label "FedlexDocument" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Act ;
            owl:onProperty laws:act_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:act_ref ] ;
    skos:definition """Root element of a Fedlex AkomaNtoso document (akn:akomaNtoso). Must contain exactly one akn:act element and no other children (FLX-RT-001). Carries the AkomaNtoso namespace declaration and the Fedlex extension namespace.
""" ;
    skos:exactMatch akn:akomaNtoso ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Wurzelelement eines Fedlex AkomaNtoso-Dokuments (akn:akomaNtoso). Muss genau ein akn:act-Element enthalten, keine weiteren Kinder (FLX-RT-001). Trägt die AkomaNtoso-Namespace-Deklaration und den Fedlex-Erweiterungs-Namespace.
""" ;
    laws:schematron_rule "FLX-RT-001: The document root should only contain an act" ;
    laws:xml_element "akn:akomaNtoso" ;
    laws:xml_namespace "http://docs.oasis-open.org/legaldocml/ns/akn/3.0" ;
    laws:xml_namespace_fedlex "http://fedlex.admin.ch/" .

laws:Act a owl:Class ;
    rdfs:label "Act" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Preface ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Preamble ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActBody ;
            owl:onProperty laws:body ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActTypeEnum ;
            owl:onProperty laws:act_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preamble_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ActMeta ;
            owl:onProperty laws:meta ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:preface_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preface_ref ] ;
    skos:definition """The legislative act element (akn:act). Main content container of an AkomaNtoso document. The @name attribute specifies the type of act (e.g. 'publicLaw').
""" ;
    skos:exactMatch akn:act ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Das Erlasselement (akn:act). Hauptinhaltselement eines AkomaNtoso-Dokuments. Das @name-Attribut gibt den Erlasstyp an (z.B. 'publicLaw').
""" ;
    laws:xml_element "akn:act" .

laws:ActBody a owl:Class ;
    rdfs:label "ActBody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subsection ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subsections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Proviso ;
            owl:onProperty laws:provisos ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Book ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Section ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Subchapter ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:transitionals ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:sections ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subchapters ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Transitional ;
            owl:onProperty laws:transitionals ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Chapter ;
            owl:onProperty laws:chapters ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:books ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:provisos ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Title ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:titles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:parts ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Part ;
            owl:onProperty laws:parts ] ;
    skos:definition """The main body of the act (akn:body), containing the legislative hierarchy. Allowed direct children are restricted to: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. No other elements are permitted (FLX-BD-001).
""" ;
    skos:exactMatch akn:body ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Hauptteil des Erlasses (akn:body) mit der Gesetzeshierarchie. Erlaubte direkte Kinder: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. Keine anderen Elemente erlaubt (FLX-BD-001).
""" ;
    laws:schematron_rule "FLX-BD-001: Illegal element in body — only the listed hierarchy elements are permitted" ;
    laws:xml_element "akn:body" ;
    laws:xsd_content_model "choice" .

laws:ActMeta a owl:Class ;
    rdfs:label "ActMeta" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:references_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Identification ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:References ;
            owl:onProperty laws:references_ref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:identification_ref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:references_ref ] ;
    skos:definition """Metadata section of the act (akn:meta). Contains FRBR identification (Work, Expression, Manifestation levels) and named reference definitions.
""" ;
    skos:exactMatch akn:meta ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Metadaten-Abschnitt des Erlasses (akn:meta). Enthält die FRBR-Identifikation (Work-, Expression-, Manifestations-Ebene) sowie benannte Referenz-Definitionen.
""" ;
    laws:xml_element "akn:meta" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#amendment> a owl:Class ;
    rdfs:label "amendment" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "An amending act" ;
    laws:description_de "Eine Änderung" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#constitution> a owl:Class ;
    rdfs:label "constitution" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A constitutional act" ;
    laws:description_de "Eine Verfassung" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#privateAct> a owl:Class ;
    rdfs:label "privateAct" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A private law act" ;
    laws:description_de "Ein Erlass des Privatrechts" .

<https://ld.ech.ch/schema/0296/laws/ActTypeEnum#publicLaw> a owl:Class ;
    rdfs:label "publicLaw" ;
    rdfs:subClassOf laws:ActTypeEnum ;
    skos:definition "A public law act" ;
    laws:description_de "Ein Erlass des öffentlichen Rechts" .

laws:BlockListItem a owl:Class ;
    rdfs:label "BlockListItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockList ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockParagraph ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ] ;
    skos:definition """A single item in a block list (akn:item). Carries a num label and block content directly: prose paragraphs (akn:p) and optionally nested block lists.
""" ;
    skos:exactMatch akn:item ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein einzelner Punkt in einer Auflistung (akn:item). Trägt ein num-Label und Block-Inhalt direkt: Fliesstext-Absätze (akn:p) und optional verschachtelte Listen.
""" ;
    laws:xml_element "akn:item" ;
    laws:xsd_content_model "choice" .

<https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#de> a owl:Class ;
    rdfs:label "de" ;
    rdfs:subClassOf laws:DocumentLanguageEnum ;
    skos:definition "German" ;
    laws:description_de "Deutsch" .

<https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#en> a owl:Class ;
    rdfs:label "en" ;
    rdfs:subClassOf laws:DocumentLanguageEnum ;
    skos:definition "English" ;
    laws:description_de "Englisch" .

<https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#fr> a owl:Class ;
    rdfs:label "fr" ;
    rdfs:subClassOf laws:DocumentLanguageEnum ;
    skos:definition "French" ;
    laws:description_de "Französisch" .

<https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#it> a owl:Class ;
    rdfs:label "it" ;
    rdfs:subClassOf laws:DocumentLanguageEnum ;
    skos:definition "Italian" ;
    laws:description_de "Italienisch" .

<https://ld.ech.ch/schema/0296/laws/DocumentLanguageEnum#rm> a owl:Class ;
    rdfs:label "rm" ;
    rdfs:subClassOf laws:DocumentLanguageEnum ;
    skos:definition "Romansh" ;
    laws:description_de "Rätoromanisch" .

laws:FRBRExpression a owl:Class ;
    rdfs:label "FRBRExpression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:LanguageType ;
            owl:onProperty laws:frbr_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ] ;
    skos:closeMatch eli:LegalExpression ;
    skos:definition """FRBR Expression level (akn:FRBRExpression): a specific language version of the legislative text. Identified by an ELI URI that includes the language code.
""" ;
    skos:exactMatch akn:FRBRExpression ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Expression-Ebene (akn:FRBRExpression): eine sprachspezifische Version des Erlasses. Identifiziert durch einen ELI-URI mit Sprachcode.
""" ;
    laws:xml_element "akn:FRBRExpression" .

laws:FRBRManifestation a owl:Class ;
    rdfs:label "FRBRManifestation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FormatType ;
            owl:onProperty laws:frbr_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ] ;
    skos:closeMatch eli:Format ;
    skos:definition """FRBR Manifestation level (akn:FRBRManifestation): a specific file format of the expression. For Fedlex XML files the format value is 'xml'. The optional fedlex:generator attribute is only permitted here (FLX-XF-002).
""" ;
    skos:exactMatch akn:FRBRManifestation ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Manifestations-Ebene (akn:FRBRManifestation): ein spezifisches Dateiformat der Expression. Für Fedlex XML-Dateien ist der Formatwert 'xml'. Das optionale Attribut fedlex:generator ist nur hier erlaubt (FLX-XF-002).
""" ;
    laws:schematron_note "FLX-XF-002: fedlex:generator only allowed on FRBRformat[@value='xml']" ;
    laws:xml_element "akn:FRBRManifestation" .

laws:FRBRName a owl:Class ;
    rdfs:label "FRBRName" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:xml_lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:xml_lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:short_form ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:xml_lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:short_form ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:short_form ] ;
    skos:closeMatch eli:title ;
    skos:definition """A multilingual name entry for the FRBR Work (akn:FRBRname). Carries the full official name and an optional abbreviation. One entry per language.
""" ;
    skos:exactMatch akn:FRBRname ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein mehrsprachiger Namenseintrag des FRBR-Works (akn:FRBRname). Enthält den offiziellen Langtitel und eine optionale Abkürzung. Ein Eintrag pro Sprache.
""" ;
    laws:xml_element "akn:FRBRname" .

laws:FRBRWork a owl:Class ;
    rdfs:label "FRBRWork" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRDate ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_names ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_dates ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRAuthor ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_authors ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:ValueType ;
            owl:onProperty laws:frbr_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_authoritative ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_country ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:UriValueType ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRName ;
            owl:onProperty laws:frbr_names ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_this ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_this ] ;
    skos:closeMatch eli:LegalResource ;
    skos:definition """FRBR Work level (akn:FRBRWork): the abstract legislative text independent of language or version. Contains ELI URIs, Fedlex/JoLux dates, authors, country code (CH), SR number, and multilingual names with short forms.
""" ;
    skos:exactMatch akn:FRBRWork ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Work-Ebene (akn:FRBRWork): der abstrakte Erlass unabhängig von Sprache und Version. Enthält ELI-URIs, Fedlex/JoLux-Daten, Autoren, Ländercode (CH), SR-Nummer und mehrsprachige Namen mit Kurzformen.
""" ;
    laws:xml_element "akn:FRBRWork" .

<https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#marginal> a owl:Class ;
    rdfs:label "marginal" ;
    rdfs:subClassOf laws:FedlexRoleEnum ;
    skos:definition "Marks a level as a marginal note. Only allowed on akn:level (FLX-XF-004)." ;
    laws:description_de "Kennzeichnet ein level als Randnote. Nur bei akn:level erlaubt (FLX-XF-004)." .

<https://ld.ech.ch/schema/0296/laws/FedlexRoleEnum#reference> a owl:Class ;
    rdfs:label "reference" ;
    rdfs:subClassOf laws:FedlexRoleEnum ;
    skos:definition "Marks a subheading as a reference heading. Only allowed on akn:subheading (FLX-XF-005)." ;
    laws:description_de """Kennzeichnet eine Unterüberschrift als Referenzüberschrift. Nur bei akn:subheading erlaubt (FLX-XF-005).
""" .

laws:FormatType a owl:Class ;
    rdfs:label "FormatType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_generator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_generator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:fedlex_generator ] ;
    skos:definition """A holder for akn:FRBRformat: a @value (typically 'xml') plus the optional fedlex:generator extension attribute (FLX-XF-002).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Halter für akn:FRBRformat: ein @value (typischerweise 'xml') plus das optionale Erweiterungsattribut fedlex:generator (FLX-XF-002).
""" .

laws:Identification a owl:Class ;
    rdfs:label "Identification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRManifestation ;
            owl:onProperty laws:frbr_manifestation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_manifestation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_work ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRWork ;
            owl:onProperty laws:frbr_work ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_work ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_manifestation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:frbr_expression ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:FRBRExpression ;
            owl:onProperty laws:frbr_expression ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:frbr_expression ] ;
    skos:definition """FRBR identification block (akn:identification) grouping Work, Expression, and Manifestation descriptions. The @source attribute references the responsible organization as an intra-document anchor (e.g. '#ch.bk').
""" ;
    skos:exactMatch akn:identification ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """FRBR-Identifikationsblock (akn:identification) mit Work-, Expression- und Manifestations-Beschreibungen. Das @source-Attribut referenziert die verantwortliche Organisation als Dokument-internen Anker (z.B. '#ch.bk').
""" ;
    laws:xml_element "akn:identification" .

laws:LanguageType a owl:Class ;
    rdfs:label "LanguageType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:language_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:DocumentLanguageEnum ;
            owl:onProperty laws:language_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:language_value ] ;
    skos:definition "A holder carrying a single @language attribute (akn:FRBRlanguage)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Halter mit einem einzelnen @language-Attribut (akn:FRBRlanguage)." .

laws:Preamble a owl:Class ;
    rdfs:label "Preamble" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockParagraph ;
            owl:onProperty laws:block_paragraphs ] ;
    skos:definition """The preamble of the act (akn:preamble), containing introductory prose paragraphs preceding the operative body.
""" ;
    skos:exactMatch akn:preamble ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Die Präambel des Erlasses (akn:preamble) mit einleitenden Fliesstext-Absätzen vor dem Hauptteil.
""" ;
    laws:xml_element "akn:preamble" .

laws:Preface a owl:Class ;
    rdfs:label "Preface" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:preface_paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:PrefaceP ;
            owl:onProperty laws:preface_paragraphs ] ;
    skos:definition """The preface of the act (akn:preface), containing the document number and title. Fedlex Schematron requires both akn:docNumber (FLX-PF-001) and akn:docTitle (FLX-PF-002) to be present inside a akn:p element.
""" ;
    skos:exactMatch akn:preface ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Vorspann des Erlasses (akn:preface) mit Dokumentnummer und -titel. Fedlex Schematron verlangt akn:docNumber (FLX-PF-001) und akn:docTitle (FLX-PF-002) innerhalb eines akn:p-Elements.
""" ;
    laws:schematron_rules "FLX-PF-001: Missing docNumber; FLX-PF-002: Missing docTitle" ;
    laws:xml_element "akn:preface" .

laws:PrefaceP a owl:Class ;
    rdfs:label "PrefaceP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:doc_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:doc_title ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:doc_number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:doc_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:doc_number ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:doc_title ] ;
    skos:definition """A preface paragraph (akn:p) that wraps the document number and/or title. Fedlex requires akn:docNumber and akn:docTitle to sit inside a akn:p of the preface (FLX-PF-001/002).
""" ;
    skos:exactMatch akn:p ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Vorspann-Absatz (akn:p), der Dokumentnummer und/oder -titel umschliesst. Fedlex verlangt akn:docNumber und akn:docTitle innerhalb eines akn:p des Vorspanns (FLX-PF-001/002).
""" ;
    laws:xml_element "akn:p" ;
    laws:xsd_mixed "true" .

laws:Proviso a owl:Class ;
    rdfs:label "Proviso" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Paragraph ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ] ;
    skos:definition """A proviso in the body of an act (akn:proviso). Permitted as a top-level body element (FLX-BD-001). Typically appears after the main articles.
""" ;
    skos:exactMatch akn:proviso ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Vorbehalt im Hauptteil eines Erlasses (akn:proviso). Als Hauptteil-Element auf oberster Ebene erlaubt (FLX-BD-001). Erscheint typischerweise nach den Hauptartikeln.
""" ;
    laws:xml_element "akn:proviso" ;
    laws:xsd_content_model "choice" .

laws:References a owl:Class ;
    rdfs:label "References" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:TLCReference ;
            owl:onProperty laws:tlc_references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:tlc_organizations ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:TLCOrganization ;
            owl:onProperty laws:tlc_organizations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:tlc_roles ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:TLCRole ;
            owl:onProperty laws:tlc_roles ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:tlc_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:source ] ;
    skos:definition """Named reference definitions used across the document (akn:references). Defines organizations, roles, and other entities that are referenced by anchor (@href='#eId') elsewhere in the document.
""" ;
    skos:exactMatch akn:references ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Benannte Referenz-Definitionen für das gesamte Dokument (akn:references). Definiert Organisationen, Rollen und andere Entitäten, die über Anker (@href='#eId') referenziert werden.
""" ;
    laws:xml_element "akn:references" .

laws:Subdivision a owl:Class ;
    rdfs:label "Subdivision" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:subheading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Paragraph ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ] ;
    skos:definition """A subdivision within an article grouping related paragraphs (akn:subdivision). Constraints (FLX-SD-*): - only heading elements and akn:paragraph are allowed as children (FLX-SD-001) - only permitted as a direct child of akn:article, not nested (FLX-SD-002) - requires unique @eId (FLX-SD-003)
""" ;
    skos:exactMatch akn:subdivision ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Unterabschnitt in einem Artikel, der zusammengehörige Absätze gruppiert (akn:subdivision). Constraints (FLX-SD-*): - nur Überschriften-Elemente und akn:paragraph als Kinder erlaubt (FLX-SD-001) - nur als direktes Kind von akn:article erlaubt, keine Verschachtelung (FLX-SD-002) - benötigt eindeutiges @eId (FLX-SD-003)
""" ;
    laws:schematron_rules "FLX-SD-001: content restricted; FLX-SD-002: only in article; FLX-SD-003: eId required" ;
    laws:xml_element "akn:subdivision" ;
    laws:xsd_content_model "choice" .

laws:TLCOrganization a owl:Class ;
    rdfs:label "TLCOrganization" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:show_as ] ;
    skos:definition """A named organization used as a reference throughout the document (akn:TLCOrganization). Example: the Federal Chancellery (ch.bk).
""" ;
    skos:exactMatch akn:TLCOrganization ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine benannte Organisation als Referenz im Dokument (akn:TLCOrganization). Beispiel: die Bundeskanzlei (ch.bk).
""" ;
    laws:xml_element "akn:TLCOrganization" .

laws:TLCReference a owl:Class ;
    rdfs:label "TLCReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:name_attr ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:name_attr ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:name_attr ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ] ;
    skos:definition """A generic named reference in the document (akn:TLCReference). Used for references that do not fit the TLCOrganization or TLCRole categories.
""" ;
    skos:exactMatch akn:TLCReference ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine generische benannte Referenz im Dokument (akn:TLCReference). Für Referenzen, die nicht TLCOrganization oder TLCRole entsprechen.
""" ;
    laws:xml_element "akn:TLCReference" .

laws:TLCRole a owl:Class ;
    rdfs:label "TLCRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:show_as ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ] ;
    skos:definition """A named role used as a reference throughout the document (akn:TLCRole). Examples: publisher, rightsHolder.
""" ;
    skos:exactMatch akn:TLCRole ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine benannte Rolle als Referenz im Dokument (akn:TLCRole). Beispiele: publisher, rightsHolder.
""" ;
    laws:xml_element "akn:TLCRole" .

laws:Table a owl:Class ;
    rdfs:label "Table" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:TableRow ;
            owl:onProperty laws:table_rows ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:table_rows ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:border ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:border ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:border ] ;
    skos:definition """A table element within content (akn:table). Contains rows (akn:tr) with cells (akn:td). Corresponds to the HTML table model.
""" ;
    skos:exactMatch akn:table ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Tabellen-Element innerhalb von Content (akn:table). Enthält Zeilen (akn:tr) mit Zellen (akn:td). Entspricht dem HTML-Tabellenmodell.
""" ;
    laws:xml_element "akn:table" .

laws:TableCell a owl:Class ;
    rdfs:label "TableCell" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockList ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:colspan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockParagraph ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_paragraphs ] ;
    skos:definition """A cell in a table row (akn:td). Contains block content: prose paragraphs (akn:p) and block lists (akn:blockList).
""" ;
    skos:exactMatch akn:td ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Zelle in einer Tabellenzeile (akn:td). Enthält Block-Inhalt: Fliesstext-Absätze (akn:p) und Auflistungen (akn:blockList).
""" ;
    laws:xml_element "akn:td" ;
    laws:xsd_content_model "choice" .

laws:TableRow a owl:Class ;
    rdfs:label "TableRow" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:TableCell ;
            owl:onProperty laws:table_cells ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:table_cells ] ;
    skos:definition "A row in an AkomaNtoso table (akn:tr)." ;
    skos:exactMatch akn:tr ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Eine Zeile in einer AkomaNtoso-Tabelle (akn:tr)." ;
    laws:xml_element "akn:tr" .

laws:Transitional a owl:Class ;
    rdfs:label "Transitional" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:Article ;
            owl:onProperty laws:articles ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Level ;
            owl:onProperty laws:levels ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:eId ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Paragraph ;
            owl:onProperty laws:paragraphs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:MixedText ;
            owl:onProperty laws:heading ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:num ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:articles ] ;
    skos:definition """A transitional provision in the body of an act (akn:transitional). Permitted as a top-level body element (FLX-BD-001). Structure follows article conventions.
""" ;
    skos:exactMatch akn:transitional ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Übergangsbestimmung im Hauptteil eines Erlasses (akn:transitional). Als Hauptteil-Element auf oberster Ebene erlaubt (FLX-BD-001). Struktur wie Artikel.
""" ;
    laws:xml_element "akn:transitional" ;
    laws:xsd_content_model "choice" .

laws:frbr_names a owl:ObjectProperty ;
    rdfs:label "frbr_names" ;
    rdfs:range laws:FRBRName ;
    skos:definition "Multilingual name entries for the FRBR Work (akn:FRBRname). One entry per language." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Mehrsprachige Namenseinträge des FRBR-Works (akn:FRBRname). Ein Eintrag pro Sprache." .

laws:items a owl:ObjectProperty ;
    rdfs:label "items" ;
    rdfs:range laws:BlockListItem ;
    skos:definition "Items in a block list (akn:item)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Punkte einer Auflistung (akn:item)." .

laws:preface_paragraphs a owl:ObjectProperty ;
    rdfs:label "preface_paragraphs" ;
    rdfs:range laws:PrefaceP ;
    skos:definition "The akn:p paragraphs of the preface, wrapping docNumber/docTitle." ;
    skos:exactMatch akn:p ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Die akn:p-Absätze des Vorspanns, die docNumber/docTitle umschliessen." ;
    laws:xml_element "akn:p" .

laws:provisos a owl:ObjectProperty ;
    rdfs:label "provisos" ;
    rdfs:range laws:Proviso ;
    skos:definition "Proviso elements (akn:proviso)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Vorbehalt-Elemente (akn:proviso)." .

laws:subdivisions a owl:ObjectProperty ;
    rdfs:label "subdivisions" ;
    rdfs:range laws:Subdivision ;
    skos:definition "Subdivision child elements (akn:subdivision) within an article." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Unterabschnitt-Kindelemente (akn:subdivision) innerhalb eines Artikels." .

laws:table_cells a owl:ObjectProperty ;
    rdfs:label "table_cells" ;
    rdfs:range laws:TableCell ;
    skos:definition "Cells in a table row (akn:td)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zellen in einer Tabellenzeile (akn:td)." .

laws:table_rows a owl:ObjectProperty ;
    rdfs:label "table_rows" ;
    rdfs:range laws:TableRow ;
    skos:definition "Rows in a table (akn:tr)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Zeilen in einer Tabelle (akn:tr)." .

laws:tables a owl:ObjectProperty ;
    rdfs:label "tables" ;
    rdfs:range laws:Table ;
    skos:definition "Table elements (akn:table) within content." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Tabellen-Elemente (akn:table) innerhalb von Content." .

laws:tlc_organizations a owl:ObjectProperty ;
    rdfs:label "tlc_organizations" ;
    rdfs:range laws:TLCOrganization ;
    skos:definition "Named organization references in the document (akn:TLCOrganization)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Benannte Organisations-Referenzen im Dokument (akn:TLCOrganization)." .

laws:tlc_references a owl:ObjectProperty ;
    rdfs:label "tlc_references" ;
    rdfs:range laws:TLCReference ;
    skos:definition "Generic named references in the document (akn:TLCReference)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Generische benannte Referenzen im Dokument (akn:TLCReference)." .

laws:tlc_roles a owl:ObjectProperty ;
    rdfs:label "tlc_roles" ;
    rdfs:range laws:TLCRole ;
    skos:definition "Named role references in the document (akn:TLCRole)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Benannte Rollen-Referenzen im Dokument (akn:TLCRole)." .

laws:transitionals a owl:ObjectProperty ;
    rdfs:label "transitionals" ;
    rdfs:range laws:Transitional ;
    skos:definition "Transitional provision elements (akn:transitional)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Übergangsbestimmungs-Elemente (akn:transitional)." .

laws:AuthorialNote a owl:Class ;
    rdfs:label "AuthorialNote" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockParagraph ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_paragraphs ],
        laws:InlineElement ;
    skos:definition """An authorial footnote (akn:authorialNote). Recurses into block content: it contains one or more akn:p paragraphs, which themselves carry inline content.
""" ;
    skos:exactMatch akn:authorialNote ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Fussnote des Autors (akn:authorialNote). Rekursiv in Block-Inhalt: enthält ein oder mehrere akn:p-Absätze, die selbst Inline-Inhalt tragen.
""" ;
    laws:xml_element "akn:authorialNote" .

laws:B a owl:Class ;
    rdfs:label "B" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Bold inline markup (akn:b)." ;
    skos:exactMatch akn:b ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Fett-Inline-Markup (akn:b)." ;
    laws:xml_element "akn:b" .

laws:Br a owl:Class ;
    rdfs:label "Br" ;
    rdfs:subClassOf laws:InlineElement ;
    skos:definition """A line break (akn:br). In the (currently disabled) FLX-TXT-001 rule, br is restricted to heading-type elements.
""" ;
    skos:exactMatch akn:br ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Zeilenumbruch (akn:br). In der (derzeit deaktivierten) Regel FLX-TXT-001 ist br auf Überschriften-Elemente beschränkt.
""" ;
    laws:xml_element "akn:br" .

laws:Content a owl:Class ;
    rdfs:label "Content" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockParagraph ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_paragraphs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:tables ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:BlockList ;
            owl:onProperty laws:block_lists ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:Table ;
            owl:onProperty laws:tables ] ;
    skos:definition """The content of a paragraph (akn:content). Contains block-level elements: akn:p (prose), akn:blockList (numbered/lettered lists), akn:table. When used inside a akn:level, must contain an akn:mod element (FLX-HR-003).
""" ;
    skos:exactMatch akn:content ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Der Inhalt eines Absatzes (akn:content). Enthält Block-Elemente: akn:p (Fliesstext), akn:blockList (Aufzählungen), akn:table. Wenn in einem akn:level, muss ein akn:mod-Element enthalten sein (FLX-HR-003).
""" ;
    laws:schematron_note "FLX-HR-003: content in level only allowed for modifications (must contain akn:mod)" ;
    laws:xml_element "akn:content" ;
    laws:xsd_content_model "choice" .

laws:I a owl:Class ;
    rdfs:label "I" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Italic inline markup (akn:i)." ;
    skos:exactMatch akn:i ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Kursiv-Inline-Markup (akn:i)." ;
    laws:xml_element "akn:i" .

laws:Inline a owl:Class ;
    rdfs:label "Inline" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:name_attr ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:name_attr ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:name_attr ],
        laws:InlineElement ;
    skos:definition "A named presentational inline (akn:inline), e.g. name='man-font-style-normal'." ;
    skos:exactMatch akn:inline ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein benanntes präsentationsbezogenes Inline (akn:inline), z.B. name='man-font-style-normal'.
""" ;
    laws:xml_element "akn:inline" .

laws:Placeholder a owl:Class ;
    rdfs:label "Placeholder" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_message ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_message ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:fedlex_message ],
        laws:InlineElement ;
    skos:definition """A placeholder for stripped content (akn:placeholder), carrying the fedlex:message extension attribute (e.g. 'E40S10-TAB').
""" ;
    skos:exactMatch akn:placeholder ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein Platzhalter für entfernten Inhalt (akn:placeholder) mit dem Erweiterungsattribut fedlex:message (z.B. 'E40S10-TAB').
""" ;
    laws:xml_element "akn:placeholder" .

laws:Ref a owl:Class ;
    rdfs:label "Ref" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:href ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:fedlex_rs_uri ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:fedlex_rs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:href ],
        laws:InlineElement ;
    skos:definition """An inline reference (akn:ref). Carries @href, and for internal SR cross-references the Fedlex extension attributes fedlex:rs and fedlex:rs-uri.
""" ;
    skos:exactMatch akn:ref ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Eine Inline-Referenz (akn:ref). Trägt @href, und bei internen SR-Querverweisen die Fedlex-Erweiterungsattribute fedlex:rs und fedlex:rs-uri.
""" ;
    laws:xml_element "akn:ref" .

laws:Span a owl:Class ;
    rdfs:label "Span" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Generic inline span (akn:span)." ;
    skos:exactMatch akn:span ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Generischer Inline-Bereich (akn:span)." ;
    laws:xml_element "akn:span" .

laws:Sup a owl:Class ;
    rdfs:label "Sup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom laws:InlineElement ;
            owl:onProperty laws:inline_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:inline_content ],
        laws:InlineElement ;
    skos:definition "Superscript inline markup (akn:sup)." ;
    skos:exactMatch akn:sup ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Hochgestelltes Inline-Markup (akn:sup)." ;
    laws:xml_element "akn:sup" .

laws:TextRun a owl:Class ;
    rdfs:label "TextRun" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty laws:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty laws:text ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:text ],
        laws:InlineElement ;
    skos:definition """A plain run of character data within mixed content. Emitted as the text node of a mixed complexType, not as an element.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein einfacher Textabschnitt in gemischtem Inhalt. Wird als Textknoten eines mixed-complexType ausgegeben, nicht als Element.
""" .

laws:act_name a owl:ObjectProperty ;
    rdfs:label "act_name" ;
    rdfs:range laws:ActTypeEnum ;
    skos:definition "Type of act (@name attribute of akn:act), e.g. 'publicLaw'." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Erlasstyp (@name-Attribut von akn:act), z.B. 'publicLaw'." ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:act_ref a owl:ObjectProperty ;
    rdfs:label "act_ref" ;
    rdfs:range laws:Act ;
    skos:definition "The legislative act (akn:act). Must be the only child of akn:akomaNtoso (FLX-RT-001)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Der Erlass (akn:act). Muss das einzige Kind von akn:akomaNtoso sein (FLX-RT-001)." ;
    laws:xml_element "akn:act" .

laws:as_role a owl:DatatypeProperty ;
    rdfs:label "as_role" ;
    rdfs:range xsd:string ;
    skos:definition """Role the author plays (akn:FRBRauthor/@as), as an anchor reference, e.g. '#publisher', '#rightsHolder'.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Rolle des Autors (akn:FRBRauthor/@as), als Anker-Referenz, z.B. '#publisher', '#rightsHolder'.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "as" .

laws:body a owl:ObjectProperty ;
    rdfs:label "body" ;
    rdfs:range laws:ActBody ;
    skos:definition "Main body of the act (akn:body)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Hauptteil des Erlasses (akn:body)." .

laws:border a owl:DatatypeProperty ;
    rdfs:label "border" ;
    rdfs:range xsd:string ;
    skos:definition "The @border attribute on akn:table (HTML-style presentation)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Das @border-Attribut auf akn:table (HTML-artige Darstellung)." ;
    laws:xml_attribute "true" .

laws:colspan a owl:DatatypeProperty ;
    rdfs:label "colspan" ;
    rdfs:range xsd:string ;
    skos:definition "The @colspan attribute on akn:td (HTML-style presentation)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Das @colspan-Attribut auf akn:td (HTML-artige Darstellung)." ;
    laws:xml_attribute "true" .

laws:date_value a owl:DatatypeProperty ;
    rdfs:label "date_value" ;
    rdfs:range xsd:date ;
    skos:definition "An ISO 8601 date value (akn:FRBRdate/@date)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ein ISO-8601-Datumswert (akn:FRBRdate/@date)." ;
    laws:xml_attribute "true" ;
    laws:xml_name "date" .

laws:doc_number a owl:DatatypeProperty ;
    rdfs:label "doc_number" ;
    rdfs:range xsd:string ;
    skos:definition """Document number in the preface (akn:docNumber). Required by FLX-PF-001. Typically the SR number, e.g. '101'.
""" ;
    skos:exactMatch akn:docNumber ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Dokumentnummer im Vorspann (akn:docNumber). Pflicht gemäss FLX-PF-001. Typischerweise die SR-Nummer, z.B. '101'.
""" ;
    laws:xml_element "akn:docNumber" .

laws:doc_title a owl:ObjectProperty ;
    rdfs:label "doc_title" ;
    rdfs:range laws:MixedText ;
    skos:definition """Document title in the preface (akn:docTitle). Required by FLX-PF-002. May contain inline markup and akn:br for line breaks.
""" ;
    skos:exactMatch akn:docTitle ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Dokumenttitel im Vorspann (akn:docTitle). Pflicht gemäss FLX-PF-002. Kann Inline-Markup und akn:br für Zeilenumbrüche enthalten.
""" ;
    laws:schematron_note "FLX-TXT-001: br allowed in docTitle (heading context)" ;
    laws:xml_element "akn:docTitle" .

laws:fedlex_generator a owl:DatatypeProperty ;
    rdfs:label "fedlex_generator" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:generator on akn:FRBRformat[@value='xml']. Identifies the tool that generated the XML file. Only allowed on FRBRformat (FLX-XF-002).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:generator bei akn:FRBRformat[@value='xml']. Identifiziert das Werkzeug, das die XML-Datei erzeugt hat. Nur bei FRBRformat erlaubt (FLX-XF-002).
""" ;
    laws:schematron_rule "FLX-XF-002: generator only allowed on FRBRformat[@value='xml']" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:generator" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_message a owl:DatatypeProperty ;
    rdfs:label "fedlex_message" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:message on akn:placeholder, marking stripped content (e.g. 'E40S10-TAB').
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:message auf akn:placeholder, das entfernten Inhalt kennzeichnet (z.B. 'E40S10-TAB').
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:message" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_role a owl:ObjectProperty ;
    rdfs:label "fedlex_role" ;
    rdfs:range laws:FedlexRoleEnum ;
    skos:definition """Fedlex extension attribute fedlex:role. Only two values are permitted (FLX-XF-003): 'marginal' (only on akn:level, FLX-XF-004) and 'reference' (only on akn:subheading, FLX-XF-005).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:role. Nur zwei Werte erlaubt (FLX-XF-003): 'marginal' (nur bei akn:level, FLX-XF-004) und 'reference' (nur bei akn:subheading, FLX-XF-005).
""" ;
    laws:schematron_rules "FLX-XF-003, FLX-XF-004, FLX-XF-005" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:role" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_rs a owl:DatatypeProperty ;
    rdfs:label "fedlex_rs" ;
    rdfs:range xsd:string ;
    skos:definition """Fedlex extension attribute fedlex:rs on akn:ref: the SR number of the referenced law (e.g. '641.20').
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:rs auf akn:ref: die SR-Nummer des referenzierten Erlasses (z.B. '641.20').
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:rs" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:fedlex_rs_uri a owl:DatatypeProperty ;
    rdfs:label "fedlex_rs_uri" ;
    rdfs:range xsd:anyURI ;
    skos:definition """Fedlex extension attribute fedlex:rs-uri on akn:ref: the ELI URI of the referenced law's systematic-collection entry.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Fedlex-Erweiterungsattribut fedlex:rs-uri auf akn:ref: die ELI-URI des SR-Eintrags des referenzierten Erlasses.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "fedlex:rs-uri" ;
    laws:xml_namespace "http://fedlex.admin.ch/" .

laws:frbr_authoritative a owl:ObjectProperty ;
    rdfs:label "frbr_authoritative" ;
    rdfs:range laws:ValueType ;
    skos:closeMatch eli:legal_value ;
    skos:definition "Whether this is the authoritative version (akn:FRBRauthoritative/@value)." ;
    skos:exactMatch akn:FRBRauthoritative ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ob dies die massgebliche Version ist (akn:FRBRauthoritative/@value)." ;
    laws:xml_element "akn:FRBRauthoritative" .

laws:frbr_country a owl:ObjectProperty ;
    rdfs:label "frbr_country" ;
    rdfs:range laws:ValueType ;
    skos:closeMatch eli:jurisdiction ;
    skos:definition "Country code for this legislative text (akn:FRBRcountry/@value), e.g. 'CH'." ;
    skos:exactMatch akn:FRBRcountry ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Ländercode für diesen Erlass (akn:FRBRcountry/@value), z.B. 'CH'." ;
    laws:xml_element "akn:FRBRcountry" .

laws:frbr_date_name a owl:DatatypeProperty ;
    rdfs:label "frbr_date_name" ;
    rdfs:range xsd:string ;
    skos:definition """Type of date (akn:FRBRdate/@name), using Fedlex/JoLux vocabulary, e.g. 'jolux:dateEntryInForce', 'jolux:dateDocument', 'jolux:dateApplicability'.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Datumstyp (akn:FRBRdate/@name), mit Fedlex/JoLux-Vokabular, z.B. 'jolux:dateEntryInForce', 'jolux:dateDocument', 'jolux:dateApplicability'.
""" ;
    laws:xml_attribute "true" ;
    laws:xml_name "name" .

laws:frbr_expression a owl:ObjectProperty ;
    rdfs:label "frbr_expression" ;
    rdfs:range laws:FRBRExpression ;
    skos:definition "FRBR Expression level description (akn:FRBRExpression)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Expression-Ebenen-Beschreibung (akn:FRBRExpression)." .

laws:frbr_format a owl:ObjectProperty ;
    rdfs:label "frbr_format" ;
    rdfs:range laws:FormatType ;
    skos:closeMatch eli:format ;
    skos:definition "File format of this manifestation (akn:FRBRformat/@value), typically 'xml'." ;
    skos:exactMatch akn:FRBRformat ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Dateiformat dieser Manifestation (akn:FRBRformat/@value), typischerweise 'xml'." ;
    laws:xml_element "akn:FRBRformat" .

laws:frbr_language a owl:ObjectProperty ;
    rdfs:label "frbr_language" ;
    rdfs:range laws:LanguageType ;
    skos:closeMatch eli:language ;
    skos:definition "Language code of this expression (akn:FRBRlanguage/@language)." ;
    skos:exactMatch akn:FRBRlanguage ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "Sprachcode dieser Expression (akn:FRBRlanguage/@language)." ;
    laws:xml_element "akn:FRBRlanguage" .

laws:frbr_manifestation a owl:ObjectProperty ;
    rdfs:label "frbr_manifestation" ;
    rdfs:range laws:FRBRManifestation ;
    skos:definition "FRBR Manifestation level description (akn:FRBRManifestation)." ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de "FRBR-Manifestations-Ebenen-Beschreibung (akn:FRBRManifestation)." .

laws:frbr_number a owl:ObjectProperty ;
    rdfs:label "frbr_number" ;
