	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Art des beiliegenden Dokuments (akn:doc/@name)." ;
	laws:xml_attribute "true" ;
	laws:xml_name "name" .
laws:doc_ref a owl:ObjectProperty ;
	rdfs:label "doc_ref" ;
	rdfs:range laws:Doc ;
	skos:definition "The embedded document itself (akn:doc)." ;
	skos:exactMatch akn:doc ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Das beiliegende Dokument selbst (akn:doc)." ;
	laws:xml_element "akn:doc" .
laws:eId a owl:DatatypeProperty ;
	rdfs:label "eId" ;
	rdfs:range xsd:string ;
	skos:definition "Unique element identifier within the document (@eId). Required by Fedlex Schematron on all hierarchical structure elements, articles, subdivisions, and paragraphs. Follows the AKN eId naming convention (hierarchical path notation), e.g. 'ti_1', 'ch_1', 'art_1', 'art_1-para_1'.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eindeutiger Element-Identifier im Dokument (@eId). Vom Fedlex Schematron gefordert bei allen Hierarchieelementen, Artikeln, Unterabschnitten und Absätzen. Folgt der AKN-eId-Namenskonvention (hierarchische Pfadnotation), z.B. 'ti_1', 'ch_1', 'art_1', 'art_1-para_1'.\n" ;
	laws:xml_attribute "true" .
laws:element_type a owl:DatatypeProperty ;
	rdfs:label "element_type" ;
	rdfs:range xsd:string ;
	skos:definition "Type designator discriminating the concrete subclass of an abstract base: InlineElement (TextRun, Ref, B, I, Sup, Span, Br, Inline, Placeholder, AuthorialNote) or BlockElement (BlockParagraph, BlockList, Table).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Typ-Diskriminator für die konkrete Unterklasse einer abstrakten Basis: InlineElement oder BlockElement.\n" .
laws:end_ref a owl:DatatypeProperty ;
	rdfs:label "end_ref" ;
	skos:definition "Anchor of the date on which the interval ends (@end); empty while open." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Anker des Datums, an dem das Intervall endet (@end); leer, solange es offen ist." ;
	laws:xml_attribute "true" ;
	laws:xml_name "end" .
laws:fedlex_generator a owl:DatatypeProperty ;
	rdfs:label "fedlex_generator" ;
	rdfs:range xsd:string ;
	skos:definition "Fedlex extension attribute fedlex:generator on akn:FRBRformat[@value='xml']. Identifies the tool that generated the XML file. Only allowed on FRBRformat (FLX-XF-002).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fedlex-Erweiterungsattribut fedlex:generator bei akn:FRBRformat[@value='xml']. Identifiziert das Werkzeug, das die XML-Datei erzeugt hat. Nur bei FRBRformat erlaubt (FLX-XF-002).\n" ;
	laws:schematron_rule "FLX-XF-002: generator only allowed on FRBRformat[@value='xml']" ;
	laws:xml_attribute "true" ;
	laws:xml_name "fedlex:generator" ;
	laws:xml_namespace "http://fedlex.admin.ch/" .
laws:fedlex_message a owl:DatatypeProperty ;
	rdfs:label "fedlex_message" ;
	rdfs:range xsd:string ;
	skos:definition "Fedlex extension attribute fedlex:message on akn:placeholder, marking stripped content (e.g. 'E40S10-TAB').\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fedlex-Erweiterungsattribut fedlex:message auf akn:placeholder, das entfernten Inhalt kennzeichnet (z.B. 'E40S10-TAB').\n" ;
	laws:xml_attribute "true" ;
	laws:xml_name "fedlex:message" ;
	laws:xml_namespace "http://fedlex.admin.ch/" .
laws:fedlex_role a owl:ObjectProperty ;
	rdfs:label "fedlex_role" ;
	rdfs:range laws:FedlexRoleEnum ;
	skos:definition "Fedlex extension attribute fedlex:role. FLX-XF-003 permits 'marginal' (only on akn:level, FLX-XF-004) and 'reference' (only on akn:subheading, FLX-XF-005); the published Federal Constitution additionally carries 'heading' on a preamble paragraph.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fedlex-Erweiterungsattribut fedlex:role. FLX-XF-003 lässt 'marginal' (nur an akn:level, FLX-XF-004) und 'reference' (nur an akn:subheading, FLX-XF-005) zu; die publizierte Bundesverfassung führt zusätzlich 'heading' an einem Präambel-Absatz.\n" ;
	laws:schematron_rules "FLX-XF-003, FLX-XF-004, FLX-XF-005" ;
	laws:xml_attribute "true" ;
	laws:xml_name "fedlex:role" ;
	laws:xml_namespace "http://fedlex.admin.ch/" .
laws:fedlex_rs a owl:DatatypeProperty ;
	rdfs:label "fedlex_rs" ;
	rdfs:range xsd:string ;
	skos:definition "Fedlex extension attribute fedlex:rs on akn:ref: the SR number of the referenced law (e.g. '641.20').\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fedlex-Erweiterungsattribut fedlex:rs auf akn:ref: die SR-Nummer des referenzierten Erlasses (z.B. '641.20').\n" ;
	laws:xml_attribute "true" ;
	laws:xml_name "fedlex:rs" ;
	laws:xml_namespace "http://fedlex.admin.ch/" .
laws:fedlex_rs_uri a owl:DatatypeProperty ;
	rdfs:label "fedlex_rs_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "Fedlex extension attribute fedlex:rs-uri on akn:ref: the ELI URI of the referenced law's systematic-collection entry.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fedlex-Erweiterungsattribut fedlex:rs-uri auf akn:ref: die ELI-URI des SR-Eintrags des referenzierten Erlasses.\n" ;
	laws:xml_attribute "true" ;
	laws:xml_name "fedlex:rs-uri" ;
	laws:xml_namespace "http://fedlex.admin.ch/" .
laws:frbr_authoritative a owl:ObjectProperty ;
	rdfs:label "frbr_authoritative" ;
	rdfs:range laws:ValueType ;
	skos:closeMatch eli:legal_value ;
	skos:definition "Whether this is the authoritative version (akn:FRBRauthoritative/@value)." ;
	skos:exactMatch akn:FRBRauthoritative ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ob dies die massgebliche Version ist (akn:FRBRauthoritative/@value)." ;
	laws:xml_element "akn:FRBRauthoritative" .
laws:frbr_authors a owl:ObjectProperty ;
	rdfs:label "frbr_authors" ;
	rdfs:range laws:FRBRAuthor ;
	skos:closeMatch eli:passed_by ;
	skos:definition "Author/rights-holder entries for this FRBR entity (akn:FRBRauthor)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Autoren-/Rechteinhaber-Einträge dieser FRBR-Entität (akn:FRBRauthor)." .
laws:frbr_country a owl:ObjectProperty ;
	rdfs:label "frbr_country" ;
	rdfs:range laws:ValueType ;
	skos:closeMatch eli:jurisdiction ;
	skos:definition "Country code for this legislative text (akn:FRBRcountry/@value), e.g. 'CH'." ;
	skos:exactMatch akn:FRBRcountry ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ländercode für diesen Erlass (akn:FRBRcountry/@value), z.B. 'CH'." ;
	laws:xml_element "akn:FRBRcountry" .
laws:frbr_date_name a owl:DatatypeProperty ;
	rdfs:label "frbr_date_name" ;
	rdfs:range _:c14n235 ;
	skos:definition "Type of this date (akn:FRBRdate/@name). Fedlex uses the JoLux vocabulary; the permissible values of FrbrDateNameEnum carry the corresponding ELI property. Cantonal publishers use their own designations, which is why a free string remains admissible.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Art dieses Datums (akn:FRBRdate/@name). Fedlex verwendet das JoLux-Vokabular; die zulässigen Werte von FrbrDateNameEnum tragen die entsprechende ELI-Eigenschaft. Kantonale Publikationsstellen führen eigene Bezeichnungen, weshalb eine freie Zeichenkette zulässig bleibt.\n" ;
	laws:xml_attribute "true" ;
	laws:xml_name "name" .
laws:frbr_dates a owl:ObjectProperty ;
	rdfs:label "frbr_dates" ;
	rdfs:range laws:FRBRDate ;
	skos:definition "Date entries for this FRBR entity (akn:FRBRdate). Multiple entries for different event types (dateEntryInForce, dateDocument, dateApplicability).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Datumseinträge dieser FRBR-Entität (akn:FRBRdate). Mehrere Einträge für verschiedene Ereignistypen.\n" .
laws:frbr_expression a owl:ObjectProperty ;
	rdfs:label "frbr_expression" ;
	rdfs:range eli:LegalExpression ;
	skos:definition "FRBR Expression level description (akn:FRBRExpression)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Expression-Ebenen-Beschreibung (akn:FRBRExpression)." .
laws:frbr_manifestation a owl:ObjectProperty ;
	rdfs:label "frbr_manifestation" ;
	rdfs:range eli:Format ;
	skos:definition "FRBR Manifestation level description (akn:FRBRManifestation)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Manifestations-Ebenen-Beschreibung (akn:FRBRManifestation)." .
laws:frbr_names a owl:ObjectProperty ;
	rdfs:label "frbr_names" ;
	rdfs:range laws:FRBRName ;
	skos:definition "Multilingual name entries for the FRBR Work (akn:FRBRname). One entry per language." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Mehrsprachige Namenseinträge des FRBR-Works (akn:FRBRname). Ein Eintrag pro Sprache." .
laws:frbr_subtype a owl:ObjectProperty ;
	rdfs:label "frbr_subtype" ;
	rdfs:range laws:ValueType ;
	skos:definition "Subtype of the work (akn:FRBRsubtype), e.g. 'Gesetz'. Used by cantonal collections." ;
	skos:exactMatch akn:FRBRsubtype ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Untertyp des Werks (akn:FRBRsubtype), z.B. „Gesetz“. Von kantonalen Sammlungen verwendet." ;
	laws:xml_element "akn:FRBRsubtype" .
laws:frbr_this a owl:ObjectProperty ;
	rdfs:label "frbr_this" ;
	rdfs:range laws:UriValueType ;
	skos:definition "Canonical ELI URI of this FRBR entity (akn:FRBRthis/@value)." ;
	skos:exactMatch akn:FRBRthis ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Kanonische ELI-URI dieser FRBR-Entität (akn:FRBRthis/@value)." ;
	laws:xml_element "akn:FRBRthis" .
laws:frbr_uri a owl:ObjectProperty ;
	rdfs:label "frbr_uri" ;
	rdfs:range laws:UriValueType ;
	skos:definition "Base ELI URI of this FRBR entity (akn:FRBRuri/@value)." ;
	skos:exactMatch akn:FRBRuri ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Basis-ELI-URI dieser FRBR-Entität (akn:FRBRuri/@value)." ;
	laws:xml_element "akn:FRBRuri" .
laws:frbr_work a owl:ObjectProperty ;
	rdfs:label "frbr_work" ;
	rdfs:range eli:LegalResource ;
	skos:definition "FRBR Work level description (akn:FRBRWork)." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Work-Ebenen-Beschreibung (akn:FRBRWork)." .
laws:heading a owl:ObjectProperty ;
	rdfs:label "heading" ;
	rdfs:range laws:MixedText ;
	skos:definition "Heading element for a hierarchical structure (akn:heading). May contain inline markup including akn:br (FLX-TXT-001: br permitted in heading context). Must precede subheading (FLX-HD-004, FLX-HD-005).\n" ;
	skos:exactMatch akn:heading ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Überschrift für ein Strukturelement (akn:heading). Kann Inline-Markup einschliesslich akn:br enthalten (FLX-TXT-001: br in Überschriften erlaubt). Muss vor subheading stehen (FLX-HD-004, FLX-HD-005).\n" ;
	laws:schematron_rules "FLX-HD-004: max one heading; FLX-HD-005: heading before subheading; FLX-TXT-001: br permitted here\n" ;
	laws:xml_element "akn:heading" .
