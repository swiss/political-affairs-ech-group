        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty laws:preface_ref ] ;
    skos:definition """An embedded document (akn:doc). Its @name states the kind; Fedlex uses 'annex'. It carries its own identification, which in the Fedlex files repeats the URIs of the act it belongs to.
""" ;
    skos:exactMatch akn:doc ;
    skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
    laws:description_de """Ein beiliegendes Dokument (akn:doc). Das @name-Attribut nennt die Art; Fedlex verwendet 'annex'. Es führt einen eigenen Identifikationsblock, der in den Fedlex-Dateien die URIs des zugehörigen Erlasses wiederholt.
""" ;
    laws:xml_element "akn:doc" .

