@prefix jolux: <http://data.legilux.public.lu/resource/ontology/jolux#> .
@prefix akn: <http://docs.oasis-open.org/legaldocml/ns/akn/3.0/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix laws: <https://ld.ech.ch/schema/0296/laws/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
eli:Format a owl:Class ;
	rdfs:label "FRBRManifestation" ;
	rdfs:subClassOf _:c14n1007 , _:c14n1014 , _:c14n1021 , _:c14n242 , _:c14n476 , _:c14n529 , _:c14n591 , _:c14n647 , _:c14n753 , _:c14n769 , _:c14n800 , _:c14n815 , _:c14n855 ;
	skos:definition "FRBR Manifestation level (akn:FRBRManifestation): a specific file format of the expression. For Fedlex XML files the format value is 'xml'. The optional fedlex:generator attribute is only permitted here (FLX-XF-002).\n" ;
	skos:exactMatch akn:FRBRManifestation , laws:FRBRManifestation ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Manifestations-Ebene (akn:FRBRManifestation): ein spezifisches Dateiformat der Expression. Für Fedlex XML-Dateien ist der Formatwert 'xml'. Das optionale Attribut fedlex:generator ist nur hier erlaubt (FLX-XF-002).\n" ;
	laws:schematron_note "FLX-XF-002: fedlex:generator only allowed on FRBRformat[@value='xml']" ;
	laws:xml_element "akn:FRBRManifestation" .
eli:LegalExpression a owl:Class ;
	rdfs:label "FRBRExpression" ;
	rdfs:subClassOf _:c14n100 , _:c14n130 , _:c14n179 , _:c14n412 , _:c14n427 , _:c14n46 , _:c14n482 , _:c14n536 , _:c14n546 , _:c14n564 , _:c14n582 , _:c14n592 , _:c14n660 , _:c14n713 , _:c14n85 , _:c14n986 ;
	skos:definition "FRBR Expression level (akn:FRBRExpression): a specific language version of the legislative text. Identified by an ELI URI that includes the language code.\n" ;
	skos:exactMatch akn:FRBRExpression , laws:FRBRExpression ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Expression-Ebene (akn:FRBRExpression): eine sprachspezifische Version des Erlasses. Identifiziert durch einen ELI-URI mit Sprachcode.\n" ;
	laws:xml_element "akn:FRBRExpression" .
eli:LegalResource a owl:Class ;
	rdfs:label "FRBRWork" ;
	rdfs:subClassOf _:c14n113 , _:c14n172 , _:c14n18 , _:c14n182 , _:c14n222 , _:c14n295 , _:c14n30 , _:c14n346 , _:c14n373 , _:c14n40 , _:c14n419 , _:c14n420 , _:c14n55 , _:c14n583 , _:c14n653 , _:c14n688 , _:c14n689 , _:c14n691 , _:c14n805 , _:c14n809 , _:c14n847 , _:c14n867 , _:c14n909 , _:c14n933 ;
	skos:definition "FRBR Work level (akn:FRBRWork): the abstract legislative text independent of language or version. Contains ELI URIs, Fedlex/JoLux dates, authors, country code (CH), SR number, and multilingual names with short forms.\n" ;
	skos:exactMatch akn:FRBRWork , laws:FRBRWork ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "FRBR-Work-Ebene (akn:FRBRWork): der abstrakte Erlass unabhängig von Sprache und Version. Enthält ELI-URIs, Fedlex/JoLux-Daten, Autoren, Ländercode (CH), SR-Nummer und mehrsprachige Namen mit Kurzformen.\n" ;
	laws:xml_element "akn:FRBRWork" .
eli:format a owl:ObjectProperty ;
	rdfs:label "frbr_format" ;
	rdfs:range laws:FormatType ;
	skos:definition "File format of this manifestation (akn:FRBRformat/@value), typically 'xml'." ;
	skos:exactMatch akn:FRBRformat ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Dateiformat dieser Manifestation (akn:FRBRformat/@value), typischerweise 'xml'." ;
	laws:xml_element "akn:FRBRformat" .
eli:language a owl:ObjectProperty ;
	rdfs:label "frbr_language" ;
	rdfs:range laws:LanguageType ;
	skos:definition "Language code of this expression (akn:FRBRlanguage/@language)." ;
	skos:exactMatch akn:FRBRlanguage ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Sprachcode dieser Expression (akn:FRBRlanguage/@language)." ;
	laws:xml_element "akn:FRBRlanguage" .
eli:number a owl:ObjectProperty ;
	rdfs:label "frbr_number" ;
	rdfs:range laws:ValueType ;
	skos:definition "SR (Systematische Rechtssammlung) number (akn:FRBRnumber/@value), e.g. '101'." ;
	skos:exactMatch akn:FRBRnumber ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "SR-Nummer (akn:FRBRnumber/@value), z.B. '101'." ;
	laws:xml_element "akn:FRBRnumber" .
jolux:dateApplicability a owl:Class ;
	rdfs:label "jolux:dateApplicability" ;
	rdfs:subClassOf laws:FrbrDateNameEnum ;
	skos:definition "Date up to which the consolidated version reflects the law -- the 'Stand am' of the Fedlex delivery.\n" ;
	skos:exactMatch eli:date_applicability ;
	laws:description_de "Datum, auf das die konsolidierte Fassung nachgeführt ist — der „Stand am“ der Fedlex-Auslieferung.\n" .
jolux:dateDocument a owl:Class ;
	rdfs:label "jolux:dateDocument" ;
	rdfs:subClassOf laws:FrbrDateNameEnum ;
	skos:definition "Date of adoption or signature of the act." ;
	skos:exactMatch eli:date_document ;
	laws:description_de "Datum der Verabschiedung oder Unterzeichnung des Erlasses." .
jolux:dateEntryInForce a owl:Class ;
	rdfs:label "jolux:dateEntryInForce" ;
	rdfs:subClassOf laws:FrbrDateNameEnum ;
	skos:definition "Date on which the act, or its first part, came into force." ;
	skos:exactMatch eli:first_date_entry_in_force ;
	laws:description_de "Datum, an dem der Erlass oder sein erster Teil in Kraft trat." .
xsd:anyURI a rdfs:Datatype .
xsd:string a rdfs:Datatype .
<https://ld.ech.ch/schema/0296/laws.owl.ttl> dcterms:license "CC-BY" ;
	dcterms:title "eCH-0296 Erlasse und Gesetzestexte" ;
	a owl:Ontology ;
	rdfs:label "ech-0296-laws-schema" ;
	skos:definition "LinkML schema for the Fedlex-specific subset of AkomaNtoso 3.0 covering Swiss federal law texts (eCH-0296). Models the full document structure (act, FRBR metadata, preface, body, legislative hierarchy, article content) and encodes all Fedlex Schematron constraints (AKN-fedlex-1.sch) as annotations. Intended for documentation generation and as the basis for a Fedlex-conformant XSD.\n" ;
	laws:description_de "LinkML-Schema für das Fedlex-spezifische Subset von AkomaNtoso 3.0 für schweizerische Bundeserlasse (eCH-0296). Modelliert die vollständige Dokumentenstruktur (act, FRBR-Metadaten, Vorspann, Hauptteil, Gesetzeshierarchie, Artikelinhalt) und kodiert alle Fedlex-Schematron-Constraints (AKN-fedlex-1.sch) als Annotierungen.\n" .
laws:Abbr a owl:Class ;
	rdfs:label "Abbr" ;
	rdfs:subClassOf laws:InlineElement , _:c14n333 , _:c14n503 , _:c14n549 , _:c14n60 , _:c14n637 , _:c14n638 , _:c14n751 , _:c14n960 ;
	skos:definition "The abbreviation of the act." ;
	skos:exactMatch akn:abbr ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Die Abkürzung des Erlasses." ;
	laws:xml_element "akn:abbr" .
laws:Act a owl:Class ;
	rdfs:label "Act" ;
	rdfs:subClassOf _:c14n1018 , _:c14n144 , _:c14n167 , _:c14n29 , _:c14n296 , _:c14n335 , _:c14n390 , _:c14n463 , _:c14n50 , _:c14n515 , _:c14n56 , _:c14n612 , _:c14n633 , _:c14n643 , _:c14n730 , _:c14n781 , _:c14n806 , _:c14n808 , _:c14n879 , _:c14n915 , _:c14n922 , _:c14n926 , _:c14n95 , _:c14n955 ;
	skos:definition "The legislative act element (akn:act). Main content container of an AkomaNtoso document. The @name attribute specifies the type of act (e.g. 'publicLaw').\n" ;
	skos:exactMatch akn:act ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Das Erlasselement (akn:act). Hauptinhaltselement eines AkomaNtoso-Dokuments. Das @name-Attribut gibt den Erlasstyp an (z.B. 'publicLaw').\n" ;
	laws:xml_element "akn:act" .
laws:ActBody a owl:Class ;
	rdfs:label "ActBody" ;
	rdfs:subClassOf _:c14n1008 , _:c14n1025 , _:c14n107 , _:c14n175 , _:c14n276 , _:c14n299 , _:c14n332 , _:c14n334 , _:c14n359 , _:c14n374 , _:c14n393 , _:c14n398 , _:c14n441 , _:c14n448 , _:c14n455 , _:c14n49 , _:c14n495 , _:c14n524 , _:c14n531 , _:c14n577 , _:c14n594 , _:c14n603 , _:c14n608 , _:c14n632 , _:c14n649 , _:c14n706 , _:c14n791 , _:c14n794 , _:c14n835 , _:c14n888 , _:c14n897 , _:c14n921 , _:c14n998 ;
	skos:definition "The main body of the act (akn:body), containing the legislative hierarchy. Allowed direct children are restricted to: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. No other elements are permitted (FLX-BD-001).\n" ;
	skos:exactMatch akn:body ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Der Hauptteil des Erlasses (akn:body) mit der Gesetzeshierarchie. Erlaubte direkte Kinder: book, title, part, chapter, subchapter, section, subsection, level, article, transitional, proviso. Keine anderen Elemente erlaubt (FLX-BD-001).\n" ;
	laws:schematron_rule "FLX-BD-001: Illegal element in body — only the listed hierarchy elements are permitted" ;
	laws:xml_element "akn:body" ;
	laws:xsd_content_model "choice" .
laws:ActMeta a owl:Class ;
	rdfs:label "ActMeta" ;
	rdfs:subClassOf _:c14n142 , _:c14n192 , _:c14n262 , _:c14n337 , _:c14n414 , _:c14n468 , _:c14n508 , _:c14n599 , _:c14n613 , _:c14n648 , _:c14n70 , _:c14n836 , _:c14n852 , _:c14n889 , _:c14n902 ;
	skos:definition "Metadata section of the act (akn:meta). Contains FRBR identification (Work, Expression, Manifestation levels) and named reference definitions.\n" ;
	skos:exactMatch akn:meta ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Metadaten-Abschnitt des Erlasses (akn:meta). Enthält die FRBR-Identifikation (Work-, Expression-, Manifestations-Ebene) sowie benannte Referenz-Definitionen.\n" ;
	laws:xml_element "akn:meta" .
laws:ActTypeEnum\#amendment a owl:Class ;
	rdfs:label "amendment" ;
	rdfs:subClassOf laws:ActTypeEnum ;
	skos:definition "An amending act" ;
	laws:description_de "Eine Änderung" .
laws:ActTypeEnum\#constitution a owl:Class ;
	rdfs:label "constitution" ;
	rdfs:subClassOf laws:ActTypeEnum ;
	skos:definition "A constitutional act" ;
	laws:description_de "Eine Verfassung" .
laws:ActTypeEnum\#privateAct a owl:Class ;
	rdfs:label "privateAct" ;
	rdfs:subClassOf laws:ActTypeEnum ;
	skos:definition "A private law act" ;
	laws:description_de "Ein Erlass des Privatrechts" .
laws:ActTypeEnum\#publicLaw a owl:Class ;
	rdfs:label "publicLaw" ;
	rdfs:subClassOf laws:ActTypeEnum ;
	skos:definition "A public law act" ;
	laws:description_de "Ein Erlass des öffentlichen Rechts" .
laws:ActTypeEnum a owl:Class ;
	rdfs:label "ActTypeEnum" ;
	owl:unionOf _:c14n838 ;
	skos:definition "Type of legislative act expressed in the akn:act/@name attribute." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Art des Erlasses, ausgedrückt im @name-Attribut von akn:act." ;
	linkml:permissible_values laws:ActTypeEnum\#amendment , laws:ActTypeEnum\#constitution , laws:ActTypeEnum\#privateAct , laws:ActTypeEnum\#publicLaw .
laws:ActiveModifications a owl:Class ;
	rdfs:label "ActiveModifications" ;
	rdfs:subClassOf _:c14n140 , _:c14n246 , _:c14n298 , _:c14n388 , _:c14n619 ;
	skos:definition "The modifications this act makes to others." ;
	skos:exactMatch akn:activeModifications ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Die Änderungen, die dieser Erlass an anderen vornimmt." ;
	laws:xml_element "akn:activeModifications" .
laws:ActiveRef a owl:Class ;
	rdfs:label "ActiveRef" ;
	rdfs:subClassOf laws:InlineElement , _:c14n245 , _:c14n294 , _:c14n370 , _:c14n381 , _:c14n509 , _:c14n662 , _:c14n74 , _:c14n788 , _:c14n971 ;
	skos:definition "Reference to an act this document modifies." ;
	skos:exactMatch akn:activeRef ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Verweis auf einen Erlass, den dieses Dokument ändert." ;
	laws:xml_element "akn:activeRef" .
laws:Analysis a owl:Class ;
	rdfs:label "Analysis" ;
	rdfs:subClassOf _:c14n1046 , _:c14n287 , _:c14n306 , _:c14n389 , _:c14n550 , _:c14n62 , _:c14n77 , _:c14n782 , _:c14n829 ;
	skos:definition "The analysis block: which modifications this act makes and receives. Fedlex does not use it; cantonal collections record their amendments here.\n" ;
	skos:exactMatch akn:analysis ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Der Analyseblock: welche Änderungen dieser Erlass vornimmt und erfährt. Fedlex verwendet ihn nicht; kantonale Sammlungen halten hier ihre Änderungen fest.\n" ;
	laws:xml_element "akn:analysis" .
laws:Article a owl:Class ;
	rdfs:label "Article" ;
	rdfs:subClassOf _:c14n1034 , _:c14n177 , _:c14n25 , _:c14n318 , _:c14n453 , _:c14n53 , _:c14n534 , _:c14n535 , _:c14n59 , _:c14n611 , _:c14n673 , _:c14n676 , _:c14n680 , _:c14n693 , _:c14n951 , _:c14n963 ;
	skos:definition "An article, the primary legislative unit (akn:article). Constraints (FLX-ART-*): - akn:num is mandatory (FLX-ART-001) - only heading elements (num, heading, subheading) plus akn:paragraph and akn:subdivision are allowed as children (FLX-ART-002) - requires unique @eId (FLX-ART-003)\n" ;
	skos:exactMatch akn:article ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein Artikel, die primäre legislative Einheit (akn:article). Constraints (FLX-ART-*): - akn:num ist obligatorisch (FLX-ART-001) - nur Überschriften-Elemente (num, heading, subheading) sowie akn:paragraph und akn:subdivision sind als Kinder erlaubt (FLX-ART-002) - benötigt eindeutiges @eId (FLX-ART-003)\n" ;
	laws:schematron_rules "FLX-ART-001: num mandatory; FLX-ART-002: content restricted to heading+paragraph+subdivision; FLX-ART-003: eId required\n" ;
	laws:xml_element "akn:article" ;
	laws:xsd_content_model "choice" .
laws:Attachment a owl:Class ;
	rdfs:label "Attachment" ;
	rdfs:subClassOf _:c14n248 , _:c14n498 , _:c14n615 ;
	skos:definition "A single attached document." ;
	skos:exactMatch akn:attachment ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein einzelnes beigefügtes Dokument." ;
	laws:xml_element "akn:attachment" .
laws:Attachments a owl:Class ;
	rdfs:label "Attachments" ;
	rdfs:subClassOf _:c14n297 , _:c14n605 ;
	skos:definition "Documents attached to the act." ;
	skos:exactMatch akn:attachments ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Dem Erlass beigefügte Dokumente." ;
	laws:xml_element "akn:attachments" .
laws:AuthorialNote a owl:Class ;
	rdfs:label "AuthorialNote" ;
	rdfs:subClassOf laws:InlineElement , _:c14n118 , _:c14n122 , _:c14n186 , _:c14n439 , _:c14n47 , _:c14n700 , _:c14n704 , _:c14n994 ;
	skos:definition "An authorial footnote (akn:authorialNote). Recurses into block content: it contains one or more akn:p paragraphs, which themselves carry inline content.\n" ;
	skos:exactMatch akn:authorialNote ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eine Fussnote des Autors (akn:authorialNote). Rekursiv in Block-Inhalt: enthält ein oder mehrere akn:p-Absätze, die selbst Inline-Inhalt tragen.\n" ;
	laws:xml_element "akn:authorialNote" .
laws:B a owl:Class ;
	rdfs:label "B" ;
	rdfs:subClassOf laws:InlineElement , _:c14n52 , _:c14n798 ;
	skos:definition "Bold inline markup (akn:b)." ;
	skos:exactMatch akn:b ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Fett-Inline-Markup (akn:b)." ;
	laws:xml_element "akn:b" .
laws:Block a owl:Class ;
	rdfs:label "Block" ;
	rdfs:subClassOf _:c14n1001 , _:c14n188 , _:c14n24 , _:c14n523 , _:c14n598 ;
	skos:definition "A generic block (akn:block) whose @name states its purpose; carries mixed content." ;
	skos:exactMatch akn:block ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein generischer Block (akn:block), dessen @name den Zweck nennt; trägt gemischten Inhalt." ;
	laws:xml_element "akn:block" .
laws:BlockElement a owl:Class ;
	rdfs:label "BlockElement" ;
	rdfs:subClassOf _:c14n255 , _:c14n733 , _:c14n790 , _:c14n992 ;
	skos:definition "Abstract base for a block-level element: the paragraphs, lists and tables of the content, and the formula and citations of the preamble.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Abstrakte Basis für ein Element auf Blockebene: die Absätze, Aufzählungen und Tabellen des Inhalts sowie Formel und Erwägungen des Vorspruchs.\n" .
laws:BlockList a owl:Class ;
	rdfs:label "BlockList" ;
	rdfs:subClassOf laws:BlockElement , _:c14n1 , _:c14n1052 , _:c14n1057 , _:c14n152 , _:c14n174 , _:c14n239 , _:c14n266 , _:c14n267 , _:c14n404 , _:c14n433 , _:c14n588 ;
	skos:definition "A block list of enumerated or lettered items (akn:blockList), optionally introduced by an akn:listIntroduction element.\n" ;
	skos:exactMatch akn:blockList ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eine Auflistung von nummerierten oder buchstabierten Punkten (akn:blockList), optional eingeleitet durch ein akn:listIntroduction-Element.\n" ;
	laws:xml_element "akn:blockList" .
laws:BlockListItem a owl:Class ;
	rdfs:label "BlockListItem" ;
	rdfs:subClassOf _:c14n157 , _:c14n229 , _:c14n238 , _:c14n283 , _:c14n314 , _:c14n559 , _:c14n650 , _:c14n670 , _:c14n672 , _:c14n80 , _:c14n945 ;
	skos:definition "A single item in a block list (akn:item). Carries a num label and block content directly: prose paragraphs (akn:p) and optionally nested block lists.\n" ;
	skos:exactMatch akn:item ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein einzelner Punkt in einer Auflistung (akn:item). Trägt ein num-Label und Block-Inhalt direkt: Fliesstext-Absätze (akn:p) und optional verschachtelte Listen.\n" ;
	laws:xml_element "akn:item" ;
	laws:xsd_content_model "choice" .
laws:BlockNameEnum\#heading a owl:Class ;
	rdfs:label "heading" ;
	rdfs:subClassOf laws:BlockNameEnum ;
	skos:definition "The heading of the enclosing container." ;
	laws:description_de "Die Überschrift des umgebenden Behälters." .
laws:BlockNameEnum\#num a owl:Class ;
	rdfs:label "num" ;
	rdfs:subClassOf laws:BlockNameEnum ;
	skos:definition "The number of the enclosing container." ;
	laws:description_de "Die Nummer des umgebenden Behälters." .
laws:BlockNameEnum a owl:Class ;
	rdfs:label "BlockNameEnum" ;
	owl:unionOf _:c14n856 ;
	skos:definition "Block purposes Fedlex uses in akn:block/@name." ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Zwecke, die Fedlex in akn:block/@name verwendet." ;
	linkml:permissible_values laws:BlockNameEnum\#heading , laws:BlockNameEnum\#num .
laws:BlockParagraph a owl:Class ;
	rdfs:label "BlockParagraph" ;
	rdfs:subClassOf laws:BlockElement , _:c14n13 , _:c14n143 , _:c14n173 , _:c14n191 , _:c14n511 ;
	skos:definition "A prose paragraph within content (akn:p). May contain mixed content with inline markup (XmlContent type). Note: akn:br is not allowed here, only in heading elements (FLX-TXT-001).\n" ;
	skos:exactMatch akn:p ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein Fliesstext-Absatz in Content (akn:p). Kann gemischten Inhalt mit Inline-Markup enthalten (XmlContent-Typ). Hinweis: akn:br ist hier nicht erlaubt, nur in Überschriften (FLX-TXT-001).\n" ;
	laws:schematron_note "FLX-TXT-001: br not allowed in p — only in heading/subheading/docTitle" ;
	laws:xml_element "akn:p" .
laws:Book a owl:Class ;
	rdfs:label "Book" ;
	rdfs:subClassOf _:c14n1038 , _:c14n137 , _:c14n148 , _:c14n151 , _:c14n363 , _:c14n369 , _:c14n41 , _:c14n413 , _:c14n418 , _:c14n42 , _:c14n459 , _:c14n473 , _:c14n566 , _:c14n595 , _:c14n665 , _:c14n677 , _:c14n687 , _:c14n741 , _:c14n823 , _:c14n850 , _:c14n858 , _:c14n86 , _:c14n884 , _:c14n918 , _:c14n934 , _:c14n935 , _:c14n946 , _:c14n967 ;
	skos:definition "Book-level division of an act (akn:book). Allowed children: title, part, chapter, subchapter, section, subsection, level (FLX-HR-001-bk). Requires unique @eId (FLX-HR-002-bk).\n" ;
	skos:exactMatch akn:book ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
