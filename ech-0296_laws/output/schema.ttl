	skos:definition "Title-level division of an act (akn:title). Allowed children: book, part, chapter, subchapter, section, subsection, level (FLX-HR-001-ti). Requires unique @eId (FLX-HR-002-ti).\n" ;
	skos:exactMatch akn:title ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Titel-Ebene eines Erlasses (akn:title). Erlaubte Kinder: book, part, chapter, subchapter, section, subsection, level (FLX-HR-001-ti). Benötigt eindeutiges @eId (FLX-HR-002-ti).\n" ;
	laws:schematron_rules "FLX-HR-001-ti, FLX-HR-002-ti" ;
	laws:xml_element "akn:title" ;
	laws:xsd_content_model "choice" .
laws:Transitional a owl:Class ;
	rdfs:label "Transitional" ;
	rdfs:subClassOf _:c14n216 , _:c14n232 , _:c14n280 , _:c14n309 , _:c14n33 , _:c14n45 , _:c14n462 , _:c14n522 , _:c14n682 , _:c14n747 , _:c14n752 , _:c14n766 , _:c14n821 , _:c14n883 , _:c14n899 ;
	skos:definition "A transitional provision in the body of an act (akn:transitional). Permitted as a top-level body element (FLX-BD-001). Structure follows article conventions.\n" ;
	skos:exactMatch akn:transitional ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Eine Übergangsbestimmung im Hauptteil eines Erlasses (akn:transitional). Als Hauptteil-Element auf oberster Ebene erlaubt (FLX-BD-001). Struktur wie Artikel.\n" ;
