	rdfs:subClassOf _:c14n1030 , _:c14n20 , _:c14n331 , _:c14n490 , _:c14n737 ;
	skos:definition "The content of a paragraph (akn:content). Contains block-level elements: akn:p (prose), akn:blockList (numbered/lettered lists), akn:table. When used inside a akn:level, must contain an akn:mod element (FLX-HR-003).\n" ;
