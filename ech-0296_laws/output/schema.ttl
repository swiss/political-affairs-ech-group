	rdfs:label "Subchapter" ;
	rdfs:subClassOf _:c14n1048 , _:c14n110 , _:c14n343 , _:c14n344 , _:c14n345 , _:c14n397 , _:c14n428 , _:c14n456 , _:c14n477 , _:c14n485 , _:c14n51 , _:c14n572 , _:c14n602 , _:c14n621 , _:c14n641 , _:c14n714 , _:c14n756 , _:c14n802 , _:c14n882 , _:c14n957 ;
