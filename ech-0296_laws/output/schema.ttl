laws:Subdivision a owl:Class ;
	rdfs:label "Subdivision" ;
	rdfs:subClassOf _:c14n1029 , _:c14n1050 , _:c14n1055 , _:c14n138 , _:c14n170 , _:c14n426 , _:c14n516 , _:c14n596 , _:c14n63 , _:c14n724 , _:c14n853 , _:c14n916 , _:c14n953 , _:c14n991 ;
	skos:definition "A subdivision within an article grouping related paragraphs (akn:subdivision). Constraints (FLX-SD-*): - only heading elements and akn:paragraph are allowed as children (FLX-SD-001) - only permitted as a direct child of akn:article, not nested (FLX-SD-002) - requires unique @eId (FLX-SD-003)\n" ;
	skos:exactMatch akn:subdivision ;
	skos:inScheme <https://ld.ech.ch/schema/0296/laws> ;
	laws:description_de "Ein Unterabschnitt in einem Artikel, der zusammengehörige Absätze gruppiert (akn:subdivision). Constraints (FLX-SD-*): - nur Überschriften-Elemente und akn:paragraph als Kinder erlaubt (FLX-SD-001) - nur als direktes Kind von akn:article erlaubt, keine Verschachtelung (FLX-SD-002) - benötigt eindeutiges @eId (FLX-SD-003)\n" ;
	laws:schematron_rules "FLX-SD-001: content restricted; FLX-SD-002: only in article; FLX-SD-003: eId required" ;
	laws:xml_element "akn:subdivision" ;
	laws:xsd_content_model "choice" .
