                                            laws:content_ref [ a laws:Content ;
                                                    laws:block_paragraphs [ a laws:BlockParagraph ;
                                                            laws:inline_content [ laws:element_type "TextRun" ;
                                                                    laws:text "Das Schweizervolk und die Kantone Zürich, Bern, Luzern, Uri, Schwyz, Obwalden und Nidwalden, Glarus, Zug, Freiburg, Solothurn, Basel-Stadt und Basel-Landschaft, Schaffhausen, Appenzell Ausserrhoden und Appenzell Innerrhoden, St. Gallen, Graubünden, Aargau, Thurgau, Tessin, Waadt, Wallis, Neuenburg, Genf und Jura bilden die Schweizerische Eidgenossenschaft." ] ] ] ;
                                            laws:eId "art_1/para" ] ] ;
