                    laws:articles [ a laws:Article ;
                            laws:eId "art_2" ;
                            laws:heading [ a laws:MixedText ;
                                    laws:inline_content [ laws:element_type "TextRun" ;
                                            laws:text "Persönlicher Geltungsbereich" ] ] ;
                            laws:num [ a laws:MixedText ;
                                    laws:inline_content [ laws:element_type "B" ;
                                            laws:inline_content [ laws:element_type "TextRun" ;
                                                    laws:text "Art. 2" ] ] ] ;
                            laws:paragraphs [ a laws:Paragraph ;
                                    laws:content_ref [ a laws:Content ;
                                            laws:block_lists [ a laws:BlockList ;
                                                    laws:eId "art_2/para_1/lst" ;
                                                    laws:items [ a laws:BlockListItem ;
                                                            laws:block_paragraphs [ a laws:BlockParagraph ;
                                                                    laws:inline_content [ laws:element_type "TextRun" ;
                                                                            laws:text "die Bundesverwaltung;" ] ] ;
                                                            laws:eId "art_2/para_1/lbl_a" ;
                                                            laws:num [ a laws:MixedText ;
                                                                    laws:inline_content [ laws:element_type "TextRun" ;
                                                                            laws:text "a. " ] ] ],
                                                        [ a laws:BlockListItem ;
                                                            laws:block_paragraphs [ a laws:BlockParagraph ;
                                                                    laws:inline_content [ laws:element_type "TextRun" ;
                                                                            laws:text "Organisationen und Personen des öffentlichen oder privaten Rechts, die nicht der Bundesverwaltung angehören, soweit sie Erlasse oder erstinstanzliche Verfügungen im Sinne von Artikel 5 des Bundesgesetzes vom 20. Dezember 1968 über das Verwaltungsverfahren erlassen;" ] ] ;
                                                            laws:eId "art_2/para_1/lbl_b" ;
                                                            laws:num [ a laws:MixedText ;
                                                                    laws:inline_content [ laws:element_type "TextRun" ;
                                                                            laws:text "b. " ] ] ] ;
                                                    laws:list_introduction [ a laws:MixedText ;
                                                            laws:eId "art_2/para_1/listintro" ;
                                                            laws:inline_content [ laws:element_type "TextRun" ;
                                                                    laws:text " Dieses Gesetz gilt für:" ] ] ] ] ;
                                    laws:eId "art_2/para_1" ;
                                    laws:num [ a laws:MixedText ;
                                            laws:inline_content [ laws:element_type "TextRun" ;
                                                    laws:text "1" ] ] ] ],
                        [ a laws:Article ;
                            laws:eId "art_1" ;
                            laws:heading [ a laws:MixedText ;
                                    laws:inline_content [ laws:element_type "TextRun" ;
                                            laws:text "Zweck und Gegenstand" ] ] ;
                            laws:num [ a laws:MixedText ;
                                    laws:inline_content [ laws:element_type "B" ;
                                            laws:inline_content [ laws:element_type "TextRun" ;
                                                    laws:text "Art. 1" ] ] ] ;
                            laws:paragraphs [ a laws:Paragraph ;
                                    laws:content_ref [ a laws:Content ;
                                            laws:block_paragraphs [ a laws:BlockParagraph ;
                                                    laws:inline_content [ laws:element_type "TextRun" ;
                                                            laws:text "Dieses Gesetz soll die Transparenz über den Auftrag, die Organisation und die Tätigkeit der Verwaltung fördern. Zu diesem Zweck trägt es zur Information der Öffentlichkeit bei, indem es den Zugang zu amtlichen Dokumenten gewährleistet." ] ] ] ;
                                    laws:eId "art_1/para" ] ] ] ;
