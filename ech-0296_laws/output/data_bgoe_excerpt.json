                                            "element_type": "TextRun",
                                            "text": "2006"
                                          }
                                        ]
                                      },
                                      {
                                        "element_type": "TextRun",
                                        "text": "2319"
                                      }
                                    ]
                                  },
                                  {
                                    "element_type": "TextRun",
                                    "text": "konsultiert werden."
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
