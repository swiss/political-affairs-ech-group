@prefix actors: <https://ld.ech.ch/schema/0294/actors/> .
@prefix mcm: <https://ld.ech.ch/schema/0292/meta-common/> .
@prefix ops: <https://ch.paf.link/schema/operations/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ops:legislature_examples a ops:Container ;
    ops:legislature ops:legislature_51,
        ops:legislature_be_2022_2026,
        ops:legislature_vd_2022_2027 .

ops:legislature_51 a ops:Legislature ;
    ops:actor_id [ a mcm:GroupReference ;
            mcm:abbreviation [ a mcm:MultilingualValue ;
                    mcm:language "de" ;
                    mcm:value "BV" ] ;
            mcm:globalURI actors:bundesversammlung ;
            mcm:label "Bundesversammlung" ] ;
    ops:description "Amtsdauer der am 20. Oktober 2019 gewählten Bundesversammlung; sie endete am Vortag der konstituierenden Sitzung der 52. Legislaturperiode vom 4. Dezember 2023." ;
    ops:landingPage "https://www.parlament.ch/de/ratsbetrieb/sessionen" ;
    ops:name [ a ops:MultilingualString ;
            ops:text "51ª legislatura" ;
            mcm:language "it" ],
        [ a ops:MultilingualString ;
            ops:text "51e législature" ;
            mcm:language "fr" ],
        [ a ops:MultilingualString ;
            ops:text "51. Legislaturperiode" ;
            mcm:language "de" ] ;
    ops:spatial "https://ld.admin.ch/country/CHE" ;
    mcm:dateBeginActual "2019-12-02"^^xsd:date ;
    mcm:dateEndActual "2023-12-03"^^xsd:date ;
    mcm:datetimeCreated "2019-12-02T09:00:00+01:00"^^xsd:dateTime ;
    mcm:datetimeModified "2023-12-04T08:30:00+01:00"^^xsd:dateTime ;
    mcm:wikidataUri <http://www.wikidata.org/entity/Q71712404> .

ops:legislature_be_2022_2026 a ops:Legislature ;
    ops:actor_id [ a mcm:GroupReference ;
            mcm:abbreviation [ a mcm:MultilingualValue ;
                    mcm:language "de" ;
                    mcm:value "GR" ] ;
            mcm:globalURI actors:gr_be ;
            mcm:label "Grosser Rat Bern" ] ;
    ops:landingPage "https://www.gr.be.ch/de/start/grosser-rat.html" ;
    ops:name [ a ops:MultilingualString ;
            ops:text "Legislatur 2022–2026" ;
            mcm:language "de" ],
        [ a ops:MultilingualString ;
            ops:text "Législature 2022-2026" ;
            mcm:language "fr" ] ;
    ops:spatial "https://ld.admin.ch/canton/2" ;
    mcm:dateBeginActual "2022-06-01"^^xsd:date ;
    mcm:dateBeginPlanned "2022-06-01"^^xsd:date ;
    mcm:dateEndActual "2026-05-31"^^xsd:date ;
    mcm:dateEndPlanned "2026-05-31"^^xsd:date ;
    mcm:datetimeCreated "2022-04-01T10:15:00+02:00"^^xsd:dateTime ;
    mcm:datetimeModified "2026-06-01T07:00:00+02:00"^^xsd:dateTime ;
    mcm:localId "GR-BE-2022-2026" .

ops:legislature_vd_2022_2027 a ops:Legislature ;
    ops:actor_id [ a mcm:GroupReference ;
            mcm:abbreviation [ a mcm:MultilingualValue ;
                    mcm:language "fr" ;
                    mcm:value "GC" ] ;
            mcm:globalURI actors:gc_vd ;
            mcm:label "Grand Conseil du canton de Vaud" ] ;
    ops:description "Le Grand Conseil vaudois est élu pour cinq ans." ;
    ops:landingPage "https://www.vd.ch/gc" ;
    ops:name [ a ops:MultilingualString ;
            ops:text "Législature 2022-2027" ;
            mcm:language "fr" ] ;
    ops:spatial "https://ld.admin.ch/canton/22" ;
    mcm:dateBeginActual "2022-07-01"^^xsd:date ;
    mcm:dateEndPlanned "2027-06-30"^^xsd:date ;
    mcm:datetimeCreated "2022-05-10T14:00:00+02:00"^^xsd:dateTime ;
    mcm:datetimeModified "2025-01-08T11:20:00+01:00"^^xsd:dateTime ;
    mcm:wikidataUri <http://www.wikidata.org/entity/Q131627357> .


