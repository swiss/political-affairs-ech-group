@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix ops: <https://ch.paf.link/schema/operations/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ch.paf.link/schema/meta/WorkContainer> a owl:Class ;
    rdfs:label "WorkContainer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/works> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/works> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ] ;
    skos:definition """Container for the documents (FRBR Works) of this schema. Deliberately not a tree_root, because the consuming schemas define their own Container.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Container für die Dokumente (FRBR Works) dieses Schemas. Bewusst kein tree_root, weil die konsumierenden Schemata ihren eigenen Container definieren.
""" ;
    ops:description_fr """Conteneur pour les documents (FRBR Works) de ce schéma. Volontairement pas un tree_root, car les schémas consommateurs définissent leur propre Container.
""" .

<https://ch.paf.link/schema/operations.owl.ttl> a owl:Ontology ;
    rdfs:label "operations" ;
    skos:definition """Meeting Schema for various legislative bodies
""" ;
    ops:description_de """Sitzungs-Schema für verschiedene gesetzgebende Körperschaften
""" ;
    ops:description_fr """Schéma des séances pour différents corps législatifs
""" .

ops:Container a owl:Class ;
    rdfs:label "Container" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ops:Speech ;
            owl:onProperty ops:speech ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:IndividualAttendance ;
            owl:onProperty ops:individualAttendance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agendaItem ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:AgendaItem ;
            owl:onProperty ops:agendaItem ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Election ;
            owl:onProperty ops:election ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Voting ;
            owl:onProperty ops:voting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:speech ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Attendance ;
            owl:onProperty ops:attendance ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:IndividualVote ;
            owl:onProperty ops:individualVote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:session ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Resolution ;
            owl:onProperty ops:resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:voting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:individualAttendance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:protocol ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Protocol ;
            owl:onProperty ops:protocol ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:attendance ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:election ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Meeting ;
            owl:onProperty ops:meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:legislature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:individualVote ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Session ;
            owl:onProperty ops:session ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Legislature ;
            owl:onProperty ops:legislature ],
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """Container for the records of public council operations: legislatures, sessions, meetings, agenda items, protocols, votings, elections, attendances, speeches and resolutions.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Container für die Daten des öffentlichen Ratsbetriebs: Legislaturperioden, Sessionen, Sitzungen, Traktanden, Protokolle, Abstimmungen, Wahlen, Anwesenheiten, Wortmeldungen und Resolutionen.
""" ;
    ops:description_fr """Conteneur pour les données de l'activité publique des conseils : législatures, sessions, séances, points de l'ordre du jour, procès-verbaux, votes, élections, présences, interventions et décisions.
""" .

ops:JointDebate a owl:Class ;
    rdfs:label "JointDebate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ops:AgendaItem ;
            owl:onProperty ops:agendaItem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agendaItem ] ;
    skos:definition """Agenda Items which are debated together.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Traktanden die gemeinsam behandelt werden.
""" ;
    ops:description_fr """Points de l'ordre du jour traités conjointement.
""" .

ops:Media a owl:Class ;
    rdfs:label "Media" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_type ],
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """Media files or documents (including protocols in PDF/HTML/WORD or links to audio/video).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Mediendateien oder Dokumente (einschliesslich Protokolle in PDF/HTML/WORD oder Links zu Audio/Video).
""" ;
    ops:description_fr """Fichiers médias ou documents (y compris les procès-verbaux en PDF/HTML/WORD ou les liens vers des contenus audio/vidéo).
""" .

ops:Motion a owl:Class ;
    rdfs:label "Motion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:title ],
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """A formal proposal or motion submitted during proceedings.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ein formeller Antrag, der während der Verhandlungen eingereicht wird.
""" ;
    ops:description_fr """Une proposition formelle déposée au cours des délibérations.
""" .

ops:agenda_item_ids a owl:DatatypeProperty ;
    rdfs:label "agenda_item_ids" ;
    rdfs:range xsd:string ;
    skos:definition """The agenda items associated with the voting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die Traktanden, die mit der Abstimmung verbunden sind.
""" ;
    ops:description_fr """Les points de l'ordre du jour associés au vote.
""" .

ops:category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    skos:definition """Category of the element.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Kategorie des Elements.
""" ;
    ops:description_fr """Catégorie de l'élément.
""" .

ops:result a owl:DatatypeProperty ;
    rdfs:label "result" ;
    skos:definition """Result of the procedure.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ergebnis des Verfahrens.
""" ;
    ops:description_fr """Résultat de la procédure.
""" .

ops:status a owl:DatatypeProperty ;
    rdfs:label "status" ;
    skos:definition """Free status designation, used where the state enumeration does not apply.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Freie Statusbezeichnung, dort verwendet, wo das Status-Enum nicht zutrifft.
""" ;
    ops:description_fr """Désignation libre de l'état, utilisée là où l'énumération des états ne s'applique pas.
""" .

ops:type a owl:DatatypeProperty ;
    rdfs:label "type" ;
    skos:definition """Generic type designation.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Generische Typbezeichnung.
""" ;
    ops:description_fr """Désignation générique du type.
""" .

<https://ld.ech.ch/schema/0292/meta-common/HasTemporalValidity> a owl:Class ;
    rdfs:label "HasTemporalValidity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/validFrom> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/validThrough> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/validThrough> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <http://schema.org/validThrough> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <http://schema.org/validFrom> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/validFrom> ] ;
    skos:definition """A mixin class that provides slots for modeling a temporal validity of information (not of an event).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Eine Mixin-Klasse, die Slots für die Modellierung einer zeitlichen Gültigkeit einer Information (nicht eines Events) zur Verfügung stellt.
""" ;
    ops:description_fr """Une classe mixin qui fournit des slots pour modéliser la validité temporelle d'une information (et non d'un événement).
""" .

<https://ld.ech.ch/schema/0292/meta-common/IsInstantaneousEvent> a owl:Class ;
    rdfs:label "IsInstantaneousEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateActual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeActual> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datePlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datePlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeActual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datePlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> ] ;
    skos:definition """A mixin class that provides slots for modeling instantaneous events or occurrences (without time duration).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Eine Mixin-Klasse, die Slots für die Modellierung von instantanen Ereignissen oder Vorkommnissen (ohne Zeitdauer) zur Verfügung stellt.
""" ;
    ops:description_fr """Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences instantanés (sans durée).
""" .

<https://ld.ech.ch/schema/0292/meta-common/IsProcessStep> a owl:Class ;
    rdfs:label "IsProcessStep" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/wikidataUri> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/globalURI> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndPlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/remark> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/remark> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/globalURI> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/localId> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginActual> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/globalURI> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndPlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/localId> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndPlanned> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginActual> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/remark> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateEndActual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/wikidataUri> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/localId> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/wikidataUri> ] ;
    skos:definition """A mixin class for a single step in a multi-stage process (e.g.,
a deliberation step of an affair or a phase step of a consultation).
Combines identification and event-duration slots and adds a free-text
remark slot. Concrete step classes add their own type-specific slots.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Eine Mixin-Klasse für einen einzelnen Schritt in einem
mehrstufigen Prozess (z. B. Bearbeitungsschritt eines Geschäfts oder
Phasen­schritt einer Konsultation). Kombiniert Identifikations- und
Zeitdauer-Slots und ergänzt einen freien Bemerkungs-Slot. Konkrete
Step-Klassen ergänzen ihre eigenen typ-spezifischen Slots.
""" ;
    ops:description_fr """Une classe mixin pour une étape unique dans un processus
à plusieurs étapes (par ex. une étape de délibération d'une affaire ou
une étape de phase d'une consultation). Combine les slots d'identification
et de durée d'événement et ajoute un slot de remarque en texte libre.
Les classes d'étape concrètes ajoutent leurs propres slots spécifiques au type.
""" .

<https://ld.ech.ch/schema/0292/meta-common/MultilingualUri> a owl:Class ;
    rdfs:label "MultilingualUri" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ] ;
    skos:definition """A URI together with the language of the resource it points to. Same structure as MultilingualValue, but the value is a URI: it is used where the same content is published under a separate address per language.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Eine URI zusammen mit der Sprache der Ressource, auf die sie verweist. Gleich aufgebaut wie MultilingualValue, der Wert ist jedoch eine URI: Sie wird dort verwendet, wo derselbe Inhalt je Sprache unter einer eigenen Adresse publiziert wird.
""" ;
    ops:description_fr """Une URI accompagnée de la langue de la ressource vers laquelle elle renvoie. Structure identique à MultilingualValue, mais la valeur est une URI : elle est utilisée là où le même contenu est publié à une adresse propre par langue.
""" .

<https://ld.ech.ch/schema/0292/meta-common/multilingualValue> a owl:ObjectProperty ;
    rdfs:label "multilingual_value" ;
    rdfs:range <https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> ;
    skos:definition """A multilingual value with language specification.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Ein mehrsprachiger Wert mit Angabe der Sprache.
""" ;
    ops:description_fr """Une valeur multilingue avec indication de la langue.
""" .

<https://ch.paf.link/schema/meta/Expression> a owl:Class ;
    rdfs:label "Expression" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <http://schema.org/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Date> ;
            owl:onProperty <https://ch.paf.link/schema/meta/dates> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ) ] ;
            owl:onProperty dcterms:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/manifestations> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Manifestation> ;
            owl:onProperty <https://ch.paf.link/schema/meta/manifestations> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ch.paf.link/schema/meta/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/dates> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:language ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ] ;
    skos:definition """FRBR Expression: a concrete language version of a Work.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """FRBR Expression: eine konkrete Sprachfassung eines Works.
""" ;
    ops:description_fr """FRBR Expression : une version linguistique concrète d'un Work.
""" .

<https://ch.paf.link/schema/meta/Manifestation> a owl:Class ;
    rdfs:label "Manifestation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/url> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/dates> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Date> ;
            owl:onProperty <https://ch.paf.link/schema/meta/dates> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/url> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://ch.paf.link/schema/meta/url> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/format> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/format> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ch.paf.link/schema/meta/format> ] ;
    skos:definition """FRBR Manifestation: a concrete file format of an Expression, addressable via a URL.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """FRBR Manifestation: eine konkrete Dateiform einer Expression, über eine URL adressierbar.
""" ;
    ops:description_fr """FRBR Manifestation : une forme de fichier concrète d'une Expression, adressable au moyen d'une URL.
""" .

<https://ch.paf.link/schema/meta/expressions> a owl:ObjectProperty ;
    rdfs:label "expressions" ;
    rdfs:range <https://ch.paf.link/schema/meta/Expression> ;
    skos:definition """The language versions (Expressions) of a Work.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Die Sprachfassungen (Expressions) eines Works.
""" ;
    ops:description_fr """Les versions linguistiques (Expressions) d'un Work.
""" .

<https://ch.paf.link/schema/meta/manifestations> a owl:ObjectProperty ;
