    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ein Abstimmungsverfahren mit Einzelstimmen und Ergebnissen.
""" ;
    ops:description_fr """Une procédure de vote avec les voix individuelles et les résultats.
""" .

ops:WorkTypesEnum a owl:Class ;
    rdfs:label "WorkTypesEnum" ;
    owl:unionOf ( <https://ch.paf.link/schema/meta/vocabulary/work_types/PV> <https://ch.paf.link/schema/meta/vocabulary/work_types/SubmittedVersion> <https://ch.paf.link/schema/meta/vocabulary/work_types/CurrentLaw> ) ;
    skos:definition """Type of a document (FRBR Work).
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Art eines Dokuments (FRBR Work).
""" ;
    ops:description_fr """Type d'un document (FRBR Work).
""" ;
    linkml:permissible_values <https://ch.paf.link/schema/meta/vocabulary/work_types/CurrentLaw>,
        <https://ch.paf.link/schema/meta/vocabulary/work_types/PV>,
        <https://ch.paf.link/schema/meta/vocabulary/work_types/SubmittedVersion> .

ops:MajorityTypeEnum a owl:Class ;
    rdfs:label "MajorityTypeEnum" ;
    owl:unionOf ( <https://ch.paf.link/schema/operations/enum/majority_type/absolute> <https://ch.paf.link/schema/operations/enum/majority_type/two_thirds> <https://ch.paf.link/schema/operations/enum/majority_type/other> ) ;
    skos:definition """Type of majority required for the vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der für die Abstimmung erforderlichen Mehrheit.
""" ;
    ops:description_fr """Type de majorité requise pour le vote.
""" ;
    linkml:permissible_values <https://ch.paf.link/schema/operations/enum/majority_type/absolute>,
        <https://ch.paf.link/schema/operations/enum/majority_type/other>,
        <https://ch.paf.link/schema/operations/enum/majority_type/two_thirds> .

ops:MeetingTypeEnum a owl:Class ;
    rdfs:label "MeetingTypeEnum" ;
    owl:unionOf ( <https://ch.paf.link/schema/operations/enum/meeting_type/session> <https://ch.paf.link/schema/operations/enum/meeting_type/committee> <https://ch.paf.link/schema/operations/enum/meeting_type/sitting> <https://ch.paf.link/schema/operations/enum/meeting_type/various> ) ;
    skos:definition """Type of the meeting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der Sitzung.
""" ;
    ops:description_fr """Type de séance.
""" ;
    linkml:permissible_values <https://ch.paf.link/schema/operations/enum/meeting_type/committee>,
        <https://ch.paf.link/schema/operations/enum/meeting_type/session>,
        <https://ch.paf.link/schema/operations/enum/meeting_type/sitting>,
        <https://ch.paf.link/schema/operations/enum/meeting_type/various> .

ops:administrative_id a owl:DatatypeProperty ;
    rdfs:label "administrative_id" ;
    skos:definition """Administrative ID of the legislative body, such as a municipality, canton, or country.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Verwaltungs-ID des gesetzgebenden Körpers, wie z.B. Gemeinde, Kanton oder Land.
""" ;
    ops:description_fr """Identifiant administratif du corps législatif, p. ex. commune, canton ou pays.
""" .

ops:majority_count a owl:DatatypeProperty ;
    rdfs:label "majority_count" ;
    rdfs:range xsd:integer ;
    skos:definition """Number of votes required for the relevant majority threshold.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Anzahl der Stimmen, die für die relevante Mehrheitsschwelle erforderlich sind.
""" ;
    ops:description_fr """Nombre de voix requis pour atteindre le seuil de majorité déterminant.
""" .

ops:majority_type a owl:ObjectProperty ;
    rdfs:label "majority_type" ;
    rdfs:range ops:MajorityTypeEnum ;
    skos:definition """Type of majority required for the vote (absolute, two-thirds, etc.).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der für die Abstimmung erforderlichen Mehrheit (absolut, Zweidrittel usw.).
""" ;
    ops:description_fr """Type de majorité requise pour le vote (absolue, deux tiers, etc.).
""" .

ops:media_type a owl:DatatypeProperty ;
    rdfs:label "media_type" ;
    skos:definition """Type of media (audio, video, document).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art des Mediums (Audio, Video, Dokument).
""" ;
    ops:description_fr """Type de média (audio, vidéo, document).
""" .

ops:meeting_abbreviation a owl:DatatypeProperty ;
    rdfs:label "meeting_abbreviation" ;
    skos:definition """Short designation of the session or meeting (e.g. "FS24" for the 2024 spring session).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Kurzbezeichnung der Session oder Sitzung (z.B. „FS24“ für die Frühjahrssession 2024).
""" ;
    ops:description_fr """Désignation abrégée de la session ou de la séance (p. ex. « FS24 » pour la session de printemps 2024).
""" .

ops:name a owl:ObjectProperty ;
    rdfs:label "name" ;
    rdfs:range ops:MultilingualString ;
    skos:definition """Multilingual full designation.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Mehrsprachige vollständige Bezeichnung.
""" ;
    ops:description_fr """Désignation complète multilingue.
""" .

ops:number a owl:DatatypeProperty ;
    rdfs:label "number" ;
    skos:definition """Sequential number, e.g. within the legislature, the session or the year.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Laufende Nummer, z.B. innerhalb der Legislatur, der Session oder des Jahres.
""" ;
    ops:description_fr """Numéro courant, p. ex. au sein de la législature, de la session ou de l'année.
""" .

ops:parent_legislature a owl:DatatypeProperty ;
    rdfs:label "parent_legislature" ;
    skos:definition """The legislative body in which the meeting is based.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Der gesetzgebende Körper, auf dem die Sitzung basiert.
""" ;
    ops:description_fr """La législature dans le cadre de laquelle la séance a lieu.
""" .

ops:position a owl:DatatypeProperty ;
    rdfs:label "position" ;
    skos:definition """Integer position within the superordinate sequence.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ganzzahlige Position innerhalb der übergeordneten Reihenfolge.
""" ;
    ops:description_fr """Position (nombre entier) au sein de la séquence supérieure.
""" .

ops:result_text a owl:DatatypeProperty ;
    rdfs:label "result_text" ;
    rdfs:range xsd:string ;
    skos:definition """Free text describing the outcome of the vote, e.g., "Accepted with 78 votes".
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Freitext zur Beschreibung des Ergebnisses der Abstimmung, z.B. „Mit 78 Stimmen angenommen“.
""" ;
    ops:description_fr """Texte libre décrivant le résultat du vote, p. ex. « Accepté par 78 voix ».
""" .

ops:sequential_number a owl:DatatypeProperty ;
    rdfs:label "sequential_number" ;
    rdfs:range xsd:integer ;
    skos:definition """Sequential number of the meeting, used for ordering.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Laufende Nummer der Sitzung, die zur Sortierung verwendet wird.
""" ;
    ops:description_fr """Numéro séquentiel de la séance, utilisé pour le tri.
""" .

ops:state_name a owl:DatatypeProperty ;
    rdfs:label "state_name" ;
    rdfs:range xsd:string ;
    skos:definition """Custom state description for the meeting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Benutzerdefinierte Zustandsbeschreibung für die Sitzung.
""" ;
    ops:description_fr """Description personnalisée de l'état de la séance.
""" .

ops:total a owl:DatatypeProperty ;
    rdfs:label "total" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of votes, excluding absent and president's vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der Stimmen, ohne abwesende und Präsidiumsstimmen.
""" ;
    ops:description_fr """Nombre total de voix, sans les absents ni la voix de la présidence.
""" .

<https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> a owl:DatatypeProperty ;
    rdfs:label "date_begin_actual" ;
    rdfs:range xsd:date ;
    skos:definition """The actual start date of an event or occurrence with time duration.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.
""" ;
    ops:description_fr """La date de début effective d'un événement ou d'une occurrence avec durée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> a owl:DatatypeProperty ;
    rdfs:label "date_begin_planned" ;
