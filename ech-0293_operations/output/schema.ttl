    skos:definition """An election procedure for selecting persons to positions.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ein Wahlverfahren zur Wahl von Personen in Positionen.
""" ;
    ops:description_fr """Une procédure d'élection visant à pourvoir des fonctions par des personnes.
""" .

ops:IndividualAttendance a owl:Class ;
    rdfs:label "IndividualAttendance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
