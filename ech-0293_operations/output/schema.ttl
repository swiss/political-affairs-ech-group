<https://ch.paf.link/schema/meta/Date> a owl:Class ;
    rdfs:label "Date" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/dateType> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ch.paf.link/schema/meta/dateType> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:DateTypesEnum ;
            owl:onProperty <https://ch.paf.link/schema/meta/dateType> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty dcterms:date ] ;
    skos:definition """A date with a type indication (e.g. first publication, last revision).
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Ein Datum mit Typangabe (z.B. Erstpublikation, letzte Revision).
""" ;
    ops:description_fr """Une date assortie d'une indication de type (p. ex. première publication, dernière révision).
""" .

<https://ch.paf.link/schema/meta/dateType> a owl:ObjectProperty ;
