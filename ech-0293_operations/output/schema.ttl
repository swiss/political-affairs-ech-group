            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^https://ld\\.admin\\.ch/(country/[A-Z]{3}|canton/[0-9]+|district/[0-9]+|municipality/[0-9]+)$" ] ) ] ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:administrative_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:administrative_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
