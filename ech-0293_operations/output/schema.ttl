ops:Meeting a owl:Class ;
    rdfs:label "Meeting" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:StateEnum ;
            owl:onProperty ops:state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:protocolRef ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_legislature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:administrative_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:group_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:group_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:position ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:group_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:meetingType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:position ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:protocolRef ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:group_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:meeting_abbreviation ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:group_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:sequential_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:meeting_abbreviation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_legislature ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:actor_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:number ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:meeting_abbreviation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^https://ld\\.admin\\.ch/(country/[A-Z]{3}|canton/[0-9]+|district/[0-9]+|municipality/[0-9]+)$" ] ) ] ;
            owl:onProperty ops:spatial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:sequential_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:sequential_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_legislature ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:meetingType ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:administrative_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MeetingTypeEnum ;
            owl:onProperty ops:meetingType ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Protocol ;
            owl:onProperty ops:protocolRef ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:number ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
            owl:onProperty ops:group_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:administrative_id ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification>,
        <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> ;
    skos:definition """A general meeting class used for Sessions, Comittee Meetings, individual session Sittings and other various Meetings.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Eine allgemeine Sitzungsklasse, die für Sessionen, Kommissionssitzungen, Sessionssitzung und andere verschiedene Versammlungen verwendet wird.
""" ;
    ops:description_fr """Une classe générale de séance utilisée pour les sessions, les séances de commission, les séances individuelles d'une session et d'autres réunions diverses.
""" .

ops:Speech a owl:Class ;
    rdfs:label "Speech" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:role ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:media_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_fullname ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:media_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:media_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty ops:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:actor_fullname ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:start ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ld.ech.ch/schema/0292/meta-common/PersonReference> ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:media_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:media_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:text_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:datetime_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:text_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty ops:datetime_end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_fullname ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:text_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:datetime_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:text_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:text_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:media_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:text ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:text_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """A speech or statement made during a meeting (also called Votum or speaker segment).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Eine Wortmeldung während einer Sitzung (auch Votum oder Redebeitrag genannt).
""" ;
    ops:description_fr """Une intervention prononcée au cours d'une séance (également appelée prise de parole).
""" .

ops:actor_fullname a owl:DatatypeProperty ;
    rdfs:label "actor_fullname" ;
    skos:definition """Full name of the actor/person.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Vollständiger Name der Akteurin oder des Akteurs bzw. der Person.
""" ;
    ops:description_fr """Nom complet de l'actrice ou de l'acteur, respectivement de la personne.
""" .

ops:actor_name a owl:DatatypeProperty ;
    rdfs:label "actor_name" ;
    rdfs:range xsd:string ;
    skos:definition """Name of the political body (e.g., Nationalrat).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Name des politischen Organs (z.B. Nationalrat).
""" ;
    ops:description_fr """Nom de l'organe politique (p. ex. Conseil national).
""" .

ops:agenda_item_category a owl:DatatypeProperty ;
    rdfs:label "agenda_item_category" ;
    rdfs:range xsd:string ;
    skos:definition """Category for grouped agenda items (e.g., introduction, by department, technical agenda items).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Kategorie für gruppierte Traktanden (z.B. Einführung, nach Departement, technische Traktanden).
""" ;
    ops:description_fr """Catégorie pour les points de l'ordre du jour regroupés (p. ex. introduction, par département, points techniques).
""" .

ops:agenda_item_number a owl:DatatypeProperty ;
    rdfs:label "agenda_item_number" ;
    rdfs:range xsd:string ;
    skos:definition """Sequential number of the agenda item (string type to support roman numerals).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Laufnummer des Traktandums (String-Typ zur Unterstützung römischer Ziffern).
""" ;
    ops:description_fr """Numéro d'ordre du point de l'ordre du jour (type chaîne, afin de permettre les chiffres romains).
""" .

ops:agenda_item_position a owl:DatatypeProperty ;
    rdfs:label "agenda_item_position" ;
    rdfs:range xsd:integer ;
    skos:definition """Integer position of the agenda item in the meeting sequence.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ganzzahlige Position des Traktandums in der Sitzungsreihenfolge.
""" ;
    ops:description_fr """Position (nombre entier) du point de l'ordre du jour dans le déroulement de la séance.
""" .

ops:agenda_item_type a owl:ObjectProperty ;
    rdfs:label "agenda_item_type" ;
    rdfs:range ops:AgendaItemTypeEnum ;
    skos:definition """Type of agenda item, distinguishing individual items from groups.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art des Traktandums, unterscheidet Einzeltraktanden von Traktandengruppen.
""" ;
    ops:description_fr """Type de point de l'ordre du jour, distinguant les points isolés des groupes de points.
""" .

ops:attendance_type a owl:ObjectProperty ;
    rdfs:label "attendance_type" ;
    rdfs:range ops:AttendanceTypeEnum ;
    skos:definition """Type of individual attendance.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der individuellen Anwesenheit.
""" ;
    ops:description_fr """Type de présence individuelle.
""" .

ops:count a owl:DatatypeProperty ;
    rdfs:label "count" ;
    rdfs:range xsd:integer ;
    skos:definition """The count of votes for the total other category.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die Anzahl der Stimmen für die Kategorie „Andere“.
""" ;
    ops:description_fr """Le nombre de voix pour la catégorie « autres ».
""" .

ops:election_type a owl:ObjectProperty ;
    rdfs:label "election_type" ;
    rdfs:range ops:ElectionTypeEnum ;
    skos:definition """Type of election procedure.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art des Wahlverfahrens.
""" ;
    ops:description_fr """Type de procédure d'élection.
""" .

ops:group_id a owl:ObjectProperty ;
    rdfs:label "group_id" ;
    rdfs:range <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
    skos:definition """Reference to the group or body (lightweight snapshot at time of linking).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Referenz auf die Gruppe oder das Gremium (Momentaufnahme zum Zeitpunkt der Verknüpfung).
""" ;
    ops:description_fr """Référence au groupe ou à l'organe (instantané au moment de la mise en relation).
""" .

ops:group_name a owl:DatatypeProperty ;
    rdfs:label "group_name" ;
    rdfs:range xsd:string ;
    skos:definition """Name of the group or body.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Name der Gruppe oder des Gremiums.
""" ;
    ops:description_fr """Nom du groupe ou de l'organe.
""" .

ops:has_resolution a owl:ObjectProperty ;
    rdfs:label "has_resolution" ;
    rdfs:range ops:Resolution ;
    skos:definition """The resolution or decision taken on this agenda item.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die Resolution oder Entscheidung zu diesem Traktandum.
""" ;
    ops:description_fr """La décision prise sur ce point de l'ordre du jour.
""" .

ops:individual_vote_type a owl:ObjectProperty ;
    rdfs:label "individual_vote_type" ;
    rdfs:range ops:IndividualVoteTypeEnum ;
    skos:definition """Type of vote cast (yes, no, abstention, no vote, etc.).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der abgegebenen Stimme (Ja, Nein, Enthaltung, nicht abgestimmt, etc.).
""" ;
    ops:description_fr """Type de voix exprimée (oui, non, abstention, n'a pas voté, etc.).
""" .

ops:label_abstention a owl:DatatypeProperty ;
    rdfs:label "label_abstention" ;
    rdfs:range xsd:string ;
    skos:definition """Meaning of an 'abstention' vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Bedeutung einer Enthaltungsstimme.
""" ;
    ops:description_fr """Signification d'une abstention.
""" .

ops:label_no a owl:DatatypeProperty ;
    rdfs:label "label_no" ;
    rdfs:range xsd:string ;
    skos:definition """Meaning of a 'no' vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Bedeutung einer „Nein“-Stimme.
""" ;
    ops:description_fr """Signification d'une voix « non ».
""" .

ops:label_yes a owl:DatatypeProperty ;
    rdfs:label "label_yes" ;
    rdfs:range xsd:string ;
    skos:definition """Meaning of a 'yes' vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Bedeutung einer „Ja“-Stimme.
""" ;
    ops:description_fr """Signification d'une voix « oui ».
""" .

ops:leading_actor_id a owl:DatatypeProperty ;
    rdfs:label "leading_actor_id" ;
    rdfs:range xsd:string ;
    skos:definition """The leading department for the agenda item.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Das federführende Departement für das Traktandum.
""" ;
    ops:description_fr """Le département responsable du point de l'ordre du jour.
""" .

ops:location a owl:DatatypeProperty ;
    rdfs:label "location" ;
    skos:definition """Place where the meeting is held (physical room, video conference or hybrid format).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ort, an dem die Sitzung stattfindet (physischer Raum, Videokonferenz oder hybrides Format).
""" ;
    ops:description_fr """Lieu où se tient la séance (salle physique, visioconférence ou format hybride).
""" .

ops:media_format a owl:DatatypeProperty ;
    rdfs:label "media_format" ;
    skos:definition """MIME type of the media file.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """MIME-Typ der Mediendatei.
""" ;
    ops:description_fr """Type MIME du fichier média.
""" .

ops:media_url a owl:DatatypeProperty ;
    rdfs:label "media_url" ;
    skos:definition """URL to media file (audio/video).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """URL zur Mediendatei (Audio/Video).
""" ;
    ops:description_fr """URL du fichier média (audio/vidéo).
""" .

ops:meetingType a owl:ObjectProperty ;
    rdfs:label "meeting_type" ;
    rdfs:range ops:MeetingTypeEnum ;
    skos:definition """Type of the meeting, e.g. session, committee, sitting, various.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der Sitzung, z.B. Session, Kommission, Sessionssitzung, Verschiedenes.
""" ;
    ops:description_fr """Type de séance, p. ex. session, commission, séance de session, divers.
""" .

ops:optional a owl:DatatypeProperty ;
    rdfs:label "optional" ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates if the meeting or voting is optional.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gibt an, ob die Sitzung oder Abstimmung optional ist.
""" ;
    ops:description_fr """Indique si la séance ou le vote est facultatif.
""" .

ops:parentAttendance a owl:ObjectProperty ;
    rdfs:label "parent_attendance" ;
    rdfs:range ops:Attendance ;
    skos:definition """The Attendance aggregate this individual attendance record belongs to.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Das Attendance-Aggregat, zu dem dieser einzelne Anwesenheits-Eintrag gehört.
""" ;
    ops:description_fr """L'agrégat Attendance auquel appartient cette constatation individuelle de présence.
""" .

ops:parentVoting a owl:ObjectProperty ;
    rdfs:label "parent_voting" ;
    rdfs:range ops:Voting ;
    skos:definition """The ID of the voting associated with the individual vote.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die ID der Abstimmung, die mit der Einzelstimme verbunden ist.
""" ;
    ops:description_fr """L'identifiant du vote auquel se rattache la voix individuelle.
""" .

ops:parent_type a owl:DatatypeProperty ;
    rdfs:label "parent_type" ;
    skos:definition """Type of parent object (meeting, agenda, speech, affair).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Typ des übergeordneten Objekts (Sitzung, Traktandum, Wortmeldung, Geschäft).
""" ;
    ops:description_fr """Type de l'objet parent (séance, point de l'ordre du jour, intervention, affaire).
""" .

ops:protocolRef a owl:ObjectProperty ;
    rdfs:label "protocol_ref" ;
    rdfs:range ops:Protocol ;
    skos:definition """The protocol (minutes) of this meeting, recorded after the meeting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Das nach der Sitzung erstellte Protokoll dieser Sitzung.
""" ;
    ops:description_fr """Le procès-verbal de cette séance, établi après celle-ci.
""" .

ops:resolution_type a owl:ObjectProperty ;
    rdfs:label "resolution_type" ;
    rdfs:range ops:ResolutionTypeEnum ;
    skos:definition """Type of resolution taken on the agenda item.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art der Resolution zum Traktandum.
""" ;
    ops:description_fr """Type de décision prise sur le point de l'ordre du jour.
""" .

ops:role a owl:DatatypeProperty ;
    rdfs:label "role" ;
    skos:definition """Role of the person (e.g., commission speaker).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Rolle der Person (z.B. Kommissionssprecherin oder Kommissionssprecher).
""" ;
    ops:description_fr """Rôle de la personne (p. ex. rapporteuse ou rapporteur de commission).
""" .

ops:seat_nr a owl:DatatypeProperty ;
    rdfs:label "seat_nr" ;
    rdfs:range xsd:string ;
    skos:definition """The seat number of the individual vote, if applicable.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die Sitznummer der Einzelstimme, falls zutreffend.
""" ;
    ops:description_fr """Le numéro de siège correspondant à la voix individuelle, le cas échéant.
""" .

ops:speaking_actor_id a owl:DatatypeProperty ;
    rdfs:label "speaking_actor_id" ;
    skos:definition """The speaker or head of the department for the agenda item.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Der Sprecher oder die Sprecherin bzw. die Departementsvorsteherin oder der Departementsvorsteher für das Traktandum.
""" ;
    ops:description_fr """La ou le porte-parole ou la cheffe ou le chef du département pour le point de l'ordre du jour.
""" .

ops:start a owl:DatatypeProperty ;
    rdfs:label "start" ;
    skos:definition """Start indicator or position.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Startangabe oder Position.
""" ;
    ops:description_fr """Indication de début ou position.
""" .

ops:state a owl:ObjectProperty ;
    rdfs:label "state" ;
    rdfs:range ops:StateEnum ;
    skos:definition """Current state of the meeting (planned, canceled, postponed).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Aktueller Status der Sitzung (geplant, abgesagt, verschoben).
""" ;
    ops:description_fr """État actuel de la séance (planifiée, annulée, reportée).
""" .

ops:state_id a owl:DatatypeProperty ;
    rdfs:label "state_id" ;
    rdfs:range xsd:string ;
    skos:definition """State identifier (reference to state enum or custom state).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Zustands-Identifikator (Verweis auf das Status-Enum oder auf einen eigenen Zustand).
""" ;
    ops:description_fr """Identifiant d'état (renvoi à l'énumération des états ou à un état propre).
""" .

ops:text_format a owl:DatatypeProperty ;
    rdfs:label "text_format" ;
    skos:definition """Format of text (text, html, html_with_timestamps).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Format des Textes (text, html, html_with_timestamps).
""" ;
    ops:description_fr """Format du texte (text, html, html_with_timestamps).
""" .

ops:text_type a owl:DatatypeProperty ;
    rdfs:label "text_type" ;
    skos:definition """Type of text (raw draft, edited version).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Typ des Textes (Rohfassung, bearbeitete Fassung).
""" ;
    ops:description_fr """Type de texte (version brute, version éditée).
""" .

ops:tie_breaker a owl:DatatypeProperty ;
    rdfs:label "tie_breaker" ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates if a tie-breaker was used in the voting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gibt an, ob ein Stichentscheid bei der Abstimmung verwendet wurde.
""" ;
    ops:description_fr """Indique si une voix prépondérante a été utilisée lors du vote.
""" .

ops:total_count a owl:DatatypeProperty ;
    rdfs:label "total_count" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of members of the body (reference value for quorum calculations).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl aller Mitglieder des Gremiums (Bezugsgrösse für Quorum-Berechnungen).
""" ;
    ops:description_fr """Nombre total de membres de l'organe (valeur de référence pour le calcul du quorum).
""" .

ops:total_count_abstention a owl:DatatypeProperty ;
    rdfs:label "total_count_abstention" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of abstentions.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der Enthaltungen.
""" ;
    ops:description_fr """Nombre total d'abstentions.
""" .

ops:total_count_no a owl:DatatypeProperty ;
    rdfs:label "total_count_no" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of 'no' votes.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der „Nein“-Stimmen.
""" ;
    ops:description_fr """Nombre total de voix « non ».
""" .

ops:total_count_yes a owl:DatatypeProperty ;
    rdfs:label "total_count_yes" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of 'yes' votes.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der „Ja“-Stimmen.
""" ;
    ops:description_fr """Nombre total de voix « oui ».
""" .

ops:total_excused a owl:DatatypeProperty ;
    rdfs:label "total_excused" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of excused absences.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der entschuldigten Abwesenheiten.
""" ;
    ops:description_fr """Nombre total d'absences excusées.
""" .

ops:total_present a owl:DatatypeProperty ;
    rdfs:label "total_present" ;
    rdfs:range xsd:integer ;
    skos:definition """Total number of members present.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Gesamtzahl der anwesenden Mitglieder.
""" ;
    ops:description_fr """Nombre total de membres présents.
""" .

ops:version a owl:DatatypeProperty ;
    rdfs:label "version" ;
    skos:definition """Version number or identifier.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Versionsnummer oder Versionskennung.
""" ;
    ops:description_fr """Numéro ou identifiant de version.
""" .

ops:voting_type a owl:ObjectProperty ;
    rdfs:label "voting_type" ;
    rdfs:range ops:VotingTypeEnum ;
    skos:definition """Type of voting procedure (preliminary, final, secret, etc.).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art des Abstimmungsverfahrens (Zwischen-, Schlussabstimmung, geheim, etc.).
""" ;
    ops:description_fr """Type de procédure de vote (vote intermédiaire, vote final, vote secret, etc.).
""" .

ops:weight a owl:DatatypeProperty ;
    rdfs:label "weight" ;
    rdfs:range xsd:integer ;
    skos:definition """The number of votes held by the individual, if applicable (e.g., in cases where a person has multiple votes).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Die Anzahl der Stimmen, die die Einzelperson hat, falls zutreffend (z.B. in Fällen, in denen eine Person mehrere Stimmen hat).
""" ;
    ops:description_fr """Le nombre de voix dont dispose la personne, le cas échéant (p. ex. lorsqu'une personne détient plusieurs voix).
""" .

<https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> a owl:Class ;
    rdfs:label "MultilingualValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ] ;
    skos:definition """A multilingual string with language specification.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Ein mehrsprachiger String mit Angabe der Sprache.
""" ;
    ops:description_fr """Une chaîne de caractères multilingue avec indication de la langue.
""" .

<https://ld.ech.ch/schema/0292/meta-common/dateActual> a owl:DatatypeProperty ;
    rdfs:label "date_actual" ;
    rdfs:range xsd:date ;
    skos:definition """The actual date of an instantaneous event or occurrence (without time duration).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das tatsächliche Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).
""" ;
    ops:description_fr """La date effective d'un événement ou d'une occurrence instantané (sans durée).
""" .

<https://ld.ech.ch/schema/0292/meta-common/dateCreated> a owl:DatatypeProperty ;
    rdfs:label "date_created" ;
    rdfs:range xsd:date ;
    skos:definition """The date when an entity was created.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das Datum, an dem eine Entität erstellt wurde.
""" ;
    ops:description_fr """La date à laquelle une entité a été créée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/dateModified> a owl:DatatypeProperty ;
    rdfs:label "date_modified" ;
    rdfs:range xsd:date ;
    skos:definition """The date when an entity was last modified.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das Datum, an dem eine Entität zuletzt geändert wurde.
""" ;
    ops:description_fr """La date à laquelle une entité a été modifiée pour la dernière fois.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datePlanned> a owl:DatatypeProperty ;
    rdfs:label "date_planned" ;
    rdfs:range xsd:date ;
    skos:definition """The planned date of an instantaneous event or occurrence (without time duration).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das geplante Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).
""" ;
    ops:description_fr """La date planifiée d'un événement ou d'une occurrence instantané (sans durée).
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeActual> a owl:DatatypeProperty ;
    rdfs:label "datetime_actual" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The actual date and time of an instantaneous event or occurrence (without time duration).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das tatsächliche Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).
""" ;
    ops:description_fr """La date et l'heure effectives d'un événement ou d'une occurrence instantané (sans durée).
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeCreated> a owl:DatatypeProperty ;
    rdfs:label "datetime_created" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The date and time when an entity was created.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.
""" ;
    ops:description_fr """La date et l'heure auxquelles une entité a été créée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeModified> a owl:DatatypeProperty ;
    rdfs:label "datetime_modified" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The date and time when an entity was last modified.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.
""" ;
    ops:description_fr """La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> a owl:DatatypeProperty ;
    rdfs:label "datetime_planned" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The planned date and time of an instantaneous event or occurrence (without time duration).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Das geplante Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).
""" ;
    ops:description_fr """La date et l'heure planifiées d'un événement ou d'une occurrence instantané (sans durée).
""" .

<https://ld.ech.ch/schema/0292/meta-common/groupLabel> a owl:DatatypeProperty ;
    rdfs:label "group_label" ;
    skos:definition """Name of the body/group at time of linking.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Name des Gremiums zum Zeitpunkt der Verknüpfung.
""" ;
    ops:description_fr """Nom de l'organe/du groupe au moment de la liaison.
""" .

<https://ld.ech.ch/schema/0292/meta-common/isCurrent> a owl:DatatypeProperty ;
    rdfs:label "is_active" ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates whether the information is currently valid. Can be useful when this information is explicitly available.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Gibt an, ob die Information aktuell gültig ist. Kann nützlich sein, wenn diese Information explizit vorhanden ist.
""" ;
    ops:description_fr """Indique si l'information est actuellement valable. Peut être utile lorsque cette information est explicitement disponible.
""" .

<https://ld.ech.ch/schema/0292/meta-common/labelLong> a owl:DatatypeProperty ;
    rdfs:label "label_long" ;
    skos:definition """Assign an extended label to a structured piece of information (e.g., display name with title, position, etc.).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Möglichkeit bei einer strukturierten Information, ein erweitertesLabel zu vergeben (bspw. Anzeigename mit Titel, Anstellung, etc.).
""" ;
    ops:description_fr """Attribuer un label étendu à une information structurée (par ex. nom d'affichage avec titre, poste, etc.).
""" .

<https://ld.ech.ch/schema/0292/meta-common/remark> a owl:DatatypeProperty ;
    rdfs:label "remark" ;
    rdfs:range xsd:string ;
    skos:definition """Free-text remark or note for edge cases or additional context on a process step or an entity.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    ops:description_de """Freitext-Bemerkung oder Notiz für Sonderfälle oder zusätzlichen Kontext zu einem Prozessschritt oder einer Entität.
""" ;
    ops:description_fr """Remarque ou note en texte libre pour les cas particuliers ou pour un contexte supplémentaire relatif à une étape de processus ou à une entité.
""" .

<https://ch.paf.link/schema/meta/dates> a owl:ObjectProperty ;
    rdfs:label "dates" ;
    rdfs:range <https://ch.paf.link/schema/meta/Date> ;
    skos:definition """Dates relating to the element, each with a type indication.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Datumsangaben zum Element, jeweils mit Typangabe.
""" ;
    ops:description_fr """Dates relatives à l'élément, chacune assortie d'une indication de type.
""" .

ops:AgendaItem a owl:Class ;
    rdfs:label "AgendaItem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:speaking_actor_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:agenda_item_number ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:leading_actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:agenda_item_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Resolution ;
            owl:onProperty ops:has_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:state_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:has_resolution ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:agenda_item_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
