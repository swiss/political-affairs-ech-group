        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:state_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:agenda_item_position ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:MultilingualString ;
            owl:onProperty ops:agenda_item_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:leading_actor_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:agenda_item_category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:agenda_item_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:affair_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_agenda_item ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:affair_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_position ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:state_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:agenda_item_number ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:leading_actor_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_agenda_item ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:affair_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:speaking_actor_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:speaking_actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:state_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:has_resolution ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:agenda_item_category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_agenda_item ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:agenda_item_category ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification>,
        <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> ;
    skos:definition """An agenda item of a meeting.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Ein Traktandum einer Sitzung.
""" ;
    ops:description_fr """Un point de l'ordre du jour d'une séance.
""" .

ops:AgendaItemTypeEnum a owl:Class ;
    rdfs:label "AgendaItemTypeEnum" ;
    owl:unionOf ( <https://ch.paf.link/schema/operations/enum/agenda_item_type/item> <https://ch.paf.link/schema/operations/enum/agenda_item_type/group> ) ;
    skos:definition """Type of agenda item, distinguishing individual items from grouped items.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Art des Traktandums, unterscheidet einzelne von gruppierten Traktanden.
""" ;
    ops:description_fr """Type de point de l'ordre du jour, distinguant les points isolés des points regroupés.
""" ;
    linkml:permissible_values <https://ch.paf.link/schema/operations/enum/agenda_item_type/group>,
        <https://ch.paf.link/schema/operations/enum/agenda_item_type/item> .

ops:Attendance a owl:Class ;
    rdfs:label "Attendance" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:total_absent ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:total_absent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:total_absent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:total_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:total_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:total_excused ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty ops:total_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:total_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:total_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:total_excused ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:total_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:actor_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:datetime_begin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:total_excused ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """Aggregated attendance record for a meeting (number of members present, absent, excused).
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Aggregierte Anwesenheitsliste für eine Sitzung (Anzahl Anwesende, Abwesende, Entschuldigte).
""" ;
    ops:description_fr """Liste de présence agrégée pour une séance (nombre de membres présents, absents, excusés).
""" .

ops:DateTypesEnum a owl:Class ;
    rdfs:label "DateTypesEnum" ;
    owl:unionOf ( <https://ch.paf.link/schema/meta/vocabulary/date_types/FirstPublication> <https://ch.paf.link/schema/meta/vocabulary/date_types/LastRevision> ) ;
    skos:definition """Meaning of a date entry.
""" ;
    skos:inScheme <https://ch.paf.link/schema/meta> ;
    ops:description_de """Bedeutung einer Datumsangabe.
""" ;
    ops:description_fr """Signification d'une indication de date.
""" ;
    linkml:permissible_values <https://ch.paf.link/schema/meta/vocabulary/date_types/FirstPublication>,
        <https://ch.paf.link/schema/meta/vocabulary/date_types/LastRevision> .

ops:Protocol a owl:Class ;
    rdfs:label "Protocol" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ops:Voting ;
            owl:onProperty ops:voting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:Speech ;
            owl:onProperty ops:speech ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:protocolItem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:parent_meeting ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:TextSegment ;
            owl:onProperty ops:textSegment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:textSegment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:voting ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:ProtocolItem ;
            owl:onProperty ops:protocolItem ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:speech ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """The minutes of a meeting, recorded after the meeting. A wrapper container bundling the actually handled agenda items (protocol_items), votings, speeches, verbatim text segments and linked documents.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Das nach der Sitzung erstellte Protokoll. Ein Wrapper-Container, der die tatsächlich behandelten Traktanden (protocol_items), Abstimmungen, Wortmeldungen, Wortlaut-Textsegmente und verknüpfte Dokumente bündelt.
""" ;
    ops:description_fr """Le procès-verbal établi après la séance. Un conteneur qui regroupe les points effectivement traités (protocol_items), les votes, les interventions, les segments de texte in extenso et les documents liés.
""" .

ops:Resolution a owl:Class ;
    rdfs:label "Resolution" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:resolution_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:vote_procedures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:type_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:type_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:type_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom ops:ResolutionTypeEnum ;
            owl:onProperty ops:resolution_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty ops:vote_procedures ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty ops:resolution_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://ch.paf.link/schema/meta/Work> ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ch.paf.link/schema/meta/documents> ] ;
    skos:definition """A resolution or decision taken on an agenda item, including voting procedures.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Eine Resolution oder Entscheidung zu einem Traktandum, einschliesslich Abstimmungsverfahren.
""" ;
    ops:description_fr """Une décision prise sur un point de l'ordre du jour, y compris les procédures de vote.
""" .

ops:agendaItem a owl:ObjectProperty ;
    rdfs:label "agenda_items" ;
    rdfs:range ops:AgendaItem ;
    skos:definition """Collection of agenda item records.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Sammlung der Traktanden.
""" ;
    ops:description_fr """Ensemble des points de l'ordre du jour.
""" .

ops:meeting a owl:ObjectProperty ;
    rdfs:label "meetings" ;
    rdfs:range ops:Meeting ;
    skos:definition """Collection of meeting records.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
