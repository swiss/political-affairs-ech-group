ops:Legislature a owl:Class ;
    rdfs:label "Legislature" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty ops:landingPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
