        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification>,
        <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> ;
    skos:definition """Term of office of a parliament as a legislative assembly. Usually lasts four years.
""" ;
    skos:inScheme <https://ch.paf.link/schema/operations> ;
    ops:description_de """Amtsdauer eines Parlaments als gesetzgebender Versammlung. Dauert in der Regel vier Jahre.
""" ;
    ops:description_fr """Durée du mandat d'un parlement en tant qu'assemblée législative. Elle est en règle générale de quatre ans.
""" .

ops:ProtocolItem a owl:Class ;
