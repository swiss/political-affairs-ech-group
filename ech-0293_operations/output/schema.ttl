@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ops: <https://ch.paf.link/schema/operations/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
dcterms:language a owl:DatatypeProperty ;
	rdfs:label "expression_language" ;
	rdfs:range _:c14n414 ;
	skos:definition "Language code in ISO 639-1 format.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Sprachcode im ISO 639-1-Format.\n" ;
	ops:description_fr "Code de langue au format ISO 639-1.\n" .
<http://schema.org/description> a owl:DatatypeProperty ;
	rdfs:label "expression_description" ;
	rdfs:range xsd:string ;
	skos:definition "Descriptive text of the language version.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Beschreibender Text zur Sprachfassung.\n" ;
	ops:description_fr "Texte descriptif de la version linguistique.\n" .
<http://schema.org/validFrom> a owl:DatatypeProperty ;
	rdfs:label "valid_from" ;
	rdfs:range xsd:date ;
	skos:definition "The date from which the information is valid.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum, ab dem die Information gültig ist.\n" ;
	ops:description_fr "La date à partir de laquelle l'information est valable.\n" .
<http://schema.org/validThrough> a owl:DatatypeProperty ;
	rdfs:label "valid_through" ;
	rdfs:range xsd:date ;
	skos:definition "The date until which the information is valid, inclusive.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum, bis und mit dem die Information gültig ist.\n" ;
	ops:description_fr "La date jusqu'à laquelle l'information est valable, incluse.\n" .
<https://ch.paf.link/schema/meta/Expression> a owl:Class ;
	rdfs:label "Expression" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n11 , _:c14n131 , _:c14n203 , _:c14n262 , _:c14n288 , _:c14n307 , _:c14n309 , _:c14n329 , _:c14n330 , _:c14n390 , _:c14n394 , _:c14n403 , _:c14n433 , _:c14n472 , _:c14n516 , _:c14n589 , _:c14n591 , _:c14n600 , _:c14n619 , _:c14n678 , _:c14n692 , _:c14n82 , _:c14n99 ;
	skos:definition "FRBR Expression: a concrete language version of a Work.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "FRBR Expression: eine konkrete Sprachfassung eines Works.\n" ;
	ops:description_fr "FRBR Expression : une version linguistique concrète d'un Work.\n" .
<https://ch.paf.link/schema/meta/Manifestation> a owl:Class ;
	rdfs:label "Manifestation" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n186 , _:c14n197 , _:c14n2 , _:c14n212 , _:c14n215 , _:c14n221 , _:c14n258 , _:c14n3 , _:c14n40 , _:c14n428 , _:c14n507 , _:c14n517 , _:c14n531 , _:c14n63 , _:c14n647 , _:c14n657 , _:c14n664 , _:c14n689 ;
	skos:definition "FRBR Manifestation: a concrete file format of an Expression, addressable via a URL.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "FRBR Manifestation: eine konkrete Dateiform einer Expression, über eine URL adressierbar.\n" ;
	ops:description_fr "FRBR Manifestation : une forme de fichier concrète d'une Expression, adressable au moyen d'une URL.\n" .
<https://ch.paf.link/schema/meta/Work> a owl:Class ;
	rdfs:label "Work" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n177 , _:c14n22 , _:c14n310 , _:c14n437 , _:c14n95 ;
	skos:definition "FRBR Work: the abstract document as such, independent of a concrete language version or file format.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "FRBR Work: das abstrakte Dokument als solches, unabhängig von einer konkreten Sprachfassung oder einem Dateiformat.\n" ;
	ops:description_fr "FRBR Work : le document abstrait en tant que tel, indépendamment d'une version linguistique ou d'un format de fichier concrets.\n" .
<https://ch.paf.link/schema/meta/WorkContainer> a owl:Class ;
	rdfs:label "WorkContainer" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n301 , _:c14n399 ;
	skos:definition "Container for the documents (FRBR Works) of this schema. Deliberately not a tree_root, because the consuming schemas define their own Container.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Container für die Dokumente (FRBR Works) dieses Schemas. Bewusst kein tree_root, weil die konsumierenden Schemata ihren eigenen Container definieren.\n" ;
	ops:description_fr "Conteneur pour les documents (FRBR Works) de ce schéma. Volontairement pas un tree_root, car les schémas consommateurs définissent leur propre Container.\n" .
<https://ch.paf.link/schema/meta/documentCategory> a owl:ObjectProperty ;
	rdfs:label "document_category" ;
	rdfs:range ops:DocumentCategoryEnum ;
	skos:definition "Category of the document. If not set, 'other' is automatically used.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Kategorie des Dokuments. Wenn nicht gesetzt, wird automatisch 'other' verwendet.\n" ;
	ops:description_fr "Catégorie du document. Si elle n'est pas renseignée, la valeur 'other' est utilisée automatiquement.\n" .
<https://ch.paf.link/schema/meta/documents> a owl:ObjectProperty ;
	rdfs:label "documents" ;
	rdfs:range <https://ch.paf.link/schema/meta/Work> ;
	skos:definition "List of documents (FRBR Works) linked to the entity.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.\n" ;
	ops:description_fr "Liste des documents (FRBR Works) liés à l'entité.\n" .
<https://ch.paf.link/schema/meta/expressions> a owl:ObjectProperty ;
	rdfs:label "expressions" ;
	rdfs:range <https://ch.paf.link/schema/meta/Expression> ;
	skos:definition "The language versions (Expressions) of a Work.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Die Sprachfassungen (Expressions) eines Works.\n" ;
	ops:description_fr "Les versions linguistiques (Expressions) d'un Work.\n" .
<https://ch.paf.link/schema/meta/format> a owl:DatatypeProperty ;
	rdfs:label "format" ;
	rdfs:range xsd:string ;
	skos:definition "The file format of the manifestation (e.g., pdf, html).\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Das Dateiformat der Manifestation (z.B. pdf, html).\n" ;
	ops:description_fr "Le format de fichier de la manifestation (p. ex. pdf, html).\n" .
<https://ch.paf.link/schema/meta/manifestations> a owl:ObjectProperty ;
	rdfs:label "manifestations" ;
	rdfs:range <https://ch.paf.link/schema/meta/Manifestation> ;
	skos:definition "The file forms (Manifestations) of an Expression.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Die Dateiformen (Manifestations) einer Expression.\n" ;
	ops:description_fr "Les formes de fichier (Manifestations) d'une Expression.\n" .
<https://ch.paf.link/schema/meta/title> a owl:DatatypeProperty ;
	rdfs:label "expression_title" ;
	rdfs:range xsd:string ;
	skos:definition "Title of the language version.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Titel der Sprachfassung.\n" ;
	ops:description_fr "Titre de la version linguistique.\n" .
<https://ch.paf.link/schema/meta/url> a owl:DatatypeProperty ;
	rdfs:label "manifestation_url" ;
	rdfs:range xsd:anyURI ;
	skos:definition "URL under which the file form can be retrieved.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "URL, unter der die Dateiform abgerufen werden kann.\n" ;
	ops:description_fr "URL sous laquelle la forme de fichier peut être consultée.\n" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/ConsultationDocuments> dcterms:title "Consultation documents" ;
	a owl:Class ;
	rdfs:label "consultation_documents" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Documents opening a consultation. Examples: invitation, list of addressees, questionnaire, synoptic table.\n" ;
	ops:description_de "Unterlagen zur Eröffnung einer Vernehmlassung. Beispiele: Einladung, Adressatenliste, Fragebogen, synoptische Darstellung (Fahne).\n" ;
	ops:description_fr "Documents d'ouverture d'une consultation. Exemples : invitation, liste des destinataires, questionnaire, tableau synoptique.\n" ;
	ops:label_de "Vernehmlassungsdokumente" ;
	ops:label_en "Consultation documents" ;
	ops:label_fr "Documents de consultation" ;
	ops:label_it "Documenti di consultazione" ;
	ops:label_rm "Documents da consultaziun" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/ConsultationResults> dcterms:title "Consultation results" ;
	a owl:Class ;
	rdfs:label "consultation_results" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Results of a consultation. Examples: statement of an organisation or person, report on the results.\n" ;
	ops:description_de "Ergebnisse einer Vernehmlassung. Beispiele: Stellungnahme einer Organisation oder Person, Ergebnisbericht.\n" ;
	ops:description_fr "Résultats d'une consultation. Exemples : prise de position d'une organisation ou d'une personne, rapport sur les résultats.\n" ;
	ops:label_de "Vernehmlassungsresultate" ;
	ops:label_en "Consultation results" ;
	ops:label_fr "Résultats de la consultation" ;
	ops:label_it "Risultati della consultazione" ;
	ops:label_rm "Resultats da la consultaziun" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/GroupDocuments> dcterms:title "Group documents" ;
	a owl:Class ;
	rdfs:label "group_documents" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Documents of a group such as a committee or party. Examples: statutes, annual report, committee allocation.\n" ;
	ops:description_de "Unterlagen einer Gruppe wie Kommission oder Partei. Beispiele: Statuten, Jahresbericht, Kommissionszuteilung.\n" ;
	ops:description_fr "Documents d'un groupe tel qu'une commission ou un parti. Exemples : statuts, rapport annuel, répartition dans les commissions.\n" ;
	ops:label_de "Gruppenunterlagen" ;
	ops:label_en "Group documents" ;
	ops:label_fr "Documents de groupe" ;
	ops:label_it "Documenti di gruppo" ;
	ops:label_rm "Documents da gruppa" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/InterestDisclosure> dcterms:title "Interest disclosure" ;
	a owl:Class ;
	rdfs:label "interest_disclosure" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Registers of the interests of council members. Example: register of interests of the National Council.\n" ;
	ops:description_de "Register der Interessenbindungen von Ratsmitgliedern. Beispiel: Register der Interessenbindungen des Nationalrats.\n" ;
	ops:description_fr "Registres des liens d'intérêts des membres des conseils. Exemple : registre des liens d'intérêts du Conseil national.\n" ;
	ops:label_de "Interessenbindungen" ;
	ops:label_en "Interest disclosures" ;
	ops:label_fr "Liens d'intérêts" ;
	ops:label_it "Relazioni d'interesse" ;
	ops:label_rm "Colliaziuns d'interess" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/LegislativeDocuments> dcterms:title "Legislative documents" ;
	a owl:Class ;
	rdfs:label "legislative_documents" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Documents of the legislative process. Examples: draft act, explanatory report, adopted act, consolidated version.\n" ;
	ops:description_de "Dokumente des Gesetzgebungsverfahrens. Beispiele: Erlassentwurf, erläuternder Bericht, beschlossener Erlass, konsolidierte Fassung.\n" ;
	ops:description_fr "Documents de la procédure législative. Exemples : projet d'acte, rapport explicatif, acte adopté, version consolidée.\n" ;
	ops:label_de "Gesetzgebungsdokumente" ;
	ops:label_en "Legislative documents" ;
	ops:label_fr "Documents législatifs" ;
	ops:label_it "Documenti legislativi" ;
	ops:label_rm "Documents legislativs" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/MediaRelease> dcterms:title "Media release" ;
	a owl:Class ;
	rdfs:label "media_release" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Press releases.\n" ;
	ops:description_de "Medienmitteilungen.\n" ;
	ops:description_fr "Communiqués de presse.\n" ;
	ops:label_de "Medienmitteilung" ;
	ops:label_en "Media release" ;
	ops:label_fr "Communiqué de presse" ;
	ops:label_it "Comunicato stampa" ;
	ops:label_rm "Communicaziun da medias" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/MeetingDocuments> dcterms:title "Meeting documents" ;
	a owl:Class ;
	rdfs:label "meeting_documents" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Documents on the affairs of a meeting. Examples: agenda, session programme, list of parliamentary interventions.\n" ;
	ops:description_de "Unterlagen zu den Geschäften einer Sitzung. Beispiele: Traktandenliste, Sessionsprogramm, Vorstossliste.\n" ;
	ops:description_fr "Documents relatifs aux affaires d'une séance. Exemples : ordre du jour, programme de session, liste des interventions.\n" ;
	ops:label_de "Sitzungsunterlagen" ;
	ops:label_en "Meeting documents" ;
	ops:label_fr "Documents de séance" ;
	ops:label_it "Documenti di seduta" ;
	ops:label_rm "Documents da sesida" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/MeetingPlanning> dcterms:title "Meeting planning" ;
	a owl:Class ;
	rdfs:label "meeting_planning" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Planning of meetings and sessions. Examples: invitation, seating plan, time budget, deadlines for motions.\n" ;
	ops:description_de "Planung von Sitzungen und Sessionen. Beispiele: Einladung, Sitzplan, Zeitbudget, Fristen für Einzelanträge.\n" ;
	ops:description_fr "Planification des séances et des sessions. Exemples : convocation, plan de salle, budget-temps, délais pour les propositions individuelles.\n" ;
	ops:label_de "Sitzungsplanung" ;
	ops:label_en "Meeting planning" ;
	ops:label_fr "Planification de séance" ;
	ops:label_it "Pianificazione della seduta" ;
	ops:label_rm "Planisaziun da sesida" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/MemberDirectory> dcterms:title "Member directory" ;
	a owl:Class ;
	rdfs:label "member_directory" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Lists of members. Examples: members of the councils, committee members, members of friendship groups.\n" ;
	ops:description_de "Mitgliederlisten. Beispiele: Mitglieder der Räte, Kommissionsmitglieder, Mitglieder von Freundschaftsgruppen.\n" ;
	ops:description_fr "Listes des membres. Exemples : membres des conseils, membres des commissions, membres des groupes d'amitié.\n" ;
	ops:label_de "Mitgliederverzeichnis" ;
	ops:label_en "Member directory" ;
	ops:label_fr "Liste des membres" ;
	ops:label_it "Elenco dei membri" ;
	ops:label_rm "Glista dals commembers" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/Other> dcterms:title "Other" ;
	a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Document that fits none of the categories, or whose category is unknown. Default if `document_category` is not set.\n" ;
	ops:description_de "Dokument, das keiner Kategorie zugeordnet werden kann oder dessen Kategorie unbekannt ist. Default, wenn `document_category` nicht gesetzt ist.\n" ;
	ops:description_fr "Document ne relevant d'aucune catégorie ou dont la catégorie est inconnue. Valeur par défaut si `document_category` n'est pas renseigné.\n" ;
	ops:label_de "Andere" ;
	ops:label_en "Other" ;
	ops:label_fr "Autre" ;
	ops:label_it "Altro" ;
	ops:label_rm "Auter" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/PersonDocuments> dcterms:title "Person documents" ;
	a owl:Class ;
	rdfs:label "person_documents" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Documents on individual persons. Examples: portrait of a council member, list of personal staff.\n" ;
	ops:description_de "Unterlagen zu einzelnen Personen. Beispiele: Porträt eines Ratsmitglieds, Liste der persönlichen Mitarbeitenden.\n" ;
	ops:description_fr "Documents relatifs à des personnes. Exemples : portrait d'un membre du conseil, liste des collaboratrices et collaborateurs personnels.\n" ;
	ops:label_de "Personenunterlagen" ;
	ops:label_en "Person documents" ;
	ops:label_fr "Documents personnels" ;
	ops:label_it "Documenti personali" ;
	ops:label_rm "Documents da persuna" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/Protocol> dcterms:title "Protocol" ;
	a owl:Class ;
	rdfs:label "protocol" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Record of the proceedings of a meeting. Examples: verbatim record, decision minutes, speaker list, video recording.\n" ;
	ops:description_de "Aufzeichnung des Verlaufs einer Sitzung. Beispiele: Wortprotokoll, Beschlussprotokoll, Rednerliste, Videoaufzeichnung.\n" ;
	ops:description_fr "Enregistrement du déroulement d'une séance. Exemples : procès-verbal in extenso, procès-verbal des décisions, liste des orateurs, enregistrement vidéo.\n" ;
	ops:label_de "Protokoll" ;
	ops:label_en "Minutes" ;
	ops:label_fr "Procès-verbal" ;
	ops:label_it "Verbale" ;
	ops:label_rm "Protocol" .
<https://ch.paf.link/schema/meta/vocabulary/document_category/VotingResult> dcterms:title "Voting result" ;
	a owl:Class ;
	rdfs:label "voting_result" ;
	rdfs:subClassOf ops:DocumentCategoryEnum ;
	skos:definition "Results of votes and elections. Examples: voting record, election record.\n" ;
	ops:description_de "Ergebnisse von Abstimmungen und Wahlen. Beispiele: Abstimmungsprotokoll, Wahlprotokoll.\n" ;
	ops:description_fr "Résultats des votes et des élections. Exemples : procès-verbal de vote, procès-verbal d'élection.\n" ;
	ops:label_de "Abstimmungsergebnis" ;
	ops:label_en "Voting result" ;
	ops:label_fr "Résultat du vote" ;
	ops:label_it "Risultato della votazione" ;
	ops:label_rm "Resultat da votaziun" .
<https://ch.paf.link/schema/meta/works> a owl:ObjectProperty ;
	rdfs:label "works" ;
	rdfs:range <https://ch.paf.link/schema/meta/Work> ;
	skos:definition "The documents (FRBR Works) contained in the container.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Die im Container enthaltenen Dokumente (FRBR Works).\n" ;
	ops:description_fr "Les documents (FRBR Works) contenus dans le conteneur.\n" .
<https://ch.paf.link/schema/operations.owl.ttl> a owl:Ontology ;
	rdfs:label "operations" ;
	skos:definition "Meeting Schema for various legislative bodies\n" ;
	ops:description_de "Sitzungs-Schema für verschiedene gesetzgebende Körperschaften\n" ;
	ops:description_fr "Schéma des séances pour différents corps législatifs\n" .
ops:AgendaItem a owl:Class ;
	rdfs:label "AgendaItem" ;
	rdfs:subClassOf ops:IsAgendaItem , <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> ;
	skos:definition "An agenda item of a meeting as planned beforehand. It structures the agenda and connects the temporal organisation (Meeting) with the substantive affairs (eCH-0295). It is embedded in its meeting (Meeting.agenda_items) or directly in its session (Session.agenda_items). Agenda items represent the planning of a meeting and are no longer changed in the data once the meeting has started: deviations during the meeting — items brought forward, postponed or added — are recorded in the protocol (ProtocolItem) and feed into the agenda of the next meeting. For the same reason, planned and actual times are kept separately.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ein vorgängig geplantes Traktandum einer Sitzung. Es gliedert die Tagesordnung und verbindet die zeitliche Organisation (Meeting) mit den inhaltlichen Geschäften (eCH-0295). Es ist in seine Sitzung eingebettet (Meeting.agenda_items) oder direkt in seine Session (Session.agenda_items). Traktanden bilden die Planung einer Sitzung ab und werden nach Sitzungsbeginn in den Daten nicht mehr geändert: Abweichungen während der Sitzung — vorgezogene, verschobene oder zusätzliche Traktanden — werden im Protokoll (ProtocolItem) erfasst und fliessen in die Traktandenliste der nächsten Sitzung ein. Aus demselben Grund werden geplante und tatsächliche Zeiten getrennt geführt.\n" ;
	ops:description_fr "Un point de l'ordre du jour d'une séance, tel que planifié à l'avance. Il structure l'ordre du jour et relie l'organisation temporelle (Meeting) aux affaires matérielles (eCH-0295). Il est imbriqué dans sa séance (Meeting.agenda_items) ou directement dans sa session (Session.agenda_items). Les points de l'ordre du jour représentent la planification d'une séance et ne sont plus modifiés dans les données une fois la séance ouverte : les écarts survenus durant la séance — points avancés, reportés ou ajoutés — sont consignés au procès-verbal (ProtocolItem) et se répercutent sur l'ordre du jour de la séance suivante. Pour la même raison, les heures prévues et effectives sont tenues séparément.\n" .
ops:AgendaItemTypeEnum a owl:Class ;
	rdfs:label "AgendaItemTypeEnum" ;
	owl:unionOf _:c14n260 ;
	skos:definition "Type of agenda item, distinguishing individual items from grouped items.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Traktandums, unterscheidet einzelne von gruppierten Traktanden.\n" ;
	ops:description_fr "Type de point de l'ordre du jour, distinguant les points isolés des points regroupés.\n" ;
	linkml:permissible_values ops:enum\/agenda_item_type\/group , ops:enum\/agenda_item_type\/item .
ops:Attendance a owl:Class ;
	rdfs:label "Attendance" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n12 , _:c14n172 , _:c14n176 , _:c14n268 , _:c14n284 , _:c14n354 , _:c14n378 , _:c14n419 , _:c14n42 , _:c14n425 , _:c14n440 , _:c14n441 , _:c14n50 , _:c14n520 , _:c14n535 , _:c14n538 , _:c14n548 , _:c14n601 , _:c14n631 , _:c14n91 , _:c14n92 ;
	skos:definition "Aggregated attendance record for a meeting (number of members present, absent, excused): it records which members of a parliamentary body were present, absent or excused at a sitting. Attendance is captured on two levels — this aggregate with the totals for the meeting, and one IndividualAttendance per person, linked to it via parent_attendance. Attendance records serve the documentation of participation, the verification of the quorum, transparency towards the public, accountability for the fulfilment of duties, statistics on attendance rates and the administration of allowances and expenses.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Aggregierte Anwesenheitsliste für eine Sitzung (Anzahl Anwesende, Abwesende, Entschuldigte): Sie hält fest, welche Mitglieder eines parlamentarischen Organs bei einer Sitzung anwesend, abwesend oder entschuldigt waren. Die Anwesenheit wird auf zwei Ebenen erfasst — mit diesem Aggregat und den Gesamtzahlen für die Sitzung sowie mit je einer IndividualAttendance pro Person, die über parent_attendance daran hängt. Anwesenheitslisten dienen der Dokumentation der Teilnahme, der Prüfung der Beschlussfähigkeit, der Transparenz gegenüber der Öffentlichkeit, der Rechenschaft über die Pflichterfüllung, der Statistik von Anwesenheitsquoten sowie der Administration von Entschädigungen und Spesen.\n" ;
	ops:description_fr "Liste de présence agrégée pour une séance (nombre de membres présents, absents, excusés) : elle retient quels membres d'un organe parlementaire étaient présents, absents ou excusés lors d'une séance. La présence est saisie à deux niveaux — par cet agrégat avec les totaux de la séance, et par une IndividualAttendance par personne, rattachée à celui-ci via parent_attendance. Les listes de présence servent à documenter la participation, à vérifier le quorum, à la transparence envers le public, à rendre compte de l'accomplissement des devoirs, à établir des statistiques sur les taux de présence ainsi qu'à administrer les indemnités et les frais.\n" .
ops:AttendanceTypeEnum a owl:Class ;
	rdfs:label "AttendanceTypeEnum" ;
	owl:unionOf _:c14n179 ;
	skos:definition "Type of individual attendance.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der individuellen Anwesenheit.\n" ;
	ops:description_fr "Type de présence individuelle.\n" ;
	linkml:permissible_values ops:enum\/attendance_type\/present , ops:enum\/attendance_type\/remote , ops:enum\/attendance_type\/substitute .
ops:Container a owl:Class ;
	rdfs:label "Container" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n101 , _:c14n107 , _:c14n14 , _:c14n153 , _:c14n16 , _:c14n171 , _:c14n222 , _:c14n23 , _:c14n245 , _:c14n295 , _:c14n33 , _:c14n356 , _:c14n364 , _:c14n430 , _:c14n453 , _:c14n481 , _:c14n524 , _:c14n539 , _:c14n540 , _:c14n606 , _:c14n649 , _:c14n88 ;
	skos:definition "Container for the records of public council operations: legislatures, sessions, meetings, protocols, votings, elections, attendances, speeches and resolutions.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Container für die Daten des öffentlichen Ratsbetriebs: Legislaturperioden, Sessionen, Sitzungen, Protokolle, Abstimmungen, Wahlen, Anwesenheiten, Wortmeldungen und Resolutionen.\n" ;
	ops:description_fr "Conteneur pour les données de l'activité publique des conseils : législatures, sessions, séances, procès-verbaux, votes, élections, présences, interventions et décisions.\n" .
ops:DocumentCategoryEnum a owl:Class ;
	rdfs:label "DocumentCategoryEnum" ;
	owl:unionOf _:c14n1 ;
	skos:definition "Categories for classifying documents referenced in eCH standards 0292-0297. Multilingual labels (DE/FR/IT/RM/EN) are encoded via `annotations` (convention `label_xx`); first proposals for FR/IT/RM are pending plenum review.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	ops:description_de "Kategorien zur Klassifikation von Dokumenten, die in den eCH Standards 0292-0297 referenziert werden. Mehrsprachige Labels (DE/FR/IT/RM/EN) sind über `annotations` (Konvention `label_xx`) abgebildet; Erstvorschläge für FR/IT/RM stehen unter Plenum-Review.\n" ;
	ops:description_fr "Catégories de classification des documents référencés dans les normes eCH 0292-0297. Les libellés multilingues (DE/FR/IT/RM/EN) sont représentés au moyen d'`annotations` (convention `label_xx`) ; les premières propositions pour FR/IT/RM sont en cours de revue par le plénum.\n" ;
	linkml:permissible_values <https://ch.paf.link/schema/meta/vocabulary/document_category/ConsultationDocuments> , <https://ch.paf.link/schema/meta/vocabulary/document_category/ConsultationResults> , <https://ch.paf.link/schema/meta/vocabulary/document_category/GroupDocuments> , <https://ch.paf.link/schema/meta/vocabulary/document_category/InterestDisclosure> , <https://ch.paf.link/schema/meta/vocabulary/document_category/LegislativeDocuments> , <https://ch.paf.link/schema/meta/vocabulary/document_category/MediaRelease> , <https://ch.paf.link/schema/meta/vocabulary/document_category/MeetingDocuments> , <https://ch.paf.link/schema/meta/vocabulary/document_category/MeetingPlanning> , <https://ch.paf.link/schema/meta/vocabulary/document_category/MemberDirectory> , <https://ch.paf.link/schema/meta/vocabulary/document_category/Other> , <https://ch.paf.link/schema/meta/vocabulary/document_category/PersonDocuments> , <https://ch.paf.link/schema/meta/vocabulary/document_category/Protocol> , <https://ch.paf.link/schema/meta/vocabulary/document_category/VotingResult> .
ops:Election a owl:Class ;
	rdfs:label "Election" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n102 , _:c14n125 , _:c14n135 , _:c14n146 , _:c14n152 , _:c14n158 , _:c14n160 , _:c14n175 , _:c14n191 , _:c14n206 , _:c14n216 , _:c14n244 , _:c14n252 , _:c14n263 , _:c14n272 , _:c14n290 , _:c14n291 , _:c14n333 , _:c14n337 , _:c14n34 , _:c14n341 , _:c14n35 , _:c14n366 , _:c14n396 , _:c14n407 , _:c14n426 , _:c14n434 , _:c14n451 , _:c14n463 , _:c14n469 , _:c14n474 , _:c14n530 , _:c14n583 , _:c14n599 , _:c14n605 , _:c14n61 , _:c14n616 , _:c14n617 , _:c14n618 , _:c14n624 , _:c14n625 , _:c14n642 , _:c14n653 , _:c14n656 , _:c14n666 , _:c14n667 , _:c14n7 , _:c14n707 , _:c14n86 , _:c14n9 ;
	skos:definition "An election in which a parliamentary body appoints one or several persons to an office or function. Unlike a voting (Voting), which decides substantive questions, an election is a decision on persons: it is often held by secret ballot and usually requires an absolute majority, whereas votings are mostly open. The presiding member, who does not take part in votings, does vote in elections. Each ballot is recorded as a separate election; the ballots of one election are linked through the common agenda item — for instance a first ballot requiring an absolute majority that remains without result, followed by a second ballot in which the relative majority suffices.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine Wahl, mit der ein parlamentarisches Organ eine oder mehrere Personen für ein Amt oder eine Funktion bestimmt. Im Unterschied zur Abstimmung (Voting), die über Sachfragen entscheidet, ist die Wahl ein Personenentscheid: Sie erfolgt oft geheim und erfordert meist das absolute Mehr, während Abstimmungen meist offen sind. Die Präsidentin oder der Präsident, die an Abstimmungen nicht teilnehmen, stimmen bei Wahlen mit. Jeder Wahlgang wird als eigene Wahl erfasst; die Wahlgänge einer Wahl sind über das gemeinsame Traktandum verbunden — etwa ein erster Wahlgang mit absolutem Mehr, der ohne Ergebnis bleibt, und ein zweiter Wahlgang, in dem das relative Mehr genügt.\n" ;
	ops:description_fr "Une élection par laquelle un organe parlementaire désigne une ou plusieurs personnes à une charge ou à une fonction. Contrairement au vote (Voting), qui tranche des questions matérielles, l'élection est une décision portant sur des personnes : elle a souvent lieu au scrutin secret et requiert en général la majorité absolue, alors que les votes sont le plus souvent ouverts. La présidente ou le président, qui ne participe pas aux votes, prend part aux élections. Chaque tour de scrutin est saisi comme une élection distincte ; les tours d'une même élection sont reliés par le point de l'ordre du jour commun — par exemple un premier tour à la majorité absolue resté sans résultat, suivi d'un second tour où la majorité relative suffit.\n" .
ops:ElectionTypeEnum a owl:Class ;
	rdfs:label "ElectionTypeEnum" ;
	owl:unionOf _:c14n637 ;
	skos:definition "Type of election procedure.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Wahlverfahrens.\n" ;
	ops:description_fr "Type de procédure d'élection.\n" ;
	linkml:permissible_values ops:enum\/election_type\/open , ops:enum\/election_type\/secret , ops:enum\/election_type\/silent .
ops:IndividualAttendance a owl:Class ;
	rdfs:label "IndividualAttendance" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n118 , _:c14n220 , _:c14n223 , _:c14n234 , _:c14n248 , _:c14n271 , _:c14n279 , _:c14n285 , _:c14n523 , _:c14n573 , _:c14n94 ;
	skos:definition "Individual attendance record for a specific person at a meeting (linked via the parent Attendance aggregate). It concerns the meeting as a whole and differs from the individual vote (IndividualVote), which records the vote cast in a specific voting: a person present at the meeting (attendance_type present) can be recorded with not_voted in a single voting because they briefly left the chamber at that moment.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Einzelne Anwesenheitsfeststellung einer Person an einer Sitzung (verknüpft über das übergeordnete Attendance-Aggregat). Sie betrifft die Sitzung als Ganzes und unterscheidet sich von der Einzelstimme (IndividualVote), welche die Stimmabgabe in einer bestimmten Abstimmung festhält: Eine an der Sitzung anwesende Person (attendance_type present) kann bei einer einzelnen Abstimmung mit not_voted erfasst werden, weil sie in diesem Moment kurz den Saal verlassen hat.\n" ;
	ops:description_fr "Constatation individuelle de la présence d'une personne à une séance (rattachée à l'agrégat Attendance parent). Elle porte sur la séance dans son ensemble et se distingue de la voix individuelle (IndividualVote), qui retient la voix exprimée lors d'un vote déterminé : une personne présente à la séance (attendance_type present) peut être saisie avec not_voted lors d'un vote particulier parce qu'elle a brièvement quitté la salle à ce moment-là.\n" .
ops:IndividualVote a owl:Class ;
	rdfs:label "IndividualVote" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n126 , _:c14n141 , _:c14n26 , _:c14n376 , _:c14n443 , _:c14n465 , _:c14n479 , _:c14n541 , _:c14n551 , _:c14n571 , _:c14n609 , _:c14n621 , _:c14n636 , _:c14n684 , _:c14n691 , _:c14n693 , _:c14n80 , _:c14n97 ;
	skos:definition "The vote cast by an individual member in a voting. Individual votes are only recorded for open votings; for secret votings only the overall result is published. An individual vote concerns one specific voting and differs from attendance (Attendance), which records presence at the meeting as a whole: a member present at the meeting may be recorded as not_voted in a single voting, for instance because they briefly left the room.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die Stimme, die ein einzelnes Mitglied in einer Abstimmung abgibt. Einzelstimmen werden nur bei offenen Abstimmungen erfasst; bei geheimen Abstimmungen wird nur das Gesamtergebnis publiziert. Eine Einzelstimme betrifft eine bestimmte Abstimmung und unterscheidet sich von der Anwesenheit (Attendance), welche die Präsenz an der Sitzung als Ganzes festhält: Ein an der Sitzung anwesendes Mitglied kann bei einer einzelnen Abstimmung mit not_voted erfasst werden, etwa weil es kurz den Saal verlassen hat.\n" ;
	ops:description_fr "La voix exprimée par un membre lors d'un vote. Les voix individuelles ne sont saisies que pour les votes ouverts ; pour les votes secrets, seul le résultat global est publié. Une voix individuelle concerne un vote déterminé et se distingue de la présence (Attendance), qui retient la présence à la séance dans son ensemble : un membre présent à la séance peut être saisi avec not_voted lors d'un vote particulier, par exemple parce qu'il a brièvement quitté la salle.\n" .
ops:IndividualVoteTypeEnum a owl:Class ;
	rdfs:label "IndividualVoteTypeEnum" ;
	owl:unionOf _:c14n236 ;
	skos:definition "Type of individual vote cast by a member.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der Einzelstimme eines Mitglieds.\n" ;
	ops:description_fr "Type de voix individuelle exprimée par un membre.\n" ;
	linkml:permissible_values ops:enum\/individual_vote_type\/abstention , ops:enum\/individual_vote_type\/no , ops:enum\/individual_vote_type\/not_voted , ops:enum\/individual_vote_type\/other , ops:enum\/individual_vote_type\/tie_breaker , ops:enum\/individual_vote_type\/yes .
ops:IsAgendaItem a owl:Class ;
	rdfs:label "IsAgendaItem" ;
	rdfs:subClassOf _:c14n106 , _:c14n122 , _:c14n132 , _:c14n138 , _:c14n192 , _:c14n194 , _:c14n209 , _:c14n213 , _:c14n226 , _:c14n227 , _:c14n241 , _:c14n251 , _:c14n254 , _:c14n274 , _:c14n278 , _:c14n289 , _:c14n339 , _:c14n340 , _:c14n343 , _:c14n344 , _:c14n355 , _:c14n362 , _:c14n389 , _:c14n39 , _:c14n395 , _:c14n408 , _:c14n410 , _:c14n420 , _:c14n454 , _:c14n480 , _:c14n492 , _:c14n494 , _:c14n513 , _:c14n518 , _:c14n536 , _:c14n562 , _:c14n564 , _:c14n57 , _:c14n598 , _:c14n646 , _:c14n662 , _:c14n67 , _:c14n675 , _:c14n677 , _:c14n683 , _:c14n690 , _:c14n694 , _:c14n76 ;
	skos:definition "A mixin class that provides the elements of an agenda item: designation, type, actors, the link to the affair, state, resolution and attached texts and documents. It is used by the planned agenda item (AgendaItem) and by the recorded one (ProtocolItem), so that both carry the same elements without one depending on the other.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine Mixin-Klasse, welche die Elemente eines Traktandums bereitstellt: Bezeichnung, Art, Akteure, Bezug zum Geschäft, Status, Beschluss sowie angehängte Texte und Dokumente. Sie wird vom geplanten Traktandum (AgendaItem) und vom protokollierten (ProtocolItem) verwendet, damit beide dieselben Elemente führen, ohne dass das eine vom anderen abhängt.\n" ;
	ops:description_fr "Une classe mixin qui fournit les éléments d'un point de l'ordre du jour : désignation, type, acteurs, lien avec l'affaire, état, décision ainsi que les textes et documents rattachés. Elle est utilisée par le point planifié (AgendaItem) et par le point consigné (ProtocolItem), de sorte que les deux portent les mêmes éléments sans que l'un dépende de l'autre.\n" .
ops:JointDebate a owl:Class ;
	rdfs:label "JointDebate" ;
	rdfs:subClassOf _:c14n114 , _:c14n38 ;
	skos:definition "A joint debate: several agenda items are deliberated together, for instance substantively related affairs dealt with in a single debate. The joint debate hangs on an agenda item (AgendaItem), a protocol item (ProtocolItem), a meeting (Meeting) or a session (Session) and references the items debated jointly by their identifiers. Attached to a meeting or a session, it can also bring together agenda items that are distributed over several agenda positions or meetings.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine gemeinsame Beratung: Mehrere Traktanden werden zusammen behandelt, etwa inhaltlich zusammenhängende Geschäfte, die in einer einzigen Debatte beraten werden. Die gemeinsame Beratung hängt an einem Traktandum (AgendaItem), einem Protokoll-Traktandum (ProtocolItem), einer Sitzung (Meeting) oder einer Session (Session) und verweist über deren Identifikatoren auf die gemeinsam behandelten Traktanden. An einer Sitzung oder Session angehängt, kann sie auch Traktanden zusammenfassen, die auf mehrere Traktandenpositionen oder Sitzungen verteilt sind.\n" ;
	ops:description_fr "Une délibération commune : plusieurs points de l'ordre du jour sont traités ensemble, par exemple des affaires connexes délibérées dans un seul et même débat. La délibération commune est rattachée à un point de l'ordre du jour (AgendaItem), à un point du procès-verbal (ProtocolItem), à une séance (Meeting) ou à une session (Session) et renvoie, par leurs identifiants, aux points traités conjointement. Rattachée à une séance ou à une session, elle peut aussi réunir des points répartis sur plusieurs positions de l'ordre du jour ou sur plusieurs séances.\n" .
ops:Legislature a owl:Class ;
	rdfs:label "Legislature" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> , _:c14n116 , _:c14n123 , _:c14n267 , _:c14n281 , _:c14n300 , _:c14n303 , _:c14n325 , _:c14n382 , _:c14n405 , _:c14n471 , _:c14n491 , _:c14n53 , _:c14n546 , _:c14n630 , _:c14n648 , _:c14n660 , _:c14n661 , _:c14n674 , _:c14n709 ;
	skos:definition "Term of office of a parliament as a legislative assembly. Usually lasts four years.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Amtsdauer eines Parlaments als gesetzgebender Versammlung. Dauert in der Regel vier Jahre.\n" ;
	ops:description_fr "Durée du mandat d'un parlement en tant qu'assemblée législative. Elle est en règle générale de quatre ans.\n" .
ops:MajorityTypeEnum a owl:Class ;
	rdfs:label "MajorityTypeEnum" ;
	owl:unionOf _:c14n401 ;
	skos:definition "Type of majority required for the vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der für die Abstimmung erforderlichen Mehrheit.\n" ;
	ops:description_fr "Type de majorité requise pour le vote.\n" ;
	linkml:permissible_values ops:enum\/majority_type\/absolute , ops:enum\/majority_type\/other , ops:enum\/majority_type\/two_thirds .
ops:Media a owl:Class ;
	rdfs:label "Media" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n25 , _:c14n257 , _:c14n276 , _:c14n361 , _:c14n412 , _:c14n45 , _:c14n478 , _:c14n512 , _:c14n52 , _:c14n534 , _:c14n549 , _:c14n570 , _:c14n629 , _:c14n710 ;
	skos:definition "Media files or documents (including protocols in PDF/HTML/WORD or links to audio/video).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Mediendateien oder Dokumente (einschliesslich Protokolle in PDF/HTML/WORD oder Links zu Audio/Video).\n" ;
	ops:description_fr "Fichiers médias ou documents (y compris les procès-verbaux en PDF/HTML/WORD ou les liens vers des contenus audio/vidéo).\n" .
ops:Meeting a owl:Class ;
	rdfs:label "Meeting" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> , _:c14n108 , _:c14n112 , _:c14n117 , _:c14n136 , _:c14n149 , _:c14n170 , _:c14n18 , _:c14n184 , _:c14n189 , _:c14n195 , _:c14n20 , _:c14n214 , _:c14n239 , _:c14n242 , _:c14n259 , _:c14n28 , _:c14n283 , _:c14n30 , _:c14n305 , _:c14n306 , _:c14n314 , _:c14n315 , _:c14n320 , _:c14n335 , _:c14n345 , _:c14n347 , _:c14n353 , _:c14n374 , _:c14n379 , _:c14n381 , _:c14n397 , _:c14n406 , _:c14n423 , _:c14n424 , _:c14n429 , _:c14n436 , _:c14n442 , _:c14n470 , _:c14n473 , _:c14n495 , _:c14n500 , _:c14n529 , _:c14n54 , _:c14n544 , _:c14n558 , _:c14n584 , _:c14n594 , _:c14n6 , _:c14n620 , _:c14n645 , _:c14n650 , _:c14n654 , _:c14n659 , _:c14n669 , _:c14n670 , _:c14n673 , _:c14n676 , _:c14n68 , _:c14n680 , _:c14n686 , _:c14n695 , _:c14n705 , _:c14n71 , _:c14n711 , _:c14n72 , _:c14n75 , _:c14n93 ;
	skos:definition "The individual sitting of a body — the level at which agenda items are deliberated, decisions taken and speeches recorded. The meeting is the node to which the other classes of this standard attach: its agenda items (AgendaItem) are embedded in it (agenda_items), while votings and elections (Voting, Election), speeches (Speech) and the attendance list (Attendance) reference it via `parent_meeting`. At this level, scheduled and actual times regularly diverge — a sitting scheduled for 14:00 only begins at 14:25 because of delays and ends at 17:30 instead of 18:00 — which is why both the planned and the actual begin and end are recorded.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die einzelne Sitzung eines Organs — die Ebene, auf der Traktanden beraten, Beschlüsse gefasst und Wortmeldungen festgehalten werden. Die Sitzung ist der Knoten, an dem die übrigen Klassen dieses Standards hängen: Ihre Traktanden (AgendaItem) sind in sie eingebettet (agenda_items), während Abstimmungen und Wahlen (Voting, Election), Wortmeldungen (Speech) sowie die Anwesenheitsliste (Attendance) über `parent_meeting` auf sie verweisen. Auf dieser Ebene fallen geplante und tatsächliche Zeiten regelmässig auseinander — eine für 14:00 angesetzte Sitzung beginnt wegen Verzögerungen erst um 14:25 und endet statt um 18:00 bereits um 17:30 —, weshalb Beginn und Ende sowohl geplant als auch tatsächlich erfasst werden.\n" ;
	ops:description_fr "La séance individuelle d'un organe — le niveau auquel les points de l'ordre du jour sont délibérés, les décisions prises et les interventions consignées. La séance est le nœud auquel se rattachent les autres classes de la présente norme : ses points de l'ordre du jour (AgendaItem) y sont imbriqués (agenda_items), tandis que les votes et élections (Voting, Election), les interventions (Speech) ainsi que la liste de présence (Attendance) y renvoient via `parent_meeting`. À ce niveau, les heures prévues et les heures effectives divergent régulièrement — une séance fixée à 14h00 ne commence, en raison de retards, qu'à 14h25 et se termine à 17h30 au lieu de 18h00 —, raison pour laquelle le début et la fin sont consignés tant prévus qu'effectifs.\n" .
ops:Motion a owl:Class ;
	rdfs:label "Motion" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n228 , _:c14n46 , _:c14n519 , _:c14n547 , _:c14n574 , _:c14n582 , _:c14n597 , _:c14n644 ;
	skos:definition "A formal proposal submitted during the proceedings, such as an amendment to a legal text, a procedural motion (e.g. closure of the debate) or a motion to refer back. It is an entity in its own right because an agenda item may contain several motions, each with its own course (submitted, supported, voted on) and possibly a vote of its own.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ein formaler Antrag, der während der Beratung gestellt wird, etwa ein Änderungsantrag zu einem Gesetzestext, ein Ordnungsantrag (z.B. Schluss der Debatte) oder ein Rückweisungsantrag. Er ist eine eigene Entität, weil ein Traktandum mehrere Anträge enthalten kann, die je einen eigenen Verlauf haben (gestellt, unterstützt, abgestimmt) und gegebenenfalls einzeln abgestimmt werden.\n" ;
	ops:description_fr "Une proposition formelle déposée au cours des délibérations, par exemple une proposition d'amendement à un texte légal, une motion d'ordre (p. ex. clôture du débat) ou une proposition de renvoi. Elle constitue une entité propre, car un point de l'ordre du jour peut comprendre plusieurs propositions, chacune ayant son propre déroulement (déposée, soutenue, mise aux voix) et, le cas échéant, son propre vote.\n" .
ops:MultilingualString a owl:Class ;
	rdfs:label "MultilingualString" ;
	rdfs:subClassOf _:c14n104 , _:c14n147 , _:c14n402 , _:c14n489 , _:c14n556 , _:c14n62 ;
	skos:definition "A string that can contain text in multiple languages.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ein String, der Text in mehreren Sprachen enthalten kann.\n" ;
	ops:description_fr "Une chaîne de caractères pouvant contenir du texte en plusieurs langues.\n" .
ops:Protocol a owl:Class ;
	rdfs:label "Protocol" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n156 , _:c14n164 , _:c14n231 , _:c14n311 , _:c14n321 , _:c14n388 , _:c14n398 , _:c14n44 , _:c14n51 , _:c14n514 , _:c14n577 , _:c14n627 , _:c14n635 , _:c14n681 , _:c14n87 ;
	skos:definition "The minutes of a meeting, recorded after the meeting and kept exactly once per meeting. A wrapper container bundling the agenda items actually dealt with (protocol_items), votings, elections, speeches, verbatim text segments and linked documents. The protocol has its own identifier, can be cited on its own and is usually published later than the meeting; the meeting therefore only references it (Meeting.has_protocol), and the protocol itself is delivered in Container.protocols, so that it can be delivered later without delivering the meeting again. Within the protocol the collections are embedded, because they arise and are delivered together with it. Whoever publishes votings or speeches independently of the protocol delivers them flat in Container.votings or Container.speeches and links them via parent_meeting and the respective agenda item reference.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das Protokoll einer Sitzung, nach der Sitzung erstellt und pro Sitzung genau einmal geführt. Ein Wrapper-Container, der die effektiv behandelten Traktanden (protocol_items), Abstimmungen, Wahlen, Wortmeldungen, Wortlaut-Textsegmente und verknüpfte Dokumente bündelt. Das Protokoll hat einen eigenen Identifikator, ist eigenständig zitierbar und wird in der Regel später veröffentlicht als die Sitzung; die Sitzung referenziert es deshalb nur (Meeting.has_protocol), und das Protokoll selbst wird in Container.protocols geliefert, sodass es nachgeliefert werden kann, ohne die Sitzung erneut zu liefern. Innerhalb des Protokolls sind die Sammlungen eingebettet, weil sie zusammen mit ihm entstehen und geliefert werden. Wer Abstimmungen oder Wortmeldungen unabhängig vom Protokoll publiziert, liefert sie flach in Container.votings bzw. Container.speeches und verknüpft sie über parent_meeting und die jeweilige Traktandenreferenz.\n" ;
	ops:description_fr "Le procès-verbal d'une séance, établi après celle-ci et tenu exactement une fois par séance. Un conteneur qui regroupe les points effectivement traités (protocol_items), les votes, les élections, les interventions, les segments de texte in extenso et les documents liés. Le procès-verbal possède son propre identifiant, peut être cité de manière autonome et est en règle générale publié après la séance ; la séance ne fait donc que le référencer (Meeting.has_protocol), et le procès-verbal lui-même est livré dans Container.protocols, de sorte qu'il puisse être livré ultérieurement sans relivrer la séance. À l'intérieur du procès-verbal, les collections sont imbriquées, car elles naissent et sont livrées avec lui. Qui publie des votes ou des interventions indépendamment du procès-verbal les livre à plat dans Container.votings ou Container.speeches et les relie par parent_meeting et la référence au point de l'ordre du jour correspondante.\n" .
ops:ProtocolItem a owl:Class ;
	rdfs:label "ProtocolItem" ;
	rdfs:subClassOf ops:IsAgendaItem , <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> ;
	skos:definition "An agenda item as actually recorded in the protocol. It carries the same elements as AgendaItem through the IsAgendaItem mixin, but is a class in its own right: the record is not a special case of the plan. It arises independently and may contain items that were never put on the agenda, just as the agenda may contain items that were never dealt with.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ein Traktandum, wie es im Protokoll tatsächlich festgehalten wurde. Es führt über das Mixin IsAgendaItem dieselben Elemente wie AgendaItem, ist aber eine eigenständige Klasse: Das Protokollierte ist kein Sonderfall des Geplanten. Es entsteht unabhängig und kann Traktanden enthalten, die nie traktandiert waren, so wie die Traktandenliste Punkte enthalten kann, die nie behandelt wurden.\n" ;
	ops:description_fr "Un point de l'ordre du jour tel qu'il a effectivement été consigné au procès-verbal. Il porte les mêmes éléments qu'AgendaItem par le mixin IsAgendaItem, mais constitue une classe à part entière : le point consigné n'est pas un cas particulier du point planifié. Il naît indépendamment et peut comprendre des points jamais mis à l'ordre du jour, de même que l'ordre du jour peut comprendre des points jamais traités.\n" .
ops:Resolution a owl:Class ;
	rdfs:label "Resolution" ;
	rdfs:subClassOf _:c14n178 , _:c14n312 , _:c14n348 , _:c14n438 , _:c14n456 , _:c14n467 , _:c14n488 , _:c14n581 , _:c14n614 , _:c14n652 ;
	skos:definition "The formal decision taken on an agenda item, including the voting procedures applied. It records what was decided, whereas Voting records how it was decided (procedure and vote ratio). Not every decision rests on a formal vote: noting a report, tacit acceptance or administrative decisions come about without one.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Der formale Beschluss zu einem Traktandum, einschliesslich der angewandten Abstimmungsverfahren. Er hält fest, was entschieden wurde, während Voting festhält, wie entschieden wurde (Verfahren und Stimmenverhältnis). Nicht jeder Beschluss beruht auf einer formalen Abstimmung: Kenntnisnahmen, stille Annahmen oder Administrativbeschlüsse kommen ohne eine solche zustande.\n" ;
	ops:description_fr "La décision formelle prise sur un point de l'ordre du jour, y compris les procédures de vote appliquées. Elle retient ce qui a été décidé, tandis que Voting retient comment il a été décidé (procédure et rapport de voix). Toute décision ne repose pas sur un vote formel : les prises de connaissance, les adoptions tacites ou les décisions administratives interviennent sans vote.\n" .
ops:ResolutionTypeEnum a owl:Class ;
	rdfs:label "ResolutionTypeEnum" ;
	owl:unionOf _:c14n643 ;
	skos:definition "Type of resolution taken on an agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der Resolution zu einem Traktandum.\n" ;
	ops:description_fr "Type de décision prise sur un point de l'ordre du jour.\n" ;
	linkml:permissible_values ops:enum\/resolution_type\/accepted , ops:enum\/resolution_type\/accepted_point_by_point , ops:enum\/resolution_type\/accepted_with_postulate , ops:enum\/resolution_type\/nearly_unanimous , ops:enum\/resolution_type\/noted , ops:enum\/resolution_type\/orally_settled , ops:enum\/resolution_type\/other , ops:enum\/resolution_type\/rejected .
ops:Session a owl:Class ;
	rdfs:label "Session" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , <https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> , _:c14n100 , _:c14n121 , _:c14n127 , _:c14n148 , _:c14n154 , _:c14n155 , _:c14n183 , _:c14n199 , _:c14n225 , _:c14n246 , _:c14n286 , _:c14n365 , _:c14n371 , _:c14n411 , _:c14n444 , _:c14n445 , _:c14n459 , _:c14n501 , _:c14n510 , _:c14n550 , _:c14n552 , _:c14n555 , _:c14n586 , _:c14n595 , _:c14n682 , _:c14n688 , _:c14n700 , _:c14n74 , _:c14n81 , _:c14n96 ;
	skos:definition "A session: a contiguous period of sittings within a legislature. It groups its meetings (meetings) and may also carry agenda items directly (agenda_items). The session is the only one of the three temporal levels that may be omitted: federal units without formal sessions leave it out and attach their meetings directly to the legislature (parent_legislature). Session and meeting may also coincide — a one-day sitting of a cantonal parliament or a Landsgemeinde is represented as a session with a single meeting, or as a session that carries its agenda items directly without any meeting.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine Session: eine zusammenhängende Sitzungsperiode innerhalb einer Legislaturperiode. Sie fasst ihre Sitzungen zusammen (meetings) und kann auch direkt Traktanden führen (agenda_items). Die Session ist die einzige der drei zeitlichen Ebenen, auf die verzichtet werden kann: Föderaleinheiten ohne formale Sessionen lassen sie weg und hängen ihre Sitzungen direkt an die Legislaturperiode (parent_legislature). Session und Sitzung können auch zusammenfallen — eine eintägige Sitzung eines Kantonsparlaments oder eine Landsgemeinde wird als Session mit einer einzigen Sitzung abgebildet oder als Session, die ihre Traktanden direkt und ohne Sitzung führt.\n" ;
	ops:description_fr "Une session : une période de séances continue au sein d'une législature. Elle regroupe ses séances (meetings) et peut aussi porter directement des points de l'ordre du jour (agenda_items). La session est le seul des trois niveaux temporels auquel il est possible de renoncer : les unités fédérales sans sessions formelles l'omettent et rattachent leurs séances directement à la législature (parent_legislature). Session et séance peuvent aussi coïncider — une séance d'un jour d'un parlement cantonal ou une Landsgemeinde est représentée comme une session comprenant une seule séance, ou comme une session qui porte directement ses points de l'ordre du jour, sans séance.\n" .
ops:Speech a owl:Class ;
	rdfs:label "Speech" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n10 , _:c14n103 , _:c14n113 , _:c14n119 , _:c14n13 , _:c14n144 , _:c14n188 , _:c14n196 , _:c14n207 , _:c14n233 , _:c14n249 , _:c14n261 , _:c14n277 , _:c14n282 , _:c14n287 , _:c14n299 , _:c14n317 , _:c14n323 , _:c14n357 , _:c14n358 , _:c14n37 , _:c14n375 , _:c14n384 , _:c14n386 , _:c14n41 , _:c14n432 , _:c14n449 , _:c14n455 , _:c14n475 , _:c14n477 , _:c14n48 , _:c14n486 , _:c14n493 , _:c14n496 , _:c14n521 , _:c14n525 , _:c14n527 , _:c14n553 , _:c14n554 , _:c14n572 , _:c14n580 , _:c14n585 , _:c14n622 , _:c14n633 , _:c14n66 , _:c14n679 , _:c14n78 , _:c14n83 , _:c14n85 , _:c14n98 ;
	skos:definition "A speech or statement made during a meeting (also called Votum or speaker segment): the oral contribution of a person in a parliamentary sitting and thus the central instrument of political debate and of expressing opinions in parliament. Speeches take various forms — main statements (detailed positions on an affair, justification of motions, presentation of the parliamentary group's opinion), short interventions (interjected questions, corrections), declarations by a parliamentary group delivered by its spokesperson, and statements by members of the government (answering questions, defending bills). A speech records who spoke when and under which agenda item, with the wording as text and, where available, as an audio or video recording. It can be delivered in two ways: embedded in the protocol (Protocol.speeches), where the meeting follows from the surrounding protocol but the agenda item does not, or flat in Container.speeches, where without references any link would be missing. parent_meeting and parent_agenda_item are therefore set in both cases; they carry the same values as on Voting and Election and make the speech evaluable regardless of the delivery form it came in.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine Wortmeldung während einer Sitzung (auch Votum oder Redebeitrag genannt): der mündliche Beitrag einer Person in einer parlamentarischen Sitzung und damit das zentrale Instrument der politischen Debatte und Meinungsäusserung im Parlament. Wortmeldungen haben verschiedene Formen — Hauptvoten (ausführliche Stellungnahmen zu einem Geschäft, Begründung von Anträgen, Darlegung der Fraktionsmeinung), Kurzinterventionen (Zwischenfragen, Richtigstellungen), Fraktionserklärungen, vorgetragen durch die Fraktionssprecherin oder den Fraktionssprecher, sowie Regierungsvoten (Beantwortung von Fragen, Verteidigung von Vorlagen). Eine Wortmeldung hält fest, wer wann unter welchem Traktandum gesprochen hat, mit dem Wortlaut als Text und, wo vorhanden, als Audio- oder Videoaufzeichnung. Sie kann auf zwei Wegen geliefert werden: eingebettet im Protokoll (Protocol.speeches), wo sich die Sitzung aus dem umgebenden Protokoll ergibt, das Traktandum aber nicht, oder flach in Container.speeches, wo ohne Referenzen jeder Bezug fehlte. parent_meeting und parent_agenda_item werden deshalb in beiden Fällen geführt; sie tragen dieselben Werte wie bei Voting und Election und machen die Wortmeldung unabhängig davon auswertbar, aus welcher Lieferform sie stammt.\n" ;
	ops:description_fr "Une intervention prononcée au cours d'une séance (également appelée prise de parole) : la contribution orale d'une personne lors d'une séance parlementaire et, partant, l'instrument central du débat politique et de l'expression des opinions au parlement. Les interventions revêtent différentes formes — interventions principales (prises de position détaillées sur une affaire, développement de propositions, exposé de l'avis du groupe parlementaire), interventions brèves (questions intermédiaires, rectifications), déclarations de groupe présentées par la porte-parole ou le porte-parole du groupe, ainsi qu'interventions du gouvernement (réponses à des questions, défense de projets). Une intervention retient qui a parlé, quand et sous quel point de l'ordre du jour, avec le texte prononcé et, le cas échéant, un enregistrement audio ou vidéo. Elle peut être livrée de deux manières : imbriquée dans le procès-verbal (Protocol.speeches), où la séance ressort du procès-verbal environnant mais non le point de l'ordre du jour, ou à plat dans Container.speeches, où tout rattachement ferait défaut sans références. parent_meeting et parent_agenda_item sont donc renseignés dans les deux cas ; ils portent les mêmes valeurs que pour Voting et Election et rendent l'intervention exploitable indépendamment de sa forme de livraison.\n" .
ops:StateEnum a owl:Class ;
	rdfs:label "StateEnum" ;
	owl:unionOf _:c14n302 ;
	skos:definition "State of the meeting.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Status der Sitzung.\n" ;
	ops:description_fr "État de la séance.\n" ;
	linkml:permissible_values ops:enum\/state\/canceled , ops:enum\/state\/planned , ops:enum\/state\/postponed .
ops:TextSegment a owl:Class ;
	rdfs:label "TextSegment" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n293 , _:c14n380 , _:c14n706 ;
	skos:definition "A text segment such as cross-references or subtitles. Text segments are carried by the protocol, by a speech or by an agenda item (planned AgendaItem or recorded ProtocolItem).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ein Textsegment wie Querverweise oder Zwischentitel. Textsegmente werden am Protokoll, an einer Wortmeldung oder an einem Traktandum geführt (geplantes AgendaItem oder protokolliertes ProtocolItem).\n" ;
	ops:description_fr "Un segment de texte tel qu'un renvoi ou un intertitre. Les segments de texte sont portés par le procès-verbal, par une intervention ou par un point de l'ordre du jour (AgendaItem planifié ou ProtocolItem consigné).\n" .
ops:TotalOther a owl:Class ;
	rdfs:label "TotalOther" ;
	rdfs:subClassOf _:c14n235 , _:c14n273 , _:c14n417 , _:c14n522 , _:c14n560 , _:c14n84 ;
	skos:definition "Vote count for one option of a multiple-choice voting. If several proposals pointing in the same direction are put to the vote at the same time, the members vote on more than two variants and the variant with most votes prevails (in Zurich colloquially a „Cup-Abstimmung“, cast via several voting buttons). Such a voting is represented with voting_type other and a descriptive type_label; total_count_yes, total_count_no and total_count_abstention remain empty, and each option receives an entry with count and label. Example: Gemeinderat of the City of Zurich, sitting of 28 February 2024, affair 2023/361, four options with 75, 25, 12 and 0 votes.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Stimmenzahl für eine Option einer Auswahlabstimmung. Liegen zu derselben Sachfrage mehrere gleichgerichtete Anträge vor, stimmen die Mitglieder über mehr als zwei Varianten gleichzeitig ab, und es obsiegt die Variante mit den meisten Stimmen (in Zürich umgangssprachlich „Cup-Abstimmung“, technisch über mehrere Abstimmungsknöpfe). Eine solche Abstimmung wird mit voting_type other und einem sprechenden type_label abgebildet; total_count_yes, total_count_no und total_count_abstention bleiben leer, und jede Option erhält einen Eintrag mit count und label. Beispiel: Gemeinderat der Stadt Zürich, Sitzung vom 28. Februar 2024, Geschäft 2023/361, vier Optionen mit 75, 25, 12 und 0 Stimmen.\n" ;
	ops:description_fr "Nombre de voix pour une option d'un vote à choix multiple. Lorsque plusieurs propositions de même sens portent sur la même question, les membres votent simultanément sur plus de deux variantes, et la variante qui obtient le plus de voix l'emporte (à Zurich, familièrement « Cup-Abstimmung », au moyen de plusieurs boutons de vote). Un tel vote est représenté avec voting_type other et un type_label explicite ; total_count_yes, total_count_no et total_count_abstention restent vides, et chaque option reçoit une entrée avec count et label. Exemple : Gemeinderat de la Ville de Zurich, séance du 28 février 2024, affaire 2023/361, quatre options avec 75, 25, 12 et 0 voix.\n" .
ops:Voting a owl:Class ;
	rdfs:label "Voting" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n110 , _:c14n111 , _:c14n115 , _:c14n128 , _:c14n137 , _:c14n143 , _:c14n145 , _:c14n162 , _:c14n163 , _:c14n169 , _:c14n17 , _:c14n173 , _:c14n174 , _:c14n204 , _:c14n218 , _:c14n219 , _:c14n232 , _:c14n243 , _:c14n247 , _:c14n256 , _:c14n266 , _:c14n27 , _:c14n275 , _:c14n29 , _:c14n298 , _:c14n304 , _:c14n308 , _:c14n316 , _:c14n32 , _:c14n322 , _:c14n328 , _:c14n338 , _:c14n350 , _:c14n351 , _:c14n373 , _:c14n383 , _:c14n416 , _:c14n418 , _:c14n43 , _:c14n446 , _:c14n450 , _:c14n461 , _:c14n462 , _:c14n464 , _:c14n47 , _:c14n482 , _:c14n485 , _:c14n487 , _:c14n490 , _:c14n498 , _:c14n499 , _:c14n503 , _:c14n504 , _:c14n537 , _:c14n55 , _:c14n557 , _:c14n561 , _:c14n568 , _:c14n576 , _:c14n578 , _:c14n58 , _:c14n592 , _:c14n607 , _:c14n610 , _:c14n623 , _:c14n632 , _:c14n655 , _:c14n658 , _:c14n685 , _:c14n687 , _:c14n696 , _:c14n698 , _:c14n70 , _:c14n702 , _:c14n704 ;
	skos:definition "A voting on a substantive question: the subject (question), the procedure, the result with its vote ratio and — for open votings — the individual votes of the members. A voting is held in the course of the sitting and is therefore anchored in the protocol (parent_protocol, parent_protocol_item); it is also linked to the meeting (parent_meeting) and to the affair (affair_id). The presiding member does not take part in votings but casts the deciding vote in case of a tie (tie_breaker). The categorical decision (accepted, rejected, noted …) is not held on the voting but in the Resolution of the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Eine Abstimmung über eine Sachfrage: der Abstimmungsgegenstand (Frage), das Verfahren, das Ergebnis mit dem Stimmenverhältnis und — bei offenen Abstimmungen — die Einzelstimmen der Mitglieder. Abgestimmt wird im Verlauf der Sitzung, weshalb die Abstimmung im Protokoll verankert ist (parent_protocol, parent_protocol_item); zudem ist sie mit der Sitzung (parent_meeting) und dem Geschäft (affair_id) verknüpft. Die Präsidentin oder der Präsident nimmt an Abstimmungen nicht teil, fällt bei Stimmengleichheit aber den Stichentscheid (tie_breaker). Der kategorische Entscheid (angenommen, abgelehnt, Kenntnisnahme …) wird nicht auf der Abstimmung, sondern in der Resolution des Traktandums festgehalten.\n" ;
	ops:description_fr "Un vote sur une question matérielle : l'objet du vote (la question), la procédure, le résultat avec le rapport de voix et — pour les votes ouverts — les voix individuelles des membres. Le vote a lieu au cours de la séance et est donc rattaché au procès-verbal (parent_protocol, parent_protocol_item) ; il est en outre lié à la séance (parent_meeting) et à l'affaire (affair_id). La présidente ou le président ne participe pas aux votes, mais départage en cas d'égalité des voix (tie_breaker). La décision catégorielle (adopté, rejeté, pris acte …) n'est pas retenue sur le vote, mais dans la Resolution du point de l'ordre du jour.\n" .
ops:VotingTypeEnum a owl:Class ;
	rdfs:label "VotingTypeEnum" ;
	owl:unionOf _:c14n483 ;
	skos:definition "Type of voting procedure.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Abstimmungsverfahrens.\n" ;
	ops:description_fr "Type de procédure de vote.\n" ;
	linkml:permissible_values ops:enum\/voting_type\/final_vote , ops:enum\/voting_type\/other , ops:enum\/voting_type\/preliminary_vote , ops:enum\/voting_type\/secret_vote , ops:enum\/voting_type\/tie_breaker_president .
ops:actor_fullname a owl:DatatypeProperty ;
	rdfs:label "actor_fullname" ;
	skos:definition "Full name of the actor/person.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Vollständiger Name der Akteurin oder des Akteurs bzw. der Person.\n" ;
	ops:description_fr "Nom complet de l'actrice ou de l'acteur, respectivement de la personne.\n" .
ops:actor_id a owl:ObjectProperty ;
	rdfs:label "actor_id" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/PersonReference> ;
	skos:definition "Reference to the acting person (lightweight snapshot at time of linking).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Referenz auf die handelnde Person (Momentaufnahme zum Zeitpunkt der Verknüpfung).\n" ;
	ops:description_fr "Référence à la personne agissante (instantané au moment de la mise en relation).\n" .
ops:actor_name a owl:DatatypeProperty ;
	rdfs:label "actor_name" ;
	rdfs:range xsd:string ;
	skos:definition "Name of the political body in plain text (e.g., Nationalrat), in addition to the reference `actor_id`.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Name des politischen Organs im Klartext (z.B. Nationalrat), zusätzlich zur Referenz `actor_id`.\n" ;
	ops:description_fr "Nom de l'organe politique en clair (p. ex. Conseil national), en complément de la référence `actor_id`.\n" .
ops:administrative_id a owl:DatatypeProperty ;
	rdfs:label "administrative_id" ;
	skos:definition "Administrative ID of the legislative body, such as a municipality, canton, or country.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Verwaltungs-ID des gesetzgebenden Körpers, wie z.B. Gemeinde, Kanton oder Land.\n" ;
	ops:description_fr "Identifiant administratif du corps législatif, p. ex. commune, canton ou pays.\n" .
ops:affair_id a owl:DatatypeProperty ;
	rdfs:label "affair_id" ;
	rdfs:range xsd:string ;
	skos:definition "Identifier of the affair (eCH-0295) the record refers to. Administrative agenda items (e.g. approval of the minutes) have no affair. An affair usually runs through several agenda items — in legislation, for instance, the debate on entering into the matter, the detailed deliberation, the final vote and, where applicable, the procedure for resolving differences between the chambers.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikator des Geschäfts (eCH-0295), auf das sich der Eintrag bezieht. Administrative Traktanden (z.B. Genehmigung des Protokolls) haben kein Geschäft. Ein Geschäft durchläuft in der Regel mehrere Traktanden — in der Gesetzgebung etwa Eintretensdebatte, Detailberatung, Schlussabstimmung und gegebenenfalls die Differenzbereinigung zwischen den Räten.\n" ;
	ops:description_fr "Identifiant de l'affaire (eCH-0295) à laquelle se rapporte l'enregistrement. Les points administratifs (p. ex. approbation du procès-verbal) n'ont pas d'affaire. Une affaire passe en règle générale par plusieurs points de l'ordre du jour — dans la législation, par exemple, le débat d'entrée en matière, la discussion par article, le vote final et, le cas échéant, la procédure d'élimination des divergences entre les conseils.\n" .
ops:agendaItem a owl:ObjectProperty ;
	rdfs:label "agenda_items" ;
	rdfs:range ops:AgendaItem ;
	skos:definition "Agenda items planned for this meeting or session, embedded as a list. On a meeting they form the agenda of the sitting. On a session they hold agenda items planned directly at the level of the session — where a federal unit does not break the session down into individual meetings (e.g. a Landsgemeinde or a one-day sitting of a cantonal parliament), or for items not (yet) assigned to a specific meeting, as in a session programme. The counterpart after the sitting are the items recorded in the protocol (Protocol.protocol_items).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Für diese Sitzung oder Session geplante Traktanden, eingebettet als Liste. Bei einer Sitzung bilden sie deren Traktandenliste. Bei einer Session enthalten sie Traktanden, die direkt auf Ebene der Session geplant sind — wo eine Föderaleinheit die Session nicht in einzelne Sitzungen gliedert (z.B. eine Landsgemeinde oder eine eintägige Sitzung eines Kantonsparlaments) oder für Traktanden, die (noch) keiner bestimmten Sitzung zugeordnet sind, wie in einem Sessionsprogramm. Das Gegenstück nach der Sitzung sind die im Protokoll festgehaltenen Traktanden (Protocol.protocol_items).\n" ;
	ops:description_fr "Points de l'ordre du jour planifiés pour cette séance ou cette session, imbriqués sous forme de liste. Pour une séance, ils forment son ordre du jour. Pour une session, ils contiennent les points planifiés directement au niveau de la session — lorsqu'une unité fédérale ne subdivise pas la session en séances (p. ex. une Landsgemeinde ou une séance d'un jour d'un parlement cantonal), ou pour des points qui ne sont pas (encore) attribués à une séance déterminée, comme dans un programme de session. Leur pendant après la séance sont les points consignés au procès-verbal (Protocol.protocol_items).\n" .
ops:agenda_item_category a owl:DatatypeProperty ;
	rdfs:label "agenda_item_category" ;
	rdfs:range xsd:string ;
	skos:definition "Free categorisation of the agenda item by content or grouping, e.g. \"Gesetzgebung\", \"Budget und Finanzen\", \"Interpellationen und Anfragen\", \"Wahlen\", by department, or introductory and technical items. The categorisation is not standardised and may vary between federal units.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Freie Kategorisierung des Traktandums nach Inhalt oder Gruppierung, z.B. „Gesetzgebung“, „Budget und Finanzen“, „Interpellationen und Anfragen“, „Wahlen“, nach Departement oder einleitende und technische Traktanden. Die Kategorisierung ist nicht standardisiert und kann je nach Föderaleinheit variieren.\n" ;
	ops:description_fr "Catégorisation libre du point selon son contenu ou son regroupement, p. ex. « Législation », « Budget et finances », « Interpellations et questions », « Élections », par département, ou points introductifs et techniques. La catégorisation n'est pas standardisée et peut varier selon l'unité fédérale.\n" .
ops:agenda_item_description a owl:ObjectProperty ;
	rdfs:label "agenda_item_description" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Subtitle or detailed description of the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Untertitel oder ausführliche Beschreibung des Traktandums.\n" ;
	ops:description_fr "Sous-titre ou description détaillée du point de l'ordre du jour.\n" .
ops:agenda_item_ids a owl:DatatypeProperty ;
	rdfs:label "agenda_item_ids" ;
	rdfs:range xsd:string ;
	skos:definition "The agenda items associated with the voting.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die Traktanden, die mit der Abstimmung verbunden sind.\n" ;
	ops:description_fr "Les points de l'ordre du jour associés au vote.\n" .
ops:agenda_item_number a owl:DatatypeProperty ;
	rdfs:label "agenda_item_number" ;
	rdfs:range xsd:string ;
	skos:definition "Number of the agenda item on the agenda, e.g. \"2.1\" or \"3\" (string type to also support roman numerals).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Nummer des Traktandums auf der Traktandenliste, z.B. „2.1“ oder „3“ (Zeichenkette, damit auch römische Ziffern möglich sind).\n" ;
	ops:description_fr "Numéro du point sur l'ordre du jour, p. ex. « 2.1 » ou « 3 » (chaîne de caractères, afin de permettre aussi les chiffres romains).\n" .
ops:agenda_item_position a owl:DatatypeProperty ;
	rdfs:label "agenda_item_position" ;
	rdfs:range xsd:integer ;
	skos:definition "Integer position of the agenda item in the meeting sequence, used for sorting and display.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ganzzahlige Position des Traktandums im Sitzungsablauf, massgebend für Sortierung und Darstellung.\n" ;
	ops:description_fr "Position entière du point dans le déroulement de la séance, déterminante pour le tri et l'affichage.\n" .
ops:agenda_item_title a owl:ObjectProperty ;
	rdfs:label "agenda_item_title" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Title of the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Titel des Traktandums.\n" ;
	ops:description_fr "Titre du point de l'ordre du jour.\n" .
ops:agenda_item_type a owl:ObjectProperty ;
	rdfs:label "agenda_item_type" ;
	rdfs:range ops:AgendaItemTypeEnum ;
	skos:definition "Type of agenda item, distinguishing individual items from groups.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Traktandums, unterscheidet Einzeltraktanden von Traktandengruppen.\n" ;
	ops:description_fr "Type de point de l'ordre du jour, distinguant les points isolés des groupes de points.\n" .
ops:attendance a owl:ObjectProperty ;
	rdfs:label "attendances" ;
	rdfs:range ops:Attendance ;
	skos:definition "Collection of attendance records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Anwesenheitslisten.\n" ;
	ops:description_fr "Ensemble des listes de présence.\n" .
ops:attendance_type a owl:ObjectProperty ;
	rdfs:label "attendance_type" ;
	rdfs:range ops:AttendanceTypeEnum ;
	skos:definition "Type of individual attendance.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der individuellen Anwesenheit.\n" ;
	ops:description_fr "Type de présence individuelle.\n" .
ops:category a owl:DatatypeProperty ;
	rdfs:label "category" ;
	skos:definition "Category of the element.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Kategorie des Elements.\n" ;
	ops:description_fr "Catégorie de l'élément.\n" .
ops:count a owl:DatatypeProperty ;
	rdfs:label "count" ;
	rdfs:range xsd:integer ;
	skos:definition "The count of votes for the total other category.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die Anzahl der Stimmen für die Kategorie „Andere“.\n" ;
	ops:description_fr "Le nombre de voix pour la catégorie « autres ».\n" .
ops:datetime_begin a owl:DatatypeProperty ;
	rdfs:label "datetime_begin" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when the meeting or voting begins.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung beginnt.\n" ;
	ops:description_fr "La date et l'heure auxquelles la séance ou le vote commence.\n" .
ops:datetime_end a owl:DatatypeProperty ;
	rdfs:label "datetime_end" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when the meeting or voting ends.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung endet.\n" ;
	ops:description_fr "La date et l'heure auxquelles la séance ou le vote se termine.\n" .
ops:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "Descriptive text of the element.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Beschreibender Text zum Element.\n" ;
	ops:description_fr "Texte descriptif de l'élément.\n" .
ops:election a owl:ObjectProperty ;
	rdfs:label "elections" ;
	rdfs:range ops:Election ;
	skos:definition "Collection of election records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Wahlen.\n" ;
	ops:description_fr "Ensemble des élections.\n" .
ops:election_type a owl:ObjectProperty ;
	rdfs:label "election_type" ;
	rdfs:range ops:ElectionTypeEnum ;
	skos:definition "Type of election procedure.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Wahlverfahrens.\n" ;
	ops:description_fr "Type de procédure d'élection.\n" .
ops:enum\/agenda_item_type\/group a owl:Class ;
	rdfs:label "group" ;
	rdfs:subClassOf ops:AgendaItemTypeEnum ;
	skos:definition "Group of agenda items (Traktandengruppe) under which sub-items are arranged via parent_agenda_item, e.g. \"Gesetzesberatungen\".\n" ;
	ops:description_de "Gruppe von Traktanden (Traktandengruppe), unter der Untertraktanden über parent_agenda_item eingeordnet werden, z.B. „Gesetzesberatungen“.\n" ;
	ops:description_fr "Groupe de points (groupe de points de l'ordre du jour) sous lequel des sous-points sont rangés au moyen de parent_agenda_item, p. ex. « Délibérations législatives ».\n" .
ops:enum\/agenda_item_type\/item a owl:Class ;
	rdfs:label "item" ;
	rdfs:subClassOf ops:AgendaItemTypeEnum ;
	skos:definition "Individual agenda item (Traktandum) with deliberation and, where applicable, a vote.\n" ;
	ops:description_de "Einzelnes Traktandum mit Beratung und gegebenenfalls Abstimmung.\n" ;
	ops:description_fr "Point individuel de l'ordre du jour, avec délibération et, le cas échéant, vote.\n" .
ops:enum\/attendance_type\/present a owl:Class ;
	rdfs:label "present" ;
	rdfs:subClassOf ops:AttendanceTypeEnum ;
	skos:definition "Present in person\n" ;
	ops:description_de "Persönlich anwesend\n" ;
	ops:description_fr "Présent en personne\n" .
ops:enum\/attendance_type\/remote a owl:Class ;
	rdfs:label "remote" ;
	rdfs:subClassOf ops:AttendanceTypeEnum ;
	skos:definition "Remote participation, e.g. via video conference\n" ;
	ops:description_de "Teilnahme per Fernzugriff, z.B. per Videokonferenz\n" ;
	ops:description_fr "Participation à distance, p. ex. par visioconférence\n" .
ops:enum\/attendance_type\/substitute a owl:Class ;
	rdfs:label "substitute" ;
	rdfs:subClassOf ops:AttendanceTypeEnum ;
	skos:definition "Substitute (Stellvertretung): another person took part in place of the member\n" ;
	ops:description_de "Stellvertretung: Eine andere Person hat in Vertretung des Mitglieds teilgenommen\n" ;
	ops:description_fr "Suppléance : une autre personne a participé à la place du membre\n" .
ops:enum\/election_type\/open a owl:Class ;
	rdfs:label "open" ;
	rdfs:subClassOf ops:ElectionTypeEnum ;
	skos:definition "Open election (Offene Wahl): votes are cast openly and it is traceable who elected whom, so individual votes can be recorded. Used where transparency is desired, for uncontested elections or in smaller bodies.\n" ;
	ops:description_de "Offene Wahl: Die Stimmen werden offen abgegeben, und es ist nachvollziehbar, wer wen gewählt hat; Einzelstimmen können daher erfasst werden. Üblich, wo Transparenz gewünscht ist, bei unumstrittenen Wahlen oder in kleineren Gremien.\n" ;
	ops:description_fr "Élection ouverte : les voix sont exprimées ouvertement et l'on peut savoir qui a élu qui ; les voix individuelles peuvent donc être saisies. Usuelle lorsque la transparence est souhaitée, pour les élections non disputées ou dans les organes de petite taille.\n" .
ops:enum\/election_type\/secret a owl:Class ;
	rdfs:label "secret" ;
	rdfs:subClassOf ops:ElectionTypeEnum ;
	skos:definition "Secret election (Geheime Wahl): votes are cast anonymously, by ballot paper or an electronic secret system, so it cannot be traced who elected whom. Standard for elections of persons and often required by law — at federal level e.g. the Federal Council (elected by the United Federal Assembly with an absolute majority in the first ballots), federal judges and committee chairs; at cantonal level e.g. the president of parliament, the president of the government, the presidents of the highest courts, judges, the state chancellor and committee chairs. Only the overall result is published, no individual votes.\n" ;
	ops:description_de "Geheime Wahl: Die Stimmen werden anonym abgegeben, mit Wahlzettel oder elektronischem Geheimwahlsystem, sodass nicht nachvollziehbar ist, wer wen gewählt hat. Standard bei Personenwahlen und oft gesetzlich vorgeschrieben — auf Bundesebene z.B. Bundesrat (durch die Vereinigte Bundesversammlung, in den ersten Wahlgängen mit absolutem Mehr), Bundesrichterinnen und Bundesrichter sowie Kommissionspräsidien; auf Kantonsebene z.B. Parlamentspräsidentin oder Parlamentspräsident, Regierungspräsidentin oder Regierungspräsident, Präsidentinnen und Präsidenten der obersten Gerichte, Richterinnen und Richter, Staatsschreiberin oder Staatsschreiber sowie Kommissionspräsidien. Publiziert wird nur das Gesamtergebnis, keine Einzelstimmen.\n" ;
	ops:description_fr "Élection secrète : les voix sont exprimées anonymement, au moyen d'un bulletin ou d'un système électronique de vote secret, de sorte qu'on ne peut savoir qui a élu qui. Standard pour les élections de personnes et souvent prescrite par la loi — au niveau fédéral p. ex. le Conseil fédéral (par l'Assemblée fédérale Chambres réunies, à la majorité absolue lors des premiers tours), les juges fédérales et juges fédéraux et les présidences de commission ; au niveau cantonal p. ex. la présidence du parlement, la présidence du gouvernement, les présidences des tribunaux suprêmes, les juges, la chancelière ou le chancelier d'État et les présidences de commission. Seul le résultat global est publié, sans voix individuelles.\n" .
ops:enum\/election_type\/silent a owl:Class ;
	rdfs:label "silent" ;
	rdfs:subClassOf ops:ElectionTypeEnum ;
	skos:definition "Silent election (Stille Wahl) without formal vote, by acclamation or consensus; possible only when no objection is raised, e.g. the re-election of a committee chair without a rival candidate.\n" ;
	ops:description_de "Stille Wahl ohne formale Abstimmung, durch Akklamation oder Konsens; nur möglich, wenn keine Gegenstimmen erhoben werden, z.B. die Wiederwahl einer Kommissionspräsidentin oder eines Kommissionspräsidenten ohne Gegenkandidatur.\n" ;
	ops:description_fr "Élection tacite sans vote formel, par acclamation ou consensus ; possible uniquement si aucune opposition n'est formulée, p. ex. la réélection d'une présidente ou d'un président de commission sans candidature concurrente.\n" .
ops:enum\/individual_vote_type\/abstention a owl:Class ;
	rdfs:label "abstention" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "Abstention: the member takes part in the voting but abstains; with electronic voting, by pressing the \"abstention\" button.\n" ;
	ops:description_de "Enthaltung: Das Mitglied nimmt an der Abstimmung teil, enthält sich aber der Stimme; bei elektronischer Stimmabgabe drückt es den Knopf „Enthaltung“.\n" ;
	ops:description_fr "Abstention : le membre participe au vote mais s'abstient ; en cas de vote électronique, il presse le bouton « abstention ».\n" .
ops:enum\/individual_vote_type\/no a owl:Class ;
	rdfs:label "no" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "No vote: the member rejects the proposal or motion.\n" ;
	ops:description_de "Nein-Stimme: Das Mitglied lehnt die Vorlage oder den Antrag ab.\n" ;
	ops:description_fr "Non : le membre rejette l'objet ou la proposition.\n" .
ops:enum\/individual_vote_type\/not_voted a owl:Class ;
	rdfs:label "not_voted" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "Not voted: the member did not cast a vote, for instance because they were present but did not vote or were absent.\n" ;
	ops:description_de "Nicht gestimmt: Das Mitglied hat keine Stimme abgegeben, etwa weil es anwesend war, aber nicht gestimmt hat, oder abwesend war.\n" ;
	ops:description_fr "N'a pas voté : le membre n'a pas exprimé de voix, par exemple parce qu'il était présent sans voter ou absent.\n" .
ops:enum\/individual_vote_type\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "Vote that cannot be placed on the yes/no axis — for instance in a multiple-choice voting, where the member voted but neither yes nor no; the chosen option is held in type_label (e.g. \"Auswahl A\"). Counterpart of total_other on the voting, which keeps the individual vote evaluable without a separate enumeration value for every cantonal selection mechanism.\n" ;
	ops:description_de "Stimme, die sich nicht auf die Ja/Nein-Achse bringen lässt — etwa bei einer Auswahlabstimmung, bei der das Mitglied gestimmt hat, aber weder Ja noch Nein; welche Option es gewählt hat, hält type_label fest (z.B. „Auswahl A“). Gegenstück zu total_other auf der Abstimmung; so bleibt die Einzelstimme auswertbar, ohne dass jede kantonale Auswahlmechanik einen eigenen Enum-Wert braucht.\n" ;
	ops:description_fr "Voix qui ne peut être placée sur l'axe oui/non — par exemple lors d'un vote à choix multiple, où le membre a voté, mais ni oui ni non ; l'option choisie est retenue dans type_label (p. ex. « Choix A »). Pendant de total_other sur le vote ; la voix individuelle reste ainsi exploitable sans qu'il faille une valeur d'énumération propre pour chaque mécanisme de choix cantonal.\n" .
ops:enum\/individual_vote_type\/tie_breaker a owl:Class ;
	rdfs:label "tie_breaker" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "Tie-breaking vote, cast by the presiding member in case of a tie (see voting_type tie_breaker_president).\n" ;
	ops:description_de "Stichentscheid, den die Präsidentin oder der Präsident bei Stimmengleichheit fällt (siehe voting_type tie_breaker_president).\n" ;
	ops:description_fr "Voix prépondérante, exprimée par la présidente ou le président en cas d'égalité des voix (voir voting_type tie_breaker_president).\n" .
ops:enum\/individual_vote_type\/yes a owl:Class ;
	rdfs:label "yes" ;
	rdfs:subClassOf ops:IndividualVoteTypeEnum ;
	skos:definition "Yes vote: the member approves the proposal or motion.\n" ;
	ops:description_de "Ja-Stimme: Das Mitglied stimmt der Vorlage oder dem Antrag zu.\n" ;
	ops:description_fr "Oui : le membre approuve l'objet ou la proposition.\n" .
ops:enum\/majority_type\/absolute a owl:Class ;
	rdfs:label "absolute" ;
	rdfs:subClassOf ops:MajorityTypeEnum ;
	skos:definition "Absolute majority: more than half of the reference base (members or votes cast, depending on the applicable rules), e.g. at least 101 of 200. Standard case for elections of persons such as the election of the Federal Council or of committee chairs, and required for constitutional amendments in some cantons. If nobody reaches it in the first ballot of an election, a second ballot usually follows in which the relative majority suffices.\n" ;
	ops:description_de "Absolutes Mehr: mehr als die Hälfte der Bezugsgrösse (Mitglieder oder abgegebene Stimmen, je nach massgebender Regelung), z.B. mindestens 101 von 200. Standardfall bei Personenwahlen wie der Wahl des Bundesrats oder der Kommissionspräsidien und in einigen Kantonen für Verfassungsänderungen erforderlich. Erreicht bei einer Wahl im ersten Wahlgang niemand das absolute Mehr, folgt meist ein zweiter Wahlgang, in dem das relative Mehr genügt.\n" ;
	ops:description_fr "Majorité absolue : plus de la moitié de la base de référence (membres ou voix exprimées, selon la réglementation applicable), p. ex. au moins 101 sur 200. Cas standard pour les élections de personnes telles que l'élection du Conseil fédéral ou des présidences de commission, et requise dans certains cantons pour les modifications constitutionnelles. Si personne ne l'atteint au premier tour d'une élection, un second tour suit généralement, où la majorité relative suffit.\n" .
ops:enum\/majority_type\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf ops:MajorityTypeEnum ;
	skos:definition "Other majority threshold not covered by the standard categories, e.g. the relative majority among several options in a multiple-choice voting.\n" ;
	ops:description_de "Anderes Mehrheitserfordernis, das nicht von den Standardkategorien abgedeckt ist, z.B. das relative Mehr unter mehreren Optionen einer Auswahlabstimmung.\n" ;
	ops:description_fr "Autre seuil de majorité non couvert par les catégories standard, p. ex. la majorité relative entre plusieurs options d'un vote à choix multiple.\n" .
ops:enum\/majority_type\/two_thirds a owl:Class ;
	rdfs:label "two_thirds" ;
	rdfs:subClassOf ops:MajorityTypeEnum ;
	skos:definition "Two-thirds majority, e.g. at least 134 of 200; required in some cantons for constitutional amendments.\n" ;
	ops:description_de "Zweidrittelmehrheit, z.B. mindestens 134 von 200; in einigen Kantonen für Verfassungsänderungen erforderlich.\n" ;
	ops:description_fr "Majorité des deux tiers, p. ex. au moins 134 sur 200 ; requise dans certains cantons pour les modifications constitutionnelles.\n" .
ops:enum\/resolution_type\/accepted a owl:Class ;
	rdfs:label "accepted" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Accepted (Annahme): e.g. a bill adopted, a motion approved, a decision taken.\n" ;
	ops:description_de "Annahme: z.B. eine Gesetzesvorlage angenommen, ein Antrag gutgeheissen, ein Beschluss gefasst.\n" ;
	ops:description_fr "Adoption : p. ex. un projet de loi adopté, une proposition approuvée, une décision prise.\n" .
ops:enum\/resolution_type\/accepted_point_by_point a owl:Class ;
	rdfs:label "accepted_point_by_point" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Accepted point by point (Punktweise Annahme)\n" ;
	ops:description_de "Punktweise Annahme\n" ;
	ops:description_fr "Acceptation point par point\n" .
ops:enum\/resolution_type\/accepted_with_postulate a owl:Class ;
	rdfs:label "accepted_with_postulate" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Accepted with postulate (Annahme mit Postulat)\n" ;
	ops:description_de "Annahme mit Postulat\n" ;
	ops:description_fr "Acceptation avec postulat\n" .
ops:enum\/resolution_type\/nearly_unanimous a owl:Class ;
	rdfs:label "nearly_unanimous" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Nearly unanimous (Beinahe einstimmig)\n" ;
	ops:description_de "Beinahe einstimmig\n" ;
	ops:description_fr "Quasi unanime\n" .
ops:enum\/resolution_type\/noted a owl:Class ;
	rdfs:label "noted" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Noted (Kenntnisnahme): e.g. reports without a vote, communications, informative agenda items.\n" ;
	ops:description_de "Kenntnisnahme: z.B. Berichte ohne Abstimmung, Mitteilungen, informative Traktanden.\n" ;
	ops:description_fr "Prise d'acte : p. ex. rapports sans vote, communications, points informatifs.\n" .
ops:enum\/resolution_type\/orally_settled a owl:Class ;
	rdfs:label "orally_settled" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Orally settled (Mündlich erledigt)\n" ;
	ops:description_de "Mündlich erledigt\n" ;
	ops:description_fr "Liquidé oralement\n" .
ops:enum\/resolution_type\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Other resolution type not covered by standard categories\n" ;
	ops:description_de "Andere Resolution, nicht durch Standardkategorien abgedeckt\n" ;
	ops:description_fr "Autre type de décision, non couvert par les catégories standard\n" .
ops:enum\/resolution_type\/rejected a owl:Class ;
	rdfs:label "rejected" ;
	rdfs:subClassOf ops:ResolutionTypeEnum ;
	skos:definition "Rejected (Ablehnung): e.g. a bill rejected, a motion dismissed.\n" ;
	ops:description_de "Ablehnung: z.B. eine Gesetzesvorlage abgelehnt, ein Antrag abgewiesen.\n" ;
	ops:description_fr "Rejet : p. ex. un projet de loi rejeté, une proposition repoussée.\n" .
ops:enum\/state\/canceled a owl:Class ;
	rdfs:label "canceled" ;
	rdfs:subClassOf ops:StateEnum ;
	skos:definition "The meeting has been cancelled.\n" ;
	ops:description_de "Die Sitzung wurde abgesagt.\n" ;
	ops:description_fr "La séance a été annulée.\n" .
ops:enum\/state\/planned a owl:Class ;
	rdfs:label "planned" ;
	rdfs:subClassOf ops:StateEnum ;
	skos:definition "The meeting is planned and will take place as scheduled.\n" ;
	ops:description_de "Die Sitzung ist geplant und findet wie vorgesehen statt.\n" ;
	ops:description_fr "La séance est planifiée et se tiendra comme prévu.\n" .
ops:enum\/state\/postponed a owl:Class ;
	rdfs:label "postponed" ;
	rdfs:subClassOf ops:StateEnum ;
	skos:definition "The meeting has been postponed.\n" ;
	ops:description_de "Die Sitzung wurde verschoben.\n" ;
	ops:description_fr "La séance a été reportée.\n" .
ops:enum\/voting_type\/final_vote a owl:Class ;
	rdfs:label "final_vote" ;
	rdfs:subClassOf ops:VotingTypeEnum ;
	skos:definition "Final vote (Schlussabstimmung) on the proposal as a whole, e.g. after the last reading of an act, the overall vote on a decree, the adoption or rejection of a proposal in its entirety, or the point-by-point vote on a parliamentary proposal.\n" ;
	ops:description_de "Schlussabstimmung über die Vorlage als Ganzes, z.B. nach der letzten Lesung eines Erlasses, Gesamtabstimmung über einen Beschluss, Annahme oder Ablehnung einer Vorlage in ihrer Gesamtheit oder punktweise Abstimmung über einen Vorstoss.\n" ;
	ops:description_fr "Vote final sur l'objet dans son ensemble, p. ex. après la dernière lecture d'un acte, vote sur l'ensemble d'un arrêté, adoption ou rejet d'un objet dans sa totalité, ou vote point par point sur une intervention parlementaire.\n" .
ops:enum\/voting_type\/other a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf ops:VotingTypeEnum ;
	skos:definition "Other voting type, specified in type_label — e.g. a multiple-choice voting on several proposals pointing in the same direction (see TotalOther).\n" ;
	ops:description_de "Anderer Abstimmungstyp, näher bezeichnet in type_label — z.B. eine Auswahlabstimmung über mehrere gleichgerichtete Anträge (siehe TotalOther).\n" ;
	ops:description_fr "Autre type de vote, précisé dans type_label — p. ex. un vote à choix multiple sur plusieurs propositions de même sens (voir TotalOther).\n" .
ops:enum\/voting_type\/preliminary_vote a owl:Class ;
	rdfs:label "preliminary_vote" ;
	rdfs:subClassOf ops:VotingTypeEnum ;
	skos:definition "Preliminary vote (Zwischenabstimmung) during the deliberation, e.g. on entering into an affair, on a motion, opposing two motions that exclude each other or refer to the same passage, a contingent vote (Eventualabstimmung) when more than two motions exist on one subject, on a single article of a law, or the overall vote after the first reading of an act deliberated in two readings.\n" ;
	ops:description_de "Zwischenabstimmung während der Beratung, z.B. über Eintreten auf ein Geschäft, über einen Antrag, Gegenüberstellung zweier Anträge, die sich gegenseitig ausschliessen oder sich auf denselben Textabschnitt beziehen, Eventualabstimmung, wenn zu einem Abstimmungsgegenstand mehr als zwei Anträge vorliegen, über einen einzelnen Artikel eines Gesetzes oder Gesamtabstimmung nach der ersten Lesung eines Erlasses, der in zwei Lesungen beraten wird.\n" ;
	ops:description_fr "Vote intermédiaire au cours de la délibération, p. ex. sur l'entrée en matière, sur une proposition, opposition de deux propositions qui s'excluent mutuellement ou portent sur le même passage, vote éventuel lorsque plus de deux propositions portent sur un même objet, sur un article isolé d'une loi, ou vote sur l'ensemble après la première lecture d'un acte délibéré en deux lectures.\n" .
ops:enum\/voting_type\/secret_vote a owl:Class ;
	rdfs:label "secret_vote" ;
	rdfs:subClassOf ops:VotingTypeEnum ;
	skos:definition "Secret ballot (Geheime Abstimmung), e.g. on particularly sensitive matters such as a request for pardon or the lifting of immunity, after a secret deliberation, or on request. Only the overall result is published.\n" ;
	ops:description_de "Geheime Abstimmung, z.B. über besonders heikle Sachgeschäfte wie ein Gnadengesuch oder die Aufhebung der Immunität, nach geheimer Beratung oder auf Antrag. Publiziert wird nur das Gesamtergebnis.\n" ;
	ops:description_fr "Vote secret, p. ex. sur des objets particulièrement sensibles tels qu'un recours en grâce ou la levée de l'immunité, après une délibération secrète ou sur demande. Seul le résultat global est publié.\n" .
ops:enum\/voting_type\/tie_breaker_president a owl:Class ;
	rdfs:label "tie_breaker_president" ;
	rdfs:subClassOf ops:VotingTypeEnum ;
	skos:definition "Casting vote of the presiding member in case of a tie (Stichentscheid Präsidium). The presiding member does not take part in votings but decides in case of a tie. In a secret vote ending in a tie, the proposal of the preparatory body is deemed accepted instead.\n" ;
	ops:description_de "Stichentscheid der Präsidentin oder des Präsidenten bei Stimmengleichheit. Die Präsidentin oder der Präsident nimmt an Abstimmungen nicht teil, entscheidet aber bei Stimmengleichheit. Endet eine geheime Abstimmung mit Stimmengleichheit, gilt stattdessen der Antrag des vorberatenden Ratsorgans als angenommen.\n" ;
	ops:description_fr "Voix prépondérante de la présidente ou du président en cas d'égalité des voix. La présidente ou le président ne participe pas aux votes, mais tranche en cas d'égalité. Si un vote secret aboutit à une égalité, c'est la proposition de l'organe préparatoire qui est réputée adoptée.\n" .
ops:group_id a owl:ObjectProperty ;
	rdfs:label "group_id" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/GroupReference> ;
	skos:definition "Reference to the group or body (lightweight snapshot at time of linking).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Referenz auf die Gruppe oder das Gremium (Momentaufnahme zum Zeitpunkt der Verknüpfung).\n" ;
	ops:description_fr "Référence au groupe ou à l'organe (instantané au moment de la mise en relation).\n" .
ops:group_name a owl:DatatypeProperty ;
	rdfs:label "group_name" ;
	rdfs:range xsd:string ;
	skos:definition "Name of the group or body in plain text, in addition to the reference `group_id`.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Name der Gruppe oder des Gremiums im Klartext, zusätzlich zur Referenz `group_id`.\n" ;
	ops:description_fr "Nom du groupe ou de l'organe en clair, en complément de la référence `group_id`.\n" .
ops:hasProtocol a owl:ObjectProperty ;
	rdfs:label "has_protocol" ;
	rdfs:range ops:Protocol ;
	skos:definition "Reference to the protocol (minutes) of this meeting, recorded after the meeting. Only the identifier of the protocol is given; the protocol itself is delivered in the container's `protocols` list. It is an entity in its own right with its own identifier and is usually published later than the meeting, so it is referenced rather than embedded.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Referenz auf das nach der Sitzung erstellte Protokoll dieser Sitzung. Angegeben wird nur der Identifikator des Protokolls; das Protokoll selbst wird in der Liste `protocols` des Containers geliefert. Es ist eine eigenständige Entität mit eigenem Identifikator und wird in der Regel später veröffentlicht als die Sitzung, weshalb es referenziert und nicht eingebettet wird.\n" ;
	ops:description_fr "Référence au procès-verbal de cette séance, établi après celle-ci. Seul l'identifiant du procès-verbal est indiqué ; le procès-verbal lui-même est livré dans la liste `protocols` du conteneur. Il constitue une entité à part entière dotée de son propre identifiant et est en règle générale publié après la séance, raison pour laquelle il est référencé et non imbriqué.\n" .
ops:has_resolution a owl:ObjectProperty ;
	rdfs:label "has_resolution" ;
	rdfs:range ops:Resolution ;
	skos:definition "The formal decision taken on this agenda item, e.g. the adoption of the energy law. The underlying voting with its vote ratio is recorded separately as a Voting.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Der formale Beschluss zu diesem Traktandum, z.B. die Annahme des Energiegesetzes. Die zugrunde liegende Abstimmung mit dem Stimmenverhältnis wird separat als Voting erfasst.\n" ;
	ops:description_fr "La décision formelle prise sur ce point de l'ordre du jour, p. ex. l'adoption de la loi sur l'énergie. Le vote sous-jacent avec son rapport de voix est saisi séparément comme Voting.\n" .
ops:individualAttendance a owl:ObjectProperty ;
	rdfs:label "individual_attendances" ;
	rdfs:range ops:IndividualAttendance ;
	skos:definition "Collection of individual attendance records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der einzelnen Anwesenheitsfeststellungen.\n" ;
	ops:description_fr "Ensemble des constatations individuelles de présence.\n" .
ops:individualVote a owl:ObjectProperty ;
	rdfs:label "individual_votes" ;
	rdfs:range ops:IndividualVote ;
	skos:definition "Collection of individual vote records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Einzelstimmen.\n" ;
	ops:description_fr "Ensemble des voix individuelles.\n" .
ops:individual_vote_type a owl:ObjectProperty ;
	rdfs:label "individual_vote_type" ;
	rdfs:range ops:IndividualVoteTypeEnum ;
	skos:definition "Type of vote cast (yes, no, abstention, no vote, etc.).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der abgegebenen Stimme (Ja, Nein, Enthaltung, nicht abgestimmt, etc.).\n" ;
	ops:description_fr "Type de voix exprimée (oui, non, abstention, n'a pas voté, etc.).\n" .
ops:jointAgendaItem a owl:DatatypeProperty ;
	rdfs:label "joint_agenda_item_ids" ;
	rdfs:range xsd:string ;
	skos:definition "Identifiers of the agenda items (AgendaItem or ProtocolItem) debated jointly.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikatoren der gemeinsam behandelten Traktanden (AgendaItem oder ProtocolItem).\n" ;
	ops:description_fr "Identifiants des points de l'ordre du jour traités conjointement (AgendaItem ou ProtocolItem).\n" .
ops:jointDebate a owl:ObjectProperty ;
	rdfs:label "joint_debates" ;
	rdfs:range ops:JointDebate ;
	skos:definition "Joint debates attached to this record: on an agenda item, the debates in which it is deliberated together with other agenda items; on a meeting or a session, the joint debates held within it.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "An diesem Eintrag angehängte gemeinsame Beratungen: bei einem Traktandum die Beratungen, in denen es zusammen mit anderen Traktanden behandelt wird; bei einer Sitzung oder Session die darin geführten gemeinsamen Beratungen.\n" ;
	ops:description_fr "Délibérations communes rattachées à cet enregistrement : pour un point de l'ordre du jour, les délibérations dans lesquelles il est traité conjointement avec d'autres points ; pour une séance ou une session, les délibérations communes qui s'y tiennent.\n" .
ops:label_abstention a owl:DatatypeProperty ;
	rdfs:label "label_abstention" ;
	rdfs:range xsd:string ;
	skos:definition "Meaning of an 'abstention' vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Bedeutung einer Enthaltungsstimme.\n" ;
	ops:description_fr "Signification d'une abstention.\n" .
ops:label_no a owl:DatatypeProperty ;
	rdfs:label "label_no" ;
	rdfs:range xsd:string ;
	skos:definition "Meaning of a 'no' vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Bedeutung einer „Nein“-Stimme.\n" ;
	ops:description_fr "Signification d'une voix « non ».\n" .
ops:label_yes a owl:DatatypeProperty ;
	rdfs:label "label_yes" ;
	rdfs:range xsd:string ;
	skos:definition "Meaning of a 'yes' vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Bedeutung einer „Ja“-Stimme.\n" ;
	ops:description_fr "Signification d'une voix « oui ».\n" .
ops:landingPage a owl:DatatypeProperty ;
	rdfs:label "landing_page" ;
	skos:definition "URL providing further information.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "URL mit weiteren Informationen.\n" ;
	ops:description_fr "URL fournissant des informations complémentaires.\n" .
ops:leading_actor_id a owl:DatatypeProperty ;
	rdfs:label "leading_actor_id" ;
	rdfs:range xsd:string ;
	skos:definition "The leading department for the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das federführende Departement für das Traktandum.\n" ;
	ops:description_fr "Le département responsable du point de l'ordre du jour.\n" .
ops:legislature a owl:ObjectProperty ;
	rdfs:label "legislatures" ;
	rdfs:range ops:Legislature ;
	skos:definition "Collection of legislature records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Legislaturperioden.\n" ;
	ops:description_fr "Ensemble des législatures.\n" .
ops:location a owl:DatatypeProperty ;
	rdfs:label "location" ;
	skos:definition "Place where the meeting is held — the physical room (\"Federal Palace, National Council chamber\"), a video conference or a hybrid format.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ort, an dem die Sitzung stattfindet — der physische Raum („Bundeshaus, Nationalratssaal“), eine Videokonferenz oder ein hybrides Format.\n" ;
	ops:description_fr "Lieu où se tient la séance — la salle physique (« Palais fédéral, salle du Conseil national »), une visioconférence ou un format hybride.\n" .
ops:majority_count a owl:DatatypeProperty ;
	rdfs:label "majority_count" ;
	rdfs:range xsd:integer ;
	skos:definition "Number of votes required for the relevant majority threshold.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Anzahl der Stimmen, die für die relevante Mehrheitsschwelle erforderlich sind.\n" ;
	ops:description_fr "Nombre de voix requis pour atteindre le seuil de majorité déterminant.\n" .
ops:majority_type a owl:ObjectProperty ;
	rdfs:label "majority_type" ;
	rdfs:range ops:MajorityTypeEnum ;
	skos:definition "Type of majority required for the vote (absolute, two-thirds, etc.).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der für die Abstimmung erforderlichen Mehrheit (absolut, Zweidrittel usw.).\n" ;
	ops:description_fr "Type de majorité requise pour le vote (absolue, deux tiers, etc.).\n" .
ops:media_format a owl:DatatypeProperty ;
	rdfs:label "media_format" ;
	skos:definition "MIME type of the media file.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "MIME-Typ der Mediendatei.\n" ;
	ops:description_fr "Type MIME du fichier média.\n" .
ops:media_type a owl:DatatypeProperty ;
	rdfs:label "media_type" ;
	skos:definition "Type of media (audio, video, document).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Mediums (Audio, Video, Dokument).\n" ;
	ops:description_fr "Type de média (audio, vidéo, document).\n" .
ops:media_url a owl:DatatypeProperty ;
	rdfs:label "media_url" ;
	skos:definition "URL to media file (audio/video).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "URL zur Mediendatei (Audio/Video).\n" ;
	ops:description_fr "URL du fichier média (audio/vidéo).\n" .
ops:meeting a owl:ObjectProperty ;
	rdfs:label "meetings" ;
	rdfs:range ops:Meeting ;
	skos:definition "Collection of meeting records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Sitzungen.\n" ;
	ops:description_fr "Ensemble des séances.\n" .
ops:meeting_abbreviation a owl:DatatypeProperty ;
	rdfs:label "meeting_abbreviation" ;
	skos:definition "Short designation of the session or meeting (e.g. \"FS24\" for the 2024 spring session).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Kurzbezeichnung der Session oder Sitzung (z.B. „FS24“ für die Frühjahrssession 2024).\n" ;
	ops:description_fr "Désignation abrégée de la session ou de la séance (p. ex. « FS24 » pour la session de printemps 2024).\n" .
ops:name a owl:ObjectProperty ;
	rdfs:label "name" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Multilingual full designation.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Mehrsprachige vollständige Bezeichnung.\n" ;
	ops:description_fr "Désignation complète multilingue.\n" .
ops:number a owl:DatatypeProperty ;
	rdfs:label "number" ;
	skos:definition "Number of the session or meeting as designated by the body, e.g. within the legislature, the session or the year. As a string it also allows roman numerals. Numbering practices vary widely, which is why number, sequential_number, position and meeting_abbreviation are available side by side.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Nummer der Session oder Sitzung, wie sie das Organ vergibt, z.B. innerhalb der Legislatur, der Session oder des Jahres. Als Zeichenkette erlaubt sie auch römische Ziffern. Nummeriert wird sehr unterschiedlich, weshalb number, sequential_number, position und meeting_abbreviation nebeneinander zur Verfügung stehen.\n" ;
	ops:description_fr "Numéro de la session ou de la séance tel qu'attribué par l'organe, p. ex. au sein de la législature, de la session ou de l'année. En tant que chaîne de caractères, il admet aussi les chiffres romains. Les pratiques de numérotation variant fortement, number, sequential_number, position et meeting_abbreviation sont disponibles côte à côte.\n" .
ops:optional a owl:DatatypeProperty ;
	rdfs:label "optional" ;
	rdfs:range xsd:boolean ;
	skos:definition "Indicates if the meeting or voting is optional.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gibt an, ob die Sitzung oder Abstimmung optional ist.\n" ;
	ops:description_fr "Indique si la séance ou le vote est facultatif.\n" .
ops:parentAttendance a owl:ObjectProperty ;
	rdfs:label "parent_attendance" ;
	rdfs:range ops:Attendance ;
	skos:definition "The Attendance aggregate this individual attendance record belongs to.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das Attendance-Aggregat, zu dem dieser einzelne Anwesenheits-Eintrag gehört.\n" ;
	ops:description_fr "L'agrégat Attendance auquel appartient cette constatation individuelle de présence.\n" .
ops:parentProtocol a owl:ObjectProperty ;
	rdfs:label "parent_protocol" ;
	rdfs:range ops:Protocol ;
	skos:definition "The protocol in which the voting or election is recorded. A vote is held during the sitting and is therefore anchored in the minutes, not in the agenda planned beforehand: what was put on the agenda does not yet say what was actually voted on. Conversely, the protocol lists its votings and elections (votings, elections).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das Protokoll, in dem die Abstimmung oder Wahl festgehalten ist. Abgestimmt wird im Verlauf der Sitzung, weshalb die Abstimmung im Protokoll und nicht in der vorgängig geplanten Traktandenliste verankert ist: Was traktandiert wurde, sagt noch nicht, worüber tatsächlich abgestimmt wurde. Umgekehrt führt das Protokoll seine Abstimmungen und Wahlen als Listen (votings, elections).\n" ;
	ops:description_fr "Le procès-verbal dans lequel le vote ou l'élection est consigné. Le vote a lieu au cours de la séance et se rattache donc au procès-verbal, et non à l'ordre du jour planifié à l'avance : ce qui a été mis à l'ordre du jour ne dit pas encore sur quoi il a effectivement été voté. Inversement, le procès-verbal reprend ses votes et élections sous forme de listes (votings, elections).\n" .
ops:parentProtocolItem a owl:ObjectProperty ;
	rdfs:label "parent_protocol_item" ;
	rdfs:range ops:ProtocolItem ;
	skos:definition "The recorded agenda item (ProtocolItem) under which the voting or election took place. Omitted when the vote was taken without an agenda item; the link to the sitting is then given by parent_protocol and parent_meeting alone.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Das protokollierte Traktandum (ProtocolItem), unter dem abgestimmt oder gewählt wurde. Entfällt, wenn ohne Traktandierung abgestimmt wurde; die Zuordnung zur Sitzung ergibt sich dann allein aus parent_protocol und parent_meeting.\n" ;
	ops:description_fr "Le point consigné au procès-verbal (ProtocolItem) sous lequel le vote ou l'élection a eu lieu. Absent lorsque le vote a eu lieu sans point de l'ordre du jour ; le rattachement à la séance découle alors uniquement de parent_protocol et parent_meeting.\n" .
ops:parentVoting a owl:ObjectProperty ;
	rdfs:label "parent_voting" ;
	rdfs:range ops:Voting ;
	skos:definition "The ID of the voting associated with the individual vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die ID der Abstimmung, die mit der Einzelstimme verbunden ist.\n" ;
	ops:description_fr "L'identifiant du vote auquel se rattache la voix individuelle.\n" .
ops:parent_agenda_item a owl:DatatypeProperty ;
	rdfs:label "parent_agenda_item" ;
	rdfs:range xsd:string ;
	skos:definition "Identifier of the agenda item this record belongs to. On an agenda item it builds a hierarchy of agenda items — e.g. an item group \"Gesetzesberatungen\" with the sub-items \"Energiegesetz (Detailberatung)\" and \"Energiegesetz (Schlussabstimmung)\"; on a speech it names the agenda item under which the speech was given.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikator des Traktandums, zu dem dieser Eintrag gehört. Bei einem Traktandum bildet er eine Hierarchie von Traktanden — z.B. eine Traktandengruppe „Gesetzesberatungen“ mit den Untertraktanden „Energiegesetz (Detailberatung)“ und „Energiegesetz (Schlussabstimmung)“; bei einer Wortmeldung bezeichnet er das Traktandum, unter dem sie erfolgte.\n" ;
	ops:description_fr "Identifiant du point de l'ordre du jour auquel cet enregistrement se rattache. Pour un point de l'ordre du jour, il forme une hiérarchie de points — p. ex. un groupe « Délibérations législatives » avec les sous-points « Loi sur l'énergie (discussion par article) » et « Loi sur l'énergie (vote final) » ; pour une intervention, il désigne le point sous lequel elle a été faite.\n" .
ops:parent_legislature a owl:DatatypeProperty ;
	rdfs:label "parent_legislature" ;
	skos:definition "Identifier of the legislature to which the session or meeting belongs. A meeting that belongs to a session is assigned to the legislature through the session (parent_session); a meeting without a session — for instance a committee sitting or a sitting in a federal unit without formal sessions — refers to the legislature directly.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikator der Legislaturperiode, zu der die Session oder Sitzung gehört. Eine Sitzung, die zu einer Session gehört, ist über die Session (parent_session) der Legislaturperiode zugeordnet; eine Sitzung ohne Session — etwa eine Kommissionssitzung oder eine Sitzung in einer Föderaleinheit ohne formale Sessionen — verweist direkt auf die Legislaturperiode.\n" ;
	ops:description_fr "Identifiant de la législature à laquelle la session ou la séance appartient. Une séance qui fait partie d'une session est rattachée à la législature par la session (parent_session) ; une séance sans session — par exemple une séance de commission ou une séance dans une unité fédérale sans sessions formelles — renvoie directement à la législature.\n" .
ops:parent_meeting a owl:DatatypeProperty ;
	rdfs:label "parent_meeting" ;
	rdfs:range xsd:string ;
	skos:definition "Identifier of the meeting this record belongs to. On a meeting it names the superordinate meeting; on a voting, election, speech, attendance list or protocol it names the meeting in which the record arose. Agenda items do not carry it: they are embedded in their meeting.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikator der Sitzung, zu der dieser Eintrag gehört. Bei einer Sitzung bezeichnet er die übergeordnete Sitzung, bei Abstimmung, Wahl, Wortmeldung, Anwesenheitsliste oder Protokoll die Sitzung, in der der Eintrag entstanden ist. Traktanden führen ihn nicht: Sie sind in ihre Sitzung eingebettet.\n" ;
	ops:description_fr "Identifiant de la séance à laquelle cet enregistrement se rattache. Pour une séance, il désigne la séance supérieure ; pour un vote, une élection, une intervention, une liste de présence ou un procès-verbal, la séance au cours de laquelle l'enregistrement est né. Les points de l'ordre du jour ne le portent pas : ils sont imbriqués dans leur séance.\n" .
ops:parent_session a owl:DatatypeProperty ;
	rdfs:label "parent_session" ;
	rdfs:range xsd:string ;
	skos:definition "Identifier of the session to which the meeting belongs.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Identifikator der Session, zu der die Sitzung gehört.\n" ;
	ops:description_fr "Identifiant de la session à laquelle la séance appartient.\n" .
ops:parent_type a owl:DatatypeProperty ;
	rdfs:label "parent_type" ;
	skos:definition "Type of parent object (meeting, agenda, speech, affair).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Typ des übergeordneten Objekts (Sitzung, Traktandum, Wortmeldung, Geschäft).\n" ;
	ops:description_fr "Type de l'objet parent (séance, point de l'ordre du jour, intervention, affaire).\n" .
ops:position a owl:DatatypeProperty ;
	rdfs:label "position" ;
	skos:definition "Integer position within the superordinate sequence, e.g. of a session within the legislature.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ganzzahlige Position innerhalb der übergeordneten Reihenfolge, z.B. einer Session innerhalb der Legislaturperiode.\n" ;
	ops:description_fr "Position entière au sein de la séquence supérieure, p. ex. d'une session au sein de la législature.\n" .
ops:protocol a owl:ObjectProperty ;
	rdfs:label "protocols" ;
	rdfs:range ops:Protocol ;
	skos:definition "Collection of protocol records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Protokolle.\n" ;
	ops:description_fr "Ensemble des procès-verbaux.\n" .
ops:protocolItem a owl:ObjectProperty ;
	rdfs:label "protocol_items" ;
	rdfs:range ops:ProtocolItem ;
	skos:definition "Agenda items as actually recorded in the protocol.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Traktanden, wie sie im Protokoll tatsächlich festgehalten wurden.\n" ;
	ops:description_fr "Points de l'ordre du jour tels qu'ils ont effectivement été consignés au procès-verbal.\n" .
ops:reason a owl:ObjectProperty ;
	rdfs:label "reason" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Reason for absence, lateness or substitution (free-text, multilingual).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Grund für Abwesenheit, Verspätung oder Vertretung (Freitext, mehrsprachig).\n" ;
	ops:description_fr "Motif de l'absence, du retard ou de la suppléance (texte libre, multilingue).\n" .
ops:resolution a owl:ObjectProperty ;
	rdfs:label "resolutions" ;
	rdfs:range ops:Resolution ;
	skos:definition "Collection of resolution records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Resolutionen.\n" ;
	ops:description_fr "Ensemble des décisions.\n" .
ops:resolution_type a owl:ObjectProperty ;
	rdfs:label "resolution_type" ;
	rdfs:range ops:ResolutionTypeEnum ;
	skos:definition "Type of resolution taken on the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art der Resolution zum Traktandum.\n" ;
	ops:description_fr "Type de décision prise sur le point de l'ordre du jour.\n" .
ops:result a owl:DatatypeProperty ;
	rdfs:label "result" ;
	skos:definition "Result of the procedure.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ergebnis des Verfahrens.\n" ;
	ops:description_fr "Résultat de la procédure.\n" .
ops:result_text a owl:DatatypeProperty ;
	rdfs:label "result_text" ;
	rdfs:range xsd:string ;
	skos:definition "Free text describing the outcome, e.g. \"Accepted with 120 to 75 votes with 5 abstentions\". For votings, the categorical decision (accepted, rejected, noted …) is not recorded here but in the Resolution (resolution_type) of the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Freitext, der das Ergebnis beschreibt, z.B. „Mit 120 zu 75 Stimmen bei 5 Enthaltungen angenommen“. Bei Abstimmungen wird der kategorische Entscheid (angenommen, abgelehnt, Kenntnisnahme …) nicht hier, sondern in der Resolution (resolution_type) des Traktandums festgehalten.\n" ;
	ops:description_fr "Texte libre décrivant le résultat, p. ex. « Adopté par 120 voix contre 75 et 5 abstentions ». Pour les votes, la décision catégorielle (adopté, rejeté, pris acte …) n'est pas retenue ici, mais dans la Resolution (resolution_type) du point de l'ordre du jour.\n" .
ops:role a owl:DatatypeProperty ;
	rdfs:label "role" ;
	skos:definition "Role of the person (e.g., commission speaker).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Rolle der Person (z.B. Kommissionssprecherin oder Kommissionssprecher).\n" ;
	ops:description_fr "Rôle de la personne (p. ex. rapporteuse ou rapporteur de commission).\n" .
ops:seat_nr a owl:DatatypeProperty ;
	rdfs:label "seat_nr" ;
	rdfs:range xsd:string ;
	skos:definition "The seat number of the individual vote, if applicable.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Die Sitznummer der Einzelstimme, falls zutreffend.\n" ;
	ops:description_fr "Le numéro de siège correspondant à la voix individuelle, le cas échéant.\n" .
ops:sequential_number a owl:DatatypeProperty ;
	rdfs:label "sequential_number" ;
	rdfs:range xsd:integer ;
	skos:definition "Sequential number of the session or meeting as an integer, used for ordering.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Laufende Nummer der Session oder Sitzung als Ganzzahl, die zur Sortierung verwendet wird.\n" ;
	ops:description_fr "Numéro d'ordre de la session ou de la séance sous forme de nombre entier, utilisé pour le tri.\n" .
ops:session a owl:ObjectProperty ;
	rdfs:label "sessions" ;
	rdfs:range ops:Session ;
	skos:definition "Collection of session records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Sessionen.\n" ;
	ops:description_fr "Ensemble des sessions.\n" .
ops:spatial a owl:DatatypeProperty ;
	rdfs:label "spatial" ;
	rdfs:range _:c14n466 ;
	skos:definition "Spatial reference to a LINDAS resource (fos-municipality number, fos-canton number, district, or country). Formats: municipality: https://ld.admin.ch/municipality/1234, district: https://ld.admin.ch/district/2301, canton: https://ld.admin.ch/canton/23, country: https://ld.admin.ch/country/CHE.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Räumliche Referenz auf eine LINDAS-Ressource (BFS-Gemeindenummer, BFS-Kantonsnummer, Bezirk oder Land). Formate: Gemeinde: https://ld.admin.ch/municipality/1234, Bezirk: https://ld.admin.ch/district/2301, Kanton: https://ld.admin.ch/canton/23, Bund: https://ld.admin.ch/country/CHE.\n" ;
	ops:description_fr "Référence spatiale à une ressource LINDAS (numéro OFS de commune, numéro OFS de canton, district ou pays). Formats : commune : https://ld.admin.ch/municipality/1234, district : https://ld.admin.ch/district/2301, canton : https://ld.admin.ch/canton/23, pays : https://ld.admin.ch/country/CHE.\n" .
ops:speaking_actor_id a owl:DatatypeProperty ;
	rdfs:label "speaking_actor_id" ;
	skos:definition "The speaker or head of the department for the agenda item.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Der Sprecher oder die Sprecherin bzw. die Departementsvorsteherin oder der Departementsvorsteher für das Traktandum.\n" ;
	ops:description_fr "La ou le porte-parole ou la cheffe ou le chef du département pour le point de l'ordre du jour.\n" .
ops:speech a owl:ObjectProperty ;
	rdfs:label "speeches" ;
	rdfs:range ops:Speech ;
	skos:definition "Collection of speech records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Wortmeldungen.\n" ;
	ops:description_fr "Ensemble des interventions.\n" .
ops:start a owl:DatatypeProperty ;
	rdfs:label "start" ;
	skos:definition "Start indicator or position.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Startangabe oder Position.\n" ;
	ops:description_fr "Indication de début ou position.\n" .
ops:state a owl:ObjectProperty ;
	rdfs:label "state" ;
	rdfs:range ops:StateEnum ;
	skos:definition "Whether the meeting takes place as planned at all (planned, canceled, postponed). A diverging, free-text designation goes into `state_name`.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Ob die Sitzung überhaupt wie vorgesehen stattfindet (geplant, abgesagt, verschoben). Eine abweichende, freitextliche Bezeichnung nimmt `state_name` auf.\n" ;
	ops:description_fr "Indique si la séance a lieu comme prévu (planifiée, annulée, reportée). Une désignation divergente, en texte libre, est reprise dans `state_name`.\n" .
ops:state_id a owl:DatatypeProperty ;
	rdfs:label "state_id" ;
	rdfs:range xsd:string ;
	skos:definition "State identifier of the agenda item (reference to a state enumeration or a custom state), e.g. pending (not yet dealt with), in_progress, completed, postponed (to a later meeting) or withdrawn.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Zustands-Identifikator des Traktandums (Verweis auf ein Status-Enum oder auf einen eigenen Zustand), z.B. pending (noch nicht behandelt), in_progress (in Beratung), completed (abgeschlossen), postponed (auf eine spätere Sitzung vertagt) oder withdrawn (zurückgezogen).\n" ;
	ops:description_fr "Identifiant d'état du point (renvoi à une énumération des états ou à un état propre), p. ex. pending (pas encore traité), in_progress (en délibération), completed (traité), postponed (renvoyé à une séance ultérieure) ou withdrawn (retiré).\n" .
ops:state_name a owl:DatatypeProperty ;
	rdfs:label "state_name" ;
	rdfs:range xsd:string ;
	skos:definition "Diverging, free-text status designation, where the status enumeration does not suffice.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Abweichende, freitextliche Statusbezeichnung, wo die Status-Aufzählung nicht genügt.\n" ;
	ops:description_fr "Désignation de statut divergente, en texte libre, là où l'énumération des statuts ne suffit pas.\n" .
ops:status a owl:DatatypeProperty ;
	rdfs:label "status" ;
	skos:definition "Free status designation, used where the state enumeration does not apply.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Freie Statusbezeichnung, dort verwendet, wo das Status-Enum nicht zutrifft.\n" ;
	ops:description_fr "Désignation libre de l'état, utilisée là où l'énumération des états ne s'applique pas.\n" .
ops:text a owl:DatatypeProperty ;
	rdfs:label "text" ;
	skos:definition "Text content of the element.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Textinhalt des Elements.\n" ;
	ops:description_fr "Contenu textuel de l'élément.\n" .
ops:textSegment a owl:ObjectProperty ;
	rdfs:label "text_segments" ;
	rdfs:range ops:TextSegment ;
	skos:definition "Collection of text segments (e.g. verbatim protocol).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung von Textsegmenten (z.B. Wortprotokoll).\n" ;
	ops:description_fr "Ensemble de segments de texte (p. ex. procès-verbal in extenso).\n" .
ops:text_format a owl:DatatypeProperty ;
	rdfs:label "text_format" ;
	skos:definition "Format of text (text, html, html_with_timestamps).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Format des Textes (text, html, html_with_timestamps).\n" ;
	ops:description_fr "Format du texte (text, html, html_with_timestamps).\n" .
ops:text_type a owl:DatatypeProperty ;
	rdfs:label "text_type" ;
	skos:definition "Type of text (raw draft, edited version).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Typ des Textes (Rohfassung, bearbeitete Fassung).\n" ;
	ops:description_fr "Type de texte (version brute, version éditée).\n" .
ops:tie_breaker a owl:DatatypeProperty ;
	rdfs:label "tie_breaker" ;
	rdfs:range xsd:boolean ;
	skos:definition "Indicates whether the result was decided by the casting vote of the presiding member in case of a tie.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gibt an, ob das Ergebnis bei Stimmengleichheit durch den Stichentscheid der Präsidentin oder des Präsidenten zustande kam.\n" ;
	ops:description_fr "Indique si le résultat a été obtenu, en cas d'égalité des voix, par la voix prépondérante de la présidente ou du président.\n" .
ops:title a owl:DatatypeProperty ;
	rdfs:label "title" ;
	skos:definition "Title of the element.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Titel des Elements.\n" ;
	ops:description_fr "Titre de l'élément.\n" .
ops:total a owl:DatatypeProperty ;
	rdfs:label "total" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of votes, excluding absent and president's vote.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der Stimmen, ohne abwesende und Präsidiumsstimmen.\n" ;
	ops:description_fr "Nombre total de voix, sans les absents ni la voix de la présidence.\n" .
ops:total_absent a owl:DatatypeProperty ;
	rdfs:label "total_absent" ;
	rdfs:range xsd:integer ;
	skos:definition "Number of absent members who could not take part. Whether an absence was excused is tracked on the attendance list (Attendance).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Anzahl abwesender Mitglieder, die nicht teilnehmen konnten. Ob eine Abwesenheit entschuldigt war, hält die Anwesenheitsliste (Attendance) fest.\n" ;
	ops:description_fr "Nombre de membres absents qui n'ont pas pu participer. La liste de présence (Attendance) indique si une absence était excusée.\n" .
ops:total_count a owl:DatatypeProperty ;
	rdfs:label "total_count" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of members of the body (reference value for quorum calculations).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl aller Mitglieder des Gremiums (Bezugsgrösse für Quorum-Berechnungen).\n" ;
	ops:description_fr "Nombre total de membres de l'organe (valeur de référence pour le calcul du quorum).\n" .
ops:total_count_abstention a owl:DatatypeProperty ;
	rdfs:label "total_count_abstention" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of abstentions.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der Enthaltungen.\n" ;
	ops:description_fr "Nombre total d'abstentions.\n" .
ops:total_count_no a owl:DatatypeProperty ;
	rdfs:label "total_count_no" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of 'no' votes.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der „Nein“-Stimmen.\n" ;
	ops:description_fr "Nombre total de voix « non ».\n" .
ops:total_count_yes a owl:DatatypeProperty ;
	rdfs:label "total_count_yes" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of 'yes' votes.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der „Ja“-Stimmen.\n" ;
	ops:description_fr "Nombre total de voix « oui ».\n" .
ops:total_excused a owl:DatatypeProperty ;
	rdfs:label "total_excused" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of excused absences.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der entschuldigten Abwesenheiten.\n" ;
	ops:description_fr "Nombre total d'absences excusées.\n" .
ops:total_other a owl:ObjectProperty ;
	rdfs:label "total_other" ;
	rdfs:range ops:TotalOther ;
	skos:definition "Vote counts for the options of a multiple-choice voting, one entry per option; used instead of total_count_yes, total_count_no and total_count_abstention (see TotalOther).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Stimmenzahlen für die Optionen einer Auswahlabstimmung, ein Eintrag pro Option; tritt an die Stelle von total_count_yes, total_count_no und total_count_abstention (siehe TotalOther).\n" ;
	ops:description_fr "Nombres de voix pour les options d'un vote à choix multiple, une entrée par option ; remplace total_count_yes, total_count_no et total_count_abstention (voir TotalOther).\n" .
ops:total_present a owl:DatatypeProperty ;
	rdfs:label "total_present" ;
	rdfs:range xsd:integer ;
	skos:definition "Total number of members present.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Gesamtzahl der anwesenden Mitglieder.\n" ;
	ops:description_fr "Nombre total de membres présents.\n" .
ops:type a owl:DatatypeProperty ;
	rdfs:label "type" ;
	skos:definition "Generic type designation.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Generische Typbezeichnung.\n" ;
	ops:description_fr "Désignation générique du type.\n" .
ops:type_label a owl:DatatypeProperty ;
	rdfs:label "type_label" ;
	skos:definition "Custom type label when standard type values don't apply.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Benutzerdefinierte Typbezeichnung, wenn Standardtypwerte nicht zutreffen.\n" ;
	ops:description_fr "Libellé de type personnalisé lorsque les valeurs de type standard ne s'appliquent pas.\n" .
ops:url a owl:ObjectProperty ;
	rdfs:label "url" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Landing page or further web address, multilingual.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Landing Page oder weiterführende Webadresse, mehrsprachig.\n" ;
	ops:description_fr "Page d'accueil ou adresse web complémentaire, multilingue.\n" .
ops:version a owl:DatatypeProperty ;
	rdfs:label "version" ;
	skos:definition "Version number or identifier.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Versionsnummer oder Versionskennung.\n" ;
	ops:description_fr "Numéro ou identifiant de version.\n" .
ops:vote_procedures a owl:DatatypeProperty ;
	rdfs:label "vote_procedures" ;
	rdfs:range xsd:string ;
	skos:definition "Procedures by which the vote was taken. Open procedures: show of hands, standing, electronic voting, roll call, and in crisis situations remote voting (votes communicated to the presidency beforehand and recorded together with the vote in the chamber), circulation procedure or voting in virtual sittings. Secret procedures: secret ballot with ballot papers, electronic secret voting. The procedure determines whether individual votes can be recorded.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Verfahren, in denen abgestimmt wurde. Offene Verfahren: Handzeichen, Aufstehen, elektronische Abstimmung, Namensaufruf, in Krisenlagen zudem externe Stimmabgabe (vorgängig dem Präsidium mitgeteilte Stimmen, die zusammen mit der Abstimmung im Rat erfasst werden), Zirkulationsverfahren oder Stimmabgabe an virtuellen Sitzungen. Geheime Verfahren: Stimmzettel, elektronische geheime Abstimmung. Das Verfahren bestimmt, ob Einzelstimmen erfasst werden können.\n" ;
	ops:description_fr "Procédures selon lesquelles le vote a eu lieu. Procédures ouvertes : main levée, assis-debout, vote électronique, appel nominal et, en situation de crise, vote à distance (voix communiquées à l'avance à la présidence et saisies en même temps que le vote au conseil), procédure par voie de circulation ou vote lors de séances virtuelles. Procédures secrètes : bulletin de vote, vote électronique secret. La procédure détermine si les voix individuelles peuvent être saisies.\n" .
ops:voting a owl:ObjectProperty ;
	rdfs:label "votings" ;
	rdfs:range ops:Voting ;
	skos:definition "Collection of voting records.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Sammlung der Abstimmungen.\n" ;
	ops:description_fr "Ensemble des votes.\n" .
ops:voting_title a owl:ObjectProperty ;
	rdfs:label "voting_title" ;
	rdfs:range ops:MultilingualString ;
	skos:definition "Title or question being voted on. If no specific subject exists, do not use the business item title.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Abstimmungstitel bzw. Gegenstand oder Frage. Wenn kein Gegenstand vorhanden ist, sollte nicht der Geschäftstitel verwendet werden.\n" ;
	ops:description_fr "Titre du vote, objet ou question soumise au vote. En l'absence d'objet propre, il ne faut pas reprendre le titre de l'affaire.\n" .
ops:voting_type a owl:ObjectProperty ;
	rdfs:label "voting_type" ;
	rdfs:range ops:VotingTypeEnum ;
	skos:definition "Type of voting procedure (preliminary, final, secret, etc.).\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Art des Abstimmungsverfahrens (Zwischen-, Schlussabstimmung, geheim, etc.).\n" ;
	ops:description_fr "Type de procédure de vote (vote intermédiaire, vote final, vote secret, etc.).\n" .
ops:weight a owl:DatatypeProperty ;
	rdfs:label "weight" ;
	rdfs:range xsd:integer ;
	skos:definition "Voting weight of the member; normally 1. Other values arise, for instance, where a member also votes for an absent member (proxy, weight 2), in communal assemblies where legal entities hold several votes, or in historical systems in which different groups of persons had different voting weights.\n" ;
	skos:inScheme <https://ch.paf.link/schema/operations> ;
	ops:description_de "Stimmgewicht des Mitglieds; im Normalfall 1. Andere Werte kommen etwa vor, wo ein Mitglied für ein abwesendes Mitglied mitstimmt (Stellvertretung, Gewicht 2), an Gemeindeversammlungen, an denen juristische Personen mehrere Stimmen haben, oder in historischen Systemen, in denen verschiedene Personengruppen unterschiedliches Stimmgewicht hatten.\n" ;
	ops:description_fr "Poids de la voix du membre ; normalement 1. D'autres valeurs se présentent par exemple lorsqu'un membre vote aussi pour un membre absent (représentation, poids 2), dans les assemblées communales où des personnes morales disposent de plusieurs voix, ou dans des systèmes historiques où différents groupes de personnes avaient un poids de voix différent.\n" .
<https://ld.ech.ch/schema/0292/meta-common/GroupReference> a owl:Class ;
	rdfs:label "GroupReference" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> , _:c14n105 , _:c14n211 , _:c14n391 , _:c14n4 , _:c14n590 , _:c14n628 ;
	skos:definition "Lightweight reference to a group with key identification data at time of linking. The referenced group is identified by `local_id` or `global_uri`; at least one of the two is required. A `local_id` is resolved within the same delivery, a `global_uri` also beyond it.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Kurzreferenz auf eine Gruppe mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Die referenzierte Gruppe wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich. Eine `local_id` wird innerhalb derselben Lieferung aufgelöst, eine `global_uri` auch darüber hinaus.\n" ;
	ops:description_fr "Référence abrégée à un groupe avec les principales données d'identification au moment de la liaison. Le groupe référencé est désigné par `local_id` ou `global_uri` ; au moins l'un des deux est requis. Un `local_id` est résolu au sein de la même livraison, un `global_uri` également au-delà.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> a owl:Class ;
	rdfs:label "HasCreationModificationDates" ;
	rdfs:subClassOf _:c14n19 , _:c14n193 , _:c14n230 , _:c14n255 , _:c14n265 , _:c14n367 , _:c14n409 , _:c14n427 , _:c14n448 , _:c14n468 , _:c14n5 , _:c14n602 ;
	skos:definition "A mixin class that provides slots for modeling creation and modification dates of an entity.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von Erstellungs- und Änderungsdaten einer Entität zur Verfügung stellt.\n" ;
	ops:description_fr "Une classe mixin qui fournit des slots pour modéliser les dates de création et de modification d'une entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasIdentification> a owl:Class ;
	rdfs:label "HasIdentification" ;
	rdfs:subClassOf _:c14n229 , _:c14n237 , _:c14n24 , _:c14n280 , _:c14n352 , _:c14n508 , _:c14n511 , _:c14n579 , _:c14n665 ;
	skos:definition "A mixin class that provides slots for the identification of an entity. It is used for entities that are identified in their own right; their `global_uri` is the identifier and therefore mandatory.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, die Slots für die Identifikation einer Entität zur Verfügung stellt. Sie wird für Entitäten verwendet, die aus sich heraus identifiziert sind; deren `global_uri` ist der Identifikator und daher obligatorisch.\n" ;
	ops:description_fr "Une classe mixin qui fournit des slots pour l'identification d'une entité. Elle est utilisée pour les entités identifiées en propre ; leur `global_uri` constitue l'identifiant et est donc obligatoire.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> a owl:Class ;
	rdfs:label "HasReferenceIdentification" ;
	rdfs:subClassOf _:c14n313 , _:c14n331 , _:c14n404 , _:c14n435 , _:c14n49 , _:c14n502 , _:c14n588 , _:c14n634 , _:c14n69 ;
	skos:definition "A mixin class that provides the slots with which a reference names the entity it points at. Unlike `HasIdentification` it does not identify the referencing object itself, which is why `global_uri` is neither an identifier here nor mandatory: a system that only holds the local id of the referenced entity states that id instead. A reference class using this mixin should require at least one of the two.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, welche die Slots bereitstellt, mit denen eine Referenz die Entität benennt, auf die sie zeigt. Im Unterschied zu `HasIdentification` identifiziert sie nicht das referenzierende Objekt selbst; deshalb ist `global_uri` hier weder Identifikator noch obligatorisch: Ein System, das nur die lokale Id der referenzierten Entität führt, gibt diese an. Eine Referenzklasse, die diesen Mixin verwendet, soll mindestens eines von beiden verlangen.\n" ;
	ops:description_fr "Une classe mixin qui fournit les slots par lesquels une référence désigne l'entité vers laquelle elle pointe. Contrairement à `HasIdentification`, elle n'identifie pas l'objet référençant lui-même ; c'est pourquoi `global_uri` n'y est ni identifiant ni obligatoire : un système qui ne dispose que de l'identifiant local de l'entité référencée indique celui-ci. Une classe de référence utilisant ce mixin doit exiger au moins l'un des deux.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasTemporalValidity> a owl:Class ;
	rdfs:label "HasTemporalValidity" ;
	rdfs:subClassOf _:c14n139 , _:c14n208 , _:c14n292 , _:c14n533 , _:c14n596 , _:c14n60 , _:c14n612 , _:c14n613 , _:c14n73 ;
	skos:definition "A mixin class that provides slots for modeling a temporal validity of information (not of an event).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, die Slots für die Modellierung einer zeitlichen Gültigkeit einer Information (nicht eines Events) zur Verfügung stellt.\n" ;
	ops:description_fr "Une classe mixin qui fournit des slots pour modéliser la validité temporelle d'une information (et non d'un événement).\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> a owl:Class ;
	rdfs:label "IsEventWithDuration" ;
	rdfs:subClassOf _:c14n130 , _:c14n202 , _:c14n21 , _:c14n270 , _:c14n332 , _:c14n334 , _:c14n349 , _:c14n359 , _:c14n387 , _:c14n413 , _:c14n421 , _:c14n497 , _:c14n506 , _:c14n515 , _:c14n532 , _:c14n543 , _:c14n569 , _:c14n608 , _:c14n641 , _:c14n65 , _:c14n651 , _:c14n668 , _:c14n703 , _:c14n77 ;
	skos:definition "A mixin class that provides slots for modeling events or occurrences with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von Ereignissen oder Vorkommnissen mit Zeitdauer zur Verfügung stellt.\n" ;
	ops:description_fr "Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences avec une durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsInstantaneousEvent> a owl:Class ;
	rdfs:label "IsInstantaneousEvent" ;
	rdfs:subClassOf _:c14n150 , _:c14n250 , _:c14n336 , _:c14n342 , _:c14n369 , _:c14n370 , _:c14n460 , _:c14n565 , _:c14n59 , _:c14n663 , _:c14n89 , _:c14n90 ;
	skos:definition "A mixin class that provides slots for modeling instantaneous events or occurrences (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von instantanen Ereignissen oder Vorkommnissen (ohne Zeitdauer) zur Verfügung stellt.\n" ;
	ops:description_fr "Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences instantanés (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsProcessStep> a owl:Class ;
	rdfs:label "IsProcessStep" ;
	rdfs:subClassOf _:c14n0 , _:c14n120 , _:c14n134 , _:c14n140 , _:c14n15 , _:c14n151 , _:c14n159 , _:c14n161 , _:c14n168 , _:c14n185 , _:c14n187 , _:c14n190 , _:c14n198 , _:c14n201 , _:c14n205 , _:c14n224 , _:c14n264 , _:c14n296 , _:c14n31 , _:c14n326 , _:c14n346 , _:c14n368 , _:c14n372 , _:c14n377 , _:c14n392 , _:c14n458 , _:c14n476 , _:c14n566 , _:c14n575 , _:c14n587 , _:c14n615 , _:c14n626 , _:c14n638 , _:c14n64 , _:c14n671 , _:c14n699 ;
	skos:definition "A mixin class for a single step in a multi-stage process (e.g.,\na deliberation step of an affair or a phase step of a consultation).\nCombines identification and event-duration slots and adds a free-text\nremark slot. Concrete step classes add their own type-specific slots.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine Mixin-Klasse für einen einzelnen Schritt in einem\nmehrstufigen Prozess (z. B. Bearbeitungsschritt eines Geschäfts oder\nPhasen­schritt einer Konsultation). Kombiniert Identifikations- und\nZeitdauer-Slots und ergänzt einen freien Bemerkungs-Slot. Konkrete\nStep-Klassen ergänzen ihre eigenen typ-spezifischen Slots.\n" ;
	ops:description_fr "Une classe mixin pour une étape unique dans un processus\nà plusieurs étapes (par ex. une étape de délibération d'une affaire ou\nune étape de phase d'une consultation). Combine les slots d'identification\net de durée d'événement et ajoute un slot de remarque en texte libre.\nLes classes d'étape concrètes ajoutent leurs propres slots spécifiques au type.\n" .
<https://ld.ech.ch/schema/0292/meta-common/MultilingualUri> a owl:Class ;
	rdfs:label "MultilingualUri" ;
	rdfs:subClassOf _:c14n181 , _:c14n217 , _:c14n36 , _:c14n431 , _:c14n509 , _:c14n639 ;
	skos:definition "A URI together with the language of the resource it points to. Same structure as MultilingualValue, but the value is a URI: it is used where the same content is published under a separate address per language.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine URI zusammen mit der Sprache der Ressource, auf die sie verweist. Gleich aufgebaut wie MultilingualValue, der Wert ist jedoch eine URI: Sie wird dort verwendet, wo derselbe Inhalt je Sprache unter einer eigenen Adresse publiziert wird.\n" ;
	ops:description_fr "Une URI accompagnée de la langue de la ressource vers laquelle elle renvoie. Structure identique à MultilingualValue, mais la valeur est une URI : elle est utilisée là où le même contenu est publié à une adresse propre par langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> a owl:Class ;
	rdfs:label "MultilingualValue" ;
	rdfs:subClassOf _:c14n142 , _:c14n166 , _:c14n238 , _:c14n297 , _:c14n415 , _:c14n563 ;
	skos:definition "A multilingual string with language specification.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Ein mehrsprachiger String mit Angabe der Sprache.\n" ;
	ops:description_fr "Une chaîne de caractères multilingue avec indication de la langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/PersonReference> a owl:Class ;
	rdfs:label "PersonReference" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> , _:c14n129 , _:c14n167 , _:c14n180 , _:c14n269 , _:c14n318 , _:c14n360 , _:c14n385 , _:c14n422 , _:c14n439 , _:c14n611 ;
	skos:definition "Lightweight reference to a person with key identification data at time of linking. Preserves historical accuracy even if the person changes later. The referenced person is identified by `local_id` or `global_uri`; at least one of the two is required.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Kurzreferenz auf eine Person mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Ermöglicht historische Korrektheit auch wenn sich die Person später ändert. Die referenzierte Person wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich.\n" ;
	ops:description_fr "Référence abrégée à une personne avec les principales données d'identification au moment de la liaison. Préserve l'exactitude historique même si la personne change ultérieurement. La personne référencée est désignée par `local_id` ou `global_uri` ; au moins l'un des deux est requis.\n" .
<https://ld.ech.ch/schema/0292/meta-common/abbreviation> a owl:ObjectProperty ;
	rdfs:label "abbreviation" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> ;
	skos:definition "Abbreviation (can be multilingual).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Abkürzung (kann mehrsprachig sein).\n" ;
	ops:description_fr "Abréviation (peut être multilingue).\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateActual> a owl:DatatypeProperty ;
	rdfs:label "date_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual date of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	ops:description_fr "La date effective d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> a owl:DatatypeProperty ;
	rdfs:label "date_begin_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual start date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date de début effective d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> a owl:DatatypeProperty ;
	rdfs:label "date_begin_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned start date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date de début planifiée d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateCreated> a owl:DatatypeProperty ;
	rdfs:label "date_created" ;
	rdfs:range xsd:date ;
	skos:definition "The date when an entity was created.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum, an dem eine Entität erstellt wurde.\n" ;
	ops:description_fr "La date à laquelle une entité a été créée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateEndActual> a owl:DatatypeProperty ;
	rdfs:label "date_end_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual end date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date de fin effective d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateEndPlanned> a owl:DatatypeProperty ;
	rdfs:label "date_end_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned end date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date de fin planifiée d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateModified> a owl:DatatypeProperty ;
	rdfs:label "date_modified" ;
	rdfs:range xsd:date ;
	skos:definition "The date when an entity was last modified.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum, an dem eine Entität zuletzt geändert wurde.\n" ;
	ops:description_fr "La date à laquelle une entité a été modifiée pour la dernière fois.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datePlanned> a owl:DatatypeProperty ;
	rdfs:label "date_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned date of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	ops:description_fr "La date planifiée d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual date and time of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	ops:description_fr "La date et l'heure effectives d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeBeginActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_begin_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual start date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_begin_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned start date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeCreated> a owl:DatatypeProperty ;
	rdfs:label "datetime_created" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when an entity was created.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.\n" ;
	ops:description_fr "La date et l'heure auxquelles une entité a été créée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_end_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual end date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_end_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned end date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	ops:description_fr "La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeModified> a owl:DatatypeProperty ;
	rdfs:label "datetime_modified" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when an entity was last modified.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.\n" ;
	ops:description_fr "La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned date and time of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Das geplante Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	ops:description_fr "La date et l'heure planifiées d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/globalURI> a owl:DatatypeProperty ;
	rdfs:label "global_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A unique, globally valid URI for the entity.\n" , "The unique, globally valid URI of the referenced entity. Unlike a local_id it also resolves beyond the delivery.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.\n" , "Eine eindeutige, global gültige URI für die Entität.\n" ;
	ops:description_fr "L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.\n" , "Une URI unique et globalement valide pour l'entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/groupLabel> a owl:DatatypeProperty ;
	rdfs:label "group_label" ;
	skos:definition "Name of the body/group at time of linking.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Name des Gremiums zum Zeitpunkt der Verknüpfung.\n" ;
	ops:description_fr "Nom de l'organe/du groupe au moment de la liaison.\n" .
<https://ld.ech.ch/schema/0292/meta-common/isCurrent> a owl:DatatypeProperty ;
	rdfs:label "is_active" ;
	rdfs:range xsd:boolean ;
	skos:definition "Indicates whether the information is currently valid. Can be useful when this information is explicitly available.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Gibt an, ob die Information aktuell gültig ist. Kann nützlich sein, wenn diese Information explizit vorhanden ist.\n" ;
	ops:description_fr "Indique si l'information est actuellement valable. Peut être utile lorsque cette information est explicitement disponible.\n" .
<https://ld.ech.ch/schema/0292/meta-common/label> a owl:DatatypeProperty ;
	rdfs:label "label" ;
	skos:definition "Assign a label to a structured piece of information (e.g., display name, position, etc.).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Möglichkeit bei einer strukturierten Information, ein Label zu vergeben (bspw. Anzeigename, Anstellung, etc.).\n" ;
	ops:description_fr "Attribuer un label à une information structurée (par ex. nom d'affichage, poste, etc.).\n" .
<https://ld.ech.ch/schema/0292/meta-common/labelLong> a owl:DatatypeProperty ;
	rdfs:label "label_long" ;
	skos:definition "Assign an extended label to a structured piece of information (e.g., display name with title, position, etc.).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Möglichkeit bei einer strukturierten Information, ein erweitertesLabel zu vergeben (bspw. Anzeigename mit Titel, Anstellung, etc.).\n" ;
	ops:description_fr "Attribuer un label étendu à une information structurée (par ex. nom d'affichage avec titre, poste, etc.).\n" .
<https://ld.ech.ch/schema/0292/meta-common/language> a owl:DatatypeProperty ;
	rdfs:label "language" ;
	rdfs:range _:c14n157 ;
	skos:definition "Language code in ISO 639-1 format (two lowercase letters, e.g. \"de\", \"fr\", \"it\", \"en\").\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. \"de\", \"fr\", \"it\", \"en\").\n" ;
	ops:description_fr "Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).\n" .
<https://ld.ech.ch/schema/0292/meta-common/localId> a owl:DatatypeProperty ;
	rdfs:label "local_id" ;
	skos:definition "Local identifier of the referenced entity. It is resolved within the same delivery.\n" , "Local identifier. For example, a UUID from the council information system.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.\n" , "Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.\n" ;
	ops:description_fr "Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.\n" , "Identifiant local. Par exemple, un UUID issu du système d'information du conseil.\n" .
<https://ld.ech.ch/schema/0292/meta-common/multilingualValue> a owl:ObjectProperty ;
	rdfs:label "multilingual_value" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> ;
	skos:definition "A multilingual value with language specification.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Ein mehrsprachiger Wert mit Angabe der Sprache.\n" ;
	ops:description_fr "Une valeur multilingue avec indication de la langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/remark> a owl:DatatypeProperty ;
	rdfs:label "remark" ;
	rdfs:range xsd:string ;
	skos:definition "Free-text remark or note for edge cases or additional context on a process step or an entity.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Freitext-Bemerkung oder Notiz für Sonderfälle oder zusätzlichen Kontext zu einem Prozessschritt oder einer Entität.\n" ;
	ops:description_fr "Remarque ou note en texte libre pour les cas particuliers ou pour un contexte supplémentaire relatif à une étape de processus ou à une entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/value> a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The value of an information besides other attributes such as type, language, etc.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.\n" ;
	ops:description_fr "La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.\n" .
<https://ld.ech.ch/schema/0292/meta-common/wikidataUri> a owl:DatatypeProperty ;
	rdfs:label "wikidata_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A URI that refers to a Wikidata entity, e.g. http://www.wikidata.org/entity/Q813067 for Beat Jans.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	ops:description_de "Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.\n" ;
	ops:description_fr "Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.\n" , "Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.\n" .
