          <xs:documentation xml:lang="fr">Date et heure de la dernière révision de la version linguistique.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Manifestation">
