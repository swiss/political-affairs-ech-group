        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Datum der Erstpublikation der Sprachfassung.</xs:documentation>
          <xs:documentation xml:lang="fr">Date de la première publication de la version linguistique.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
