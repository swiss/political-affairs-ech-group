        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IsProcessStep">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Mixin-Klasse für einen einzelnen Schritt in einem
mehrstufigen Prozess (z. B. Bearbeitungsschritt eines Geschäfts oder
Phasen­schritt einer Konsultation). Kombiniert Identifikations- und
Zeitdauer-Slots und ergänzt einen freien Bemerkungs-Slot. Konkrete
Step-Klassen ergänzen ihre eigenen typ-spezifischen Slots.</xs:documentation>
      <xs:documentation xml:lang="fr">Une classe mixin pour une étape unique dans un processus
à plusieurs étapes (par ex. une étape de délibération d'une affaire ou
une étape de phase d'une consultation). Combine les slots d'identification
et de durée d'événement et ajoute un slot de remarque en texte libre.
Les classes d'étape concrètes ajoutent leurs propres slots spécifiques au type.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="remark" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freitext-Bemerkung oder Notiz für Sonderfälle oder zusätzlichen Kontext zu einem Prozessschritt oder einer Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Remarque ou note en texte libre pour les cas particuliers ou pour un contexte supplémentaire relatif à une étape de processus ou à une entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MultilingualValue">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein mehrsprachiger String mit Angabe der Sprache.</xs:documentation>
      <xs:documentation xml:lang="fr">Une chaîne de caractères multilingue avec indication de la langue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="value" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.</xs:documentation>
          <xs:documentation xml:lang="fr">La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").</xs:documentation>
          <xs:documentation xml:lang="fr">Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MultilingualUri">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine URI zusammen mit der Sprache der Ressource, auf die sie verweist. Gleich aufgebaut wie MultilingualValue, der Wert ist jedoch eine URI: Sie wird dort verwendet, wo derselbe Inhalt je Sprache unter einer eigenen Adresse publiziert wird.</xs:documentation>
      <xs:documentation xml:lang="fr">Une URI accompagnée de la langue de la ressource vers laquelle elle renvoie. Structure identique à MultilingualValue, mais la valeur est une URI : elle est utilisée là où le même contenu est publié à une adresse propre par langue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="value" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.</xs:documentation>
          <xs:documentation xml:lang="fr">La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").</xs:documentation>
          <xs:documentation xml:lang="fr">Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PersonReference">
    <xs:annotation>
      <xs:documentation xml:lang="de">Kurzreferenz auf eine Person mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Ermöglicht historische Korrektheit auch wenn sich die Person später ändert. Die referenzierte Person wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich.</xs:documentation>
      <xs:documentation xml:lang="fr">Référence abrégée à une personne avec les principales données d'identification au moment de la liaison. Préserve l'exactitude historique même si la personne change ultérieurement. La personne référencée est désignée par `local_id` ou `global_uri` ; au moins l'un des deux est requis.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="label" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Obligatorischer Kurzname zur Identifikation der Person innerhalb der Organisation (z.B. mit Geburtsjahr zur Unterscheidung von Personen mit gleichem Namen).</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage court obligatoire permettant d'identifier la personne au sein de l'organisation (par ex. avec l'ajout de l'année de naissance afin de distinguer les personnes portant le même nom).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_long" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Optionaler langer Anzeigename mit akademischen Titeln und vollständigem amtlichem Namen (z.B. "Dr. Maria Muster-Beispiel").</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage long facultatif comprenant les titres académiques et le nom officiel complet (par ex. « Dr. Maria Muster-Beispiel »).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="group_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Name des Gremiums zum Zeitpunkt der Verknüpfung.</xs:documentation>
          <xs:documentation xml:lang="fr">Nom de l'organe/du groupe au moment de la liaison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.</xs:documentation>
          <xs:documentation xml:lang="fr">L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GroupReference">
    <xs:annotation>
      <xs:documentation xml:lang="de">Kurzreferenz auf eine Gruppe mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Die referenzierte Gruppe wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich. Eine `local_id` wird innerhalb derselben Lieferung aufgelöst, eine `global_uri` auch darüber hinaus.</xs:documentation>
      <xs:documentation xml:lang="fr">Référence abrégée à un groupe avec les principales données d'identification au moment de la liaison. Le groupe référencé est désigné par `local_id` ou `global_uri` ; au moins l'un des deux est requis. Un `local_id` est résolu au sein de la même livraison, un `global_uri` également au-delà.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Möglichkeit bei einer strukturierten Information, ein Label zu vergeben (bspw. Anzeigename, Anstellung, etc.).</xs:documentation>
          <xs:documentation xml:lang="fr">Attribuer un label à une information structurée (par ex. nom d'affichage, poste, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="abbreviation" minOccurs="0" maxOccurs="unbounded" type="MultilingualValue">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abkürzung (kann mehrsprachig sein).</xs:documentation>
          <xs:documentation xml:lang="fr">Abréviation (peut être multilingue).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.</xs:documentation>
          <xs:documentation xml:lang="fr">L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Work">
    <xs:annotation>
      <xs:documentation xml:lang="de">FRBR Work: das abstrakte Dokument als solches, unabhängig von einer konkreten Sprachfassung oder einem Dateiformat.</xs:documentation>
      <xs:documentation xml:lang="fr">FRBR Work : le document abstrait en tant que tel, indépendamment d'une version linguistique ou d'un format de fichier concrets.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="document_category" minOccurs="0" maxOccurs="1" type="DocumentCategoryEnum" default="other">
        <xs:annotation>
          <xs:documentation xml:lang="de">Kategorie des Dokuments. Wenn nicht gesetzt, wird automatisch 'other' verwendet.</xs:documentation>
          <xs:documentation xml:lang="fr">Catégorie du document. Si elle n'est pas renseignée, la valeur 'other' est utilisée automatiquement.</xs:documentation>
