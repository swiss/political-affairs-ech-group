      <xs:element name="agenda_item_description" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Untertitel oder ausführliche Beschreibung des Traktandums.</xs:documentation>
          <xs:documentation xml:lang="fr">Sous-titre ou description détaillée du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="state_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Zustands-Identifikator des Traktandums (Verweis auf ein Status-Enum oder auf einen eigenen Zustand), z.B. pending (noch nicht behandelt), in_progress (in Beratung), completed (abgeschlossen), postponed (auf eine spätere Sitzung vertagt) oder withdrawn (zurückgezogen).</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant d'état du point (renvoi à une énumération des états ou à un état propre), p. ex. pending (pas encore traité), in_progress (en délibération), completed (traité), postponed (renvoyé à une séance ultérieure) ou withdrawn (retiré).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="state_name" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abweichende, freitextliche Statusbezeichnung, wo die Status-Aufzählung nicht genügt.</xs:documentation>
          <xs:documentation xml:lang="fr">Désignation de statut divergente, en texte libre, là où l'énumération des statuts ne suffit pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL mit weiteren Informationen.</xs:documentation>
          <xs:documentation xml:lang="fr">URL fournissant des informations complémentaires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="url" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Landing Page oder weiterführende Webadresse, mehrsprachig.</xs:documentation>
          <xs:documentation xml:lang="fr">Page d'accueil ou adresse web complémentaire, multilingue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_category" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freie Kategorisierung des Traktandums nach Inhalt oder Gruppierung, z.B. „Gesetzgebung“, „Budget und Finanzen“, „Interpellationen und Anfragen“, „Wahlen“, nach Departement oder einleitende und technische Traktanden. Die Kategorisierung ist nicht standardisiert und kann je nach Föderaleinheit variieren.</xs:documentation>
          <xs:documentation xml:lang="fr">Catégorisation libre du point selon son contenu ou son regroupement, p. ex. « Législation », « Budget et finances », « Interpellations et questions », « Élections », par département, ou points introductifs et techniques. La catégorisation n'est pas standardisée et peut varier selon l'unité fédérale.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_agenda_item" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Traktandums, zu dem dieser Eintrag gehört. Bei einem Traktandum bildet er eine Hierarchie von Traktanden — z.B. eine Traktandengruppe „Gesetzesberatungen“ mit den Untertraktanden „Energiegesetz (Detailberatung)“ und „Energiegesetz (Schlussabstimmung)“; bei einer Wortmeldung bezeichnet er das Traktandum, unter dem sie erfolgte.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant du point de l'ordre du jour auquel cet enregistrement se rattache. Pour un point de l'ordre du jour, il forme une hiérarchie de points — p. ex. un groupe « Délibérations législatives » avec les sous-points « Loi sur l'énergie (discussion par article) » et « Loi sur l'énergie (vote final) » ; pour une intervention, il désigne le point sous lequel elle a été faite.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="has_resolution" minOccurs="0" maxOccurs="1" type="Resolution">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der formale Beschluss zu diesem Traktandum, z.B. die Annahme des Energiegesetzes. Die zugrunde liegende Abstimmung mit dem Stimmenverhältnis wird separat als Voting erfasst.</xs:documentation>
          <xs:documentation xml:lang="fr">La décision formelle prise sur ce point de l'ordre du jour, p. ex. l'adoption de la loi sur l'énergie. Le vote sous-jacent avec son rapport de voix est saisi séparément comme Voting.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="joint_debates" minOccurs="0" maxOccurs="unbounded" type="JointDebate">
        <xs:annotation>
          <xs:documentation xml:lang="de">An diesem Eintrag angehängte gemeinsame Beratungen: bei einem Traktandum die Beratungen, in denen es zusammen mit anderen Traktanden behandelt wird; bei einer Sitzung oder Session die darin geführten gemeinsamen Beratungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Délibérations communes rattachées à cet enregistrement : pour un point de l'ordre du jour, les délibérations dans lesquelles il est traité conjointement avec d'autres points ; pour une séance ou une session, les délibérations communes qui s'y tiennent.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text_segments" minOccurs="0" maxOccurs="unbounded" type="TextSegment">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Textsegmenten (z.B. Wortprotokoll).</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble de segments de texte (p. ex. procès-verbal in extenso).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Unterlagen zum Traktandum als FRBR-Works, z.B. Botschaften und Berichte, Anträge und Änderungsanträge.</xs:documentation>
          <xs:documentation xml:lang="fr">Documents relatifs au point de l'ordre du jour, sous forme de FRBR Works, p. ex. messages et rapports, propositions et propositions d'amendement.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Protocol">
    <xs:annotation>
      <xs:documentation xml:lang="de">Das Protokoll einer Sitzung, nach der Sitzung erstellt und pro Sitzung genau einmal geführt. Ein Wrapper-Container, der die effektiv behandelten Traktanden (protocol_items), Abstimmungen, Wahlen, Wortmeldungen, Wortlaut-Textsegmente und verknüpfte Dokumente bündelt. Das Protokoll hat einen eigenen Identifikator, ist eigenständig zitierbar und wird in der Regel später veröffentlicht als die Sitzung; die Sitzung referenziert es deshalb nur (Meeting.has_protocol), und das Protokoll selbst wird in Container.protocols geliefert, sodass es nachgeliefert werden kann, ohne die Sitzung erneut zu liefern. Innerhalb des Protokolls sind die Sammlungen eingebettet, weil sie zusammen mit ihm entstehen und geliefert werden. Wer Abstimmungen oder Wortmeldungen unabhängig vom Protokoll publiziert, liefert sie flach in Container.votings bzw. Container.speeches und verknüpft sie über parent_meeting und die jeweilige Traktandenreferenz.</xs:documentation>
      <xs:documentation xml:lang="fr">Le procès-verbal d'une séance, établi après celle-ci et tenu exactement une fois par séance. Un conteneur qui regroupe les points effectivement traités (protocol_items), les votes, les élections, les interventions, les segments de texte in extenso et les documents liés. Le procès-verbal possède son propre identifiant, peut être cité de manière autonome et est en règle générale publié après la séance ; la séance ne fait donc que le référencer (Meeting.has_protocol), et le procès-verbal lui-même est livré dans Container.protocols, de sorte qu'il puisse être livré ultérieurement sans relivrer la séance. À l'intérieur du procès-verbal, les collections sont imbriquées, car elles naissent et sont livrées avec lui. Qui publie des votes ou des interventions indépendamment du procès-verbal les livre à plat dans Container.votings ou Container.speeches et les relie par parent_meeting et la référence au point de l'ordre du jour correspondante.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parent_meeting" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator der Sitzung, zu der dieser Eintrag gehört. Bei einer Sitzung bezeichnet er die übergeordnete Sitzung, bei Abstimmung, Wahl, Wortmeldung, Anwesenheitsliste oder Protokoll die Sitzung, in der der Eintrag entstanden ist. Traktanden führen ihn nicht: Sie sind in ihre Sitzung eingebettet.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de la séance à laquelle cet enregistrement se rattache. Pour une séance, il désigne la séance supérieure ; pour un vote, une élection, une intervention, une liste de présence ou un procès-verbal, la séance au cours de laquelle l'enregistrement est né. Les points de l'ordre du jour ne le portent pas : ils sont imbriqués dans leur séance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="protocol_items" minOccurs="0" maxOccurs="unbounded" type="ProtocolItem">
        <xs:annotation>
          <xs:documentation xml:lang="de">Traktanden, wie sie im Protokoll tatsächlich festgehalten wurden.</xs:documentation>
          <xs:documentation xml:lang="fr">Points de l'ordre du jour tels qu'ils ont effectivement été consignés au procès-verbal.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="votings" minOccurs="0" maxOccurs="unbounded" type="Voting">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung der Abstimmungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble des votes.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="elections" minOccurs="0" maxOccurs="unbounded" type="Election">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung der Wahlen.</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble des élections.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="speeches" minOccurs="0" maxOccurs="unbounded" type="Speech">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung der Wortmeldungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble des interventions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text_segments" minOccurs="0" maxOccurs="unbounded" type="TextSegment">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Textsegmenten (z.B. Wortprotokoll).</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble de segments de texte (p. ex. procès-verbal in extenso).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ProtocolItem">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein Traktandum, wie es im Protokoll tatsächlich festgehalten wurde. Es führt über das Mixin IsAgendaItem dieselben Elemente wie AgendaItem, ist aber eine eigenständige Klasse: Das Protokollierte ist kein Sonderfall des Geplanten. Es entsteht unabhängig und kann Traktanden enthalten, die nie traktandiert waren, so wie die Traktandenliste Punkte enthalten kann, die nie behandelt wurden.</xs:documentation>
      <xs:documentation xml:lang="fr">Un point de l'ordre du jour tel qu'il a effectivement été consigné au procès-verbal. Il porte les mêmes éléments qu'AgendaItem par le mixin IsAgendaItem, mais constitue une classe à part entière : le point consigné n'est pas un cas particulier du point planifié. Il naît indépendamment et peut comprendre des points jamais mis à l'ordre du jour, de même que l'ordre du jour peut comprendre des points jamais traités.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_type" minOccurs="0" maxOccurs="1" type="AgendaItemTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art des Traktandums, unterscheidet Einzeltraktanden von Traktandengruppen.</xs:documentation>
          <xs:documentation xml:lang="fr">Type de point de l'ordre du jour, distinguant les points isolés des groupes de points.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_number" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Nummer des Traktandums auf der Traktandenliste, z.B. „2.1“ oder „3“ (Zeichenkette, damit auch römische Ziffern möglich sind).</xs:documentation>
          <xs:documentation xml:lang="fr">Numéro du point sur l'ordre du jour, p. ex. « 2.1 » ou « 3 » (chaîne de caractères, afin de permettre aussi les chiffres romains).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_position" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Ganzzahlige Position des Traktandums im Sitzungsablauf, massgebend für Sortierung und Darstellung.</xs:documentation>
          <xs:documentation xml:lang="fr">Position entière du point dans le déroulement de la séance, déterminante pour le tri et l'affichage.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="leading_actor_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das federführende Departement für das Traktandum.</xs:documentation>
          <xs:documentation xml:lang="fr">Le département responsable du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="speaking_actor_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der Sprecher oder die Sprecherin bzw. die Departementsvorsteherin oder der Departementsvorsteher für das Traktandum.</xs:documentation>
          <xs:documentation xml:lang="fr">La ou le porte-parole ou la cheffe ou le chef du département pour le point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_title" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Titel des Traktandums.</xs:documentation>
          <xs:documentation xml:lang="fr">Titre du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="affair_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Geschäfts (eCH-0295), auf das sich der Eintrag bezieht. Administrative Traktanden (z.B. Genehmigung des Protokolls) haben kein Geschäft. Ein Geschäft durchläuft in der Regel mehrere Traktanden — in der Gesetzgebung etwa Eintretensdebatte, Detailberatung, Schlussabstimmung und gegebenenfalls die Differenzbereinigung zwischen den Räten.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de l'affaire (eCH-0295) à laquelle se rapporte l'enregistrement. Les points administratifs (p. ex. approbation du procès-verbal) n'ont pas d'affaire. Une affaire passe en règle générale par plusieurs points de l'ordre du jour — dans la législation, par exemple, le débat d'entrée en matière, la discussion par article, le vote final et, le cas échéant, la procédure d'élimination des divergences entre les conseils.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_description" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Untertitel oder ausführliche Beschreibung des Traktandums.</xs:documentation>
          <xs:documentation xml:lang="fr">Sous-titre ou description détaillée du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="state_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Zustands-Identifikator des Traktandums (Verweis auf ein Status-Enum oder auf einen eigenen Zustand), z.B. pending (noch nicht behandelt), in_progress (in Beratung), completed (abgeschlossen), postponed (auf eine spätere Sitzung vertagt) oder withdrawn (zurückgezogen).</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant d'état du point (renvoi à une énumération des états ou à un état propre), p. ex. pending (pas encore traité), in_progress (en délibération), completed (traité), postponed (renvoyé à une séance ultérieure) ou withdrawn (retiré).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="state_name" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abweichende, freitextliche Statusbezeichnung, wo die Status-Aufzählung nicht genügt.</xs:documentation>
          <xs:documentation xml:lang="fr">Désignation de statut divergente, en texte libre, là où l'énumération des statuts ne suffit pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL mit weiteren Informationen.</xs:documentation>
          <xs:documentation xml:lang="fr">URL fournissant des informations complémentaires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="url" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Landing Page oder weiterführende Webadresse, mehrsprachig.</xs:documentation>
          <xs:documentation xml:lang="fr">Page d'accueil ou adresse web complémentaire, multilingue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="agenda_item_category" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freie Kategorisierung des Traktandums nach Inhalt oder Gruppierung, z.B. „Gesetzgebung“, „Budget und Finanzen“, „Interpellationen und Anfragen“, „Wahlen“, nach Departement oder einleitende und technische Traktanden. Die Kategorisierung ist nicht standardisiert und kann je nach Föderaleinheit variieren.</xs:documentation>
          <xs:documentation xml:lang="fr">Catégorisation libre du point selon son contenu ou son regroupement, p. ex. « Législation », « Budget et finances », « Interpellations et questions », « Élections », par département, ou points introductifs et techniques. La catégorisation n'est pas standardisée et peut varier selon l'unité fédérale.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_agenda_item" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Traktandums, zu dem dieser Eintrag gehört. Bei einem Traktandum bildet er eine Hierarchie von Traktanden — z.B. eine Traktandengruppe „Gesetzesberatungen“ mit den Untertraktanden „Energiegesetz (Detailberatung)“ und „Energiegesetz (Schlussabstimmung)“; bei einer Wortmeldung bezeichnet er das Traktandum, unter dem sie erfolgte.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant du point de l'ordre du jour auquel cet enregistrement se rattache. Pour un point de l'ordre du jour, il forme une hiérarchie de points — p. ex. un groupe « Délibérations législatives » avec les sous-points « Loi sur l'énergie (discussion par article) » et « Loi sur l'énergie (vote final) » ; pour une intervention, il désigne le point sous lequel elle a été faite.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="has_resolution" minOccurs="0" maxOccurs="1" type="Resolution">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der formale Beschluss zu diesem Traktandum, z.B. die Annahme des Energiegesetzes. Die zugrunde liegende Abstimmung mit dem Stimmenverhältnis wird separat als Voting erfasst.</xs:documentation>
          <xs:documentation xml:lang="fr">La décision formelle prise sur ce point de l'ordre du jour, p. ex. l'adoption de la loi sur l'énergie. Le vote sous-jacent avec son rapport de voix est saisi séparément comme Voting.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="joint_debates" minOccurs="0" maxOccurs="unbounded" type="JointDebate">
        <xs:annotation>
          <xs:documentation xml:lang="de">An diesem Eintrag angehängte gemeinsame Beratungen: bei einem Traktandum die Beratungen, in denen es zusammen mit anderen Traktanden behandelt wird; bei einer Sitzung oder Session die darin geführten gemeinsamen Beratungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Délibérations communes rattachées à cet enregistrement : pour un point de l'ordre du jour, les délibérations dans lesquelles il est traité conjointement avec d'autres points ; pour une séance ou une session, les délibérations communes qui s'y tiennent.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text_segments" minOccurs="0" maxOccurs="unbounded" type="TextSegment">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Textsegmenten (z.B. Wortprotokoll).</xs:documentation>
          <xs:documentation xml:lang="fr">Ensemble de segments de texte (p. ex. procès-verbal in extenso).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Unterlagen zum Traktandum als FRBR-Works, z.B. Botschaften und Berichte, Anträge und Änderungsanträge.</xs:documentation>
          <xs:documentation xml:lang="fr">Documents relatifs au point de l'ordre du jour, sous forme de FRBR Works, p. ex. messages et rapports, propositions et propositions d'amendement.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="JointDebate">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine gemeinsame Beratung: Mehrere Traktanden werden zusammen behandelt, etwa inhaltlich zusammenhängende Geschäfte, die in einer einzigen Debatte beraten werden. Die gemeinsame Beratung hängt an einem Traktandum (AgendaItem), einem Protokoll-Traktandum (ProtocolItem), einer Sitzung (Meeting) oder einer Session (Session) und verweist über deren Identifikatoren auf die gemeinsam behandelten Traktanden. An einer Sitzung oder Session angehängt, kann sie auch Traktanden zusammenfassen, die auf mehrere Traktandenpositionen oder Sitzungen verteilt sind.</xs:documentation>
      <xs:documentation xml:lang="fr">Une délibération commune : plusieurs points de l'ordre du jour sont traités ensemble, par exemple des affaires connexes délibérées dans un seul et même débat. La délibération commune est rattachée à un point de l'ordre du jour (AgendaItem), à un point du procès-verbal (ProtocolItem), à une séance (Meeting) ou à une session (Session) et renvoie, par leurs identifiants, aux points traités conjointement. Rattachée à une séance ou à une session, elle peut aussi réunir des points répartis sur plusieurs positions de l'ordre du jour ou sur plusieurs séances.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="joint_agenda_item_ids" minOccurs="0" maxOccurs="unbounded" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikatoren der gemeinsam behandelten Traktanden (AgendaItem oder ProtocolItem).</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiants des points de l'ordre du jour traités conjointement (AgendaItem ou ProtocolItem).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Resolution">
    <xs:annotation>
      <xs:documentation xml:lang="de">Der formale Beschluss zu einem Traktandum, einschliesslich der angewandten Abstimmungsverfahren. Er hält fest, was entschieden wurde, während Voting festhält, wie entschieden wurde (Verfahren und Stimmenverhältnis). Nicht jeder Beschluss beruht auf einer formalen Abstimmung: Kenntnisnahmen, stille Annahmen oder Administrativbeschlüsse kommen ohne eine solche zustande.</xs:documentation>
      <xs:documentation xml:lang="fr">La décision formelle prise sur un point de l'ordre du jour, y compris les procédures de vote appliquées. Elle retient ce qui a été décidé, tandis que Voting retient comment il a été décidé (procédure et rapport de voix). Toute décision ne repose pas sur un vote formel : les prises de connaissance, les adoptions tacites ou les décisions administratives interviennent sans vote.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="resolution_type" minOccurs="0" maxOccurs="1" type="ResolutionTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der Resolution zum Traktandum.</xs:documentation>
          <xs:documentation xml:lang="fr">Type de décision prise sur le point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Benutzerdefinierte Typbezeichnung, wenn Standardtypwerte nicht zutreffen.</xs:documentation>
          <xs:documentation xml:lang="fr">Libellé de type personnalisé lorsque les valeurs de type standard ne s'appliquent pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vote_procedures" minOccurs="0" maxOccurs="unbounded" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Verfahren, in denen abgestimmt wurde. Offene Verfahren: Handzeichen, Aufstehen, elektronische Abstimmung, Namensaufruf, in Krisenlagen zudem externe Stimmabgabe (vorgängig dem Präsidium mitgeteilte Stimmen, die zusammen mit der Abstimmung im Rat erfasst werden), Zirkulationsverfahren oder Stimmabgabe an virtuellen Sitzungen. Geheime Verfahren: Stimmzettel, elektronische geheime Abstimmung. Das Verfahren bestimmt, ob Einzelstimmen erfasst werden können.</xs:documentation>
          <xs:documentation xml:lang="fr">Procédures selon lesquelles le vote a eu lieu. Procédures ouvertes : main levée, assis-debout, vote électronique, appel nominal et, en situation de crise, vote à distance (voix communiquées à l'avance à la présidence et saisies en même temps que le vote au conseil), procédure par voie de circulation ou vote lors de séances virtuelles. Procédures secrètes : bulletin de vote, vote électronique secret. La procédure détermine si les voix individuelles peuvent être saisies.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Voting">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Abstimmung über eine Sachfrage: der Abstimmungsgegenstand (Frage), das Verfahren, das Ergebnis mit dem Stimmenverhältnis und — bei offenen Abstimmungen — die Einzelstimmen der Mitglieder. Abgestimmt wird im Verlauf der Sitzung, weshalb die Abstimmung im Protokoll verankert ist (parent_protocol, parent_protocol_item); zudem ist sie mit der Sitzung (parent_meeting) und dem Geschäft (affair_id) verknüpft. Die Präsidentin oder der Präsident nimmt an Abstimmungen nicht teil, fällt bei Stimmengleichheit aber den Stichentscheid (tie_breaker). Der kategorische Entscheid (angenommen, abgelehnt, Kenntnisnahme …) wird nicht auf der Abstimmung, sondern in der Resolution des Traktandums festgehalten.</xs:documentation>
      <xs:documentation xml:lang="fr">Un vote sur une question matérielle : l'objet du vote (la question), la procédure, le résultat avec le rapport de voix et — pour les votes ouverts — les voix individuelles des membres. Le vote a lieu au cours de la séance et est donc rattaché au procès-verbal (parent_protocol, parent_protocol_item) ; il est en outre lié à la séance (parent_meeting) et à l'affaire (affair_id). La présidente ou le président ne participe pas aux votes, mais départage en cas d'égalité des voix (tie_breaker). La décision catégorielle (adopté, rejeté, pris acte …) n'est pas retenue sur le vote, mais dans la Resolution du point de l'ordre du jour.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="datetime_begin" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung beginnt.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles la séance ou le vote commence.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung endet.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles la séance ou le vote se termine.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="voting_type" minOccurs="0" maxOccurs="1" type="VotingTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art des Abstimmungsverfahrens (Zwischen-, Schlussabstimmung, geheim, etc.).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de procédure de vote (vote intermédiaire, vote final, vote secret, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Benutzerdefinierte Typbezeichnung, wenn Standardtypwerte nicht zutreffen.</xs:documentation>
          <xs:documentation xml:lang="fr">Libellé de type personnalisé lorsque les valeurs de type standard ne s'appliquent pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="voting_title" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abstimmungstitel bzw. Gegenstand oder Frage. Wenn kein Gegenstand vorhanden ist, sollte nicht der Geschäftstitel verwendet werden.</xs:documentation>
          <xs:documentation xml:lang="fr">Titre du vote, objet ou question soumise au vote. En l'absence d'objet propre, il ne faut pas reprendre le titre de l'affaire.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="optional" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gibt an, ob die Sitzung oder Abstimmung optional ist.</xs:documentation>
          <xs:documentation xml:lang="fr">Indique si la séance ou le vote est facultatif.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL mit weiteren Informationen.</xs:documentation>
          <xs:documentation xml:lang="fr">URL fournissant des informations complémentaires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_yes" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Bedeutung einer „Ja“-Stimme.</xs:documentation>
          <xs:documentation xml:lang="fr">Signification d'une voix « oui ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_no" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Bedeutung einer „Nein“-Stimme.</xs:documentation>
          <xs:documentation xml:lang="fr">Signification d'une voix « non ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_abstention" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Bedeutung einer Enthaltungsstimme.</xs:documentation>
          <xs:documentation xml:lang="fr">Signification d'une abstention.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="tie_breaker" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gibt an, ob das Ergebnis bei Stimmengleichheit durch den Stichentscheid der Präsidentin oder des Präsidenten zustande kam.</xs:documentation>
          <xs:documentation xml:lang="fr">Indique si le résultat a été obtenu, en cas d'égalité des voix, par la voix prépondérante de la présidente ou du président.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_count_yes" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl der „Ja“-Stimmen.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total de voix « oui ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_count_no" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl der „Nein“-Stimmen.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total de voix « non ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_count_abstention" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl der Enthaltungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total d'abstentions.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_other" minOccurs="0" maxOccurs="unbounded" type="TotalOther">
        <xs:annotation>
          <xs:documentation xml:lang="de">Stimmenzahlen für die Optionen einer Auswahlabstimmung, ein Eintrag pro Option; tritt an die Stelle von total_count_yes, total_count_no und total_count_abstention (siehe TotalOther).</xs:documentation>
          <xs:documentation xml:lang="fr">Nombres de voix pour les options d'un vote à choix multiple, une entrée par option ; remplace total_count_yes, total_count_no et total_count_abstention (voir TotalOther).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_absent" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl abwesender Mitglieder, die nicht teilnehmen konnten. Ob eine Abwesenheit entschuldigt war, hält die Anwesenheitsliste (Attendance) fest.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de membres absents qui n'ont pas pu participer. La liste de présence (Attendance) indique si une absence était excusée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl der Stimmen, ohne abwesende und Präsidiumsstimmen.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total de voix, sans les absents ni la voix de la présidence.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="majority_type" minOccurs="0" maxOccurs="1" type="MajorityTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der für die Abstimmung erforderlichen Mehrheit (absolut, Zweidrittel usw.).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de majorité requise pour le vote (absolue, deux tiers, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="majority_count" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl der Stimmen, die für die relevante Mehrheitsschwelle erforderlich sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de voix requis pour atteindre le seuil de majorité déterminant.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="result_text" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freitext, der das Ergebnis beschreibt, z.B. „Mit 120 zu 75 Stimmen bei 5 Enthaltungen angenommen“. Bei Abstimmungen wird der kategorische Entscheid (angenommen, abgelehnt, Kenntnisnahme …) nicht hier, sondern in der Resolution (resolution_type) des Traktandums festgehalten.</xs:documentation>
          <xs:documentation xml:lang="fr">Texte libre décrivant le résultat, p. ex. « Adopté par 120 voix contre 75 et 5 abstentions ». Pour les votes, la décision catégorielle (adopté, rejeté, pris acte …) n'est pas retenue ici, mais dans la Resolution (resolution_type) du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_meeting" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator der Sitzung, zu der dieser Eintrag gehört. Bei einer Sitzung bezeichnet er die übergeordnete Sitzung, bei Abstimmung, Wahl, Wortmeldung, Anwesenheitsliste oder Protokoll die Sitzung, in der der Eintrag entstanden ist. Traktanden führen ihn nicht: Sie sind in ihre Sitzung eingebettet.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de la séance à laquelle cet enregistrement se rattache. Pour une séance, il désigne la séance supérieure ; pour un vote, une élection, une intervention, une liste de présence ou un procès-verbal, la séance au cours de laquelle l'enregistrement est né. Les points de l'ordre du jour ne le portent pas : ils sont imbriqués dans leur séance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_protocol" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Protokoll, in dem die Abstimmung oder Wahl festgehalten ist. Abgestimmt wird im Verlauf der Sitzung, weshalb die Abstimmung im Protokoll und nicht in der vorgängig geplanten Traktandenliste verankert ist: Was traktandiert wurde, sagt noch nicht, worüber tatsächlich abgestimmt wurde. Umgekehrt führt das Protokoll seine Abstimmungen und Wahlen als Listen (votings, elections).</xs:documentation>
          <xs:documentation xml:lang="fr">Le procès-verbal dans lequel le vote ou l'élection est consigné. Le vote a lieu au cours de la séance et se rattache donc au procès-verbal, et non à l'ordre du jour planifié à l'avance : ce qui a été mis à l'ordre du jour ne dit pas encore sur quoi il a effectivement été voté. Inversement, le procès-verbal reprend ses votes et élections sous forme de listes (votings, elections).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_protocol_item" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das protokollierte Traktandum (ProtocolItem), unter dem abgestimmt oder gewählt wurde. Entfällt, wenn ohne Traktandierung abgestimmt wurde; die Zuordnung zur Sitzung ergibt sich dann allein aus parent_protocol und parent_meeting.</xs:documentation>
          <xs:documentation xml:lang="fr">Le point consigné au procès-verbal (ProtocolItem) sous lequel le vote ou l'élection a eu lieu. Absent lorsque le vote a eu lieu sans point de l'ordre du jour ; le rattachement à la séance découle alors uniquement de parent_protocol et parent_meeting.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="affair_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Geschäfts (eCH-0295), auf das sich der Eintrag bezieht. Administrative Traktanden (z.B. Genehmigung des Protokolls) haben kein Geschäft. Ein Geschäft durchläuft in der Regel mehrere Traktanden — in der Gesetzgebung etwa Eintretensdebatte, Detailberatung, Schlussabstimmung und gegebenenfalls die Differenzbereinigung zwischen den Räten.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de l'affaire (eCH-0295) à laquelle se rapporte l'enregistrement. Les points administratifs (p. ex. approbation du procès-verbal) n'ont pas d'affaire. Une affaire passe en règle générale par plusieurs points de l'ordre du jour — dans la législation, par exemple, le débat d'entrée en matière, la discussion par article, le vote final et, le cas échéant, la procédure d'élimination des divergences entre les conseils.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="group_reference" minOccurs="0" maxOccurs="1" type="GroupReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Referenz auf das handelnde Organ/Gremium (Momentaufnahme zum Zeitpunkt der Verknüpfung).</xs:documentation>
          <xs:documentation xml:lang="fr">Référence à l'organe agissant (instantané au moment de la mise en relation).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IndividualVote">
    <xs:annotation>
      <xs:documentation xml:lang="de">Die Stimme, die ein einzelnes Mitglied in einer Abstimmung abgibt. Einzelstimmen werden nur bei offenen Abstimmungen erfasst; bei geheimen Abstimmungen wird nur das Gesamtergebnis publiziert. Eine Einzelstimme betrifft eine bestimmte Abstimmung und unterscheidet sich von der Anwesenheit (Attendance), welche die Präsenz an der Sitzung als Ganzes festhält: Ein an der Sitzung anwesendes Mitglied kann bei einer einzelnen Abstimmung mit not_voted erfasst werden, etwa weil es kurz den Saal verlassen hat.</xs:documentation>
      <xs:documentation xml:lang="fr">La voix exprimée par un membre lors d'un vote. Les voix individuelles ne sont saisies que pour les votes ouverts ; pour les votes secrets, seul le résultat global est publié. Une voix individuelle concerne un vote déterminé et se distingue de la présence (Attendance), qui retient la présence à la séance dans son ensemble : un membre présent à la séance peut être saisi avec not_voted lors d'un vote particulier, par exemple parce qu'il a brièvement quitté la salle.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parent_voting" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die ID der Abstimmung, die mit der Einzelstimme verbunden ist.</xs:documentation>
          <xs:documentation xml:lang="fr">L'identifiant du vote auquel se rattache la voix individuelle.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="person_reference" minOccurs="0" maxOccurs="1" type="PersonReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Mitglied, das die Stimme abgegeben hat, als Referenz auf eine Person gemäss eCH-0294.</xs:documentation>
          <xs:documentation xml:lang="fr">Le membre qui a exprimé la voix, sous forme de référence à une personne selon eCH-0294.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="seat_nr" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die Sitznummer der Einzelstimme, falls zutreffend.</xs:documentation>
          <xs:documentation xml:lang="fr">Le numéro de siège correspondant à la voix individuelle, le cas échéant.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="weight" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Stimmgewicht des Mitglieds; im Normalfall 1. Andere Werte kommen etwa vor, wo ein Mitglied für ein abwesendes Mitglied mitstimmt (Stellvertretung, Gewicht 2), an Gemeindeversammlungen, an denen juristische Personen mehrere Stimmen haben, oder in historischen Systemen, in denen verschiedene Personengruppen unterschiedliches Stimmgewicht hatten.</xs:documentation>
          <xs:documentation xml:lang="fr">Poids de la voix du membre ; normalement 1. D'autres valeurs se présentent par exemple lorsqu'un membre vote aussi pour un membre absent (représentation, poids 2), dans les assemblées communales où des personnes morales disposent de plusieurs voix, ou dans des systèmes historiques où différents groupes de personnes avaient un poids de voix différent.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="individual_vote_type" minOccurs="0" maxOccurs="1" type="IndividualVoteTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der abgegebenen Stimme (Ja, Nein, Enthaltung, nicht abgestimmt, etc.).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de voix exprimée (oui, non, abstention, n'a pas voté, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Benutzerdefinierte Typbezeichnung, wenn Standardtypwerte nicht zutreffen.</xs:documentation>
          <xs:documentation xml:lang="fr">Libellé de type personnalisé lorsque les valeurs de type standard ne s'appliquent pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Election">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Wahl, mit der ein parlamentarisches Organ eine oder mehrere Personen für ein Amt oder eine Funktion bestimmt. Im Unterschied zur Abstimmung (Voting), die über Sachfragen entscheidet, ist die Wahl ein Personenentscheid: Sie erfolgt oft geheim und erfordert meist das absolute Mehr, während Abstimmungen meist offen sind. Die Präsidentin oder der Präsident, die an Abstimmungen nicht teilnehmen, stimmen bei Wahlen mit. Jeder Wahlgang wird als eigene Wahl erfasst; die Wahlgänge einer Wahl sind über das gemeinsame Traktandum verbunden — etwa ein erster Wahlgang mit absolutem Mehr, der ohne Ergebnis bleibt, und ein zweiter Wahlgang, in dem das relative Mehr genügt.</xs:documentation>
      <xs:documentation xml:lang="fr">Une élection par laquelle un organe parlementaire désigne une ou plusieurs personnes à une charge ou à une fonction. Contrairement au vote (Voting), qui tranche des questions matérielles, l'élection est une décision portant sur des personnes : elle a souvent lieu au scrutin secret et requiert en général la majorité absolue, alors que les votes sont le plus souvent ouverts. La présidente ou le président, qui ne participe pas aux votes, prend part aux élections. Chaque tour de scrutin est saisi comme une élection distincte ; les tours d'une même élection sont reliés par le point de l'ordre du jour commun — par exemple un premier tour à la majorité absolue resté sans résultat, suivi d'un second tour où la majorité relative suffit.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="datetime_begin" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung beginnt.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles la séance ou le vote commence.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, zu der die Sitzung oder Abstimmung endet.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles la séance ou le vote se termine.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="election_type" minOccurs="0" maxOccurs="1" type="ElectionTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art des Wahlverfahrens.</xs:documentation>
          <xs:documentation xml:lang="fr">Type de procédure d'élection.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="type_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Benutzerdefinierte Typbezeichnung, wenn Standardtypwerte nicht zutreffen.</xs:documentation>
          <xs:documentation xml:lang="fr">Libellé de type personnalisé lorsque les valeurs de type standard ne s'appliquent pas.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="title" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Titel der Wahl, z.B. „Wahl Kommissionspräsidium WAK“.</xs:documentation>
          <xs:documentation xml:lang="fr">Titre de l'élection, p. ex. « Élection à la présidence de la CER ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL mit weiteren Informationen.</xs:documentation>
          <xs:documentation xml:lang="fr">URL fournissant des informations complémentaires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_absent" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl abwesender Mitglieder, die nicht teilnehmen konnten. Ob eine Abwesenheit entschuldigt war, hält die Anwesenheitsliste (Attendance) fest.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de membres absents qui n'ont pas pu participer. La liste de présence (Attendance) indique si une absence était excusée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl der Stimmen, ohne abwesende und Präsidiumsstimmen.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total de voix, sans les absents ni la voix de la présidence.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="majority_type" minOccurs="0" maxOccurs="1" type="MajorityTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der für die Abstimmung erforderlichen Mehrheit (absolut, Zweidrittel usw.).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de majorité requise pour le vote (absolue, deux tiers, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="majority_count" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl der Stimmen, die für die relevante Mehrheitsschwelle erforderlich sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de voix requis pour atteindre le seuil de majorité déterminant.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="result_text" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freitext, der das Ergebnis beschreibt, z.B. „Mit 120 zu 75 Stimmen bei 5 Enthaltungen angenommen“. Bei Abstimmungen wird der kategorische Entscheid (angenommen, abgelehnt, Kenntnisnahme …) nicht hier, sondern in der Resolution (resolution_type) des Traktandums festgehalten.</xs:documentation>
          <xs:documentation xml:lang="fr">Texte libre décrivant le résultat, p. ex. « Adopté par 120 voix contre 75 et 5 abstentions ». Pour les votes, la décision catégorielle (adopté, rejeté, pris acte …) n'est pas retenue ici, mais dans la Resolution (resolution_type) du point de l'ordre du jour.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_meeting" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator der Sitzung, zu der dieser Eintrag gehört. Bei einer Sitzung bezeichnet er die übergeordnete Sitzung, bei Abstimmung, Wahl, Wortmeldung, Anwesenheitsliste oder Protokoll die Sitzung, in der der Eintrag entstanden ist. Traktanden führen ihn nicht: Sie sind in ihre Sitzung eingebettet.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de la séance à laquelle cet enregistrement se rattache. Pour une séance, il désigne la séance supérieure ; pour un vote, une élection, une intervention, une liste de présence ou un procès-verbal, la séance au cours de laquelle l'enregistrement est né. Les points de l'ordre du jour ne le portent pas : ils sont imbriqués dans leur séance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_protocol" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Protokoll, in dem die Abstimmung oder Wahl festgehalten ist. Abgestimmt wird im Verlauf der Sitzung, weshalb die Abstimmung im Protokoll und nicht in der vorgängig geplanten Traktandenliste verankert ist: Was traktandiert wurde, sagt noch nicht, worüber tatsächlich abgestimmt wurde. Umgekehrt führt das Protokoll seine Abstimmungen und Wahlen als Listen (votings, elections).</xs:documentation>
          <xs:documentation xml:lang="fr">Le procès-verbal dans lequel le vote ou l'élection est consigné. Le vote a lieu au cours de la séance et se rattache donc au procès-verbal, et non à l'ordre du jour planifié à l'avance : ce qui a été mis à l'ordre du jour ne dit pas encore sur quoi il a effectivement été voté. Inversement, le procès-verbal reprend ses votes et élections sous forme de listes (votings, elections).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_protocol_item" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das protokollierte Traktandum (ProtocolItem), unter dem abgestimmt oder gewählt wurde. Entfällt, wenn ohne Traktandierung abgestimmt wurde; die Zuordnung zur Sitzung ergibt sich dann allein aus parent_protocol und parent_meeting.</xs:documentation>
          <xs:documentation xml:lang="fr">Le point consigné au procès-verbal (ProtocolItem) sous lequel le vote ou l'élection a eu lieu. Absent lorsque le vote a eu lieu sans point de l'ordre du jour ; le rattachement à la séance découle alors uniquement de parent_protocol et parent_meeting.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="affair_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Geschäfts (eCH-0295), auf das sich der Eintrag bezieht. Administrative Traktanden (z.B. Genehmigung des Protokolls) haben kein Geschäft. Ein Geschäft durchläuft in der Regel mehrere Traktanden — in der Gesetzgebung etwa Eintretensdebatte, Detailberatung, Schlussabstimmung und gegebenenfalls die Differenzbereinigung zwischen den Räten.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de l'affaire (eCH-0295) à laquelle se rapporte l'enregistrement. Les points administratifs (p. ex. approbation du procès-verbal) n'ont pas d'affaire. Une affaire passe en règle générale par plusieurs points de l'ordre du jour — dans la législation, par exemple, le débat d'entrée en matière, la discussion par article, le vote final et, le cas échéant, la procédure d'élimination des divergences entre les conseils.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="group_reference" minOccurs="0" maxOccurs="1" type="GroupReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Referenz auf das handelnde Organ/Gremium (Momentaufnahme zum Zeitpunkt der Verknüpfung).</xs:documentation>
          <xs:documentation xml:lang="fr">Référence à l'organe agissant (instantané au moment de la mise en relation).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Attendance">
    <xs:annotation>
      <xs:documentation xml:lang="de">Aggregierte Anwesenheitsliste für eine Sitzung (Anzahl Anwesende, Abwesende, Entschuldigte): Sie hält fest, welche Mitglieder eines parlamentarischen Organs bei einer Sitzung anwesend, abwesend oder entschuldigt waren. Die Anwesenheit wird auf zwei Ebenen erfasst — mit diesem Aggregat und den Gesamtzahlen für die Sitzung sowie mit je einer IndividualAttendance pro Person, die über parent_attendance daran hängt. Anwesenheitslisten dienen der Dokumentation der Teilnahme, der Prüfung der Beschlussfähigkeit, der Transparenz gegenüber der Öffentlichkeit, der Rechenschaft über die Pflichterfüllung, der Statistik von Anwesenheitsquoten sowie der Administration von Entschädigungen und Spesen.</xs:documentation>
      <xs:documentation xml:lang="fr">Liste de présence agrégée pour une séance (nombre de membres présents, absents, excusés) : elle retient quels membres d'un organe parlementaire étaient présents, absents ou excusés lors d'une séance. La présence est saisie à deux niveaux — par cet agrégat avec les totaux de la séance, et par une IndividualAttendance par personne, rattachée à celui-ci via parent_attendance. Les listes de présence servent à documenter la participation, à vérifier le quorum, à la transparence envers le public, à rendre compte de l'accomplissement des devoirs, à établir des statistiques sur les taux de présence ainsi qu'à administrer les indemnités et les frais.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parent_meeting" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die Sitzung, zu der die Anwesenheitsliste gehört.</xs:documentation>
          <xs:documentation xml:lang="fr">La séance à laquelle se rapporte la liste de présence.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Datum und Uhrzeit, zu der die Anwesenheit erfasst wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">Date et heure auxquelles la présence a été saisie.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="group_reference" minOccurs="0" maxOccurs="1" type="GroupReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Referenz auf das handelnde Organ/Gremium (Momentaufnahme zum Zeitpunkt der Verknüpfung).</xs:documentation>
          <xs:documentation xml:lang="fr">Référence à l'organe agissant (instantané au moment de la mise en relation).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_count" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gesamtzahl aller Mitglieder des Gremiums, die Bezugsgrösse für Quorum-Berechnungen (z.B. 200 für den Nationalrat, 46 für den Ständerat). Die Beschlussfähigkeit selbst wird nicht als eigenes Feld gespeichert: Sie ergibt sich aus dem Verhältnis von total_present zu total_count und den Quorum-Regeln des Gremiums und wird bei Bedarf datenseitig berechnet.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre total de membres de l'organe, valeur de référence pour le calcul du quorum (p. ex. 200 pour le Conseil national, 46 pour le Conseil des États). Le quorum lui-même n'est pas enregistré dans un champ propre : il résulte du rapport entre total_present et total_count et des règles de quorum de l'organe, et est calculé au besoin à partir des données.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_present" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl anwesender Mitglieder, z.B. 185 von 200.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de membres présents, p. ex. 185 sur 200.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_absent" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl unentschuldigt abwesender Mitglieder, z.B. 3 von 200.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de membres absents sans excuse, p. ex. 3 sur 200.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="total_excused" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Anzahl Mitglieder, deren Abwesenheit entschuldigt war, z.B. 12 von 200.</xs:documentation>
          <xs:documentation xml:lang="fr">Nombre de membres dont l'absence était excusée, p. ex. 12 sur 200.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IndividualAttendance">
    <xs:annotation>
      <xs:documentation xml:lang="de">Einzelne Anwesenheitsfeststellung einer Person an einer Sitzung (verknüpft über das übergeordnete Attendance-Aggregat). Sie betrifft die Sitzung als Ganzes und unterscheidet sich von der Einzelstimme (IndividualVote), welche die Stimmabgabe in einer bestimmten Abstimmung festhält: Eine an der Sitzung anwesende Person (attendance_type present) kann bei einer einzelnen Abstimmung mit not_voted erfasst werden, weil sie in diesem Moment kurz den Saal verlassen hat.</xs:documentation>
      <xs:documentation xml:lang="fr">Constatation individuelle de la présence d'une personne à une séance (rattachée à l'agrégat Attendance parent). Elle porte sur la séance dans son ensemble et se distingue de la voix individuelle (IndividualVote), qui retient la voix exprimée lors d'un vote déterminé : une personne présente à la séance (attendance_type present) peut être saisie avec not_voted lors d'un vote particulier parce qu'elle a brièvement quitté la salle à ce moment-là.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parent_attendance" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Attendance-Aggregat, zu dem dieser Eintrag gehört; da das Aggregat seinerseits an der Sitzung hängt, ist die einzelne Erfassung damit der Sitzung zugeordnet.</xs:documentation>
          <xs:documentation xml:lang="fr">L'agrégat Attendance auquel appartient cet enregistrement ; comme l'agrégat est lui-même rattaché à la séance, la saisie individuelle est ainsi attribuée à la séance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="person_reference" minOccurs="0" maxOccurs="1" type="PersonReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die Person, deren Anwesenheit erfasst wird, als Referenz auf eine Person gemäss eCH-0294.</xs:documentation>
          <xs:documentation xml:lang="fr">La personne dont la présence est saisie, sous forme de référence à une personne selon eCH-0294.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="attendance_type" minOccurs="0" maxOccurs="1" type="AttendanceTypeEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der individuellen Anwesenheit.</xs:documentation>
          <xs:documentation xml:lang="fr">Type de présence individuelle.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="reason" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Grund für Abwesenheit, Verspätung oder Vertretung (Freitext, mehrsprachig).</xs:documentation>
          <xs:documentation xml:lang="fr">Motif de l'absence, du retard ou de la suppléance (texte libre, multilingue).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Speech">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Wortmeldung während einer Sitzung (auch Votum oder Redebeitrag genannt): der mündliche Beitrag einer Person in einer parlamentarischen Sitzung und damit das zentrale Instrument der politischen Debatte und Meinungsäusserung im Parlament. Wortmeldungen haben verschiedene Formen — Hauptvoten (ausführliche Stellungnahmen zu einem Geschäft, Begründung von Anträgen, Darlegung der Fraktionsmeinung), Kurzinterventionen (Zwischenfragen, Richtigstellungen), Fraktionserklärungen, vorgetragen durch die Fraktionssprecherin oder den Fraktionssprecher, sowie Regierungsvoten (Beantwortung von Fragen, Verteidigung von Vorlagen). Eine Wortmeldung hält fest, wer wann unter welchem Traktandum gesprochen hat, mit dem Wortlaut als Text und, wo vorhanden, als Audio- oder Videoaufzeichnung. Sie kann auf zwei Wegen geliefert werden: eingebettet im Protokoll (Protocol.speeches), wo sich die Sitzung aus dem umgebenden Protokoll ergibt, das Traktandum aber nicht, oder flach in Container.speeches, wo ohne Referenzen jeder Bezug fehlte. parent_meeting und parent_agenda_item werden deshalb in beiden Fällen geführt; sie tragen dieselben Werte wie bei Voting und Election und machen die Wortmeldung unabhängig davon auswertbar, aus welcher Lieferform sie stammt.</xs:documentation>
      <xs:documentation xml:lang="fr">Une intervention prononcée au cours d'une séance (également appelée prise de parole) : la contribution orale d'une personne lors d'une séance parlementaire et, partant, l'instrument central du débat politique et de l'expression des opinions au parlement. Les interventions revêtent différentes formes — interventions principales (prises de position détaillées sur une affaire, développement de propositions, exposé de l'avis du groupe parlementaire), interventions brèves (questions intermédiaires, rectifications), déclarations de groupe présentées par la porte-parole ou le porte-parole du groupe, ainsi qu'interventions du gouvernement (réponses à des questions, défense de projets). Une intervention retient qui a parlé, quand et sous quel point de l'ordre du jour, avec le texte prononcé et, le cas échéant, un enregistrement audio ou vidéo. Elle peut être livrée de deux manières : imbriquée dans le procès-verbal (Protocol.speeches), où la séance ressort du procès-verbal environnant mais non le point de l'ordre du jour, ou à plat dans Container.speeches, où tout rattachement ferait défaut sans références. parent_meeting et parent_agenda_item sont donc renseignés dans les deux cas ; ils portent les mêmes valeurs que pour Voting et Election et rendent l'intervention exploitable indépendamment de sa forme de livraison.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="parent_meeting" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator der Sitzung, zu der dieser Eintrag gehört. Bei einer Sitzung bezeichnet er die übergeordnete Sitzung, bei Abstimmung, Wahl, Wortmeldung, Anwesenheitsliste oder Protokoll die Sitzung, in der der Eintrag entstanden ist. Traktanden führen ihn nicht: Sie sind in ihre Sitzung eingebettet.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant de la séance à laquelle cet enregistrement se rattache. Pour une séance, il désigne la séance supérieure ; pour un vote, une élection, une intervention, une liste de présence ou un procès-verbal, la séance au cours de laquelle l'enregistrement est né. Les points de l'ordre du jour ne le portent pas : ils sont imbriqués dans leur séance.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_agenda_item" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Identifikator des Traktandums, zu dem dieser Eintrag gehört. Bei einem Traktandum bildet er eine Hierarchie von Traktanden — z.B. eine Traktandengruppe „Gesetzesberatungen“ mit den Untertraktanden „Energiegesetz (Detailberatung)“ und „Energiegesetz (Schlussabstimmung)“; bei einer Wortmeldung bezeichnet er das Traktandum, unter dem sie erfolgte.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant du point de l'ordre du jour auquel cet enregistrement se rattache. Pour un point de l'ordre du jour, il forme une hiérarchie de points — p. ex. un groupe « Délibérations législatives » avec les sous-points « Loi sur l'énergie (discussion par article) » et « Loi sur l'énergie (vote final) » ; pour une intervention, il désigne le point sous lequel elle a été faite.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprache, in der gesprochen wurde, z.B. de (Deutsch), fr (Französisch), it (Italienisch), rm (Rätoromanisch) oder en (Englisch).</xs:documentation>
          <xs:documentation xml:lang="fr">Langue dans laquelle l'intervention a été prononcée, p. ex. de (allemand), fr (français), it (italien), rm (romanche) ou en (anglais).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="start" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Startangabe oder Position.</xs:documentation>
          <xs:documentation xml:lang="fr">Indication de début ou position.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Datum und Uhrzeit, zu der die Wortmeldung begann. Zusammen mit datetime_end ermöglicht sie die genaue Referenzierung in Audio- und Videoaufzeichnungen, die Analyse der Redezeit pro Person oder Fraktion und die Kontrolle der Einhaltung von Zeitlimiten.</xs:documentation>
          <xs:documentation xml:lang="fr">Date et heure auxquelles l'intervention a commencé. Avec datetime_end, elle permet de situer précisément l'intervention dans les enregistrements audio et vidéo, d'analyser le temps de parole par personne ou par groupe parlementaire et de contrôler le respect des limites de temps.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Datum und Uhrzeit, zu der die Wortmeldung endete; die Redezeit ergibt sich aus der Differenz zu datetime_begin.</xs:documentation>
          <xs:documentation xml:lang="fr">Date et heure auxquelles l'intervention s'est terminée ; le temps de parole résulte de la différence avec datetime_begin.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="actor_fullname" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Name der sprechenden Person, für den schnellen Zugriff ohne Auflösung von person_reference.</xs:documentation>
          <xs:documentation xml:lang="fr">Nom de la personne qui s'exprime, pour un accès rapide sans résolution de person_reference.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="person_reference" minOccurs="0" maxOccurs="1" type="PersonReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die sprechende Person, als Referenz auf eine Person gemäss eCH-0294.</xs:documentation>
          <xs:documentation xml:lang="fr">La personne qui s'exprime, sous forme de référence à une personne selon eCH-0294.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="role" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Rolle, in der die Person spricht, z.B. Fraktionspräsidentin oder Fraktionspräsident, Berichterstatterin oder Berichterstatter, Bundesrätin oder Bundesrat.</xs:documentation>
          <xs:documentation xml:lang="fr">Rôle dans lequel la personne s'exprime, p. ex. présidente ou président de groupe parlementaire, rapporteuse ou rapporteur, conseillère fédérale ou conseiller fédéral.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Wortlaut der Wortmeldung.</xs:documentation>
          <xs:documentation xml:lang="fr">Texte prononcé de l'intervention.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text_format" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Format des Textes (text, html, html_with_timestamps).</xs:documentation>
          <xs:documentation xml:lang="fr">Format du texte (text, html, html_with_timestamps).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="text_type" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Fassung des Wortlauts: das Rohtranskript (wörtliche, unbearbeitete Niederschrift mit Füllwörtern, direkt nach der Sitzung verfügbar) oder das bearbeitete Transkript (redaktionell überarbeitet und grammatikalisch korrigiert, die offizielle Protokollversion).</xs:documentation>
          <xs:documentation xml:lang="fr">Version du texte : la transcription brute (transcription littérale, non retravaillée et avec les mots de remplissage, disponible directement après la séance) ou la transcription éditée (revue par la rédaction et corrigée sur le plan grammatical, la version officielle du procès-verbal).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL mit weiteren Informationen.</xs:documentation>
          <xs:documentation xml:lang="fr">URL fournissant des informations complémentaires.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="media_url" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL der Audio- oder Videoaufzeichnung der Wortmeldung oder des Livestreams während der Sitzung, der danach archiviert wird.</xs:documentation>
          <xs:documentation xml:lang="fr">URL de l'enregistrement audio ou vidéo de l'intervention, ou de la diffusion en direct pendant la séance, archivée par la suite.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="media_type" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art der Aufzeichnung: Audio (Originalton der Wortmeldung) oder Video (visuelle Aufzeichnung, in der Regel bei Plenarsitzungen).</xs:documentation>
          <xs:documentation xml:lang="fr">Type d'enregistrement : audio (son original de l'intervention) ou vidéo (enregistrement visuel, en général lors des séances plénières).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="media_format" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">MIME-Typ der Aufzeichnung, z.B. audio/mpeg (MP3), audio/wav, video/mp4 oder video/webm.</xs:documentation>
          <xs:documentation xml:lang="fr">Type MIME de l'enregistrement, p. ex. audio/mpeg (MP3), audio/wav, video/mp4 ou video/webm.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TextSegment">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein Textsegment wie Querverweise oder Zwischentitel. Textsegmente werden am Protokoll, an einer Wortmeldung oder an einem Traktandum geführt (geplantes AgendaItem oder protokolliertes ProtocolItem).</xs:documentation>
      <xs:documentation xml:lang="fr">Un segment de texte tel qu'un renvoi ou un intertitre. Les segments de texte sont portés par le procès-verbal, par une intervention ou par un point de l'ordre du jour (AgendaItem planifié ou ProtocolItem consigné).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="text" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Textinhalt des Elements.</xs:documentation>
          <xs:documentation xml:lang="fr">Contenu textuel de l'élément.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Motion">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein formaler Antrag, der während der Beratung gestellt wird, etwa ein Änderungsantrag zu einem Gesetzestext, ein Ordnungsantrag (z.B. Schluss der Debatte) oder ein Rückweisungsantrag. Er ist eine eigene Entität, weil ein Traktandum mehrere Anträge enthalten kann, die je einen eigenen Verlauf haben (gestellt, unterstützt, abgestimmt) und gegebenenfalls einzeln abgestimmt werden.</xs:documentation>
      <xs:documentation xml:lang="fr">Une proposition formelle déposée au cours des délibérations, par exemple une proposition d'amendement à un texte légal, une motion d'ordre (p. ex. clôture du débat) ou une proposition de renvoi. Elle constitue une entité propre, car un point de l'ordre du jour peut comprendre plusieurs propositions, chacune ayant son propre déroulement (déposée, soutenue, mise aux voix) et, le cas échéant, son propre vote.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="title" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Kurztitel des Antrags.</xs:documentation>
          <xs:documentation xml:lang="fr">Titre abrégé de la proposition.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="description" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Vollständiger Antragstext.</xs:documentation>
          <xs:documentation xml:lang="fr">Texte intégral de la proposition.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="documents" minOccurs="0" maxOccurs="unbounded" type="Work">
        <xs:annotation>
          <xs:documentation xml:lang="de">Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.</xs:documentation>
          <xs:documentation xml:lang="fr">Liste des documents (FRBR Works) liés à l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Media">
    <xs:annotation>
      <xs:documentation xml:lang="de">Mediendateien oder Dokumente (einschliesslich Protokolle in PDF/HTML/WORD oder Links zu Audio/Video).</xs:documentation>
      <xs:documentation xml:lang="fr">Fichiers médias ou documents (y compris les procès-verbaux en PDF/HTML/WORD ou les liens vers des contenus audio/vidéo).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="title" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Titel des Elements.</xs:documentation>
          <xs:documentation xml:lang="fr">Titre de l'élément.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="media_type" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Art des Mediums (Audio, Video, Dokument).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de média (audio, vidéo, document).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="url" minOccurs="0" maxOccurs="unbounded" type="MultilingualString">
        <xs:annotation>
          <xs:documentation xml:lang="de">Landing Page oder weiterführende Webadresse, mehrsprachig.</xs:documentation>
          <xs:documentation xml:lang="fr">Page d'accueil ou adresse web complémentaire, multilingue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="version" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Versionsnummer oder Versionskennung.</xs:documentation>
          <xs:documentation xml:lang="fr">Numéro ou identifiant de version.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_type" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Typ des übergeordneten Objekts (Sitzung, Traktandum, Wortmeldung, Geschäft).</xs:documentation>
          <xs:documentation xml:lang="fr">Type de l'objet parent (séance, point de l'ordre du jour, intervention, affaire).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TotalOther">
    <xs:annotation>
      <xs:documentation xml:lang="de">Stimmenzahl für eine Option einer Auswahlabstimmung. Liegen zu derselben Sachfrage mehrere gleichgerichtete Anträge vor, stimmen die Mitglieder über mehr als zwei Varianten gleichzeitig ab, und es obsiegt die Variante mit den meisten Stimmen (in Zürich umgangssprachlich „Cup-Abstimmung“, technisch über mehrere Abstimmungsknöpfe). Eine solche Abstimmung wird mit voting_type other und einem sprechenden type_label abgebildet; total_count_yes, total_count_no und total_count_abstention bleiben leer, und jede Option erhält einen Eintrag mit count und label. Beispiel: Gemeinderat der Stadt Zürich, Sitzung vom 28. Februar 2024, Geschäft 2023/361, vier Optionen mit 75, 25, 12 und 0 Stimmen.</xs:documentation>
      <xs:documentation xml:lang="fr">Nombre de voix pour une option d'un vote à choix multiple. Lorsque plusieurs propositions de même sens portent sur la même question, les membres votent simultanément sur plus de deux variantes, et la variante qui obtient le plus de voix l'emporte (à Zurich, familièrement « Cup-Abstimmung », au moyen de plusieurs boutons de vote). Un tel vote est représenté avec voting_type other et un type_label explicite ; total_count_yes, total_count_no et total_count_abstention restent vides, et chaque option reçoit une entrée avec count et label. Exemple : Gemeinderat de la Ville de Zurich, séance du 28 février 2024, affaire 2023/361, quatre options avec 75, 25, 12 et 0 voix.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="count" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die Anzahl der Stimmen für die Kategorie „Andere“.</xs:documentation>
          <xs:documentation xml:lang="fr">Le nombre de voix pour la catégorie « autres ».</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Möglichkeit bei einer strukturierten Information, ein Label zu vergeben (bspw. Anzeigename, Anstellung, etc.).</xs:documentation>
          <xs:documentation xml:lang="fr">Attribuer un label à une information structurée (par ex. nom d'affichage, poste, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MultilingualString">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein String, der Text in mehreren Sprachen enthalten kann.</xs:documentation>
      <xs:documentation xml:lang="fr">Une chaîne de caractères pouvant contenir du texte en plusieurs langues.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="text" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Textinhalt des Elements.</xs:documentation>
          <xs:documentation xml:lang="fr">Contenu textuel de l'élément.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").</xs:documentation>
          <xs:documentation xml:lang="fr">Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
