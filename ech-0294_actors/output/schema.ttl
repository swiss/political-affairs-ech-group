            owl:onProperty act:picture ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty act:gender ],
        [ a owl:Restriction ;
            owl:allValuesFrom act:InterestLink ;
            owl:onProperty act:interestLink ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/label> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/deathDate> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/labelLong> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty act:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom act:Training ;
            owl:onProperty act:training ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty act:picture ],
        <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates>,
        <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> ;
    skos:definition """A person with identifiers, names, addresses, citizenships, and occupations.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Eine Person mit Identifikatoren, Namen, Adressen, Staatsbürgerschaften und Berufen.
""" ;
    act:description_fr """Une personne avec des identifiants, des noms, des adresses, des nationalités et des professions.
""" .

