        <https://register.ld.admin.ch/i14y/concept/LEVEL_EDUC/323> .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty act:role_label ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty act:role_type_enum ;
                owl:someValuesFrom xsd:string ] act:RoleType ) .


