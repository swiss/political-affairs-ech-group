""" ;
    act:description_fr """La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> a owl:DatatypeProperty ;
    rdfs:label "datetime_begin_planned" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The planned start date and time of an event or occurrence with time duration.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.
""" ;
    act:description_fr """La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> a owl:DatatypeProperty ;
    rdfs:label "datetime_end_actual" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The actual end date and time of an event or occurrence with time duration.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.
""" ;
    act:description_fr """La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> a owl:DatatypeProperty ;
    rdfs:label "datetime_end_planned" ;
    rdfs:range xsd:dateTime ;
    skos:definition """The planned end date and time of an event or occurrence with time duration.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.
""" ;
    act:description_fr """La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.
""" .

<https://ld.ech.ch/schema/0292/meta-common/isCurrent> a owl:DatatypeProperty ;
    rdfs:label "is_active" ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates whether the information is currently valid. Can be useful when this information is explicitly available.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Gibt an, ob die Information aktuell gültig ist. Kann nützlich sein, wenn diese Information explizit vorhanden ist.
""" ;
    act:description_fr """Indique si l'information est actuellement valable. Peut être utile lorsque cette information est explicitement disponible.
""" .

<https://ld.ech.ch/schema/0292/meta-common/labelLong> a owl:DatatypeProperty ;
    rdfs:label "label_long" ;
    skos:definition """Assign an extended label to a structured piece of information (e.g., display name with title, position, etc.).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Möglichkeit bei einer strukturierten Information, ein erweitertesLabel zu vergeben (bspw. Anzeigename mit Titel, Anstellung, etc.).
""" ;
    act:description_fr """Attribuer un label étendu à une information structurée (par ex. nom d'affichage avec titre, poste, etc.).
""" .

act:RoleEnum a owl:Class ;
    rdfs:label "RoleEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0294/actors/RoleEnum#member> <https://ld.ech.ch/schema/0294/actors/RoleEnum#president> <https://ld.ech.ch/schema/0294/actors/RoleEnum#deputy> <https://ld.ech.ch/schema/0294/actors/RoleEnum#other> ) ;
    skos:definition """Roles a person can have within a membership.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Rollen, die eine Person im Rahmen einer Mitgliedschaft haben kann.
""" ;
    act:description_fr """Rôles qu'une personne peut occuper dans le cadre d'une affiliation.
""" ;
    linkml:permissible_values <https://ld.ech.ch/schema/0294/actors/RoleEnum#deputy>,
        <https://ld.ech.ch/schema/0294/actors/RoleEnum#member>,
        <https://ld.ech.ch/schema/0294/actors/RoleEnum#other>,
        <https://ld.ech.ch/schema/0294/actors/RoleEnum#president> .

act:country a owl:DatatypeProperty ;
    rdfs:label "country" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Z]{2}$" ] ) ] ;
    skos:definition """ISO 3166-1 alpha-2 country code.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """ISO 3166-1 alpha-2 Ländercode.
""" ;
    act:description_fr """Code de pays ISO 3166-1 alpha-2.
""" .

act:isPaid a owl:DatatypeProperty ;
    rdfs:label "is_paid" ;
    rdfs:range xsd:boolean ;
    skos:definition """Indicates whether the activity is paid.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Gibt an, ob die Tätigkeit bezahlt ist.
""" ;
    act:description_fr """Indique si l'activité est rémunérée.
""" .

act:legalForm a owl:ObjectProperty ;
    rdfs:label "legal_form" ;
    rdfs:range act:LegalFormEnum ;
    skos:definition """Legal form of the organization. See controlled vocabulary: https://register.ld.admin.ch/i14y/concept/legalForm
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Rechtsform der Organisation. Siehe kontrolliertes Vokabular: https://register.ld.admin.ch/i14y/concept/legalForm
""" ;
    act:description_fr """Forme juridique de l'organisation. Voir le vocabulaire contrôlé : https://register.ld.admin.ch/i14y/concept/legalForm
""" .

act:organizationName a owl:DatatypeProperty ;
    rdfs:label "organization_name" ;
    skos:definition """Name of the organization or enterprise.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Name der Organisation oder des Unternehmens.
""" ;
    act:description_fr """Nom de l'organisation ou de l'entreprise.
""" .

act:personReference a owl:ObjectProperty ;
    rdfs:label "person_reference" ;
    rdfs:range <https://ld.ech.ch/schema/0292/meta-common/PersonReference> ;
    skos:definition """Reference to a person with snapshot data at time of linking.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Referenz auf eine Person mit Snapshot-Daten zum Zeitpunkt der Verknüpfung.
""" ;
    act:description_fr """Référence à une personne avec des données instantanées au moment de la mise en relation.
""" .

act:ContactTypeEnum a owl:Class ;
    rdfs:label "ContactTypeEnum" ;
    owl:unionOf ( <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#email> <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#phone> <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#contact_website> <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#linked_in> <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#twitter> ) ;
    skos:definition """Types of contact information.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Kontaktinformationstypen.
""" ;
    act:description_fr """Types d'informations de contact.
""" ;
    linkml:permissible_values <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#contact_website>,
        <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#email>,
        <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#linked_in>,
        <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#phone>,
        <https://ld.ech.ch/schema/0294/actors/ContactTypeEnum#twitter> .

<https://ld.ech.ch/schema/0292/meta-common/HasTemporalValidity> a owl:Class ;
    rdfs:label "HasTemporalValidity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/validFrom> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <http://schema.org/validFrom> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty <http://schema.org/validThrough> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/validThrough> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <http://schema.org/validFrom> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/isCurrent> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <http://schema.org/validThrough> ] ;
    skos:definition """A mixin class that provides slots for modeling a temporal validity of information (not of an event).
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Eine Mixin-Klasse, die Slots für die Modellierung einer zeitlichen Gültigkeit einer Information (nicht eines Events) zur Verfügung stellt.
""" ;
    act:description_fr """Une classe mixin qui fournit des slots pour modéliser la validité temporelle d'une information (et non d'un événement).
""" .

<https://ld.ech.ch/schema/0292/meta-common/globalURI> a owl:DatatypeProperty ;
    rdfs:label "global_uri" ;
    rdfs:range xsd:anyURI ;
    skos:definition """A unique, globally valid URI for the entity.
""",
        """The unique, globally valid URI of the referenced entity. Unlike a local_id it also resolves beyond the delivery.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.
""",
        """Eine eindeutige, global gültige URI für die Entität.
""" ;
    act:description_fr """L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.
""",
        """Une URI unique et globalement valide pour l'entité.
""" .

<https://ld.ech.ch/schema/0292/meta-common/language> a owl:DatatypeProperty ;
    rdfs:label "language" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ;
    skos:definition """Language code in ISO 639-1 format (two lowercase letters, e.g. "de", "fr", "it", "en").
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").
""" ;
    act:description_fr """Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).
""" .

<https://ld.ech.ch/schema/0292/meta-common/localId> a owl:DatatypeProperty ;
    rdfs:label "local_id" ;
    skos:definition """Local identifier of the referenced entity. It is resolved within the same delivery.
""",
        """Local identifier. For example, a UUID from the council information system.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.
""",
        """Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.
""" ;
    act:description_fr """Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.
""",
        """Identifiant local. Par exemple, un UUID issu du système d'information du conseil.
""" .

<https://ld.ech.ch/schema/0292/meta-common/wikidataUri> a owl:DatatypeProperty ;
    rdfs:label "wikidata_uri" ;
    rdfs:range xsd:anyURI ;
    skos:definition """A URI that refers to a Wikidata entity, e.g. http://www.wikidata.org/entity/Q813067 for Beat Jans.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
    act:description_de """Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.
""" ;
    act:description_fr """Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.
""",
        """Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.
""" .

act:organizationUid a owl:DatatypeProperty ;
    rdfs:label "organization_uid" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CHE[1-9][0-9]{8}$" ] ) ] ;
    skos:definition """UID of the organization from the federal UID register (uid.admin.ch), in the exchange format of eCH-0108: CHE followed by nine digits, without separators (e.g. CHE106063525). The last digit is a check digit calculated modulo 11. The dotted form CHE-106.063.525 is the presentation used by uid.admin.ch and is not recorded here.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """UID der Organisation aus dem eidgenössischen UID-Register (uid.admin.ch), im Austauschformat von eCH-0108: CHE gefolgt von neun Ziffern, ohne Trennzeichen (z.B. CHE106063525). Die letzte Ziffer ist eine Prüfziffer nach Modulo 11. Die punktierte Form CHE-106.063.525 ist die Darstellung von uid.admin.ch und wird hier nicht erfasst.
""" ;
    act:description_fr """IDE de l'organisation issu du registre fédéral IDE (uid.admin.ch), dans le format d'échange d'eCH-0108 : CHE suivi de neuf chiffres, sans séparateurs (p. ex. CHE106063525). Le dernier chiffre est un chiffre de contrôle calculé modulo 11. La forme pointée CHE-106.063.525 est la présentation utilisée par uid.admin.ch et n'est pas saisie ici.
""" .

<https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> a owl:Class ;
    rdfs:label "MultilingualValue" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:string ;
                    owl:withRestrictions ( [ xsd:pattern "^[a-z]{2}$" ] ) ] ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/language> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
