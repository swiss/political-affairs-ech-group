act:Training a owl:Class ;
    rdfs:label "Training" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty act:trainingCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty act:trainingCode ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty act:training_type ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty act:training_code ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:string ;
                        owl:onProperty act:value ] ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty act:trainingType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty act:trainingCode ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty act:trainingType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://ld.ech.ch/schema/0292/meta-common/value> ],
        [ a owl:Restriction ;
            owl:allValuesFrom act:TrainingTypeEnum ;
            owl:onProperty act:trainingType ],
        <https://ld.ech.ch/schema/0292/meta-common/HasTemporalValidity> ;
    skos:definition """Training or education of a person indicating a type (e.g., school diploma, university degree, military service), a label, an ISCO-19 code, and temporal validity.
""" ;
    skos:inScheme <https://ld.ech.ch/schema/0294/actors> ;
    act:description_de """Ausbildung oder Bildung einer Person mit Angabe eines Typs (z.B. Schulabschluss, Universitätsabschluss, Militärdienst), eines Labels, eines ISCO-19 Codes und der zeitlichen Gültigkeit.
""" ;
    act:description_fr """Formation ou éducation d'une personne indiquant un type (p. ex. diplôme scolaire, diplôme universitaire, service militaire), un libellé, un code ISCO-19 et la validité temporelle.
""" .

<https://ld.ech.ch/schema/0294/actors/TrainingTypeEnum#military> a owl:Class ;
    rdfs:label "military" ;
    rdfs:subClassOf act:TrainingTypeEnum ;
    skos:definition "Military service (Swiss army). Use `value` to specify the rank reached." ;
    act:description_de "Militärdienst (Schweizer Armee). Den erreichten Grad im Feld `value` angeben." ;
