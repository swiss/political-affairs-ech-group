          <xs:documentation xml:lang="fr">Indique s'il s'agit de la langue préférée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="is_native" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
