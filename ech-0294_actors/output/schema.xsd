  <xs:complexType name="LanguageProficiency">
    <xs:annotation>
      <xs:documentation xml:lang="de">Sprachkenntnisse einer Person mit Angabe der Sprache und ob es sich um die bevorzugte Sprache oder die Muttersprache handelt.</xs:documentation>
      <xs:documentation xml:lang="fr">Compétences linguistiques d'une personne indiquant la langue et le fait qu'il s'agisse ou non de la langue préférée ou de la langue maternelle.</xs:documentation>
