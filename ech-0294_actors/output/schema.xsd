      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IsProcessStep">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Mixin-Klasse für einen einzelnen Schritt in einem
mehrstufigen Prozess (z. B. Bearbeitungsschritt eines Geschäfts oder
Phasen­schritt einer Konsultation). Kombiniert Identifikations- und
Zeitdauer-Slots und ergänzt einen freien Bemerkungs-Slot. Konkrete
Step-Klassen ergänzen ihre eigenen typ-spezifischen Slots.</xs:documentation>
      <xs:documentation xml:lang="fr">Une classe mixin pour une étape unique dans un processus
à plusieurs étapes (par ex. une étape de délibération d'une affaire ou
une étape de phase d'une consultation). Combine les slots d'identification
et de durée d'événement et ajoute un slot de remarque en texte libre.
Les classes d'étape concrètes ajoutent leurs propres slots spécifiques au type.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="remark" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Freitext-Bemerkung oder Notiz für Sonderfälle oder zusätzlichen Kontext zu einem Prozessschritt oder einer Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Remarque ou note en texte libre pour les cas particuliers ou pour un contexte supplémentaire relatif à une étape de processus ou à une entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MultilingualValue">
    <xs:annotation>
      <xs:documentation xml:lang="de">Ein mehrsprachiger String mit Angabe der Sprache.</xs:documentation>
      <xs:documentation xml:lang="fr">Une chaîne de caractères multilingue avec indication de la langue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="value" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.</xs:documentation>
          <xs:documentation xml:lang="fr">La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").</xs:documentation>
          <xs:documentation xml:lang="fr">Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="MultilingualUri">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine URI zusammen mit der Sprache der Ressource, auf die sie verweist. Gleich aufgebaut wie MultilingualValue, der Wert ist jedoch eine URI: Sie wird dort verwendet, wo derselbe Inhalt je Sprache unter einer eigenen Adresse publiziert wird.</xs:documentation>
      <xs:documentation xml:lang="fr">Une URI accompagnée de la langue de la ressource vers laquelle elle renvoie. Structure identique à MultilingualValue, mais la valeur est une URI : elle est utilisée là où le même contenu est publié à une adresse propre par langue.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="value" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.</xs:documentation>
          <xs:documentation xml:lang="fr">La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. "de", "fr", "it", "en").</xs:documentation>
          <xs:documentation xml:lang="fr">Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[a-z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="PersonReference">
    <xs:annotation>
      <xs:documentation xml:lang="de">Kurzreferenz auf eine Person mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Ermöglicht historische Korrektheit auch wenn sich die Person später ändert. Die referenzierte Person wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich.</xs:documentation>
      <xs:documentation xml:lang="fr">Référence abrégée à une personne avec les principales données d'identification au moment de la liaison. Préserve l'exactitude historique même si la personne change ultérieurement. La personne référencée est désignée par `local_id` ou `global_uri` ; au moins l'un des deux est requis.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="label" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Obligatorischer Kurzname zur Identifikation der Person innerhalb der Organisation (z.B. mit Geburtsjahr zur Unterscheidung von Personen mit gleichem Namen).</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage court obligatoire permettant d'identifier la personne au sein de l'organisation (par ex. avec l'ajout de l'année de naissance afin de distinguer les personnes portant le même nom).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_long" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Optionaler langer Anzeigename mit akademischen Titeln und vollständigem amtlichem Namen (z.B. "Dr. Maria Muster-Beispiel").</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage long facultatif comprenant les titres académiques et le nom officiel complet (par ex. « Dr. Maria Muster-Beispiel »).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="group_label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Name des Gremiums zum Zeitpunkt der Verknüpfung.</xs:documentation>
          <xs:documentation xml:lang="fr">Nom de l'organe/du groupe au moment de la liaison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.</xs:documentation>
          <xs:documentation xml:lang="fr">L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="GroupReference">
    <xs:annotation>
      <xs:documentation xml:lang="de">Kurzreferenz auf eine Gruppe mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Die referenzierte Gruppe wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich. Eine `local_id` wird innerhalb derselben Lieferung aufgelöst, eine `global_uri` auch darüber hinaus.</xs:documentation>
      <xs:documentation xml:lang="fr">Référence abrégée à un groupe avec les principales données d'identification au moment de la liaison. Le groupe référencé est désigné par `local_id` ou `global_uri` ; au moins l'un des deux est requis. Un `local_id` est résolu au sein de la même livraison, un `global_uri` également au-delà.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="label" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Möglichkeit bei einer strukturierten Information, ein Label zu vergeben (bspw. Anzeigename, Anstellung, etc.).</xs:documentation>
          <xs:documentation xml:lang="fr">Attribuer un label à une information structurée (par ex. nom d'affichage, poste, etc.).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="abbreviation" minOccurs="0" maxOccurs="unbounded" type="MultilingualValue">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abkürzung (kann mehrsprachig sein).</xs:documentation>
          <xs:documentation xml:lang="fr">Abréviation (peut être multilingue).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.</xs:documentation>
          <xs:documentation xml:lang="fr">L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Container">
    <xs:annotation>
      <xs:documentation xml:lang="de">Container für politische Akteure, Gruppen und Beziehungen.</xs:documentation>
      <xs:documentation xml:lang="fr">Conteneur pour les acteurs politiques, les groupes et les relations.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="persons" minOccurs="0" maxOccurs="unbounded" type="Person">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Personen.</xs:documentation>
          <xs:documentation xml:lang="fr">Collection de personnes.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="groups" minOccurs="0" maxOccurs="unbounded" type="Group">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Gruppen.</xs:documentation>
          <xs:documentation xml:lang="fr">Collection de groupes.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="memberships" minOccurs="0" maxOccurs="unbounded" type="Membership">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Mitgliedschaften.</xs:documentation>
          <xs:documentation xml:lang="fr">Collection d'affiliations.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="interest_links" minOccurs="0" maxOccurs="unbounded" type="InterestLink">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Interessenbindungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Collection de liens d'intérêts.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Person">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Person mit Identifikatoren, Namen, Adressen, Staatsbürgerschaften und Berufen.</xs:documentation>
      <xs:documentation xml:lang="fr">Une personne avec des identifiants, des noms, des adresses, des nationalités et des professions.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="label" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Obligatorischer Kurzname zur Identifikation der Person innerhalb der Organisation (z.B. mit Geburtsjahr zur Unterscheidung von Personen mit gleichem Namen). Bevorzugt: PersonOfficialName (amtlicher Name) kombiniert mit PersonCallFirstName (Rufname).</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage court et obligatoire permettant d'identifier la personne au sein de l'organisation (p. ex. avec l'ajout de l'année de naissance afin de distinguer des personnes portant le même nom). Recommandé : PersonOfficialName combiné avec PersonCallFirstName.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label_long" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Optionaler langer Anzeigename mit akademischen Titeln und vollständigem amtlichem Namen (z.B. "Dr. Maria Muster-Beispiel").</xs:documentation>
          <xs:documentation xml:lang="fr">Nom d'affichage long et facultatif comprenant les titres académiques et le nom officiel complet (p. ex. « Dr. Maria Muster-Beispiel »).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="birth_year" minOccurs="0" maxOccurs="1" type="xs:integer">
        <xs:annotation>
          <xs:documentation xml:lang="de">Geburtsjahr. Nur zu verwenden, wenn kein vollständiges `birthDate` vorhanden ist.</xs:documentation>
          <xs:documentation xml:lang="fr">Année de naissance. À utiliser uniquement lorsqu'aucune `birthDate` complète n'est disponible.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="birth_date" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Genaues Geburtsdatum, sofern verfügbar und öffentlich. Dieses Feld hat Vorrang vor dem Feld `birthYear`.</xs:documentation>
          <xs:documentation xml:lang="fr">Date de naissance exacte si disponible et publique. Ce champ prime sur le champ `birthYear`.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="death_date" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Genaues Todesdatum.</xs:documentation>
          <xs:documentation xml:lang="fr">Date de décès exacte.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="picture" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Link zu einem Bild (bevorzugt: PNG, dann JPG, dann GIF).</xs:documentation>
          <xs:documentation xml:lang="fr">Lien vers une image (de préférence : PNG, puis JPG, puis GIF).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="names" minOccurs="0" maxOccurs="unbounded" type="Name">
        <xs:annotation>
          <xs:documentation xml:lang="de">Namen der Person mit Typ und Wert.</xs:documentation>
          <xs:documentation xml:lang="fr">Noms de la personne avec type et valeur.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="addresses" minOccurs="0" maxOccurs="unbounded" type="Address">
        <xs:annotation>
          <xs:documentation xml:lang="de">Adressen mit Typ (privat, geschäftlich, lokal).</xs:documentation>
          <xs:documentation xml:lang="fr">Adresses avec type (privée, professionnelle, locale).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="language_proficiencies" minOccurs="0" maxOccurs="unbounded" type="LanguageProficiency">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sprachkompetenzen der Person.</xs:documentation>
          <xs:documentation xml:lang="fr">Compétences linguistiques de la personne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="citizenships" minOccurs="0" maxOccurs="unbounded" type="Citizenship">
        <xs:annotation>
          <xs:documentation xml:lang="de">Staatsbürgerschaften der Person.</xs:documentation>
          <xs:documentation xml:lang="fr">Nationalités de la personne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="genders" minOccurs="0" maxOccurs="unbounded" type="Gender">
        <xs:annotation>
          <xs:documentation xml:lang="de">Geschlecht der Person.</xs:documentation>
          <xs:documentation xml:lang="fr">Sexe de la personne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="occupations" minOccurs="0" maxOccurs="unbounded" type="Occupation">
        <xs:annotation>
          <xs:documentation xml:lang="de">Berufe oder Tätigkeiten der Person.</xs:documentation>
          <xs:documentation xml:lang="fr">Métiers ou professions de la personne.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="trainings" minOccurs="0" maxOccurs="unbounded" type="Training">
        <xs:annotation>
          <xs:documentation xml:lang="de">Ausbildungen oder Bildungen der Person. Richtlinie: Im Grundsatz nur die höchste Ausbildung angeben.</xs:documentation>
          <xs:documentation xml:lang="fr">Formations ou éducations de la personne. Directive : n'indiquer en principe que la qualification la plus élevée obtenue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="contacts" minOccurs="0" maxOccurs="unbounded" type="Contact">
        <xs:annotation>
          <xs:documentation xml:lang="de">Kontaktinformationen (E-Mail, Website, Social Media). Richtlinie: E-Mail ist quasi-obligatorisch und sollte wenn vorhanden immer angegeben werden.</xs:documentation>
          <xs:documentation xml:lang="fr">Informations de contact (e-mail, site web, réseaux sociaux). Directive : l'e-mail est quasi obligatoire et devrait toujours être fourni lorsqu'il est disponible.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="interest_links" minOccurs="0" maxOccurs="unbounded" type="InterestLink">
        <xs:annotation>
          <xs:documentation xml:lang="de">Sammlung von Interessenbindungen.</xs:documentation>
          <xs:documentation xml:lang="fr">Collection de liens d'intérêts.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="global_uri" minOccurs="1" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine eindeutige, global gültige URI für die Entität.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI unique et globalement valide pour l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="wikidata_uri" minOccurs="0" maxOccurs="1" type="xs:anyURI">
        <xs:annotation>
          <xs:documentation xml:lang="de">Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.</xs:documentation>
          <xs:documentation xml:lang="fr">Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_created" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été créée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_modified" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_modified" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="Group">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine politische Gruppe, Organisation oder Körperschaft (z.B. Partei, Kommission, Parlament, Departement).</xs:documentation>
      <xs:documentation xml:lang="fr">Un groupe, une organisation ou une collectivité politique (p. ex. parti, commission, parlement, département).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="group_type" minOccurs="1" maxOccurs="1" type="GroupType">
        <xs:annotation>
          <xs:documentation xml:lang="de">Klasse der Gruppierung, wie z.B. Partei, Kommission, Parlament oder ähnliches. Die genaue Benennung und Beschreibung der Gruppierung wird über `label` gemacht.</xs:documentation>
          <xs:documentation xml:lang="fr">Type de groupe (p. ex. parti, commission, parlement ou similaire). La désignation et la description exactes du groupe sont fournies via `label`.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="label" minOccurs="1" maxOccurs="unbounded" type="MultilingualValue">
        <xs:annotation>
          <xs:documentation xml:lang="de">Bezeichnung der Gruppe mit der Sprache, in der sie publiziert wird. Ist eine Gruppe amtlich in mehreren Sprachen benannt, wird pro Sprache ein Eintrag erfasst.</xs:documentation>
          <xs:documentation xml:lang="fr">Désignation du groupe avec la langue dans laquelle elle est publiée. Lorsqu'un groupe porte officiellement un nom dans plusieurs langues, une entrée est saisie par langue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="abbreviation" minOccurs="0" maxOccurs="unbounded" type="MultilingualValue">
        <xs:annotation>
          <xs:documentation xml:lang="de">Abkürzung (kann mehrsprachig sein).</xs:documentation>
          <xs:documentation xml:lang="fr">Abréviation (peut être multilingue).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="description" minOccurs="0" maxOccurs="unbounded" type="MultilingualValue">
        <xs:annotation>
          <xs:documentation xml:lang="de">Kurze Beschreibung der Gruppierung.</xs:documentation>
          <xs:documentation xml:lang="fr">Description de l'entité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="organization_uid" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">UID der Organisation aus dem eidgenössischen UID-Register (uid.admin.ch), im Austauschformat von eCH-0108: CHE gefolgt von neun Ziffern, ohne Trennzeichen (z.B. CHE106063525). Die letzte Ziffer ist eine Prüfziffer nach Modulo 11. Die punktierte Form CHE-106.063.525 ist die Darstellung von uid.admin.ch und wird hier nicht erfasst.</xs:documentation>
          <xs:documentation xml:lang="fr">IDE de l'organisation issu du registre fédéral IDE (uid.admin.ch), dans le format d'échange d'eCH-0108 : CHE suivi de neuf chiffres, sans séparateurs (p. ex. CHE106063525). Le dernier chiffre est un chiffre de contrôle calculé modulo 11. La forme pointée CHE-106.063.525 est la présentation utilisée par uid.admin.ch et n'est pas saisie ici.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="CHE[1-9][0-9]{8}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="legal_form" minOccurs="0" maxOccurs="1" type="LegalFormEnum">
        <xs:annotation>
          <xs:documentation xml:lang="de">Rechtsform der Organisation. Siehe kontrolliertes Vokabular: https://register.ld.admin.ch/i14y/concept/legalForm</xs:documentation>
          <xs:documentation xml:lang="fr">Forme juridique de l'organisation. Voir le vocabulaire contrôlé : https://register.ld.admin.ch/i14y/concept/legalForm</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="landing_page" minOccurs="0" maxOccurs="unbounded" type="MultilingualUri">
        <xs:annotation>
          <xs:documentation xml:lang="de">Website mit weiteren Informationen. Wird die Website je Sprache unter einer eigenen Adresse publiziert, wird pro Sprache ein Eintrag erfasst.</xs:documentation>
          <xs:documentation xml:lang="fr">Site web fournissant de plus amples informations. Lorsque le site est publié à une adresse propre par langue, une entrée est saisie par langue.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="parent_groups" minOccurs="0" maxOccurs="unbounded" type="GroupReference">
        <xs:annotation>
          <xs:documentation xml:lang="de">Verweis auf die übergeordneten Gruppen als GroupReference, also angegeben über deren local_id oder deren global_uri. Hierher gehört nur eine echte Über-/Unterordnung: die Mutterpartei einer Kantonalpartei, die Hierarchie in der Exekutive, eine Subkommission unter ihrer Kommission oder eine Fraktion unter ihrem Parlament. (parentGroup wird typischerweise im selben group_type verwendet, typenübergreifende Verknüpfungen sind aber erlaubt, z.B. Fraktion → Parlament.) Die eine Fraktion tragenden Parteien sind ihr nicht übergeordnet und werden hier deshalb nicht angegeben.</xs:documentation>
          <xs:documentation xml:lang="fr">Référence aux groupes supérieurs sous forme de GroupReference, c'est-à-dire indiquée au moyen de leur local_id ou de leur global_uri. Seule une véritable relation de subordination y a sa place : le parti faîtier d'un parti cantonal, la hiérarchie au sein de l'exécutif, une sous-commission rattachée à sa commission ou un groupe parlementaire rattaché à son parlement. (parentGroup est généralement utilisé au sein d'un même group_type, mais les liens intertypes sont autorisés, p. ex. groupe parlementaire → parlement.) Les partis qui portent un groupe parlementaire ne lui sont pas supérieurs et ne sont donc pas indiqués ici.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="spatial" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">Räumliche Referenz auf eine LINDAS-Ressource (BFS-Gemeindenummer, BFS-Kantonsnummer, Bezirk oder Land). Formate: Gemeinde: https://ld.admin.ch/municipality/1234, Bezirk: https://ld.admin.ch/district/2301, Kanton: https://ld.admin.ch/canton/23, Bund: https://ld.admin.ch/country/CHE.</xs:documentation>
          <xs:documentation xml:lang="fr">Référence spatiale à une ressource LINDAS (numéro OFS de commune, numéro OFS de canton, district ou pays). Formats : commune : https://ld.admin.ch/municipality/1234, district : https://ld.admin.ch/district/2301, canton : https://ld.admin.ch/canton/23, pays : https://ld.admin.ch/country/CHE.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="https://ld\.admin\.ch/(country/[A-Z]{3}|canton/[0-9]+|district/[0-9]+|municipality/[0-9]+)"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="contacts" minOccurs="0" maxOccurs="unbounded" type="Contact">
        <xs:annotation>
          <xs:documentation xml:lang="de">Kontaktinformationen (E-Mail, Website, Social Media). Richtlinie: E-Mail ist quasi-obligatorisch und sollte wenn vorhanden immer angegeben werden.</xs:documentation>
          <xs:documentation xml:lang="fr">Informations de contact (e-mail, site web, réseaux sociaux). Directive : l'e-mail est quasi obligatoire et devrait toujours être fourni lorsqu'il est disponible.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="addresses" minOccurs="0" maxOccurs="unbounded" type="Address">
        <xs:annotation>
          <xs:documentation xml:lang="de">Adressen mit Typ (privat, geschäftlich, lokal).</xs:documentation>
          <xs:documentation xml:lang="fr">Adresses avec type (privée, professionnelle, locale).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="statutes_url" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">URL zu Parteistatuten (PDF oder Webseite; optional für Parteien).</xs:documentation>
          <xs:documentation xml:lang="fr">URL vers les statuts du parti (PDF ou page web ; facultatif pour les partis).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="party_color" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Parteifarbe als Hexadezimalwert (optional für Parteien, z.B. "#FF0000").</xs:documentation>
          <xs:documentation xml:lang="fr">Couleur du parti sous forme de valeur hexadécimale (facultatif pour les partis, p. ex. « #FF0000 »).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="local_id" minOccurs="0" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation xml:lang="de">Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.</xs:documentation>
          <xs:documentation xml:lang="fr">Identifiant local. Par exemple, un UUID issu du système d'information du conseil.</xs:documentation>
        </xs:annotation>
      </xs:element>
