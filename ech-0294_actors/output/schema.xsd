          <xs:documentation xml:lang="fr">La date et l'heure effectives d'un événement ou d'une occurrence instantané (sans durée).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).</xs:documentation>
          <xs:documentation xml:lang="fr">La date planifiée d'un événement ou d'une occurrence instantané (sans durée).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure planifiées d'un événement ou d'une occurrence instantané (sans durée).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="IsEventWithDuration">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Mixin-Klasse, die Slots für die Modellierung von Ereignissen oder Vorkommnissen mit Zeitdauer zur Verfügung stellt.</xs:documentation>
      <xs:documentation xml:lang="fr">Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences avec une durée.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="date_begin_actual" minOccurs="0" maxOccurs="1" type="xs:date">
