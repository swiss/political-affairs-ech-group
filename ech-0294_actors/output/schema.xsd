  <xs:complexType name="Citizenship">
    <xs:annotation>
      <xs:documentation xml:lang="de">Staatsangehörigkeit (wird auch für Nationalität verwendet) einer Person unter Angabe des Landes und der zeitlichen Gültigkeit. Wenn kein `valid_from` angegeben ist, ist diese Information nicht bekannt. Ist bekannt, dass die Staatsangehörigkeit seit der Geburt gültig ist, ist das Geburtsdatum hier anzugeben. Wenn kein `valid_through` angegeben ist, ist die Staatsangehörigkeit weiterhin gültig.</xs:documentation>
      <xs:documentation xml:lang="fr">Nationalité (également utilisée pour la citoyenneté) d'une personne indiquant le pays et la validité temporelle. Si aucun `valid_from` n'est fourni, cette information n'est pas connue. S'il est établi que la nationalité est valable depuis la naissance, la date de naissance doit être répétée ici. En l'absence de `valid_through`, la nationalité est toujours en vigueur.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="country" minOccurs="1" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">ISO 3166-1 alpha-2 Ländercode.</xs:documentation>
          <xs:documentation xml:lang="fr">Code de pays ISO 3166-1 alpha-2.</xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2}"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="valid_from" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, ab dem die Information gültig ist.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à partir de laquelle l'information est valable.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="valid_through" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, bis und mit dem die Information gültig ist.</xs:documentation>
          <xs:documentation xml:lang="fr">La date jusqu'à laquelle l'information est valable, incluse.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="is_active" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gibt an, ob die Information aktuell gültig ist. Kann nützlich sein, wenn diese Information explizit vorhanden ist.</xs:documentation>
          <xs:documentation xml:lang="fr">Indique si l'information est actuellement valable. Peut être utile lorsque cette information est explicitement disponible.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
