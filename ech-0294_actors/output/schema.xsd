          <xs:documentation xml:lang="de">Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_begin_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de début planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_begin_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_actual" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin effective d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_actual" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="date_end_planned" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date de fin planifiée d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datetime_end_planned" minOccurs="0" maxOccurs="1" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.</xs:documentation>
          <xs:documentation xml:lang="fr">La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="HasCreationModificationDates">
    <xs:annotation>
      <xs:documentation xml:lang="de">Eine Mixin-Klasse, die Slots für die Modellierung von Erstellungs- und Änderungsdaten einer Entität zur Verfügung stellt.</xs:documentation>
      <xs:documentation xml:lang="fr">Une classe mixin qui fournit des slots pour modéliser les dates de création et de modification d'une entité.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="date_created" minOccurs="0" maxOccurs="1" type="xs:date">
        <xs:annotation>
          <xs:documentation xml:lang="de">Das Datum, an dem eine Entität erstellt wurde.</xs:documentation>
          <xs:documentation xml:lang="fr">La date à laquelle une entité a été créée.</xs:documentation>
