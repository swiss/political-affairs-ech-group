  <xs:complexType name="Occupation">
    <xs:annotation>
      <xs:documentation xml:lang="de">Beruf oder Tätigkeit einer Person mit Angabe eines Labels, eines ISCO-19 Codes, ob die Tätigkeit bezahlt ist, und der zeitlichen Gültigkeit.</xs:documentation>
      <xs:documentation xml:lang="fr">Métier ou profession d'une personne indiquant un libellé, un code ISCO-19, si l'activité est rémunérée, ainsi que la validité temporelle.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="is_paid" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation xml:lang="de">Gibt an, ob die Tätigkeit bezahlt ist.</xs:documentation>
          <xs:documentation xml:lang="fr">Indique si l'activité est rémunérée.</xs:documentation>
