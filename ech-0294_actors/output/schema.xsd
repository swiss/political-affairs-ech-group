          <xs:documentation xml:lang="de">Ort.</xs:documentation>
          <xs:documentation xml:lang="fr">Localité.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="country" minOccurs="0" maxOccurs="1">
        <xs:annotation>
          <xs:documentation xml:lang="de">ISO 3166-1 alpha-2 Ländercode.</xs:documentation>
