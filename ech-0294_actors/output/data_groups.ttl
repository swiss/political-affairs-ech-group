<https://www.parlament.ch/de/organe/gruppen/konsumenteninformation-und-schutz> a act:Group ;
    schema1:validFrom "2012-01-01"^^xsd:date ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "it" ;
            mcm:value "Informazione e tutela dei consumatori" ],
        [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Konsumenteninformation und -schutz" ],
        [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "Information et défense des consommateurs" ] ;
    mcm:localId "6627" ;
    act:address [ a act:Address ;
            act:addressType "businessAddress" ;
            act:addressURI <https://geo.ld.admin.ch/location/address/101009806> ;
            act:country "CH" ;
            act:postalCode 1001 ;
            act:postalLocality "Lausanne" ;
            act:streetAddress "Fédération romande des consommateurs, Rue de Genève 17, case postale 585" ] ;
    act:contact [ a act:Contact ;
            mcm:label "Sekretariat" ;
            mcm:value "+41 21 331 00 95" ;
            act:contactType "phone" ],
        [ a act:Contact ;
            mcm:label "Sekretariat" ;
            mcm:value "l.altwegg@frc.ch" ;
            act:contactType "email" ] ;
    act:description [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "L'intergroupe parlementaire « Information et défense des consommateurs » réunit toutes les sensibilités politiques. Cet intergroupe a pour mission d'informer et de sensibiliser les élu·e·s aux questions relatives à la défense des consommateur·rice·s en Suisse." ] ;
    act:groupType [ a act:GroupType ;
            mcm:label [ a mcm:MultilingualValue ;
                    mcm:language "de" ;
                    mcm:value "Interessengruppe" ],
                [ a mcm:MultilingualValue ;
                    mcm:language "it" ;
                    mcm:value "Gruppo d'interesse" ],
                [ a mcm:MultilingualValue ;
                    mcm:language "fr" ;
                    mcm:value "Groupe d'intérêt" ] ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/interest_group> ] ;
    act:landingPage [ a mcm:MultilingualUri ;
            mcm:language "de" ;
            mcm:value <https://www.parlament.ch/centers/documents/de/gruppen-der-bundesversammlung.pdf> ] ;
    act:spatial "https://ld.admin.ch/country/CHE" .

