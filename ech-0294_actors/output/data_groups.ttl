            act:streetAddress "Fédération romande des consommateurs, Rue de Genève 17, case postale 585" ] ;
    act:contact [ a act:Contact ;
            mcm:label "Sekretariat" ;
            mcm:value "+41 21 331 00 95" ;
            act:contactType "phone" ],
        [ a act:Contact ;
            mcm:label "Sekretariat" ;
            mcm:value "l.altwegg@frc.ch" ;
            act:contactType "email" ] ;
    act:description [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "L'intergroupe parlementaire « Information et défense des consommateurs » réunit toutes les sensibilités politiques. Cet intergroupe a pour mission d'informer et de sensibiliser les élu·e·s aux questions relatives à la défense des consommateur·rice·s en Suisse." ] ;
    act:groupType [ a act:GroupType ;
            mcm:label "Interessengruppe" ;
