@prefix act: <https://ld.ech.ch/schema/0294/actors/> .
@prefix mcm: <https://ld.ech.ch/schema/0292/meta-common/> .
@prefix schema1: <http://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

act:groups_example a act:Container ;
    act:group <https://api.openparldata.ch/v1/groups/20>,
        <https://api.openparldata.ch/v1/groups/3>,
        <https://api.openparldata.ch/v1/groups/50>,
        <https://api.openparldata.ch/v1/groups/5000>,
        <https://api.openparldata.ch/v1/groups/6627>,
        <https://api.openparldata.ch/v1/groups/700> .

<https://api.openparldata.ch/v1/groups/20> a act:Group ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Evangelische Volkspartei" ] ;
    mcm:localId "20" ;
    act:groupType [ a act:GroupType ;
            mcm:label "Fraktion" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/faction> ] ;
    act:spatial "https://ld.admin.ch/canton/12" .

<https://api.openparldata.ch/v1/groups/3> a act:Group ;
    mcm:abbreviation [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "GPK" ] ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Geschäftsprüfungskommission" ] ;
    mcm:localId "3" ;
    act:groupType [ a act:GroupType ;
            mcm:label "Kommission" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/commission> ] ;
    act:spatial "https://ld.admin.ch/canton/15" .

<https://api.openparldata.ch/v1/groups/50> a act:Group ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Büro des Grossen Rates" ] ;
    mcm:localId "50" ;
    act:groupType [ a act:GroupType ;
            mcm:label "Ratsbüro" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/parliamentary_bureau> ] ;
    act:spatial "https://ld.admin.ch/canton/12" .

<https://api.openparldata.ch/v1/groups/5000> a act:Group ;
    schema1:validFrom "2007-12-12"^^xsd:date ;
    mcm:abbreviation [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Del-StRFE" ],
        [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "Del-DetPen" ] ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "Délégation FR à la CIP détention pénale" ],
        [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Freiburger Delegation IPK strafrechtliche Einschliessung" ] ;
    mcm:localId "5000" ;
    act:description [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Die Interparlamentarische Aufsichtskommission strafrechtliche Einschliessung besteht aus 18 Grossrätinnen und Grossräten aus den sechs Vertragskantonen Freiburg, Genf, Jura, Neuenburg, Waadt und Wallis. Sie ist für die parlamentarische Aufsicht über den Vollzug der beiden lateinischen Konkordate über den strafrechtlichen Freiheitsentzug zuständig." ],
        [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "La Commission interparlementaire de contrôle détention pénale est composée de 18 députés issus des six cantons partenaires : Fribourg, Genève, Jura, Neuchâtel, Vaud et Valais. Elle est chargée de la surveillance parlementaire de l'exécution des deux concordats latins sur la détention pénale." ] ;
    act:groupType [ a act:GroupType ;
            mcm:label "Delegation" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/delegation> ] ;
    act:landingPage [ a mcm:MultilingualUri ;
            mcm:language "fr" ;
            mcm:value <https://www.fr.ch/parlinfo/app/organizations/a1acb0c030d54b3baed840fe8bbed6b5> ],
        [ a mcm:MultilingualUri ;
            mcm:language "de" ;
            mcm:value <https://www.fr.ch/de/parlinfo/app/organizations/a1acb0c030d54b3baed840fe8bbed6b5> ] ;
    act:spatial "https://ld.admin.ch/canton/10" .

<https://api.openparldata.ch/v1/groups/6627> a act:Group ;
    schema1:validFrom "2012-01-01"^^xsd:date ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "Information et défense des consommateurs" ],
        [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Konsumenteninformation und -schutz" ],
        [ a mcm:MultilingualValue ;
            mcm:language "it" ;
            mcm:value "Informazione e tutela dei consumatori" ] ;
    mcm:localId "6627" ;
    act:description [ a mcm:MultilingualValue ;
            mcm:language "fr" ;
            mcm:value "L'intergroupe parlementaire « Information et défense des consommateurs » réunit toutes les sensibilités politiques. Cet intergroupe a pour mission d'informer et de sensibiliser les élu·e·s aux questions relatives à la défense des consommateur·rice·s en Suisse." ] ;
    act:groupType [ a act:GroupType ;
            mcm:label "Interessengruppe" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/interest_group> ] ;
    act:spatial "https://ld.admin.ch/country/CHE" .

<https://api.openparldata.ch/v1/groups/700> a act:Group ;
    mcm:label [ a mcm:MultilingualValue ;
            mcm:language "de" ;
            mcm:value "Stadtparlament St. Gallen" ] ;
    mcm:localId "700" ;
    act:groupType [ a act:GroupType ;
            mcm:label "Parlament (Legislativrat)" ;
            act:groupTypeEnum <https://ld.ech.ch/schema/0294/actors/enum/group_type/parliament> ] ;
    act:spatial "https://ld.admin.ch/municipality/3203" .


