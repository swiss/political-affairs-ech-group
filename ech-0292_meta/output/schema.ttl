@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix meta: <https://ch.paf.link/schema/meta/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
dcterms:language a owl:DatatypeProperty ;
	rdfs:label "expression_language" ;
	rdfs:range _:c14n125 ;
	skos:definition "Language code in ISO 639-1 format.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Sprachcode im ISO 639-1-Format.\n" ;
	meta:description_fr "Code de langue au format ISO 639-1.\n" .
<http://schema.org/description> a owl:DatatypeProperty ;
	rdfs:label "expression_description" ;
	rdfs:range xsd:string ;
	skos:definition "Descriptive text of the language version.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Beschreibender Text zur Sprachfassung.\n" ;
	meta:description_fr "Texte descriptif de la version linguistique.\n" .
<http://schema.org/validFrom> a owl:DatatypeProperty ;
	rdfs:label "valid_from" ;
	rdfs:range xsd:date ;
	skos:definition "The date from which the information is valid.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum, ab dem die Information gültig ist.\n" ;
	meta:description_fr "La date à partir de laquelle l'information est valable.\n" .
<http://schema.org/validThrough> a owl:DatatypeProperty ;
	rdfs:label "valid_through" ;
	rdfs:range xsd:date ;
	skos:definition "The date until which the information is valid, inclusive.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum, bis und mit dem die Information gültig ist.\n" ;
	meta:description_fr "La date jusqu'à laquelle l'information est valable, incluse.\n" .
<https://ch.paf.link/schema/meta.owl.ttl> a owl:Ontology ;
	rdfs:label "meta" ;
	skos:definition "This schema models meta topics for the eCH standards 0293-0297. In a first step, FRBR entities are modelled in order to manage documents and their translations.\n" ;
	meta:description_de "Dieses Schema modelliert Meta-Themen für die eCH Standards 0293-0297. In einem ersten Schritt werden FRBR-Entitäten modelliert, um die Verwaltung von Dokumenten und deren Übersetzungen zu ermöglichen.\n" ;
	meta:description_fr "Ce schéma modélise les thèmes transversaux des normes eCH 0293-0297. Dans un premier temps, des entités FRBR sont modélisées afin de permettre la gestion des documents et de leurs traductions.\n" .
meta:DocumentCategoryEnum a owl:Class ;
	rdfs:label "DocumentCategoryEnum" ;
	owl:unionOf _:c14n101 ;
	skos:definition "Categories for classifying documents referenced in eCH standards 0292-0297. Multilingual labels (DE/FR/IT/RM/EN) are encoded via `annotations` (convention `label_xx`); first proposals for FR/IT/RM are pending plenum review.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Kategorien zur Klassifikation von Dokumenten, die in den eCH Standards 0292-0297 referenziert werden. Mehrsprachige Labels (DE/FR/IT/RM/EN) sind über `annotations` (Konvention `label_xx`) abgebildet; Erstvorschläge für FR/IT/RM stehen unter Plenum-Review.\n" ;
	meta:description_fr "Catégories de classification des documents référencés dans les normes eCH 0292-0297. Les libellés multilingues (DE/FR/IT/RM/EN) sont représentés au moyen d'`annotations` (convention `label_xx`) ; les premières propositions pour FR/IT/RM sont en cours de revue par le plénum.\n" ;
	linkml:permissible_values meta:vocabulary\/document_category\/ConsultationDocuments , meta:vocabulary\/document_category\/ConsultationResults , meta:vocabulary\/document_category\/GroupDocuments , meta:vocabulary\/document_category\/InterestDisclosure , meta:vocabulary\/document_category\/LegislativeDocuments , meta:vocabulary\/document_category\/MediaRelease , meta:vocabulary\/document_category\/MeetingDocuments , meta:vocabulary\/document_category\/MeetingPlanning , meta:vocabulary\/document_category\/MemberDirectory , meta:vocabulary\/document_category\/Other , meta:vocabulary\/document_category\/PersonDocuments , meta:vocabulary\/document_category\/Protocol , meta:vocabulary\/document_category\/VotingResult .
meta:Expression a owl:Class ;
	rdfs:label "Expression" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n115 , _:c14n118 , _:c14n121 , _:c14n132 , _:c14n142 , _:c14n152 , _:c14n170 , _:c14n172 , _:c14n174 , _:c14n181 , _:c14n196 , _:c14n198 , _:c14n24 , _:c14n28 , _:c14n34 , _:c14n5 , _:c14n59 , _:c14n76 , _:c14n82 , _:c14n88 , _:c14n89 , _:c14n94 , _:c14n95 ;
	skos:definition "FRBR Expression: a concrete language version of a Work.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "FRBR Expression: eine konkrete Sprachfassung eines Works.\n" ;
	meta:description_fr "FRBR Expression : une version linguistique concrète d'un Work.\n" .
meta:Manifestation a owl:Class ;
	rdfs:label "Manifestation" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> , <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n1 , _:c14n13 , _:c14n130 , _:c14n147 , _:c14n153 , _:c14n155 , _:c14n17 , _:c14n188 , _:c14n190 , _:c14n192 , _:c14n197 , _:c14n2 , _:c14n51 , _:c14n55 , _:c14n64 , _:c14n65 , _:c14n67 , _:c14n75 ;
	skos:definition "FRBR Manifestation: a concrete file format of an Expression, addressable via a URL.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "FRBR Manifestation: eine konkrete Dateiform einer Expression, über eine URL adressierbar.\n" ;
	meta:description_fr "FRBR Manifestation : une forme de fichier concrète d'une Expression, adressable au moyen d'une URL.\n" .
meta:Work a owl:Class ;
	rdfs:label "Work" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n134 , _:c14n27 , _:c14n35 , _:c14n9 , _:c14n90 ;
	skos:definition "FRBR Work: the abstract document as such, independent of a concrete language version or file format.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "FRBR Work: das abstrakte Dokument als solches, unabhängig von einer konkreten Sprachfassung oder einem Dateiformat.\n" ;
	meta:description_fr "FRBR Work : le document abstrait en tant que tel, indépendamment d'une version linguistique ou d'un format de fichier concrets.\n" .
meta:WorkContainer a owl:Class ;
	rdfs:label "WorkContainer" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasIdentification> , _:c14n119 , _:c14n87 ;
	skos:definition "Container for the documents (FRBR Works) of this schema. Deliberately not a tree_root, because the consuming schemas define their own Container.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Container für die Dokumente (FRBR Works) dieses Schemas. Bewusst kein tree_root, weil die konsumierenden Schemata ihren eigenen Container definieren.\n" ;
	meta:description_fr "Conteneur pour les documents (FRBR Works) de ce schéma. Volontairement pas un tree_root, car les schémas consommateurs définissent leur propre Container.\n" .
meta:documentCategory a owl:ObjectProperty ;
	rdfs:label "document_category" ;
	rdfs:range meta:DocumentCategoryEnum ;
	skos:definition "Category of the document. If not set, 'other' is automatically used.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Kategorie des Dokuments. Wenn nicht gesetzt, wird automatisch 'other' verwendet.\n" ;
	meta:description_fr "Catégorie du document. Si elle n'est pas renseignée, la valeur 'other' est utilisée automatiquement.\n" .
meta:documents a owl:ObjectProperty ;
	rdfs:label "documents" ;
	rdfs:range meta:Work ;
	skos:definition "List of documents (FRBR Works) linked to the entity.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Liste von Dokumenten (FRBR Works), die mit der Entität verknüpft sind.\n" ;
	meta:description_fr "Liste des documents (FRBR Works) liés à l'entité.\n" .
meta:expressions a owl:ObjectProperty ;
	rdfs:label "expressions" ;
	rdfs:range meta:Expression ;
	skos:definition "The language versions (Expressions) of a Work.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Die Sprachfassungen (Expressions) eines Works.\n" ;
	meta:description_fr "Les versions linguistiques (Expressions) d'un Work.\n" .
meta:format a owl:DatatypeProperty ;
	rdfs:label "format" ;
	rdfs:range xsd:string ;
	skos:definition "The file format of the manifestation (e.g., pdf, html).\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Das Dateiformat der Manifestation (z.B. pdf, html).\n" ;
	meta:description_fr "Le format de fichier de la manifestation (p. ex. pdf, html).\n" .
meta:manifestations a owl:ObjectProperty ;
	rdfs:label "manifestations" ;
	rdfs:range meta:Manifestation ;
	skos:definition "The file forms (Manifestations) of an Expression.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Die Dateiformen (Manifestations) einer Expression.\n" ;
	meta:description_fr "Les formes de fichier (Manifestations) d'une Expression.\n" .
meta:title a owl:DatatypeProperty ;
	rdfs:label "expression_title" ;
	rdfs:range xsd:string ;
	skos:definition "Title of the language version.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Titel der Sprachfassung.\n" ;
	meta:description_fr "Titre de la version linguistique.\n" .
meta:url a owl:DatatypeProperty ;
	rdfs:label "manifestation_url" ;
	rdfs:range xsd:anyURI ;
	skos:definition "URL under which the file form can be retrieved.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "URL, unter der die Dateiform abgerufen werden kann.\n" ;
	meta:description_fr "URL sous laquelle la forme de fichier peut être consultée.\n" .
meta:vocabulary\/document_category\/ConsultationDocuments dcterms:title "Consultation documents" ;
	a owl:Class ;
	rdfs:label "consultation_documents" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Documents opening a consultation. Examples: invitation, list of addressees, questionnaire, synoptic table.\n" ;
	meta:description_de "Unterlagen zur Eröffnung einer Vernehmlassung. Beispiele: Einladung, Adressatenliste, Fragebogen, synoptische Darstellung (Fahne).\n" ;
	meta:description_fr "Documents d'ouverture d'une consultation. Exemples : invitation, liste des destinataires, questionnaire, tableau synoptique.\n" ;
	meta:label_de "Vernehmlassungsdokumente" ;
	meta:label_en "Consultation documents" ;
	meta:label_fr "Documents de consultation" ;
	meta:label_it "Documenti di consultazione" ;
	meta:label_rm "Documents da consultaziun" .
meta:vocabulary\/document_category\/ConsultationResults dcterms:title "Consultation results" ;
	a owl:Class ;
	rdfs:label "consultation_results" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Results of a consultation. Examples: statement of an organisation or person, report on the results.\n" ;
	meta:description_de "Ergebnisse einer Vernehmlassung. Beispiele: Stellungnahme einer Organisation oder Person, Ergebnisbericht.\n" ;
	meta:description_fr "Résultats d'une consultation. Exemples : prise de position d'une organisation ou d'une personne, rapport sur les résultats.\n" ;
	meta:label_de "Vernehmlassungsresultate" ;
	meta:label_en "Consultation results" ;
	meta:label_fr "Résultats de la consultation" ;
	meta:label_it "Risultati della consultazione" ;
	meta:label_rm "Resultats da la consultaziun" .
meta:vocabulary\/document_category\/GroupDocuments dcterms:title "Group documents" ;
	a owl:Class ;
	rdfs:label "group_documents" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Documents of a group such as a committee or party. Examples: statutes, annual report, committee allocation.\n" ;
	meta:description_de "Unterlagen einer Gruppe wie Kommission oder Partei. Beispiele: Statuten, Jahresbericht, Kommissionszuteilung.\n" ;
	meta:description_fr "Documents d'un groupe tel qu'une commission ou un parti. Exemples : statuts, rapport annuel, répartition dans les commissions.\n" ;
	meta:label_de "Gruppenunterlagen" ;
	meta:label_en "Group documents" ;
	meta:label_fr "Documents de groupe" ;
	meta:label_it "Documenti di gruppo" ;
	meta:label_rm "Documents da gruppa" .
meta:vocabulary\/document_category\/InterestDisclosure dcterms:title "Interest disclosure" ;
	a owl:Class ;
	rdfs:label "interest_disclosure" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Registers of the interests of council members. Example: register of interests of the National Council.\n" ;
	meta:description_de "Register der Interessenbindungen von Ratsmitgliedern. Beispiel: Register der Interessenbindungen des Nationalrats.\n" ;
	meta:description_fr "Registres des liens d'intérêts des membres des conseils. Exemple : registre des liens d'intérêts du Conseil national.\n" ;
	meta:label_de "Interessenbindungen" ;
	meta:label_en "Interest disclosures" ;
	meta:label_fr "Liens d'intérêts" ;
	meta:label_it "Relazioni d'interesse" ;
	meta:label_rm "Colliaziuns d'interess" .
meta:vocabulary\/document_category\/LegislativeDocuments dcterms:title "Legislative documents" ;
	a owl:Class ;
	rdfs:label "legislative_documents" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Documents of the legislative process. Examples: draft act, explanatory report, adopted act, consolidated version.\n" ;
	meta:description_de "Dokumente des Gesetzgebungsverfahrens. Beispiele: Erlassentwurf, erläuternder Bericht, beschlossener Erlass, konsolidierte Fassung.\n" ;
	meta:description_fr "Documents de la procédure législative. Exemples : projet d'acte, rapport explicatif, acte adopté, version consolidée.\n" ;
	meta:label_de "Gesetzgebungsdokumente" ;
	meta:label_en "Legislative documents" ;
	meta:label_fr "Documents législatifs" ;
	meta:label_it "Documenti legislativi" ;
	meta:label_rm "Documents legislativs" .
meta:vocabulary\/document_category\/MediaRelease dcterms:title "Media release" ;
	a owl:Class ;
	rdfs:label "media_release" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Press releases.\n" ;
	meta:description_de "Medienmitteilungen.\n" ;
	meta:description_fr "Communiqués de presse.\n" ;
	meta:label_de "Medienmitteilung" ;
	meta:label_en "Media release" ;
	meta:label_fr "Communiqué de presse" ;
	meta:label_it "Comunicato stampa" ;
	meta:label_rm "Communicaziun da medias" .
meta:vocabulary\/document_category\/MeetingDocuments dcterms:title "Meeting documents" ;
	a owl:Class ;
	rdfs:label "meeting_documents" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Documents on the affairs of a meeting. Examples: agenda, session programme, list of parliamentary interventions.\n" ;
	meta:description_de "Unterlagen zu den Geschäften einer Sitzung. Beispiele: Traktandenliste, Sessionsprogramm, Vorstossliste.\n" ;
	meta:description_fr "Documents relatifs aux affaires d'une séance. Exemples : ordre du jour, programme de session, liste des interventions.\n" ;
	meta:label_de "Sitzungsunterlagen" ;
	meta:label_en "Meeting documents" ;
	meta:label_fr "Documents de séance" ;
	meta:label_it "Documenti di seduta" ;
	meta:label_rm "Documents da sesida" .
meta:vocabulary\/document_category\/MeetingPlanning dcterms:title "Meeting planning" ;
	a owl:Class ;
	rdfs:label "meeting_planning" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Planning of meetings and sessions. Examples: invitation, seating plan, time budget, deadlines for motions.\n" ;
	meta:description_de "Planung von Sitzungen und Sessionen. Beispiele: Einladung, Sitzplan, Zeitbudget, Fristen für Einzelanträge.\n" ;
	meta:description_fr "Planification des séances et des sessions. Exemples : convocation, plan de salle, budget-temps, délais pour les propositions individuelles.\n" ;
	meta:label_de "Sitzungsplanung" ;
	meta:label_en "Meeting planning" ;
	meta:label_fr "Planification de séance" ;
	meta:label_it "Pianificazione della seduta" ;
	meta:label_rm "Planisaziun da sesida" .
meta:vocabulary\/document_category\/MemberDirectory dcterms:title "Member directory" ;
	a owl:Class ;
	rdfs:label "member_directory" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Lists of members. Examples: members of the councils, committee members, members of friendship groups.\n" ;
	meta:description_de "Mitgliederlisten. Beispiele: Mitglieder der Räte, Kommissionsmitglieder, Mitglieder von Freundschaftsgruppen.\n" ;
	meta:description_fr "Listes des membres. Exemples : membres des conseils, membres des commissions, membres des groupes d'amitié.\n" ;
	meta:label_de "Mitgliederverzeichnis" ;
	meta:label_en "Member directory" ;
	meta:label_fr "Liste des membres" ;
	meta:label_it "Elenco dei membri" ;
	meta:label_rm "Glista dals commembers" .
meta:vocabulary\/document_category\/Other dcterms:title "Other" ;
	a owl:Class ;
	rdfs:label "other" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Document that fits none of the categories, or whose category is unknown. Default if `document_category` is not set.\n" ;
	meta:description_de "Dokument, das keiner Kategorie zugeordnet werden kann oder dessen Kategorie unbekannt ist. Default, wenn `document_category` nicht gesetzt ist.\n" ;
	meta:description_fr "Document ne relevant d'aucune catégorie ou dont la catégorie est inconnue. Valeur par défaut si `document_category` n'est pas renseigné.\n" ;
	meta:label_de "Andere" ;
	meta:label_en "Other" ;
	meta:label_fr "Autre" ;
	meta:label_it "Altro" ;
	meta:label_rm "Auter" .
meta:vocabulary\/document_category\/PersonDocuments dcterms:title "Person documents" ;
	a owl:Class ;
	rdfs:label "person_documents" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Documents on individual persons. Examples: portrait of a council member, list of personal staff.\n" ;
	meta:description_de "Unterlagen zu einzelnen Personen. Beispiele: Porträt eines Ratsmitglieds, Liste der persönlichen Mitarbeitenden.\n" ;
	meta:description_fr "Documents relatifs à des personnes. Exemples : portrait d'un membre du conseil, liste des collaboratrices et collaborateurs personnels.\n" ;
	meta:label_de "Personenunterlagen" ;
	meta:label_en "Person documents" ;
	meta:label_fr "Documents personnels" ;
	meta:label_it "Documenti personali" ;
	meta:label_rm "Documents da persuna" .
meta:vocabulary\/document_category\/Protocol dcterms:title "Protocol" ;
	a owl:Class ;
	rdfs:label "protocol" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Record of the proceedings of a meeting. Examples: verbatim record, decision minutes, speaker list, video recording.\n" ;
	meta:description_de "Aufzeichnung des Verlaufs einer Sitzung. Beispiele: Wortprotokoll, Beschlussprotokoll, Rednerliste, Videoaufzeichnung.\n" ;
	meta:description_fr "Enregistrement du déroulement d'une séance. Exemples : procès-verbal in extenso, procès-verbal des décisions, liste des orateurs, enregistrement vidéo.\n" ;
	meta:label_de "Protokoll" ;
	meta:label_en "Minutes" ;
	meta:label_fr "Procès-verbal" ;
	meta:label_it "Verbale" ;
	meta:label_rm "Protocol" .
meta:vocabulary\/document_category\/VotingResult dcterms:title "Voting result" ;
	a owl:Class ;
	rdfs:label "voting_result" ;
	rdfs:subClassOf meta:DocumentCategoryEnum ;
	skos:definition "Results of votes and elections. Examples: voting record, election record.\n" ;
	meta:description_de "Ergebnisse von Abstimmungen und Wahlen. Beispiele: Abstimmungsprotokoll, Wahlprotokoll.\n" ;
	meta:description_fr "Résultats des votes et des élections. Exemples : procès-verbal de vote, procès-verbal d'élection.\n" ;
	meta:label_de "Abstimmungsergebnis" ;
	meta:label_en "Voting result" ;
	meta:label_fr "Résultat du vote" ;
	meta:label_it "Risultato della votazione" ;
	meta:label_rm "Resultat da votaziun" .
meta:works a owl:ObjectProperty ;
	rdfs:label "works" ;
	rdfs:range meta:Work ;
	skos:definition "The documents (FRBR Works) contained in the container.\n" ;
	skos:inScheme <https://ch.paf.link/schema/meta> ;
	meta:description_de "Die im Container enthaltenen Dokumente (FRBR Works).\n" ;
	meta:description_fr "Les documents (FRBR Works) contenus dans le conteneur.\n" .
<https://ld.ech.ch/schema/0292/meta-common/GroupReference> a owl:Class ;
	rdfs:label "GroupReference" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> , _:c14n116 , _:c14n171 , _:c14n183 , _:c14n29 , _:c14n3 , _:c14n63 ;
	skos:definition "Lightweight reference to a group with key identification data at time of linking. The referenced group is identified by `local_id` or `global_uri`; at least one of the two is required. A `local_id` is resolved within the same delivery, a `global_uri` also beyond it.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Kurzreferenz auf eine Gruppe mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Die referenzierte Gruppe wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich. Eine `local_id` wird innerhalb derselben Lieferung aufgelöst, eine `global_uri` auch darüber hinaus.\n" ;
	meta:description_fr "Référence abrégée à un groupe avec les principales données d'identification au moment de la liaison. Le groupe référencé est désigné par `local_id` ou `global_uri` ; au moins l'un des deux est requis. Un `local_id` est résolu au sein de la même livraison, un `global_uri` également au-delà.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasCreationModificationDates> a owl:Class ;
	rdfs:label "HasCreationModificationDates" ;
	rdfs:subClassOf _:c14n107 , _:c14n123 , _:c14n129 , _:c14n137 , _:c14n141 , _:c14n175 , _:c14n4 , _:c14n54 , _:c14n7 , _:c14n70 , _:c14n74 , _:c14n78 ;
	skos:definition "A mixin class that provides slots for modeling creation and modification dates of an entity.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von Erstellungs- und Änderungsdaten einer Entität zur Verfügung stellt.\n" ;
	meta:description_fr "Une classe mixin qui fournit des slots pour modéliser les dates de création et de modification d'une entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasIdentification> a owl:Class ;
	rdfs:label "HasIdentification" ;
	rdfs:subClassOf _:c14n10 , _:c14n104 , _:c14n148 , _:c14n150 , _:c14n167 , _:c14n193 , _:c14n69 , _:c14n71 , _:c14n81 ;
	skos:definition "A mixin class that provides slots for the identification of an entity. It is used for entities that are identified in their own right; their `global_uri` is the identifier and therefore mandatory.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, die Slots für die Identifikation einer Entität zur Verfügung stellt. Sie wird für Entitäten verwendet, die aus sich heraus identifiziert sind; deren `global_uri` ist der Identifikator und daher obligatorisch.\n" ;
	meta:description_fr "Une classe mixin qui fournit des slots pour l'identification d'une entité. Elle est utilisée pour les entités identifiées en propre ; leur `global_uri` constitue l'identifiant et est donc obligatoire.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> a owl:Class ;
	rdfs:label "HasReferenceIdentification" ;
	rdfs:subClassOf _:c14n122 , _:c14n133 , _:c14n14 , _:c14n145 , _:c14n169 , _:c14n184 , _:c14n20 , _:c14n91 , _:c14n96 ;
	skos:definition "A mixin class that provides the slots with which a reference names the entity it points at. Unlike `HasIdentification` it does not identify the referencing object itself, which is why `global_uri` is neither an identifier here nor mandatory: a system that only holds the local id of the referenced entity states that id instead. A reference class using this mixin should require at least one of the two.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, welche die Slots bereitstellt, mit denen eine Referenz die Entität benennt, auf die sie zeigt. Im Unterschied zu `HasIdentification` identifiziert sie nicht das referenzierende Objekt selbst; deshalb ist `global_uri` hier weder Identifikator noch obligatorisch: Ein System, das nur die lokale Id der referenzierten Entität führt, gibt diese an. Eine Referenzklasse, die diesen Mixin verwendet, soll mindestens eines von beiden verlangen.\n" ;
	meta:description_fr "Une classe mixin qui fournit les slots par lesquels une référence désigne l'entité vers laquelle elle pointe. Contrairement à `HasIdentification`, elle n'identifie pas l'objet référençant lui-même ; c'est pourquoi `global_uri` n'y est ni identifiant ni obligatoire : un système qui ne dispose que de l'identifiant local de l'entité référencée indique celui-ci. Une classe de référence utilisant ce mixin doit exiger au moins l'un des deux.\n" .
<https://ld.ech.ch/schema/0292/meta-common/HasTemporalValidity> a owl:Class ;
	rdfs:label "HasTemporalValidity" ;
	rdfs:subClassOf _:c14n157 , _:c14n16 , _:c14n173 , _:c14n178 , _:c14n179 , _:c14n21 , _:c14n37 , _:c14n61 , _:c14n83 ;
	skos:definition "A mixin class that provides slots for modeling a temporal validity of information (not of an event).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, die Slots für die Modellierung einer zeitlichen Gültigkeit einer Information (nicht eines Events) zur Verfügung stellt.\n" ;
	meta:description_fr "Une classe mixin qui fournit des slots pour modéliser la validité temporelle d'une information (et non d'un événement).\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsEventWithDuration> a owl:Class ;
	rdfs:label "IsEventWithDuration" ;
	rdfs:subClassOf _:c14n103 , _:c14n105 , _:c14n114 , _:c14n124 , _:c14n127 , _:c14n144 , _:c14n146 , _:c14n151 , _:c14n156 , _:c14n159 , _:c14n165 , _:c14n176 , _:c14n187 , _:c14n189 , _:c14n19 , _:c14n194 , _:c14n201 , _:c14n22 , _:c14n33 , _:c14n58 , _:c14n8 , _:c14n80 , _:c14n97 , _:c14n98 ;
	skos:definition "A mixin class that provides slots for modeling events or occurrences with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von Ereignissen oder Vorkommnissen mit Zeitdauer zur Verfügung stellt.\n" ;
	meta:description_fr "Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences avec une durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsInstantaneousEvent> a owl:Class ;
	rdfs:label "IsInstantaneousEvent" ;
	rdfs:subClassOf _:c14n100 , _:c14n109 , _:c14n110 , _:c14n140 , _:c14n15 , _:c14n162 , _:c14n191 , _:c14n25 , _:c14n26 , _:c14n40 , _:c14n73 , _:c14n99 ;
	skos:definition "A mixin class that provides slots for modeling instantaneous events or occurrences (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse, die Slots für die Modellierung von instantanen Ereignissen oder Vorkommnissen (ohne Zeitdauer) zur Verfügung stellt.\n" ;
	meta:description_fr "Une classe mixin qui fournit des slots pour modéliser des événements ou occurrences instantanés (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/IsProcessStep> a owl:Class ;
	rdfs:label "IsProcessStep" ;
	rdfs:subClassOf _:c14n0 , _:c14n102 , _:c14n108 , _:c14n11 , _:c14n111 , _:c14n112 , _:c14n117 , _:c14n139 , _:c14n143 , _:c14n163 , _:c14n166 , _:c14n168 , _:c14n18 , _:c14n180 , _:c14n182 , _:c14n185 , _:c14n195 , _:c14n199 , _:c14n31 , _:c14n36 , _:c14n38 , _:c14n41 , _:c14n43 , _:c14n44 , _:c14n47 , _:c14n50 , _:c14n52 , _:c14n53 , _:c14n56 , _:c14n57 , _:c14n6 , _:c14n60 , _:c14n68 , _:c14n77 , _:c14n85 , _:c14n93 ;
	skos:definition "A mixin class for a single step in a multi-stage process (e.g.,\na deliberation step of an affair or a phase step of a consultation).\nCombines identification and event-duration slots and adds a free-text\nremark slot. Concrete step classes add their own type-specific slots.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine Mixin-Klasse für einen einzelnen Schritt in einem\nmehrstufigen Prozess (z. B. Bearbeitungsschritt eines Geschäfts oder\nPhasen­schritt einer Konsultation). Kombiniert Identifikations- und\nZeitdauer-Slots und ergänzt einen freien Bemerkungs-Slot. Konkrete\nStep-Klassen ergänzen ihre eigenen typ-spezifischen Slots.\n" ;
	meta:description_fr "Une classe mixin pour une étape unique dans un processus\nà plusieurs étapes (par ex. une étape de délibération d'une affaire ou\nune étape de phase d'une consultation). Combine les slots d'identification\net de durée d'événement et ajoute un slot de remarque en texte libre.\nLes classes d'étape concrètes ajoutent leurs propres slots spécifiques au type.\n" .
<https://ld.ech.ch/schema/0292/meta-common/MultilingualUri> a owl:Class ;
	rdfs:label "MultilingualUri" ;
	rdfs:subClassOf _:c14n12 , _:c14n131 , _:c14n149 , _:c14n186 , _:c14n49 , _:c14n66 ;
	skos:definition "A URI together with the language of the resource it points to. Same structure as MultilingualValue, but the value is a URI: it is used where the same content is published under a separate address per language.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine URI zusammen mit der Sprache der Ressource, auf die sie verweist. Gleich aufgebaut wie MultilingualValue, der Wert ist jedoch eine URI: Sie wird dort verwendet, wo derselbe Inhalt je Sprache unter einer eigenen Adresse publiziert wird.\n" ;
	meta:description_fr "Une URI accompagnée de la langue de la ressource vers laquelle elle renvoie. Structure identique à MultilingualValue, mais la valeur est une URI : elle est utilisée là où le même contenu est publié à une adresse propre par langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> a owl:Class ;
	rdfs:label "MultilingualValue" ;
	rdfs:subClassOf _:c14n126 , _:c14n161 , _:c14n39 , _:c14n45 , _:c14n72 , _:c14n86 ;
	skos:definition "A multilingual string with language specification.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Ein mehrsprachiger String mit Angabe der Sprache.\n" ;
	meta:description_fr "Une chaîne de caractères multilingue avec indication de la langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/PersonReference> a owl:Class ;
	rdfs:label "PersonReference" ;
	rdfs:subClassOf <https://ld.ech.ch/schema/0292/meta-common/HasReferenceIdentification> , _:c14n106 , _:c14n113 , _:c14n128 , _:c14n135 , _:c14n177 , _:c14n32 , _:c14n46 , _:c14n48 , _:c14n79 , _:c14n92 ;
	skos:definition "Lightweight reference to a person with key identification data at time of linking. Preserves historical accuracy even if the person changes later. The referenced person is identified by `local_id` or `global_uri`; at least one of the two is required.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Kurzreferenz auf eine Person mit den wichtigsten Identifikationsmerkmalen zum Zeitpunkt der Verknüpfung. Ermöglicht historische Korrektheit auch wenn sich die Person später ändert. Die referenzierte Person wird über `local_id` oder `global_uri` bezeichnet; mindestens eines von beiden ist erforderlich.\n" ;
	meta:description_fr "Référence abrégée à une personne avec les principales données d'identification au moment de la liaison. Préserve l'exactitude historique même si la personne change ultérieurement. La personne référencée est désignée par `local_id` ou `global_uri` ; au moins l'un des deux est requis.\n" .
<https://ld.ech.ch/schema/0292/meta-common/abbreviation> a owl:ObjectProperty ;
	rdfs:label "abbreviation" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> ;
	skos:definition "Abbreviation (can be multilingual).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Abkürzung (kann mehrsprachig sein).\n" ;
	meta:description_fr "Abréviation (peut être multilingue).\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateActual> a owl:DatatypeProperty ;
	rdfs:label "date_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual date of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	meta:description_fr "La date effective d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateBeginActual> a owl:DatatypeProperty ;
	rdfs:label "date_begin_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual start date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date de début effective d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateBeginPlanned> a owl:DatatypeProperty ;
	rdfs:label "date_begin_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned start date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Startdatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date de début planifiée d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateCreated> a owl:DatatypeProperty ;
	rdfs:label "date_created" ;
	rdfs:range xsd:date ;
	skos:definition "The date when an entity was created.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum, an dem eine Entität erstellt wurde.\n" ;
	meta:description_fr "La date à laquelle une entité a été créée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateEndActual> a owl:DatatypeProperty ;
	rdfs:label "date_end_actual" ;
	rdfs:range xsd:date ;
	skos:definition "The actual end date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date de fin effective d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateEndPlanned> a owl:DatatypeProperty ;
	rdfs:label "date_end_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned end date of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Enddatum eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date de fin planifiée d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/dateModified> a owl:DatatypeProperty ;
	rdfs:label "date_modified" ;
	rdfs:range xsd:date ;
	skos:definition "The date when an entity was last modified.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum, an dem eine Entität zuletzt geändert wurde.\n" ;
	meta:description_fr "La date à laquelle une entité a été modifiée pour la dernière fois.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datePlanned> a owl:DatatypeProperty ;
	rdfs:label "date_planned" ;
	rdfs:range xsd:date ;
	skos:definition "The planned date of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Datum eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	meta:description_fr "La date planifiée d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual date and time of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	meta:description_fr "La date et l'heure effectives d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeBeginActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_begin_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual start date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date et l'heure de début effectives d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeBeginPlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_begin_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned start date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Startdatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date et l'heure de début planifiées d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeCreated> a owl:DatatypeProperty ;
	rdfs:label "datetime_created" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when an entity was created.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum und die Uhrzeit, an dem eine Entität erstellt wurde.\n" ;
	meta:description_fr "La date et l'heure auxquelles une entité a été créée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeEndActual> a owl:DatatypeProperty ;
	rdfs:label "datetime_end_actual" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The actual end date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das tatsächliche Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date et l'heure de fin effectives d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeEndPlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_end_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned end date and time of an event or occurrence with time duration.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Enddatum und die Uhrzeit eines Ereignisses oder Vorkommnissen mit Zeitdauer.\n" ;
	meta:description_fr "La date et l'heure de fin planifiées d'un événement ou d'une occurrence avec durée.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimeModified> a owl:DatatypeProperty ;
	rdfs:label "datetime_modified" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The date and time when an entity was last modified.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das Datum und die Uhrzeit, an dem eine Entität zuletzt geändert wurde.\n" ;
	meta:description_fr "La date et l'heure auxquelles une entité a été modifiée pour la dernière fois.\n" .
<https://ld.ech.ch/schema/0292/meta-common/datetimePlanned> a owl:DatatypeProperty ;
	rdfs:label "datetime_planned" ;
	rdfs:range xsd:dateTime ;
	skos:definition "The planned date and time of an instantaneous event or occurrence (without time duration).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Das geplante Datum und die Uhrzeit eines instantanen Ereignisses oder Vorkommnissen (ohne Zeitdauer).\n" ;
	meta:description_fr "La date et l'heure planifiées d'un événement ou d'une occurrence instantané (sans durée).\n" .
<https://ld.ech.ch/schema/0292/meta-common/globalURI> a owl:DatatypeProperty ;
	rdfs:label "global_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A unique, globally valid URI for the entity.\n" , "The unique, globally valid URI of the referenced entity. Unlike a local_id it also resolves beyond the delivery.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Die eindeutige, global gültige URI der referenzierten Entität. Im Unterschied zu einer local_id ist sie auch über die Lieferung hinaus auflösbar.\n" , "Eine eindeutige, global gültige URI für die Entität.\n" ;
	meta:description_fr "L'URI unique et globalement valide de l'entité référencée. Contrairement à un local_id, elle est également résoluble au-delà de la livraison.\n" , "Une URI unique et globalement valide pour l'entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/groupLabel> a owl:DatatypeProperty ;
	rdfs:label "group_label" ;
	skos:definition "Name of the body/group at time of linking.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Name des Gremiums zum Zeitpunkt der Verknüpfung.\n" ;
	meta:description_fr "Nom de l'organe/du groupe au moment de la liaison.\n" .
<https://ld.ech.ch/schema/0292/meta-common/isCurrent> a owl:DatatypeProperty ;
	rdfs:label "is_active" ;
	rdfs:range xsd:boolean ;
	skos:definition "Indicates whether the information is currently valid. Can be useful when this information is explicitly available.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Gibt an, ob die Information aktuell gültig ist. Kann nützlich sein, wenn diese Information explizit vorhanden ist.\n" ;
	meta:description_fr "Indique si l'information est actuellement valable. Peut être utile lorsque cette information est explicitement disponible.\n" .
<https://ld.ech.ch/schema/0292/meta-common/label> a owl:DatatypeProperty ;
	rdfs:label "label" ;
	skos:definition "Assign a label to a structured piece of information (e.g., display name, position, etc.).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Möglichkeit bei einer strukturierten Information, ein Label zu vergeben (bspw. Anzeigename, Anstellung, etc.).\n" ;
	meta:description_fr "Attribuer un label à une information structurée (par ex. nom d'affichage, poste, etc.).\n" .
<https://ld.ech.ch/schema/0292/meta-common/labelLong> a owl:DatatypeProperty ;
	rdfs:label "label_long" ;
	skos:definition "Assign an extended label to a structured piece of information (e.g., display name with title, position, etc.).\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Möglichkeit bei einer strukturierten Information, ein erweitertesLabel zu vergeben (bspw. Anzeigename mit Titel, Anstellung, etc.).\n" ;
	meta:description_fr "Attribuer un label étendu à une information structurée (par ex. nom d'affichage avec titre, poste, etc.).\n" .
<https://ld.ech.ch/schema/0292/meta-common/language> a owl:DatatypeProperty ;
	rdfs:label "language" ;
	rdfs:range _:c14n42 ;
	skos:definition "Language code in ISO 639-1 format (two lowercase letters, e.g. \"de\", \"fr\", \"it\", \"en\").\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Sprachcode im ISO 639-1 Format (zwei Kleinbuchstaben, z.B. \"de\", \"fr\", \"it\", \"en\").\n" ;
	meta:description_fr "Code de langue au format ISO 639-1 (deux lettres minuscules, par ex. « de », « fr », « it », « en »).\n" .
<https://ld.ech.ch/schema/0292/meta-common/localId> a owl:DatatypeProperty ;
	rdfs:label "local_id" ;
	skos:definition "Local identifier of the referenced entity. It is resolved within the same delivery.\n" , "Local identifier. For example, a UUID from the council information system.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Lokaler Identifikator der referenzierten Entität. Er wird innerhalb derselben Lieferung aufgelöst.\n" , "Lokaler Identifikator. Bspw. eine UUID aus dem Ratsinformationssystem.\n" ;
	meta:description_fr "Identifiant local de l'entité référencée. Il est résolu au sein de la même livraison.\n" , "Identifiant local. Par exemple, un UUID issu du système d'information du conseil.\n" .
<https://ld.ech.ch/schema/0292/meta-common/multilingualValue> a owl:ObjectProperty ;
	rdfs:label "multilingual_value" ;
	rdfs:range <https://ld.ech.ch/schema/0292/meta-common/MultilingualValue> ;
	skos:definition "A multilingual value with language specification.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Ein mehrsprachiger Wert mit Angabe der Sprache.\n" ;
	meta:description_fr "Une valeur multilingue avec indication de la langue.\n" .
<https://ld.ech.ch/schema/0292/meta-common/remark> a owl:DatatypeProperty ;
	rdfs:label "remark" ;
	rdfs:range xsd:string ;
	skos:definition "Free-text remark or note for edge cases or additional context on a process step or an entity.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Freitext-Bemerkung oder Notiz für Sonderfälle oder zusätzlichen Kontext zu einem Prozessschritt oder einer Entität.\n" ;
	meta:description_fr "Remarque ou note en texte libre pour les cas particuliers ou pour un contexte supplémentaire relatif à une étape de processus ou à une entité.\n" .
<https://ld.ech.ch/schema/0292/meta-common/value> a owl:DatatypeProperty ;
	rdfs:label "value" ;
	skos:definition "The value of an information besides other attributes such as type, language, etc.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Der eigentliche Wert einer Information neben weiteren attributen wie Typ, Sprache, etc.\n" ;
	meta:description_fr "La valeur proprement dite d'une information, en plus d'autres attributs tels que le type, la langue, etc.\n" .
<https://ld.ech.ch/schema/0292/meta-common/wikidataUri> a owl:DatatypeProperty ;
	rdfs:label "wikidata_uri" ;
	rdfs:range xsd:anyURI ;
	skos:definition "A URI that refers to a Wikidata entity, e.g. http://www.wikidata.org/entity/Q813067 for Beat Jans.\n" ;
	skos:inScheme <https://ld.ech.ch/schema/0292/meta-common> ;
	meta:description_de "Eine URI, die auf eine Wikidata-Entität verweist, z.B. http://www.wikidata.org/entity/Q813067 für Beat Jans.\n" ;
	meta:description_fr "Une URI qui renvoie à une entité Wikidata, p. ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.\n" , "Une URI qui renvoie à une entité Wikidata, par ex. http://www.wikidata.org/entity/Q813067 pour Beat Jans.\n" .
